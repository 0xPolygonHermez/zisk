require "std_permutation.pil"
require "std_range_check.pil"
require "std_direct.pil"
require "operations.pil"
require "opids.pil"
require "config.pil"
require "allocator/pil/allocator_common.pil"

// AllocatorCanonical
//
// Deterministic allocator: the address returned by each alloc is fully determined by the previous
// operations of the main, the prover has no decision to take. It's the same idea as Allocator
// (the state is a set of tokens in a private multiset bus), plus:
//
//  - an ordered free list, to prove that the block taken is THE best fit,
//  - the neighbours of each block, to prove that a released block is joined with every free
//    neighbour (so there are no internal join rows: each row is one operation of the main).
//
// Tokens (type, addr, size, prev, dirty, ver, next_size, next_addr):
//
//      FREE    free block and node of the free list. The list is ordered by (size, addr) and
//              (next_size, next_addr) is the key of the following node. The head of the list is
//              the token FREE(addr 0, size 0), proved once by allocator_canonical_init(), and the tail
//              is only a key, (2**32, 0).
//      USE     block handed out.
//      GUARD   end of a created area. A block that is never free.
//
//      prev    size of the block just below, 0 at the beginning of an area. Blocks tile the
//              areas, so from a block both neighbours can be located, and "the neighbour is not
//              free" is proved by showing that it is a USE or a GUARD.
//      ver     version that produced the token.
//
// Time. The row of the main step s does up to three sequential updates, with the versions
// 4s + 1, 4s + 2 and 4s + 3. A token is produced with the version of its update, and can only be
// consumed by a later version. So a row never consumes a token of its future (which would allow
// cycles that create blocks out of nothing, or to see the list as it was before or after), and
// the updates of a row may touch the same token one after the other without special cases.
//
// Operations:
//
//      create  (addr, size)        [3] insert FREE(addr, size, prev 0), produce GUARD(addr + size)
//
//      alloc   (size) => addr      [1] remove node N from the list. N is the first node with
//                                      size >= requested: the prover gives its predecessor P,
//                                      and P.size < size is verified. Produce USE(addr, size).
//                                  [3] if N is bigger: insert the rest and update prev of the
//                                      block above. The rest can't be dropped.
//
//      dealloc (addr)              [1] consume USE(addr, size, prev). The block below is removed
//                                      from the list (it's free: join) or shown as USE.
//                                  [2] the block above is removed from the list, if it's free.
//                                  [3] the first non free block above is shown (USE or GUARD) and
//                                      its prev updated. Insert the joined block.
//
// Each produced token has a flag (emit_*) that the prover clears when nobody consumes it, to
// balance the bus. A token that isn't produced can't be consumed later: clearing a flag of a
// token that is needed makes the following operation unprovable, never different.
//
// Assumptions on the caller (ziskos), NOT verified here:
//  - created areas don't overlap each other nor any other memory in use, and a create_clean area
//    is really zeroed,
//  - addr and size of the created areas are multiples of 8 and addr + size < 2**33 (the order of
//    the list needs it; alloc sizes are verified here).

const int ALLOC_TAIL_SIZE = 2**32;

// Head of the free list. Must be called once, at proof level.
function allocator_canonical_init() {
    direct_global_update_proves(ALLOC_CANONICAL_BUS_ID, [ALLOC_TOKEN_FREE, 0, 0, 0, 0, 0, ALLOC_TAIL_SIZE, 0]);
}

airtemplate AllocatorCanonical(int N = 2**20) {

    // Only ranges that other airs already use (16, 22 and 24 bits), to not add new range tables.
    const int VER_CHUNK_BITS[2] = [16, 24];
    const int KEY_CHUNK_BITS[3] = [16, 22, 24];
    assert(VER_CHUNK_BITS[0] + VER_CHUNK_BITS[1] >= MAIN_STEP_BITS + 2);

    const int T_FREE = ALLOC_TOKEN_FREE;
    const int T_USE = ALLOC_TOKEN_USE;
    const int T_GUARD = ALLOC_TOKEN_GUARD;

    // Key of the free list. Sizes are multiples of 8 and addr < 2**33, so this is the
    // lexicographic order (size, addr), and the key of the tail is 2**62.
    const int KEY_SIZE_FACTOR = 2**30;

    // Operation selectors, at most one per row. A row without operation does nothing.

    col witness bits(1) sel_create;
    col witness bits(1) sel_alloc;
    col witness bits(1) sel_dealloc;

    const expr sel = sel_create + sel_alloc + sel_dealloc;

    sel_create * (1 - sel_create) === 0;
    sel_alloc * (1 - sel_alloc) === 0;
    sel_dealloc * (1 - sel_dealloc) === 0;
    sel * (1 - sel) === 0;

    // Operation
    //
    //   create:  (addr, size) is the new area.
    //   alloc:   size is the requested size. addr and prev unused.
    //   dealloc: addr given by the main, (addr, size, prev) is the USE token to release.

    col witness bits(MAIN_STEP_BITS) step;
    col witness bits(ADDR_BITS + 1) addr;
    col witness bits(32) size;
    col witness bits(32) prev;

    col witness bits(1) dirty;              // create: the area isn't zeroed
    col witness bits(1) calloc;             // alloc: the block must be returned zeroed
    col witness bits(1) memset;             // alloc: calloc over a dirty block
    col witness bits(1) has_rest;           // alloc: the block taken is bigger than requested
    col witness bits(1) has_below;          // dealloc: it isn't the first block of the area
    col witness bits(1) join_below;         // dealloc: the block below is free
    col witness bits(1) join_above;         // dealloc: the block above is free

    dirty * (1 - dirty) === 0;
    calloc * (1 - calloc) === 0;
    has_rest * (1 - has_rest) === 0;
    has_below * (1 - has_below) === 0;
    join_below * (1 - join_below) === 0;
    join_above * (1 - join_above) === 0;

    calloc * (1 - sel_alloc) === 0;
    has_rest * (1 - sel_alloc) === 0;
    has_below * (1 - sel_dealloc) === 0;
    join_below * (1 - has_below) === 0;
    join_above * (1 - sel_dealloc) === 0;

    // Versions of the three updates of the row.
    const expr version[3];
    for (int i = 0; i < 3; i++) {
        version[i] = 4 * step + i + 1;
    }

    // Version of a consumed token: it isn't a column, it's defined from the version of the
    // update that consumes it and a range checked distance, so it's always older.

    const int V_A = 0;
    const int V_PA = 1;
    const int V_USE = 2;
    const int V_B = 3;
    const int V_PB = 4;
    const int V_Q = 5;
    const int V_UP = 6;
    const int VER_COUNT = 7;
    const int VER_UPDATE[VER_COUNT] = [0, 0, 0, 1, 1, 2, 2];

    col witness bits(VER_CHUNK_BITS[0]) ver_diff_0[VER_COUNT];
    col witness bits(VER_CHUNK_BITS[1]) ver_diff_1[VER_COUNT];

    const expr older_version[VER_COUNT];
    for (int i = 0; i < VER_COUNT; i++) {
        range_check(expression: ver_diff_0[i], min: 0, max: 2**VER_CHUNK_BITS[0] - 1);
        range_check(expression: ver_diff_1[i], min: 0, max: 2**VER_CHUNK_BITS[1] - 1);
        older_version[i] = version[VER_UPDATE[i]] - 1 - ver_diff_0[i] - ver_diff_1[i] * 2**VER_CHUNK_BITS[0];
    }

    // 32 bits values of the alloc checks, as two range checked chunks.

    const int R_SIZE = 0;
    const int R_BEST_FIT = 1;
    const int R_REST = 2;
    const int R32_COUNT = 3;

    col witness bits(16) r32_chunk_0[R32_COUNT];
    col witness bits(16) r32_chunk_1[R32_COUNT];

    const expr r32[R32_COUNT];
    for (int i = 0; i < R32_COUNT; i++) {
        range_check(expression: r32_chunk_0[i], min: 0, max: 2**16 - 1);
        range_check(expression: r32_chunk_1[i], min: 0, max: 2**16 - 1);
        r32[i] = r32_chunk_0[i] + r32_chunk_1[i] * 2**16;
    }

    // UPDATE 1 (alloc, dealloc)
    // --------------------------------------------------------------------------------
    // Block A (a_addr, a_size, a_prev, a_dirty, a_ver, a_next_size, a_next_addr)
    //
    //   alloc:    the free block taken, a_addr is the result. Removed from the list.
    //   dealloc:  the block below, if any. If it's free (join_below) it's removed from the list,
    //             if it isn't, it's a USE token that is consumed and produced again.
    //
    // PA is the predecessor of A in the list, when A is removed.

    col witness bits(ADDR_BITS + 1) a_addr;
    col witness bits(32) a_size;
    col witness bits(32) a_prev;
    col witness bits(1) a_dirty;
    col witness bits(32) a_next_size;
    col witness bits(ADDR_BITS + 1) a_next_addr;
    const expr a_ver = older_version[V_A];

    col witness bits(ADDR_BITS + 1) pa_addr;
    col witness bits(32) pa_size;
    col witness bits(32) pa_prev;
    col witness bits(1) pa_dirty;
    const expr pa_ver = older_version[V_PA];

    col witness bits(1) emit_pa;
    col witness bits(1) emit_below;

    const expr remove_a = sel_alloc + join_below;
    const expr show_below = has_below - join_below;

    emit_pa * (1 - emit_pa) === 0;
    emit_below * (1 - emit_below) === 0;
    emit_pa * (1 - remove_a) === 0;
    emit_below * (1 - show_below) === 0;

    // dealloc: the block below is located by prev. Without block below, prev must be zero.
    (sel_dealloc - has_below) * prev === 0;
    has_below * (a_addr - addr + prev) === 0;
    has_below * (a_size - prev) === 0;

    // a USE token has neither dirty flag nor link
    show_below * a_dirty === 0;
    show_below * a_next_size === 0;
    show_below * a_next_addr === 0;

    // alloc: the requested size is a non-zero multiple of 8
    sel_alloc * (size - (r32[R_SIZE] + 1) * 8) === 0;

    // alloc: best fit. The predecessor is too small ...
    sel_alloc * (size - pa_size - 1 - r32[R_BEST_FIT]) === 0;

    // ... and the block is big enough. The rest, if any, is at least 8 bytes, and it's
    // mandatory: without rest the fit must be exact.
    sel_alloc * (a_size - size - 8 * has_rest - r32[R_REST]) === 0;
    (sel_alloc - has_rest) * (a_size - size) === 0;

    // dealloc: the USE token to release
    const expr use_ver = older_version[V_USE];

    // UPDATE 2 (dealloc)
    // --------------------------------------------------------------------------------
    // Block B (addr + size, b_size, size, b_dirty, b_ver, b_next_size, b_next_addr): the block
    // above, if it's free (join_above). Removed from the list. PB is its predecessor.

    col witness bits(32) b_size;
    col witness bits(1) b_dirty;
    col witness bits(32) b_next_size;
    col witness bits(ADDR_BITS + 1) b_next_addr;
    const expr b_ver = older_version[V_B];

    col witness bits(ADDR_BITS + 1) pb_addr;
    col witness bits(32) pb_size;
    col witness bits(32) pb_prev;
    col witness bits(1) pb_dirty;
    const expr pb_ver = older_version[V_PB];

    col witness bits(1) emit_pb;

    emit_pb * (1 - emit_pb) === 0;
    emit_pb * (1 - join_above) === 0;

    // b_size is added to the joined block, it must be zero if there is no join
    (1 - join_above) * b_size === 0;

    // UPDATE 3 (create, alloc with rest, dealloc)
    // --------------------------------------------------------------------------------
    // Block M (m_addr, m_size, m_prev, m_dirty): the new free block, inserted in the list.
    //
    //   create:   the area.
    //   alloc:    the rest of the block taken.
    //   dealloc:  the released block joined with its free neighbours.
    //
    // Q is the predecessor of M in the list and (qn_size, qn_addr) the key that follows.

    col witness bits(ADDR_BITS + 1) m_addr;
    col witness bits(32) m_size;
    col witness bits(32) m_prev;
    col witness bits(1) m_dirty;

    col witness bits(ADDR_BITS + 1) q_addr;
    col witness bits(32) q_size;
    col witness bits(32) q_prev;
    col witness bits(1) q_dirty;
    col witness bits(33) qn_size;
    col witness bits(ADDR_BITS + 1) qn_addr;
    const expr q_ver = older_version[V_Q];

    col witness bits(1) emit_q;
    col witness bits(1) emit_m;

    const expr insert = sel_create + has_rest + sel_dealloc;

    emit_q * (1 - emit_q) === 0;
    emit_m * (1 - emit_m) === 0;
    emit_q * (1 - insert) === 0;
    emit_m * (1 - insert) === 0;

    sel_create * (m_addr - addr) === 0;
    sel_create * (m_size - size) === 0;
    sel_create * m_prev === 0;
    sel_create * (m_dirty - dirty) === 0;

    has_rest * (m_addr - a_addr - size) === 0;
    has_rest * (m_size - a_size + size) === 0;
    has_rest * (m_prev - size) === 0;
    has_rest * (m_dirty - a_dirty) === 0;

    // size of the block below when it's joined, if not zero
    col witness bits(32) below_size;

    join_below * (below_size - prev) === 0;
    (1 - join_below) * below_size === 0;

    join_below * (m_addr - a_addr) === 0;
    (sel_dealloc - join_below) * (m_addr - addr) === 0;
    sel_dealloc * (m_size - size - below_size - b_size) === 0;
    join_below * (m_prev - a_prev) === 0;
    (sel_dealloc - join_below) * (m_prev - prev) === 0;
    sel_dealloc * (m_dirty - 1) === 0;

    // The list is ordered: key(Q) < key(M) < key(next of Q)

    const expr m_key = m_size * KEY_SIZE_FACTOR + m_addr;
    const expr q_key = q_size * KEY_SIZE_FACTOR + q_addr;
    const expr qn_key = qn_size * KEY_SIZE_FACTOR + qn_addr;

    col witness bits(KEY_CHUNK_BITS[0]) key_diff_0[2];
    col witness bits(KEY_CHUNK_BITS[1]) key_diff_1[2];
    col witness bits(KEY_CHUNK_BITS[2]) key_diff_2[2];

    for (int i = 0; i < 2; i++) {
        range_check(expression: key_diff_0[i], min: 0, max: 2**KEY_CHUNK_BITS[0] - 1);
        range_check(expression: key_diff_1[i], min: 0, max: 2**KEY_CHUNK_BITS[1] - 1);
        range_check(expression: key_diff_2[i], min: 0, max: 2**KEY_CHUNK_BITS[2] - 1);
    }
    const expr key_diff[2];
    for (int i = 0; i < 2; i++) {
        key_diff[i] = key_diff_0[i] + key_diff_1[i] * 2**KEY_CHUNK_BITS[0]
                                    + key_diff_2[i] * 2**(KEY_CHUNK_BITS[0] + KEY_CHUNK_BITS[1]);
    }

    insert * (m_key - q_key - 1 - key_diff[0]) === 0;
    insert * (qn_key - m_key - 1 - key_diff[1]) === 0;

    // Block UP (type, up_addr, up_size, up_prev): the first non free block above M, a USE or
    // the GUARD of the area. Its prev becomes the size of M.
    //
    //   alloc:    the block above the block taken (only if there is rest, if not nothing changes).
    //   dealloc:  the block above the released block, or above B if it's joined. It proves that
    //             there is nothing else to join.

    col witness bits(ADDR_BITS + 1) up_addr;
    col witness bits(32) up_size;
    col witness bits(32) up_prev;
    col witness bits(1) up_guard;
    const expr up_ver = older_version[V_UP];

    col witness bits(1) emit_up;

    const expr update_up = has_rest + sel_dealloc;

    up_guard * (1 - up_guard) === 0;
    up_guard * up_size === 0;
    emit_up * (1 - emit_up) === 0;
    emit_up * (1 - update_up) === 0;

    has_rest * (up_addr - a_addr - a_size) === 0;
    has_rest * (up_prev - a_size) === 0;

    sel_dealloc * (up_addr - addr - size - b_size) === 0;
    join_above * (up_prev - b_size) === 0;
    (sel_dealloc - join_above) * (up_prev - size) === 0;

    // Tokens produced without update

    col witness bits(1) emit_use;           // alloc: the USE token of the block
    col witness bits(1) emit_guard;         // create: the GUARD of the area

    emit_use * (1 - emit_use) === 0;
    emit_guard * (1 - emit_guard) === 0;
    emit_use * (1 - sel_alloc) === 0;
    emit_guard * (1 - sel_create) === 0;

    // BUS: ALLOC (tokens)
    // --------------------------------------------------------------------------------
    // All the selectors are boolean: a non boolean selector would be a multiplicity.

    // [1] remove A: - FREE(PA -> A), - FREE(A -> next), + FREE(PA -> next)
    //     show below: - USE(A), + USE(A)
    permutation_assumes(ALLOC_CANONICAL_BUS_ID, [T_FREE, pa_addr, pa_size, pa_prev, pa_dirty, pa_ver, a_size, a_addr],
                        sel: remove_a, sel_is_binary: 1);
    permutation_assumes(ALLOC_CANONICAL_BUS_ID, [T_FREE + show_below * (T_USE - T_FREE), a_addr, a_size, a_prev, a_dirty, a_ver,
                                       a_next_size, a_next_addr],
                        sel: sel_alloc + has_below, sel_is_binary: 1);
    permutation_proves(ALLOC_CANONICAL_BUS_ID, [T_FREE, pa_addr, pa_size, pa_prev, pa_dirty, version[0], a_next_size, a_next_addr],
                       sel: emit_pa, sel_is_binary: 1);
    permutation_proves(ALLOC_CANONICAL_BUS_ID, [T_USE, a_addr, a_size, a_prev, 0, version[0], 0, 0],
                       sel: emit_below, sel_is_binary: 1);

    // [1] alloc:   + USE(a_addr, size, a_prev)
    //     dealloc: - USE(addr, size, prev)
    permutation_proves(ALLOC_CANONICAL_BUS_ID, [T_USE, a_addr, size, a_prev, 0, version[0], 0, 0],
                       sel: emit_use, sel_is_binary: 1);
    permutation_assumes(ALLOC_CANONICAL_BUS_ID, [T_USE, addr, size, prev, 0, use_ver, 0, 0],
                        sel: sel_dealloc, sel_is_binary: 1);

    // [2] remove B: - FREE(PB -> B), - FREE(B -> next), + FREE(PB -> next)
    permutation_assumes(ALLOC_CANONICAL_BUS_ID, [T_FREE, pb_addr, pb_size, pb_prev, pb_dirty, pb_ver, b_size, addr + size],
                        sel: join_above, sel_is_binary: 1);
    permutation_assumes(ALLOC_CANONICAL_BUS_ID, [T_FREE, addr + size, b_size, size, b_dirty, b_ver, b_next_size, b_next_addr],
                        sel: join_above, sel_is_binary: 1);
    permutation_proves(ALLOC_CANONICAL_BUS_ID, [T_FREE, pb_addr, pb_size, pb_prev, pb_dirty, version[1], b_next_size, b_next_addr],
                       sel: emit_pb, sel_is_binary: 1);

    // [3] update UP: - UP(prev = up_prev), + UP(prev = m_size)
    permutation_assumes(ALLOC_CANONICAL_BUS_ID, [T_USE + up_guard * (T_GUARD - T_USE), up_addr, up_size, up_prev, 0, up_ver, 0, 0],
                        sel: update_up, sel_is_binary: 1);
    permutation_proves(ALLOC_CANONICAL_BUS_ID, [T_USE + up_guard * (T_GUARD - T_USE), up_addr, up_size, m_size, 0, version[2], 0, 0],
                       sel: emit_up, sel_is_binary: 1);

    // [3] insert M: - FREE(Q -> next), + FREE(Q -> M), + FREE(M -> next)
    permutation_assumes(ALLOC_CANONICAL_BUS_ID, [T_FREE, q_addr, q_size, q_prev, q_dirty, q_ver, qn_size, qn_addr],
                        sel: insert, sel_is_binary: 1);
    permutation_proves(ALLOC_CANONICAL_BUS_ID, [T_FREE, q_addr, q_size, q_prev, q_dirty, version[2], m_size, m_addr],
                       sel: emit_q, sel_is_binary: 1);
    permutation_proves(ALLOC_CANONICAL_BUS_ID, [T_FREE, m_addr, m_size, m_prev, m_dirty, version[2], qn_size, qn_addr],
                       sel: emit_m, sel_is_binary: 1);

    // [3] create: + GUARD(addr + size, prev = size)
    permutation_proves(ALLOC_CANONICAL_BUS_ID, [T_GUARD, addr + size, 0, size, 0, version[2], 0, 0],
                       sel: emit_guard, sel_is_binary: 1);

    // BUS: ALLOCATOR ===> MAIN
    // --------------------------------------------------------------------------------
    // OP_ALLOC_CREATE_CLEAN  (addr, 0, size, 0,      0, 0, 0, main_step)
    // OP_ALLOC_CREATE_DIRTY  (addr, 0, size, 0,      0, 0, 0, main_step)
    // OP_ALLOC_ALLOC         (size, 0,    0, 0, a_addr, 0, 0, main_step)
    // OP_ALLOC_CALLOC        (size, 0,    0, 0, a_addr, 0, 0, main_step)
    // OP_ALLOC_DEALLOC       (addr, 0,    0, 0,      0, 0, 0, main_step)
    //
    // The high chunks are zero: a size or an address of more than 32 bits can't be proved, and it
    // can't alias a small one modulo the field either.

    proves_operation(op: sel_create * (OP_ALLOC_CREATE_CLEAN + dirty) +
                         sel_alloc * (OP_ALLOC_ALLOC + calloc) +
                         sel_dealloc * OP_ALLOC_DEALLOC,
                     a: [(sel_create + sel_dealloc) * addr + sel_alloc * size, 0],
                     b: [sel_create * size, 0],
                     c: [sel_alloc * a_addr, 0],
                     flag: 0,
                     main_step: step,
                     mul: sel);

    // BUS: ALLOCATOR ===> DMA
    // --------------------------------------------------------------------------------
    // A calloc over a dirty block launches the memset as the main would do:
    //
    // OP_DMA_XMEMSET  (dst, 0, count, 0, dst, 0, 0, main_step, value)

    memset === calloc * a_dirty;

    assumes_operation(op: OP_DMA_XMEMSET,
                      a: [a_addr, 0],
                      b: [size, 0],
                      c: [a_addr, 0],
                      flag: 0,
                      main_step: step,
                      extended_arg: 0,
                      sel: memset,
                      sel_is_binary: 1);
}
