// PROTOTYPE: provisional ids, not wired into zisk.pil / operations.pil / opids.pil yet.
//
// Common definitions of the two allocators:
//
//   Allocator      (allocator.pil)       Default. Deterministic: best fit over an ordered free
//                                         list and forced coalescing. The prover has no decision
//                                         to take, so it can't shape the heap to exploit a bug
//                                         of the guest.
//
//   AllocatorFlex  (allocator_flex.pil)  Cheaper. Sound while the guest program is correct. The
//                                         prover decides which free block is used and when free
//                                         blocks are joined.
//
// Both validate the same main operations, only one of them must be instantiated.

const int ALLOC_BUS_ID = 8301;         // tokens of Allocator
const int ALLOC_FLEX_BUS_ID = 8300;    // tokens of AllocatorFlex (different layout)

const int OP_ALLOC_CREATE_CLEAN = 0xDB;
const int OP_ALLOC_CREATE_DIRTY = 0xDC;     // must be OP_ALLOC_CREATE_CLEAN + 1
const int OP_ALLOC_ALLOC = 0xDD;
const int OP_ALLOC_CALLOC = 0xDE;           // must be OP_ALLOC_ALLOC + 1
const int OP_ALLOC_DEALLOC = 0xDF;

// Token types of the alloc bus.
const int ALLOC_TOKEN_FREE = 1;
const int ALLOC_TOKEN_USE = 2;
const int ALLOC_TOKEN_GUARD = 3;
