require "std_lookup.pil"
require "std_range_check.pil"
require "opids.pil"
require "operations.pil"

// Value of each code of the dot_f8 formats, in the format's units (zisk_definitions::dot_f8).
// Row 256*f + c holds format f and code c. E2M1 codes are nibbles, so its 256 rows repeat its
// 16 codes: a lookup of format 3 also proves the code is below 16. NaN codes decode to 0.
const int DOT_F8_DECODE_TABLE_SIZE = 1024;

airtemplate DotF8DecodeTable(int N = DOT_F8_DECODE_TABLE_SIZE) {
    col fixed F = [0:256, 1:256, 2:256, 3:256];
    col fixed C;
    col fixed V;
    for (int row = 0; row < N; row++) {
        const int f = row / 256;
        int c = row % 256;
        if (f == 3) { c = c % 16; }
        int mag = 0;
        int neg = 0;
        if (f == 0) {
            mag = c % 128;
            if (c >= 128) { mag = 128 - mag; neg = 1; }
        } else if (f == 3) {
            const int e = (c / 2) % 4;
            mag = c % 2;
            if (e != 0) { mag = (2 + c % 2) * 2**(e - 1); }
            neg = c / 8;
        } else {
            const int e = (c / 8) % 16;
            mag = c % 8;
            if (e != 0) { mag = (8 + c % 8) * 2**(e - 1); }
            if (f == 1 && e == 15 && c % 8 == 7) { mag = 0; }
            if (f == 2 && c == 128) { mag = 0; }
            neg = c / 128;
        }
        C[row] = c;
        V[row] = mag - 2 * neg * mag;
    }

    col witness multiplicity;
    lookup_proves(DOT_F8_DECODE_TABLE_ID, mul: multiplicity, expressions: [F, C, V]);
}

// One call per run of rows, 8 multiply-adds per row. The parameter block [x, y, n, formats,
// block, out] is at word `pw`, with n = 8*R and block = 8*Bk (0: one block).
// Decoded values are below 2^18 in magnitude and a call has at most 8*N <= 2^26 products, so
// every sum stays below 2^62 and never wraps the field.
// Addresses are word indices; the memory bus proves they are 29-bit.
airtemplate DotF8(const int N = 2**21, const int with_bus = 1) {
    assert(N <= 2**23);
    col fixed FIRST = [1,0...];
    col fixed LAST = [0...,1];

    col witness bits(1) in_use, start, end, active, nz, ce, be, bz, oz, par, lx, ly, w;
    col witness bits(1) fx[2], fy[2], ex, ey, csg, bsg, rep, yr;
    col witness step, pw, R, r_inv, idx, rem_inv, Bk, bidx, brem_inv, ow, ow_inv, ob;
    col witness xw, yw, yb, x_word[2], y_word[2], xc[8], xv[8], yc[8], yv[8];
    col witness accb, s, tot, t;
    col witness cl[2], ch[2], bl[2], bh[2];

    for (int i = 0; i < 2; i++) {
        fx[i] * (1 - fx[i]) === 0;
        fy[i] * (1 - fy[i]) === 0;
    }
    in_use * (1 - in_use) === 0;
    start * (1 - start) === 0;
    par * (1 - par) === 0;
    bz * (1 - bz) === 0;
    csg * (1 - csg) === 0;
    bsg * (1 - bsg) === 0;
    rep * (1 - rep) === 0;
    ex === fx[0] * fx[1];
    ey === fy[0] * fy[1];
    const expr fmt_x = fx[0] + 2 * fx[1];
    const expr fmt_y = fy[0] + 2 * fy[1];

    // Call framing: every call starts and ends in this instance.
    start === FIRST + (1 - FIRST) * 'end;
    LAST * (1 - end) === 0;
    const expr keep = 1 - start;
    keep * (in_use - 'in_use) === 0;
    keep * (step - 'step) === 0;
    keep * (pw - 'pw) === 0;
    keep * (R - 'R) === 0;
    keep * (nz - 'nz) === 0;
    keep * (Bk - 'Bk) === 0;
    keep * (bz - 'bz) === 0;
    keep * (ow - 'ow) === 0;
    for (int i = 0; i < 2; i++) {
        keep * (fx[i] - 'fx[i]) === 0;
        keep * (fy[i] - 'fy[i]) === 0;
        keep * (cl[i] - 'cl[i]) === 0;
        keep * (ch[i] - 'ch[i]) === 0;
    }
    keep * (csg - 'csg) === 0;
    keep * (rep - 'rep) === 0;
    keep * (yb - 'yb) === 0;

    // Rows: idx = 0..R-1, or one inactive row when n = 0. Padding rows are n = 0 rows.
    (1 - in_use) * R === 0;
    idx === keep * ('idx + 1);
    nz === R * r_inv;
    (1 - nz) * R === 0;
    active === in_use * nz;
    const expr rem = R - 1 - idx;
    ce === 1 - rem * rem_inv;
    rem * ce === 0;
    end === 1 - active * (1 - ce);

    // Blocks of Bk rows; the last row of the call ends a block, so Bk divides R.
    bz * (Bk - R) === 0;
    bidx === keep * (1 - 'be) * ('bidx + 1);
    const expr brem = Bk - 1 - bidx;
    be === active * (1 - brem * brem_inv);
    brem * be === 0;
    active * end * (1 - be) === 0;

    // Words: 8-bit vectors load every row, E2M1 vectors on even rows. y starts at yb, and
    // starts again at yb with each block when rep (yr), on an even row for E2M1.
    start * par === 0;
    keep * (par + 'par - 1) === 0;
    lx === 1 - ex * par;
    ly === 1 - ey * par;
    rep * bz === 0;
    yr === keep * rep * 'be;
    yr * ey * par === 0;
    keep * (xw - 'xw - lx) === 0;
    (keep - yr) * (yw - 'yw - ly) === 0;
    (start + yr) * (yw - yb) === 0;
    for (int i = 0; i < 2; i++) {
        keep * (1 - lx) * (x_word[i] - 'x_word[i]) === 0;
        keep * (1 - ly) * (y_word[i] - 'y_word[i]) === 0;
    }
    expr x_bytes[2] = [0, 0];
    expr y_bytes[2] = [0, 0];
    expr x_nibbles = 0;
    expr y_nibbles = 0;
    for (int j = 0; j < 8; j++) {
        x_bytes[j / 4] = x_bytes[j / 4] + xc[j] * 2**(8 * (j % 4));
        y_bytes[j / 4] = y_bytes[j / 4] + yc[j] * 2**(8 * (j % 4));
        x_nibbles = x_nibbles + xc[j] * 2**(4 * j);
        y_nibbles = y_nibbles + yc[j] * 2**(4 * j);
    }
    for (int i = 0; i < 2; i++) {
        (1 - ex) * (x_word[i] - x_bytes[i]) === 0;
        (1 - ey) * (y_word[i] - y_bytes[i]) === 0;
    }
    ex * ((1 - par) * x_word[0] + par * x_word[1] - x_nibbles) === 0;
    ey * ((1 - par) * y_word[0] + par * y_word[1] - y_nibbles) === 0;

    // Exact sums: accb is the block sum before this row, s after it; tot and t likewise.
    expr prod = 0;
    for (int j = 0; j < 8; j++) {
        prod = prod + xv[j] * yv[j];
        lookup_assumes(DOT_F8_DECODE_TABLE_ID, [fmt_x, xc[j], xv[j]], sel: active, sel_is_binary: 1);
        lookup_assumes(DOT_F8_DECODE_TABLE_ID, [fmt_y, yc[j], yv[j]], sel: active, sel_is_binary: 1);
    }
    s === accb + active * prod;
    t === tot + active * prod;
    start * accb === 0;
    start * tot === 0;
    keep * (accb - (1 - 'be) * 's) === 0;
    keep * (tot - 't) === 0;

    // i64 limbs: v = lo + 2^32*hi - 2^64*sign, lo = l0 + 2^16*l1, hi = h0 + 2^16*h1 + 2^31*sign.
    const expr c_lo = cl[0] + 2**16 * cl[1];
    const expr c_hi = ch[0] + 2**16 * ch[1] + 2**31 * csg;
    const expr b_lo = bl[0] + 2**16 * bl[1];
    const expr b_hi = bh[0] + 2**16 * bh[1] + 2**31 * bsg;
    in_use * end * (t - (c_lo + 2**32 * c_hi - 2**64 * csg)) === 0;
    w * (s - (b_lo + 2**32 * b_hi - 2**64 * bsg)) === 0;
    const expr call = start * in_use;
    for (int i = 0; i < 2; i++) {
        range_check(cl[i], 0, 2**16 - 1, call, 1);
        range_check(bl[i], 0, 2**16 - 1, w, 1);
    }
    range_check(ch[0], 0, 2**16 - 1, call, 1);
    range_check(ch[1], 0, 2**15 - 1, call);
    range_check(bh[0], 0, 2**16 - 1, w, 1);
    range_check(bh[1], 0, 2**15 - 1, w);

    // Block sums go to out + 8*b, unless out is 0.
    oz === 1 - ow * ow_inv;
    ow * oz === 0;
    w === be * (1 - oz);
    start * (ob - ow) === 0;
    keep * (ob - 'ob - 'be) === 0;

    if (with_bus) {
        proves_operation(op: OP_DOT_F8, b: [8 * pw, 0], c: [c_lo, c_hi], main_step: step, mul: call);
        precompiled_mem_load(addr: 8 * pw, main_step: step, value: [8 * xw, 0], sel: call);
        precompiled_mem_load(addr: 8 * pw + 8, main_step: step, value: [8 * yw, 0], sel: call);
        precompiled_mem_load(addr: 8 * pw + 16, main_step: step, value: [8 * R, 0], sel: call);
        precompiled_mem_load(addr: 8 * pw + 24, main_step: step, value: [fmt_x + 256 * fmt_y + 2**16 * rep, 0], sel: call);
        precompiled_mem_load(addr: 8 * pw + 32, main_step: step, value: [(1 - bz) * 8 * Bk, 0], sel: call);
        precompiled_mem_load(addr: 8 * pw + 40, main_step: step, value: [8 * ow, 0], sel: call);
        precompiled_mem_load(addr: 8 * xw, main_step: step, value: x_word, sel: active * lx);
        precompiled_mem_load(addr: 8 * yw, main_step: step, value: y_word, sel: active * ly);
        precompiled_mem_store(addr: 8 * ob, main_step: step, value: [b_lo, b_hi], sel: w);
    }
}
