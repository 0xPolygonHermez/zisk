require "std_lookup.pil"
require "operations.pil"
require "opids.pil"
require "keccakf_chi_table.pil"
require "keccakf_xor5_table.pil"

// Precompile in charge of performing the Keccak-f[1600] permutation.
// For reference: https://keccak.team/keccak_specs_summary.html or https://keccak.team/files/Keccak-reference-3.0.pdf

// We use little-endian representation

airtemplate Keccakf(const int N = 2**17, const int lanes_per_row = 25) {
    /*
        ═══════════════════════════════════════════════════════════════════════════
        KECCAKF SPECIFICATION
        ═══════════════════════════════════════════════════════════════════════════

        KECCAKF(state: [u64; 25]) -> [u64; 25]

        The state is organized as an array of 5x5 lanes A, each of 64 bits.

        There are 24 rounds.

        Each round consists of 5 steps:
            • θ (Theta) step - Column parity computation and mixing
            • ρ (Rho) step - Bitwise rotation
            • π (Pi) step - Lane permutation
            • χ (Chi) step - Nonlinear transformation
            • ι (Iota) step - Add round constant

        θ step:
            1. C[x] = A[x,0] xor A[x,1] xor A[x,2] xor A[x,3] xor A[x,4],   for x in 0…4
            2. D[x] = C[x-1] xor rot(C[x+1],1),                             for x in 0…4
            3. A[x,y] = A[x,y] xor D[x],                           for (x,y) in (0…4,0…4)

        ρ and π steps:
            B[y,2*x+3*y] = rot(A[x,y], r[x,y]),                 for (x,y) in (0…4,0…4)

        χ step
            A[x,y] = B[x,y] xor ((not B[x+1,y]) and B[x+2,y]),  for (x,y) in (0…4,0…4)

        ι step
            A[0,0] = A[0,0] xor RC

       ═══════════════════════════════════════════════════════════════════════════
       EXECUTION TRACE LAYOUT: TWO INSTANCES PER SLOT
       ═══════════════════════════════════════════════════════════════════════════

        Each slot proves TWO independent Keccak-f operations, A and B. On the
        round rows every state cell is SLICED: it holds v = a + 8·b, the
        same-position values of both instances (slot base 8 leaves room for θ's
        column sums, which reach 5 per instance). The boundary rows hold the two
        instances' plain bits, so the memory interface can pack per-instance
        words; they are glued to the sliced rows by linear constraints.

        Every state-group (a full 1600-cell state) occupies ROWS_PER_STATE =
        25 / lanes_per_row consecutive rows: group-row k holds the lanes
        [k·lanes_per_row, (k+1)·lanes_per_row), where lane l = 5y + x holds the
        bits (x, y, 0..63). A slot is 29 state-groups:

           GROUP              state[64·lanes_per_row]
        |---------|--------------------------------------------------|
        |    0    |  op A input bits                                 | <-- A STATE IN
        |    1    |  op B input bits                                 | <-- B STATE IN
        |---------|--------------------------------------------------|
        |    2    |  round0  (sliced a+8b, plus sliced parities c)   |
        |   ...   |  ...                                             |
        |   25    |  round23 (sliced, plus c)                        |
        |   26    |  round24 (sliced)                                |
        |---------|--------------------------------------------------|
        |   27    |  op A output bits                                | <-- A STATE OUT
        |   28    |  op B output bits                                | <-- B STATE OUT
        |---------|--------------------------------------------------|

        Glue (all linear, uniform in lanes_per_row):
            group 2  = group 0 + 8·group 1     (slice in, row by row)
            group 26 = group 27 + 8·group 28   (unslice out, row by row)
        with booleanity enforced on the boundary groups, which makes both the
        slicing and the memory packing decode uniquely.

       ═══════════════════════════════════════════════════════════════════════════
       ROUND VERIFICATION: SLICED χ-ROW S-BOX + XOR5 NORMALIZATION
       ═══════════════════════════════════════════════════════════════════════════

        Everything in the round up to χ is 𝔽₂-linear per instance. On sliced
        cells, sums act on both slots at once:

            1. Column sums Σ_y state[x,y,z] have slot values in [0,5]. They are
               normalized to the committed sliced parities c (xor5 table, three
               positions per lookup) — this keeps the χ-table input entropy
               affordable at two instances per cell. Parity (x,z) is stored at
               group-row (x·64+z) / C_PER_ROW, column (x·64+z) % C_PER_ROW.

            2. θ-outputs are rebuilt from CLEAN parities:
                   t[x,y,z] = state[x,y,z] + c[x-1][z] + c[x+1][z-1],
               so each slot stays in [0,3]; ρπ is pure rewiring of these
               degree-1 expressions.

            3. One lookup per χ-row (y,z) packs the five sliced θ-outputs in
               base 28 together with the ι bit,
                   ( rc·28⁵ + Σ_x 28ˣ·b[x,y,z],  state'[0,y,z], …, state'[4,y,z] ),
               and the table returns the five sliced post-χι outputs, pinned
               entry-wise to the next state-group. ι is a table input: y = 0
               rows pass the clock-weighted constant wrc[z] (applied to both
               slots — the two instances of a slot share the round).
    */

    const int LANES = 25;
    const int LANE_BITS = 64;
    const int WIDTH = LANES * LANE_BITS;
    const int ROUNDS = 24;
    const int OPS_PER_SLOT = 2;

    if ((lanes_per_row < 1) || (LANES % lanes_per_row != 0)) {
        error(`lanes_per_row must be a divisor of ${LANES}, but received lanes_per_row=${lanes_per_row}`);
    }

    const int ROWS_PER_STATE = LANES / lanes_per_row;
    const int BITS_PER_ROW = lanes_per_row * LANE_BITS;

    // 2 input-bit groups + 25 sliced round groups + 2 output-bit groups
    const int GROUPS = 2 + (1 + ROUNDS) + 2;
    const int CLOCKS = GROUPS * ROWS_PER_STATE;

    // Sliced parities per row: the 320 (x,z) positions of a round, spread
    // across its ROWS_PER_STATE rows
    const int C_PER_ROW = (320 + ROWS_PER_STATE - 1) / ROWS_PER_STATE;

    // Calculate usable capacity
    const int NUM_NON_USABLE_ROWS = N % CLOCKS;
    const int NUM_SLOTS = (N - NUM_NON_USABLE_ROWS) / CLOCKS;
    if (NUM_SLOTS < 1) {
        error(`N must be at least ${CLOCKS} to fit the Keccak-f[${WIDTH}] arithmetization, but received N=${N}`);
    }
    const int NUM_KECCAKF = OPS_PER_SLOT * NUM_SLOTS;
    println(`The total number of Keccak-f's with N = 2^${log2(N)} is ${NUM_KECCAKF} (${NUM_SLOTS} slots)`);

    // Round constants
    const int RC[ROUNDS] = [
        0x0000000000000001, 0x0000000000008082, 0x800000000000808A, 0x8000000080008000, 0x000000000000808B, 0x0000000080000001,
        0x8000000080008081, 0x8000000000008009, 0x000000000000008A, 0x0000000000000088, 0x0000000080008009, 0x000000008000000A,
        0x000000008000808B, 0x800000000000008B, 0x8000000000008089, 0x8000000000008003, 0x8000000000008002, 0x8000000000000080,
        0x000000000000800A, 0x800000008000000A, 0x8000000080008081, 0x8000000000008080, 0x0000000080000001, 0x8000000080008008
    ];

    // First rows of the slot's groups
    const int GROUP_IN_A = 0;
    const int GROUP_IN_B = ROWS_PER_STATE;
    const int GROUP_ROUND_0 = 2 * ROWS_PER_STATE;
    const int GROUP_ROUND_LAST = (2 + ROUNDS) * ROWS_PER_STATE;   // round-24 group
    const int GROUP_OUT_A = (3 + ROUNDS) * ROWS_PER_STATE;
    const int GROUP_OUT_B = (4 + ROUNDS) * ROWS_PER_STATE;

    // ═══════════════════════════════════════════════════════════════════════════
    // CLOCK SELECTORS
    // ═══════════════════════════════════════════════════════════════════════════

    // Base clock: 1 at first cycle row, 0 elsewhere within each cycle
    if (NUM_NON_USABLE_ROWS == 0) {
        col fixed air.CLK_0 = [[1, 0:(CLOCKS-1)]:NUM_SLOTS];
    } else {
        col fixed air.CLK_0 = [[1, 0:(CLOCKS-1)]:NUM_SLOTS, 0...];
    }

    // Clock selectors for each row in the cycle
    const expr CLK[CLOCKS];
    for (int i = 0; i < CLOCKS; i++) {
        CLK[i] = (i)'CLK_0;
    }

    // Per-operation activation flags. Slots are filled A-first: op B requires op A,
    // because the sliced rounds are verified under op A's flag.
    col witness bits(1) in_use_a; // 1 when op A of the slot is in use
    col witness bits(1) in_use_b; // 1 when op B of the slot is in use
    in_use_a * (1 - in_use_a) === 0;
    in_use_b * (1 - in_use_b) === 0;
    in_use_b * (1 - in_use_a) === 0;

    // Selector latching: once activated, stays active for full slot
    const expr in_use_latched = clock_set(start: 1, end: CLOCKS);
    in_use_latched * (in_use_a - 'in_use_a) === 0;
    in_use_latched * (in_use_b - 'in_use_b) === 0;

    col witness bits(1) in_use_a_clk_0; // 1 at the first clock of a slot whose op A is in use
    col witness bits(1) in_use_b_clk_0; // 1 at the first clock of a slot whose op B is in use
    in_use_a_clk_0 <== CLK_0 * in_use_a;
    in_use_b_clk_0 <== CLK_0 * in_use_b;

    // ═══════════════════════════════════════════════════════════════════════════
    // STATE COLUMNS
    // ═══════════════════════════════════════════════════════════════════════════

    // Plain bits on the boundary groups, sliced values a + 8·b on round rows
    col witness bits(4) state[BITS_PER_ROW];

    // Committed sliced column parities of θ
    col witness bits(4) c[C_PER_ROW];

    // Booleanity on the boundary groups
    const expr BOUNDARY_CLK = clock_set(start: GROUP_IN_A, end: GROUP_ROUND_0) +
                              clock_set(start: GROUP_OUT_A, end: CLOCKS);
    for (int i = 0; i < BITS_PER_ROW; i++) {
        BOUNDARY_CLK * state[i] * (1 - state[i]) === 0;
    }

    // Slice in: round-0 group = A input bits + 8·B input bits
    const expr SLICE_CLK = clock_set(start: GROUP_ROUND_0, end: GROUP_ROUND_0 + ROWS_PER_STATE);
    for (int i = 0; i < BITS_PER_ROW; i++) {
        SLICE_CLK * (state[i] - (GROUP_ROUND_0 - GROUP_IN_A)'state[i] - KECCAKF_SLOT * (GROUP_ROUND_0 - GROUP_IN_B)'state[i]) === 0;
    }

    // Unslice out: round-24 group = A output bits + 8·B output bits
    const expr UNSLICE_CLK = clock_set(start: GROUP_ROUND_LAST, end: GROUP_ROUND_LAST + ROWS_PER_STATE);
    for (int i = 0; i < BITS_PER_ROW; i++) {
        UNSLICE_CLK * (state[i] - state[i]'(GROUP_OUT_A - GROUP_ROUND_LAST) - KECCAKF_SLOT * state[i]'(GROUP_OUT_B - GROUP_ROUND_LAST)) === 0;
    }

    // Round transitions fire on the rows of the groups holding rounds 0..23
    const expr ROUNDS_CLK = clock_set(start: GROUP_ROUND_0, end: GROUP_ROUND_LAST);
    const expr rounds_active = in_use_a * ROUNDS_CLK;

    // ═══════════════════════════════════════════════════════════════════════════
    // KECCAK-F ROUND CONSTRAINTS
    // ═══════════════════════════════════════════════════════════════════════════

    // ι round-constant bit of the round whose transition anchors at this row:
    // the y = 0 χ-rows of round r anchor at group-row 0 of round r's group
    expr wrc[LANE_BITS];
    for (int z = 0; z < LANE_BITS; z++) {
        wrc[z] = 0;
        for (int i = 0; i < ROUNDS; i++) {
            if (((RC[i] >> z) & 1) == 1) {
                wrc[z] += CLK[GROUP_ROUND_0 + i * ROWS_PER_STATE];
            }
        }
    }

    if (ROWS_PER_STATE == 1) {
        // Full state per row: every χ-row anchors here, the packed θ-expressions
        // feed the lookups directly and no accumulator is needed.

        // xor5 normalization: bind the committed sliced parities to the column sums
        for (int g = 0; g < (320 + KECCAKF_XOR5_BATCH - 1) / KECCAKF_XOR5_BATCH; g++) {
            const expr lookup_cols[2 * KECCAKF_XOR5_BATCH];

            for (int k = 0; k < KECCAKF_XOR5_BATCH; k++) {
                const int pos = g * KECCAKF_XOR5_BATCH + k;
                if (pos < 320) {
                    const int x = pos / 64;
                    const int z = pos % 64;

                    expr col_sum = 0;
                    for (int y = 0; y < 5; y++) {
                        col_sum += state[bit_pos(x, y, z)];
                    }
                    lookup_cols[k] = col_sum;
                    lookup_cols[KECCAKF_XOR5_BATCH + k] = c[pos];
                } else {
                    // Pad with zeros (a valid table entry: zero sums have zero parities)
                    lookup_cols[k] = 0;
                    lookup_cols[KECCAKF_XOR5_BATCH + k] = 0;
                }
            }

            lookup_assumes(KECCAKF_XOR5_TABLE_ID, lookup_cols, sel: rounds_active, sel_is_binary: 1);
        }

        // θ-outputs from the clean parities (slot values in [0,3])
        const expr theta_out[WIDTH];
        for (int x = 0; x < 5; x++) {
            const int x1 = (x + 4) % 5;
            const int x2 = (x + 1) % 5;
            for (int y = 0; y < 5; y++) {
                for (int z = 0; z < 64; z++) {
                    const int pos = bit_pos(x, y, z);
                    theta_out[pos] = state[pos] + c[x1 * 64 + z] + c[x2 * 64 + ((z + 63) % 64)];
                }
            }
        }

        // ρπ rewiring
        const expr b[WIDTH] = pi(rho(theta_out));

        // One lookup per χ-row (y,z): the five sliced θ-outputs go in (packed in
        // base 28, together with the ι bit), the five sliced next-row cells come out
        for (int y = 0; y < 5; y++) {
            for (int z = 0; z < 64; z++) {
                expr in_pack = 0;
                for (int x = 0; x < 5; x++) {
                    in_pack += (KECCAKF_CHI_BASE ** x) * b[bit_pos(x, y, z)];
                }
                if (y == 0) {
                    // Lane (0,0) lives at x = 0 of the y = 0 χ-rows: ι applies here
                    in_pack += KECCAKF_CHI_SPAN * wrc[z];
                }

                const expr lookup_cols[1 + KECCAKF_CHI_ROW_SIZE];
                lookup_cols[0] = in_pack;
                for (int x = 0; x < 5; x++) {
                    lookup_cols[1 + x] = state[bit_pos(x, y, z)]';
                }

                lookup_assumes(KECCAKF_CHI_TABLE_ID, lookup_cols, sel: rounds_active, sel_is_binary: 1);
            }
        }
    } else {
        // Narrow layout (lanes_per_row <= 5): each anchor row carries exactly
        // one y, and the lookups are shared across anchors.

        // Fixed mask: 1 at group-row 0 of the round groups 0..23 of each cycle.
        // Group-row k of those groups is selected by shifting the mask by k rows.
        col fixed ROUND_CLK_0 = [[0:(2*ROWS_PER_STATE), [1, 0:(ROWS_PER_STATE-1)]:ROUNDS, 0:(3*ROWS_PER_STATE)]:NUM_SLOTS, 0...];

        // View of the full current state-group, as seen from group-row k:
        // lane l lives at group-row l / lanes_per_row, i.e. (l / lanes_per_row - k)
        // rows away; the parity of position p = x·64+z lives at group-row
        // p / C_PER_ROW, column p % C_PER_ROW.

        // ── xor5 normalization with mask-gated inputs: at group-row rho the
        // column c[j] holds the parity of position p = rho·C_PER_ROW + j, and the
        // input expression selects that row's column sum through the masks
        for (int g = 0; g < (C_PER_ROW + KECCAKF_XOR5_BATCH - 1) / KECCAKF_XOR5_BATCH; g++) {
            const expr lookup_cols[2 * KECCAKF_XOR5_BATCH];

            for (int k = 0; k < KECCAKF_XOR5_BATCH; k++) {
                const int j = g * KECCAKF_XOR5_BATCH + k;
                if (j < C_PER_ROW) {
                    expr masked_sum = 0;
                    for (int rho_row = 0; rho_row < ROWS_PER_STATE; rho_row++) {
                        const int pos = rho_row * C_PER_ROW + j;
                        if (pos >= 320) continue;
                        const int x = pos / 64;
                        const int z = pos % 64;

                        // Column sum of (x,z) as seen from group-row rho_row
                        expr col_sum = 0;
                        for (int y = 0; y < 5; y++) {
                            const int lane = 5 * y + x;
                            const int row_offset = lane / lanes_per_row - rho_row;
                            const int column = (lane % lanes_per_row) * LANE_BITS + z;
                            col_sum += state[column]'(row_offset);
                        }
                        masked_sum += (rho_row)'ROUND_CLK_0 * col_sum;
                    }
                    lookup_cols[k] = masked_sum;
                    lookup_cols[KECCAKF_XOR5_BATCH + k] = c[j];
                } else {
                    lookup_cols[k] = 0;
                    lookup_cols[KECCAKF_XOR5_BATCH + k] = 0;
                }
            }

            lookup_assumes(KECCAKF_XOR5_TABLE_ID, lookup_cols, sel: rounds_active, sel_is_binary: 1);
        }

        // ── χ-row S-box through a committed accumulator: chi_acc[z] holds, at
        // the anchor row of χ-row (y,z), its packed input rc·28⁵ + Σ_x 28ˣ·b_x
        col witness bits(26) chi_acc[LANE_BITS];

        expr chi_acc_def[LANE_BITS];
        for (int z = 0; z < LANE_BITS; z++) {
            chi_acc_def[z] = 0;
        }
        expr anchor_mask = 0;

        for (int k = 0; k < ROWS_PER_STATE; k++) {
            // Group-row k anchors χ-row y iff it holds lane 5y, i.e. 5y = k·lanes_per_row
            if ((k * lanes_per_row) % 5 != 0) continue;
            const int y = (k * lanes_per_row) / 5;

            anchor_mask += (k)'ROUND_CLK_0;

            // θ-outputs of the whole state as seen from this anchor
            const expr theta_out[WIDTH];
            for (int x = 0; x < 5; x++) {
                const int x1 = (x + 4) % 5;
                const int x2 = (x + 1) % 5;
                for (int yy = 0; yy < 5; yy++) {
                    for (int z = 0; z < 64; z++) {
                        const int lane = 5 * yy + x;
                        const int row_offset = lane / lanes_per_row - k;
                        const int column = (lane % lanes_per_row) * LANE_BITS + z;

                        const int p1 = x1 * 64 + z;
                        const int p2 = x2 * 64 + ((z + 63) % 64);

                        theta_out[bit_pos(x, yy, z)] = state[column]'(row_offset)
                            + c[p1 % C_PER_ROW]'(p1 / C_PER_ROW - k)
                            + c[p2 % C_PER_ROW]'(p2 / C_PER_ROW - k);
                    }
                }
            }

            // ρπ rewiring
            const expr b[WIDTH] = pi(rho(theta_out));

            for (int z = 0; z < LANE_BITS; z++) {
                expr in_pack = 0;
                for (int x = 0; x < 5; x++) {
                    in_pack += (KECCAKF_CHI_BASE ** x) * b[bit_pos(x, y, z)];
                }
                if (y == 0) {
                    // Lane (0,0) lives at x = 0 of the y = 0 χ-rows: ι applies here
                    in_pack += KECCAKF_CHI_SPAN * wrc[z];
                }

                chi_acc_def[z] += (k)'ROUND_CLK_0 * in_pack;
            }
        }

        // Bind the accumulator on anchor rows of active slots; elsewhere both
        // sides are 0 (the masks vanish on non-anchor and padding rows, and
        // in_use_a vanishes on unused slots)
        for (int z = 0; z < LANE_BITS; z++) {
            chi_acc[z] - in_use_a * chi_acc_def[z] === 0;
        }

        // Anchor-invariant lookups: χ-row (y,z), anchored at the group-row
        // holding lane 5y, outputs to lane 5y+x of the next state-group, i.e.
        // row offset ROWS_PER_STATE + x/lanes_per_row and column
        // (x % lanes_per_row)·64 + z, both independent of the anchor
        const expr chi_sel = in_use_a * anchor_mask;
        for (int z = 0; z < LANE_BITS; z++) {
            const expr lookup_cols[1 + KECCAKF_CHI_ROW_SIZE];
            lookup_cols[0] = chi_acc[z];
            for (int x = 0; x < 5; x++) {
                const int row_offset = ROWS_PER_STATE + x / lanes_per_row;
                const int column = (x % lanes_per_row) * LANE_BITS + z;
                lookup_cols[1 + x] = state[column]'(row_offset);
            }

            lookup_assumes(KECCAKF_CHI_TABLE_ID, lookup_cols, sel: chi_sel, sel_is_binary: 1);
        }
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // MEMORY INTERFACE
    // ═══════════════════════════════════════════════════════════════════════════

    /*
        MEMORY ACCESS MAP (per op; A and B have independent step/addr)
        ===============================================================================================================
          0 | STEP_MAIN     | R | ADDR_STATE       |  input_state[0]
          . |    ...        | . |    ...           |     ...
         24 | STEP_MAIN     | R | ADDR_STATE + 192 |  input_state[24]
         25 | STEP_MAIN + 1 | W | ADDR_STATE       |  output_state[0]
          . |    ...        | . |    ...           |     ...
         49 | STEP_MAIN + 1 | W | ADDR_STATE + 192 |  output_state[24]
        ===============================================================================================================

        Memory Access Schedule (100 total operations, lanes_per_row in parallel):
            Group GROUP_IN_A:   Read op A input_state[0..24]    (lanes_per_row per clock)
            Group GROUP_IN_B:   Read op B input_state[0..24]
            Group GROUP_OUT_A:  Write op A output_state[0..24]
            Group GROUP_OUT_B:  Write op B output_state[0..24]
    */

    col witness bits(40) step_addr;

    const int STEP_A = 0;
    const int ADDR_A = 1;
    const int STEP_B = 2;
    const int ADDR_B = 3;

    const int BITS_PER_LIMB = 32;
    const int WORD_SIZE = 64 / 8; // bytes per 64-bit word
    const int MEM_OPS_IN_PARALLEL = lanes_per_row;

    const expr mem_sel = clock_set(in_use_a, start: GROUP_IN_A, end: GROUP_IN_A + ROWS_PER_STATE) +
                         clock_set(in_use_b, start: GROUP_IN_B, end: GROUP_IN_B + ROWS_PER_STATE) +
                         clock_set(in_use_a, start: GROUP_OUT_A, end: GROUP_OUT_A + ROWS_PER_STATE) +
                         clock_set(in_use_b, start: GROUP_OUT_B, end: GROUP_OUT_B + ROWS_PER_STATE);

    const expr mem_is_write = clock_set(start: GROUP_OUT_A, end: CLOCKS);

    const expr main_step = clock_shift(step_addr, STEP_A, start: GROUP_IN_A, end: GROUP_IN_A + ROWS_PER_STATE) +
                           clock_shift(step_addr, STEP_B, start: GROUP_IN_B, end: GROUP_IN_B + ROWS_PER_STATE) +
                           clock_shift(step_addr, STEP_A, start: GROUP_OUT_A, end: GROUP_OUT_A + ROWS_PER_STATE) +
                           clock_shift(step_addr, STEP_B, start: GROUP_OUT_B, end: GROUP_OUT_B + ROWS_PER_STATE);

    for (int i = 0; i < MEM_OPS_IN_PARALLEL; i++) {
        // Address: ADDR + WORD_SIZE*(k*lanes_per_row + i) at group-row k of the op
        // whose bits live at the firing clock, i.e. the word address advances by
        // WORD_SIZE*lanes_per_row per clock within each window
        const expr mem_addr = clock_shift(step_addr, ADDR_A, start: GROUP_IN_A, end: GROUP_IN_A + ROWS_PER_STATE, offset: WORD_SIZE*i, delta: WORD_SIZE*lanes_per_row) +
                              clock_shift(step_addr, ADDR_B, start: GROUP_IN_B, end: GROUP_IN_B + ROWS_PER_STATE, offset: WORD_SIZE*i, delta: WORD_SIZE*lanes_per_row) +
                              clock_shift(step_addr, ADDR_A, start: GROUP_OUT_A, end: GROUP_OUT_A + ROWS_PER_STATE, offset: WORD_SIZE*i, delta: WORD_SIZE*lanes_per_row) +
                              clock_shift(step_addr, ADDR_B, start: GROUP_OUT_B, end: GROUP_OUT_B + ROWS_PER_STATE, offset: WORD_SIZE*i, delta: WORD_SIZE*lanes_per_row);

        // Pack this row's state bits into two 32-bit limbs
        const int base = i * 64;
        const expr mem_value[2];
        mem_value[0] = pack(state, offset: base, len: BITS_PER_LIMB);
        mem_value[1] = pack(state, offset: base + BITS_PER_LIMB, len: BITS_PER_LIMB);

        precompiled_mem_op(
            sel: mem_sel,
            is_write: mem_is_write,
            main_step: main_step,
            addr: mem_addr,
            value: mem_value
        );
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // MAIN PROCESSOR INTEGRATION
    // ═══════════════════════════════════════════════════════════════════════════
    proves_operation(op: OP_KECCAKF, b: [step_addr'(ADDR_A), 0], main_step: step_addr'(STEP_A), mul: in_use_a_clk_0);
    proves_operation(op: OP_KECCAKF, b: [step_addr'(ADDR_B), 0], main_step: step_addr'(STEP_B), mul: in_use_b_clk_0);

    function rho(const expr a[]): const expr[] {
        const int len = length(a);
        assert(len == air.WIDTH);
        const expr result[len];

        // For all z such that 0 ≤ z < 64, let result[0, 0, z] = a[0, 0, z]
        for (int z = 0; z < 64; z++) {
            const int pos = bit_pos(0, 0, z);
            result[pos] = a[pos];
        }

        // Let (x, y) = (1, 0)
        // For t from 0 to 23:
        //      1. For all z such that 0 ≤ z < 64, let result[x, y, z] = a[x, y, z – (t + 1)(t + 2)/2]
        //      2. Let (x, y) = (y, 2x + 3y)
        int x = 1;
        int y = 0;
        for (int t = 0; t < 24; t++) {
            const int offset = ((t + 1) * (t + 2)) / 2;

            for (int z = 0; z < 64; z++) {
                const int src_z = (z + 64 - (offset % 64)) % 64;
                const int src_pos = bit_pos(x, y, src_z);
                const int dst_pos = bit_pos(x, y, z);

                result[dst_pos] = a[src_pos];
            }

            const int aux = y;
            y = (2 * x + 3 * y) % 5;
            x = aux;
        }

        return result;
    }

    function pi(const expr a[]): const expr[] {
        const int len = length(a);
        assert(len == air.WIDTH);
        const expr result[len];

        // For all triples (x, y, z) such that 0 ≤ x,y < 5, and 0 ≤ z < 64, let:
        //      result[x, y, z] = a[x + 3y, x, z].
        for (int x = 0; x < 5; x++) {
            for (int y = 0; y < 5; y++) {
                for (int z = 0; z < 64; z++) {
                    const int src_x = (x + 3 * y) % 5;
                    const int src_pos = bit_pos(src_x, x, z);
                    const int dst_pos = bit_pos(x, y, z);
                    result[dst_pos] = a[src_pos];
                }
            }
        }

        return result;
    }

    function pack(const expr a[], const int offset = 0, const int len = 0): const expr {
        const int n = (len == 0) ? (length(a) - offset) : len;

        expr packed = 0;
        for (int j = 0; j < n; j++) {
            packed += a[offset + j] * 2**j;
        }
        return packed;
    }

    function bit_pos(const int x, const int y, const int z): int {
        assert(0 <= x && x < 5);
        assert(0 <= y && y < 5);
        assert(0 <= z && z < 64);

        return (y * 5 + x) * 64 + z;
    }

    function clock_set(const expr mvcol = 1, const int start = 0, int end = -1): const expr {
        expr result = 0;
        if (end == -1) {
            end = start + 1;
        }

        for (int i = start; i < end; i++) {
            result += air.CLK[i];
        }
        return result * mvcol;
    }

    function clock_shift(const expr mvcol, const int pos, const int start = 0, int end = -1, int offset = 0,  const int delta = 0): const expr {
        expr result = 0;
        if (end == -1) {
            end = start + 1;
        }
        for (int i = start; i < end; i++) {
            const int iclock = (pos - i) % air.CLOCKS;
            if (offset != 0) {
                result += air.CLK[i] * (mvcol'(iclock) + offset);
            } else {
                result += air.CLK[i] * mvcol'(iclock);
            }
            offset += delta;
        }
        return result;
    }
}
