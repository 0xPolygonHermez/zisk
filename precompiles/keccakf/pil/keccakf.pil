require "std_lookup.pil"
require "operations.pil"
require "opids.pil"
require "keccakf_table.pil"

// Precompile in charge of performing the Keccak-f[1600] permutation.
// For reference: https://keccak.team/keccak_specs_summary.html or https://keccak.team/files/Keccak-reference-3.0.pdf

// We use little-endian representation

airtemplate Keccakf(const int N = 2**17, const int lanes_per_row = 25) {
    /*
        ═══════════════════════════════════════════════════════════════════════════
        KECCAKF SPECIFICATION
        ═══════════════════════════════════════════════════════════════════════════

        KECCAKF(state: [u64; 25]) -> [u64; 25]

        The state is organized as an array of 5x5 lanes A, each of 64 bits.

        There are 24 rounds.

        Each round consists of 5 steps:
            • θ (Theta) step - Column parity computation and mixing
            • ρ (Rho) step - Bitwise rotation
            • π (Pi) step - Lane permutation
            • χ (Chi) step - Nonlinear transformation
            • ι (Iota) step - Add round constant

        θ step:
            1. C[x] = A[x,0] xor A[x,1] xor A[x,2] xor A[x,3] xor A[x,4],   for x in 0…4
            2. D[x] = C[x-1] xor rot(C[x+1],1),                             for x in 0…4
            3. A[x,y] = A[x,y] xor D[x],                           for (x,y) in (0…4,0…4)

        ρ and π steps:
            B[y,2*x+3*y] = rot(A[x,y], r[x,y]),                 for (x,y) in (0…4,0…4)

        χ step
            A[x,y] = B[x,y] xor ((not B[x+1,y]) and B[x+2,y]),  for (x,y) in (0…4,0…4)

        ι step
            A[0,0] = A[0,0] xor RC

       ═══════════════════════════════════════════════════════════════════════════
       EXECUTION TRACE LAYOUT
       ═══════════════════════════════════════════════════════════════════════════

        With lanes_per_row = 25:

           ROW           state[1600]
        |------|-----------------------------|
        |  0   |  initial_state lanes 0..24  | <-- STATE IN
        |------|-----------------------------|
        |  1   |  round1_state  lanes 0..24  |
        | ...  |              ...            |
        |  24  |  round24_state lanes 0..24  | <-- STATE OUT
        |------|-----------------------------|

        With lanes_per_row = 5:

           ROW           state[320]
        |------|-----------------------------|
        |  0   |  initial_state lanes  0..4  | <-- STATE IN
        | ...  |             ...             |
        |  4   |  initial_state lanes 20..24 | <-- STATE IN
        |------|-----------------------------|
        |  5   |  round1_state  lanes  0..4  |
        | ...  |             ...             |
        |  9   |  round1_state  lanes 20..24 |
        |------|-----------------------------|
        | ...  |             ...             |
        |------|-----------------------------|
        | 120  |  round24_state lanes  0..4  | <-- STATE OUT
        | ...  |             ...             |
        | 124  |  round24_state lanes 20..24 | <-- STATE OUT
        |------|-----------------------------|

       ═══════════════════════════════════════════════════════════════════════════
       ROUND VERIFICATION: THE χ-ROW S-BOX
       ═══════════════════════════════════════════════════════════════════════════

        Everything in the round up to χ is 𝔽₂-linear, so it is expressed with plain
        integer sums of the bits (values stay <= 11; only parities carry keccak semantics):

            b[x,y,z] = (π∘ρ∘θ)(state)[x,y,z]        // degree-1 expression

        χ is the only nonlinear step, and it acts independently on each row of five
        bits (fixed y,z): A'[x] = B[x] ⊕ (¬B[x+1] ∧ B[x+2]). So the whole
        nonlinear part of the round is delegated to one lookup per χ-row:

            (rc·12⁵ + Σ_x 12ˣ·b[x,y,z],  state'[0,y,z], ..., state'[4,y,z])  ∈  KECCAKF_TABLE

        where the input is a single degree-1 expression and the outputs are the
        five next-row state bits, pinned entry-wise to the table's precomputed
        χ (and ι) output.

        ι is round-dependent, so the table takes the round-constant bit rc as part
        of the input: the y = 0 rows (which contain lane (0,0)) pass the fixed
        clock-weighted expression wrc[z]; every other row passes 0.
    */

    const int LANES = 25;
    const int LANE_BITS = 64;
    const int WIDTH = LANES * LANE_BITS;
    const int ROUNDS = 24;

    if ((lanes_per_row < 1) || (LANES % lanes_per_row != 0)) {
        error(`lanes_per_row must be a divisor of ${LANES}, but received lanes_per_row=${lanes_per_row}`);
    }

    const int ROWS_PER_STATE = LANES / lanes_per_row;
    const int BITS_PER_ROW = lanes_per_row * LANE_BITS;
    const int CLOCKS = (1 + ROUNDS) * ROWS_PER_STATE; // 1 state-group for the input state

    // Calculate usable capacity
    const int NUM_NON_USABLE_ROWS = N % CLOCKS;
    const int NUM_OPS = (N - NUM_NON_USABLE_ROWS) / CLOCKS;
    if (NUM_OPS < 1) {
        error(`N must be at least ${CLOCKS} to fit the Keccak-f[${WIDTH}] arithmetization, but received N=${N}`);
    }
    println(`The total number of Keccak-f's with N = 2^${log2(N)} is ${NUM_OPS}`);

    // Round constants
    const int RC[ROUNDS] = [
        0x0000000000000001, 0x0000000000008082, 0x800000000000808A, 0x8000000080008000, 0x000000000000808B, 0x0000000080000001,
        0x8000000080008081, 0x8000000000008009, 0x000000000000008A, 0x0000000000000088, 0x0000000080008009, 0x000000008000000A,
        0x000000008000808B, 0x800000000000008B, 0x8000000000008089, 0x8000000000008003, 0x8000000000008002, 0x8000000000000080,
        0x000000000000800A, 0x800000008000000A, 0x8000000080008081, 0x8000000000008080, 0x0000000080000001, 0x8000000080008008
    ];

    // ═══════════════════════════════════════════════════════════════════════════
    // CLOCK SELECTORS
    // ═══════════════════════════════════════════════════════════════════════════

    // Base clock: 1 at first cycle row, 0 elsewhere within each cycle
    if (NUM_NON_USABLE_ROWS == 0) {
        col fixed air.CLK_0 = [[1, 0:(CLOCKS-1)]:NUM_OPS];
    } else {
        col fixed air.CLK_0 = [[1, 0:(CLOCKS-1)]:NUM_OPS, 0...];
    }

    // Clock selectors for each row in the cycle
    const expr CLK[CLOCKS];
    for (int i = 0; i < CLOCKS; i++) {
        CLK[i] = (i)'CLK_0;
    }

    col witness bits(1) in_use; // 1 when the Keccak-f operation is in use, 0 otherwise
    in_use * (1 - in_use) === 0;

    // Selector latching: once activated, stays active for full cycle
    const expr in_use_latched = clock_set(start: 1, end: CLOCKS);
    in_use_latched * (in_use - 'in_use) === 0;

    col witness bits(1) in_use_clk_0; // 1 at the first clock cycle of the Keccak-f operation, 0 otherwise
    in_use_clk_0 <== CLK_0 * in_use;

    // ═══════════════════════════════════════════════════════════════════════════
    // STATE COLUMNS
    // ═══════════════════════════════════════════════════════════════════════════

    // Each row holds BITS_PER_ROW bits of the state
    col witness bits(1) state[BITS_PER_ROW];

    // Bit constraint the state
    for (int i = 0; i < BITS_PER_ROW; i++) {
        state[i] * (1 - state[i]) === 0;
    }

    // Union round-function selector: 1 on every row of the first ROUNDS state-groups
    // of an active cycle, i.e. everywhere except the output state-group rows
    expr round_f_active = in_use;
    for (int k = 0; k < ROWS_PER_STATE; k++) {
        round_f_active -= (CLOCKS - ROWS_PER_STATE + k)'in_use_clk_0;
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // KECCAK-F ROUND CONSTRAINTS
    // ═══════════════════════════════════════════════════════════════════════════

    // ARRAY_SIZE is a global std setting; the previous generation set 634 here and
    // later-required AIRs inherit it, so it is kept identical. Do not lower it.
    set_array_size(634);

    // ι round-constant bit of the round whose transition anchors at this row: the
    // y = 0 χ-rows of round r anchor at group-row 0 of round r's state-group
    expr wrc[LANE_BITS];
    for (int z = 0; z < LANE_BITS; z++) {
        wrc[z] = 0;
        for (int i = 0; i < ROUNDS; i++) {
            if (((RC[i] >> z) & 1) == 1) {
                wrc[z] += CLK[i * ROWS_PER_STATE];
            }
        }
    }

    if (ROWS_PER_STATE == 1) {
        // Full state per row: every χ-row anchors here, the packed θ-expressions
        // feed the lookups directly and no accumulator is needed.

        // χ-inputs of the round: b = (π∘ρ∘θ)(state).
        // θ returns integer sums (xor = add), so every b[i] is a degree-1 expression
        // with value <= 11; ρ and π are pure rewiring.
        const expr b[WIDTH] = pi(rho(theta(state)));

        // One lookup per χ-row (y,z): the five θ-outputs go in (packed in base 12,
        // together with the ι bit), the five next-row state bits come out.
        for (int y = 0; y < 5; y++) {
            for (int z = 0; z < LANE_BITS; z++) {
                expr in_pack = 0;
                for (int x = 0; x < 5; x++) {
                    in_pack += (KECCAKF_SBOX_BASE ** x) * b[bit_pos(x, y, z)];
                }
                if (y == 0) {
                    // Lane (0,0) lives at x = 0 of the y = 0 χ-rows: ι applies here
                    in_pack += KECCAKF_SBOX_SPAN * wrc[z];
                }

                const expr lookup_cols[1 + KECCAKF_SBOX_INPUTS];
                lookup_cols[0] = in_pack;
                for (int x = 0; x < 5; x++) {
                    lookup_cols[1 + x] = state[bit_pos(x, y, z)]';
                }

                lookup_assumes(KECCAKF_TABLE_ID, lookup_cols, sel: round_f_active, sel_is_binary: 1);
            }
        }
    } else {
        // Narrow layout (lanes_per_row <= 5): each anchor row carries exactly one y.
        // The packed θ-expression of χ-row (y,z) is bound to sbox_acc[z] at its
        // anchor row, and a single anchor-invariant lookup family per z covers all
        // group-rows.

        // Fixed mask: 1 at group-row 0 of the first ROUNDS state-groups of each cycle.
        // Group-row k is selected by shifting the mask by k rows: the shifted mask
        // stays 0 on the whole output state-group and on padding rows.
        col fixed ROUND_CLK_0 = [[[1, 0:(ROWS_PER_STATE-1)]:ROUNDS, 0:ROWS_PER_STATE]:NUM_OPS, 0...];

        // Packed χ-row S-box input of the χ-row anchored at this row
        col witness bits(19) sbox_acc[LANE_BITS];

        expr acc_def[LANE_BITS];
        for (int z = 0; z < LANE_BITS; z++) {
            acc_def[z] = 0;
        }
        expr anchor_mask = 0;

        for (int k = 0; k < ROWS_PER_STATE; k++) {
            // Group-row k anchors χ-row y iff it holds lane 5y, i.e. 5y = k·lanes_per_row
            if ((k * lanes_per_row) % 5 != 0) continue;
            const int y = (k * lanes_per_row) / 5;

            anchor_mask += (k)'ROUND_CLK_0;

            // View of the full current state-group, as seen from group-row k:
            // lane l lives at group-row l / lanes_per_row, i.e. (l / lanes_per_row - k)
            // rows away from the anchor row
            const expr state_group[WIDTH];
            for (int lane = 0; lane < LANES; lane++) {
                const int row_offset = lane / lanes_per_row - k;
                const int first_col = (lane % lanes_per_row) * LANE_BITS;
                for (int z = 0; z < LANE_BITS; z++) {
                    state_group[lane * LANE_BITS + z] = state[first_col + z]'(row_offset);
                }
            }

            // χ-inputs of the round as seen from this anchor (degree 1, values <= 11)
            const expr b[WIDTH] = pi(rho(theta(state_group)));

            for (int z = 0; z < LANE_BITS; z++) {
                expr in_pack = 0;
                for (int x = 0; x < 5; x++) {
                    in_pack += (KECCAKF_SBOX_BASE ** x) * b[bit_pos(x, y, z)];
                }
                if (y == 0) {
                    // Lane (0,0) lives at x = 0 of the y = 0 χ-rows: ι applies here
                    in_pack += KECCAKF_SBOX_SPAN * wrc[z];
                }

                acc_def[z] += (k)'ROUND_CLK_0 * in_pack;
            }
        }

        // Bind the accumulator on anchor rows of active cycles; elsewhere both
        // sides are 0 (the masks vanish on non-anchor rows, on the output
        // state-group and on padding rows, and in_use vanishes on unused cycles)
        for (int z = 0; z < LANE_BITS; z++) {
            sbox_acc[z] - in_use * acc_def[z] === 0;
        }

        // Anchor-invariant lookups: χ-row (y,z), anchored at group-row k = 5y/lanes_per_row,
        // outputs to lane 5y+x = k·lanes_per_row + x of the next state-group, i.e. row
        // offset ROWS_PER_STATE + x/lanes_per_row and column (x % lanes_per_row)·64 + z,
        // both independent of the anchor
        const expr sbox_sel = in_use * anchor_mask;
        for (int z = 0; z < LANE_BITS; z++) {
            const expr lookup_cols[1 + KECCAKF_SBOX_INPUTS];
            lookup_cols[0] = sbox_acc[z];
            for (int x = 0; x < 5; x++) {
                const int row_offset = ROWS_PER_STATE + x / lanes_per_row;
                const int column = (x % lanes_per_row) * LANE_BITS + z;
                lookup_cols[1 + x] = state[column]'(row_offset);
            }

            lookup_assumes(KECCAKF_TABLE_ID, lookup_cols, sel: sbox_sel, sel_is_binary: 1);
        }
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // MEMORY INTERFACE
    // ═══════════════════════════════════════════════════════════════════════════

    /*
        MEMORY ACCESS MAP
        ===============================================================================================================
          0 | STEP_MAIN     | R | ADDR_STATE       |  input_state[0]
          1 | STEP_MAIN     | R | ADDR_STATE + 8   |  input_state[1]
          2 | STEP_MAIN     | R | ADDR_STATE + 16  |  input_state[2]
          3 | STEP_MAIN     | R | ADDR_STATE + 24  |  input_state[3]
          . |    ...        | . |    ...           |     ...
         24 | STEP_MAIN     | R | ADDR_STATE + 192 |  input_state[24]
         25 | STEP_MAIN + 1 | W | ADDR_STATE       |  output_state[0]
         26 | STEP_MAIN + 1 | W | ADDR_STATE + 8   |  output_state[1]
         27 | STEP_MAIN + 1 | W | ADDR_STATE + 16  |  output_state[2]
         28 | STEP_MAIN + 1 | W | ADDR_STATE + 24  |  output_state[3]
          . |    ...        | . |    ...           |     ...
         49 | STEP_MAIN + 1 | W | ADDR_STATE + 192 |  output_state[24]
        ===============================================================================================================

        Memory Access Schedule (50 total operations, lanes_per_row in parallel):
            First ROWS_PER_STATE clocks:  Read input_state[0..24]    (25 ops, lanes_per_row per clock)
            Last ROWS_PER_STATE clocks:   Write output_state[0..24]  (25 ops, lanes_per_row per clock)
    */

    col witness bits(40) step_addr;

    const int STEP_MAIN = 0;
    const int ADDR_STATE = STEP_MAIN + 1;

    const int BITS_PER_LIMB = 32;
    const int U64_LIMBS = 64 / BITS_PER_LIMB;
    const int WORD_SIZE = 64 / 8; // bytes per 64-bit word
    const int BITS_PER_CLOCK = BITS_PER_LIMB * U64_LIMBS;
    const int MEM_OPS = WIDTH / BITS_PER_CLOCK;
    const int MEM_OPS_IN_PARALLEL = lanes_per_row;
    const int CLOCKS_WITH_MEM_OPS = MEM_OPS / MEM_OPS_IN_PARALLEL;

    const expr mem_sel = clock_set(in_use, start: 0, end: CLOCKS_WITH_MEM_OPS) +
                         clock_set(in_use, start: CLOCKS - CLOCKS_WITH_MEM_OPS, end: CLOCKS);

    const expr mem_is_write = clock_set(start: CLOCKS - CLOCKS_WITH_MEM_OPS, end: CLOCKS);

    const expr main_step = clock_shift(step_addr, STEP_MAIN, start: 0, end: CLOCKS_WITH_MEM_OPS) +
                           clock_shift(step_addr, STEP_MAIN, start: CLOCKS - CLOCKS_WITH_MEM_OPS, end: CLOCKS);

    for (int i = 0; i < MEM_OPS_IN_PARALLEL; i++) {
        // Address: ADDR_STATE + WORD_SIZE*(k*lanes_per_row + i) at group-row k, i.e. the
        // word address advances by WORD_SIZE*lanes_per_row per clock within the window
        const expr mem_addr = clock_shift(step_addr, ADDR_STATE, start: 0, end: CLOCKS_WITH_MEM_OPS, offset: WORD_SIZE*i, delta: WORD_SIZE*lanes_per_row) +
                              clock_shift(step_addr, ADDR_STATE, start: CLOCKS - CLOCKS_WITH_MEM_OPS, end: CLOCKS, offset: WORD_SIZE*i, delta: WORD_SIZE*lanes_per_row);

        // Pack state bits into two BITS_PER_CLOCK-bit limbs
        const int base = i * BITS_PER_CLOCK;
        const expr mem_value[2];
        mem_value[0] = pack(state, offset: base, len: BITS_PER_LIMB);
        mem_value[1] = pack(state, offset: base + BITS_PER_LIMB, len: BITS_PER_LIMB);

        precompiled_mem_op(
            sel: mem_sel,
            is_write: mem_is_write,
            main_step: main_step,
            addr: mem_addr,
            value: mem_value
        );
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // MAIN PROCESSOR INTEGRATION
    // ═══════════════════════════════════════════════════════════════════════════
    proves_operation(op: OP_KECCAKF, b: [step_addr'(ADDR_STATE), 0], main_step: step_addr'(STEP_MAIN), mul: in_use_clk_0);

    function theta(const expr a[]): const expr[] {
        const int len = length(a);
        assert(len == air.WIDTH);
        const expr result[len];

        // For all pairs (x, z) such that 0 ≤ x < 5 and 0 ≤ z < 64, compute:
        //      c[x, z] = xor(a[x, 0, z], a[x, 1, z], a[x, 2, z], a[x, 3, z], a[x, 4, z])
        const expr c[5][64];
        for (int x = 0; x < 5; x++) {
            for (int z = 0; z < 64; z++) {
                const int x1 = bit_pos(x, 0, z);
                const int x2 = bit_pos(x, 1, z);
                const int x3 = bit_pos(x, 2, z);
                const int x4 = bit_pos(x, 3, z);
                const int x5 = bit_pos(x, 4, z);

                c[x][z] = xor5(a[x1], a[x2], a[x3], a[x4], a[x5]);
            }
        }

        // For all pairs (x, z) such that 0 ≤ x < 5 and 0 ≤ z < 64, compute:
        //      d[x, z] = xor(c[x - 1, z], c[x + 1, z - 1])
        const expr d[5][64];
        for (int x = 0; x < 5; x++) {
            const int x1 = (x + 4) % 5;
            const int x2 = (x + 1) % 5;
            for (int z = 0; z < 64; z++) {
                const int z1 = z;
                const int z2 = (z + 63) % 64;
                d[x][z] = xor(c[x1][z1], c[x2][z2]);
            }
        }

        // For all triples (x, y, z) such that 0 ≤ x,y < 5 and 0 ≤ z < 64, compute:
        //      result[x, y, z] = xor(a[x, y, z], d[x, z])
        for (int x = 0; x < 5; x++) {
            for (int y = 0; y < 5; y++) {
                for (int z = 0; z < 64; z++) {
                    const int pos = bit_pos(x, y, z);
                    result[pos] = xor(a[pos], d[x][z]);
                }
            }
        }

        return result;
    }

    function rho(const expr a[]): const expr[] {
        const int len = length(a);
        assert(len == air.WIDTH);
        const expr result[len];

        // For all z such that 0 ≤ z < 64, let result[0, 0, z] = a[0, 0, z]
        for (int z = 0; z < 64; z++) {
            const int pos = bit_pos(0, 0, z);
            result[pos] = a[pos];
        }

        // Let (x, y) = (1, 0)
        // For t from 0 to 23:
        //      1. For all z such that 0 ≤ z < 64, let result[x, y, z] = a[x, y, z – (t + 1)(t + 2)/2]
        //      2. Let (x, y) = (y, 2x + 3y)
        int x = 1;
        int y = 0;
        for (int t = 0; t < 24; t++) {
            const int offset = ((t + 1) * (t + 2)) / 2;

            for (int z = 0; z < 64; z++) {
                const int src_z = (z + 64 - (offset % 64)) % 64;
                const int src_pos = bit_pos(x, y, src_z);
                const int dst_pos = bit_pos(x, y, z);

                result[dst_pos] = a[src_pos];
            }

            const int aux = y;
            y = (2 * x + 3 * y) % 5;
            x = aux;
        }

        return result;
    }

    function pi(const expr a[]): const expr[] {
        const int len = length(a);
        assert(len == air.WIDTH);
        const expr result[len];

        // For all triples (x, y, z) such that 0 ≤ x,y < 5, and 0 ≤ z < 64, let:
        //      result[x, y, z] = a[x + 3y, x, z].
        for (int x = 0; x < 5; x++) {
            for (int y = 0; y < 5; y++) {
                for (int z = 0; z < 64; z++) {
                    const int src_x = (x + 3 * y) % 5;
                    const int src_pos = bit_pos(src_x, x, z);
                    const int dst_pos = bit_pos(x, y, z);

                    result[dst_pos] = a[src_pos];
                }
            }
        }

        return result;
    }

    function add(const expr b[]): const expr {
        const int len = length(b);
        expr result = 0;
        for (int i = 0; i < len; i++) {
            result += b[i];
        }
        return result;
    }

    function xor(const expr b1, const expr b2): const expr {
        return add([b1, b2]);
    }

    function xor5(const expr b1, const expr b2, const expr b3, const expr b4, const expr b5): const expr {
        return add([b1, b2, b3, b4, b5]);
    }

    function pack(const expr a[], const int offset = 0, const int len = 0): const expr {
        const int n = (len == 0) ? (length(a) - offset) : len;

        expr packed = 0;
        for (int j = 0; j < n; j++) {
            packed += a[offset + j] * 2**j;
        }
        return packed;
    }

    function bit_pos(const int x, const int y, const int z): int {
        assert(0 <= x && x < 5);
        assert(0 <= y && y < 5);
        assert(0 <= z && z < 64);

        return (y * 5 + x) * 64 + z;
    }

    function clock_set(const expr mvcol = 1, const int start = 0, int end = -1): const expr {
        expr result = 0;
        if (end == -1) {
            end = start + 1;
        }

        for (int i = start; i < end; i++) {
            result += air.CLK[i];
        }
        return result * mvcol;
    }

    function clock_shift(const expr mvcol, const int pos, const int start = 0, int end = -1, int offset = 0,  const int delta = 0): const expr {
        expr result = 0;
        if (end == -1) {
            end = start + 1;
        }
        for (int i = start; i < end; i++) {
            const int iclock = (pos - i) % air.CLOCKS;
            if (offset != 0) {
                result += air.CLK[i] * (mvcol'(iclock) + offset);
            } else {
                result += air.CLK[i] * mvcol'(iclock);
            }
            offset += delta;
        }
        return result;
    }
}
