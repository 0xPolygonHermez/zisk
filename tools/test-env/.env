ZISK_BRANCH=pre-develop-1.3.0-alpha
ZISK_TEMPLATE_BRANCH=pre-develop-1.3.0-alpha
ZISK_ETH_CLIENT_BRANCH=fix/ziskethone-macos
ZISK_ETHPROOFS_BRANCH=develop-0.13.0
PIL2_COMPILER_BRANCH=develop-0.14.0

ZISK_SETUP_FILE=zisk-provingkey-pre-1.3.0-alpha.tar.gz
SETUP_VERSION=1.3.0-alpha
INSTALL_SETUP=1
SETUP_ADD_DYLIBS=0

ZEC_GUEST=ziskethone
REBUILD_ZISKETHONE_GUEST=0
BLOCK_INPUTS_SINGLE=mainnet_25431013_172_16_zec_ziskethone.bin
#BLOCK_INPUTS_MPI=mainnet_25431013_172_16_zec_ziskethone.bin,mainnet_25431039_325_25_zec_ziskethone.bin
