BLOCK_INPUTS_ETHPROOFS_HINTS=mainnet_24628611_627_58_zec_reth.bin,mainnet_24628590_478_49_zec_reth.bin

MPI_PROCESSES=2
MPI_THREADS=64

PROVE_FLAGS=-y
ONLY_CPU=0
ONLY_GPU=0
ENABLE_HINTS=1

DISABLE_CLONE_REPO=0
DISABLE_RECURSIVE_SETUP=0
DISABLE_PROVE=0
DISABLE_ENV_CONFIRM=0
USE_CACHE_SETUP=0

