; ============================================================================
; zisklib_uint256_add.zisk - 256-bit addition / subtraction. Mirrors
; ziskos/entrypoint/src/zisklib/lib/uint256/add.rs (the checked/saturating/
; wrapping/neg variants are Rust wrappers over these two overflowing cores).
; Shared data lives in zisklib_uint256_common.zisk. Internal labels: `us_`.
; ============================================================================

; RAM scratch: the add256 pointer header [&a, &b, cin, &c] and, for subtraction,
; the one's-complement of b (a - b = a + ~b + 1).
u64 U256_ADD_HDR[4] = 0, 0, 0, 0
u64 U256_NOTB[4] = 0, 0, 0, 0

; ----------------------------------------------------------------------------
; u64 zisklib_overflowing_add256(const u64* a, const u64* b, u64* result)
;   result = a + b (mod 2^256); returns the carry-out (1 on overflow, else 0).
;   Uses the add256 precompile: header [&a, &b, cin=0, &result], carry in the
;   c register. Args: r10 = a, r11 = b, r12 = result. Caller-saved regs only.
; ----------------------------------------------------------------------------
zisklib_overflowing_add256:
	copyb(0, U256_ADD_HDR) -> r5
	copyb(r5, r10) -> 8[a + 0]         ; &a
	copyb(r5, r11) -> 8[a + 8]         ; &b
	copyb(r5, 0) -> 8[a + 16]          ; cin = 0
	copyb(r5, r12) -> 8[a + 24]        ; &c = result
	add256(0, r5) -> r10               ; carry-out -> return value
	ret

; ----------------------------------------------------------------------------
; u64 zisklib_overflowing_sub256(const u64* a, const u64* b, u64* result)
;   result = a - b (mod 2^256); returns 1 on borrow/underflow (a < b), else 0.
;   Computes a + ~b + 1 with the add256 precompile; a carry-out of 0 means borrow.
;   Args: r10 = a, r11 = b, r12 = result. Caller-saved regs only.
; ----------------------------------------------------------------------------
zisklib_overflowing_sub256:
	; not_b = ~b, word by word
	copyb(0, U256_NOTB) -> r5
	copyb(0, 4) -> r6
us_notb:
	eq(r6, 0), j(us_add)
	copyb(r11, 8[a + 0]) -> r7
	xor(r7, 0xffffffffffffffff) -> r7  ; ones'-complement of the word
	copyb(r5, r7) -> 8[a + 0]
	add(r11, 8) -> r11
	add(r5, 8) -> r5
	sub(r6, 1) -> r6
	jump(us_notb)
us_add:
	; header [&a, &not_b, cin=1, &result]
	copyb(0, U256_ADD_HDR) -> r5
	copyb(r5, r10) -> 8[a + 0]         ; &a
	copyb(0, U256_NOTB) -> r7
	copyb(r5, r7) -> 8[a + 8]          ; &not_b
	copyb(r5, 1) -> 8[a + 16]          ; cin = 1
	copyb(r5, r12) -> 8[a + 24]        ; &c = result
	add256(0, r5) -> r6                ; carry-out
	; borrow = (carry-out == 0)
	eq(r6, 0), j(us_borrow)
	copyb(0, 0) -> r10                 ; carry-out != 0 -> no borrow
	ret
us_borrow:
	copyb(0, 1) -> r10                 ; carry-out == 0 -> borrow
	ret
