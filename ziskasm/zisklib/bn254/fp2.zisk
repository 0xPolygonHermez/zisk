; ============================================================================
; bn254/fp2.zisk - degree-2 extension field Fp2 = Fp[u]/(u²+1) for BN254.
; Mirrors ziskos/entrypoint/src/zisklib/lib/bn254/fp2.rs. All arithmetic runs on
; the bn254 complex precompiles (bn254_complex_add/sub/mul), which take a = &f1
; and b = &f2 directly (each 8 u64 = real‖imag) and update f1 in place. inv uses the
; FCALL_BN254_FP2_INV hint + verify. All leaves; they clobber only r5. Prefix `bf2_`.
; Fp2 element = 8 u64 LE limbs: real (limbs 0..3) ‖ imag (limbs 4..7).
; ============================================================================

u64 BN_F2_INV[8]  = 0, 0, 0, 0, 0, 0, 0, 0
u64 BN_F2_PROD[8] = 0, 0, 0, 0, 0, 0, 0, 0
; scalar operand b‖0 (imag half stays 0) and conjugate operand 0‖a_imag (real half stays 0)
u64 BN_F2_SB[8]   = 0, 0, 0, 0, 0, 0, 0, 0
u64 BN_F2_CB[8]   = 0, 0, 0, 0, 0, 0, 0, 0

; f2 = (P-1)‖0: multiplying by it negates an Fp2 element (used by neg).
const u64 BN_F2_NEGMUL[8] =
	0x3C208C16D87CFD46, 0x97816A916871CA8D, 0xB85045B68181585D, 0x30644E72E131A029,
	0, 0, 0, 0
const u64 BN_F2_ZERO[8] = 0, 0, 0, 0, 0, 0, 0, 0
const u64 BN_F2_ONE[8]  = 1, 0, 0, 0, 0, 0, 0, 0

; All leaves copy the in-place operand with one DMA op and run the precompile on
; it directly (a = the in-place operand, b = the other one); they clobber only r5.
; void zisklib_add_fp2_bn254(const u64* a, const u64* b, u64* result)
;   result = a + b.  [r10=a, r11=b, r12=result]  (result must not alias b)
zisklib_add_fp2_bn254:
	dma_xmemcpy(r12, r10) -> r5, j(64, 4)
	bn254_complex_add(r12, r11)
	ret

; void zisklib_sub_fp2_bn254(const u64* a, const u64* b, u64* result)  [r10,r11,r12]
zisklib_sub_fp2_bn254:
	dma_xmemcpy(r12, r10) -> r5, j(64, 4)
	bn254_complex_sub(r12, r11)
	ret

; void zisklib_mul_fp2_bn254(const u64* a, const u64* b, u64* result)  [r10,r11,r12]
zisklib_mul_fp2_bn254:
	dma_xmemcpy(r12, r10) -> r5, j(64, 4)
	bn254_complex_mul(r12, r11)
	ret

; void zisklib_dbl_fp2_bn254(const u64* a, u64* result)  [r10=a, r11=result]
;   (result may alias a: the precompile then adds a to itself; else result + a after the copy)
zisklib_dbl_fp2_bn254:
	dma_xmemcpy(r11, r10) -> r5, j(64, 4)
	bn254_complex_add(r11, r10)
	ret

; void zisklib_square_fp2_bn254(const u64* a, u64* result)  [r10=a, r11=result]
;   result = a * a.
zisklib_square_fp2_bn254:
	dma_xmemcpy(r11, r10) -> r5, j(64, 4)
	bn254_complex_mul(r11, r10)
	ret

; void zisklib_neg_fp2_bn254(const u64* a, u64* result)  [r10=a, r11=result]
;   result = -a = a * (P-1).
zisklib_neg_fp2_bn254:
	dma_xmemcpy(r11, r10) -> r5, j(64, 4)
	bn254_complex_mul(r11, BN_F2_NEGMUL)
	ret

; void zisklib_scalar_mul_fp2_bn254(const u64* a, const u64* b, u64* result)
;   result = a * (b + 0·u), b is an Fp scalar (4 u64).  [r10=a, r11=b, r12=result]
;   (b may alias result: it is copied into BN_F2_SB first)
zisklib_scalar_mul_fp2_bn254:
	dma_xmemcpy(BN_F2_SB, r11) -> r5, j(32, 4)
	dma_xmemcpy(r12, r10) -> r5, j(64, 4)
	bn254_complex_mul(r12, BN_F2_SB)
	ret

; void zisklib_conjugate_fp2_bn254(const u64* a, u64* result)  [r10=a, r11=result]
;   result = (a_real, -a_imag), via complex_sub((a_real,0), (0,a_imag)). May alias.
zisklib_conjugate_fp2_bn254:
	add(r10, 32) -> r5
	dma_xmemcpy(BN_F2_CB + 32, r5) -> r5, j(32, 4)
	dma_xmemcpy(r11, r10) -> r5, j(32, 4)
	add(r11, 32) -> r5
	dma_xmemset(r5, 32) -> r5, j(0, 4)
	bn254_complex_sub(r11, BN_F2_CB)
	ret

; void zisklib_inv_fp2_bn254(const u64* a, u64* result)  [r10=a, r11=result]
;   result = a^(-1) in Fp2 (returns a unchanged if a == 0). Hint FCALL_BN254_FP2_INV,
;   verify inverse canonical (both halves < P) and a*inv == 1; halt on bad hint.
;   Clobbers r5.
zisklib_inv_fp2_bn254:
	dma_xmemcmp(r10, BN_F2_ZERO) -> r5, j(64, 4)
	eq(r5, 0), j(bf2_inv_zero)
	fcall_param(8, r10)
	fcall(FCALL_BN254_FP2_INV, 0)
	fcall_get(0, [FREE_INPUT]) -> [BN_F2_INV]
	fcall_get(0, [FREE_INPUT]) -> [BN_F2_INV + 8]
	fcall_get(0, [FREE_INPUT]) -> [BN_F2_INV + 16]
	fcall_get(0, [FREE_INPUT]) -> [BN_F2_INV + 24]
	fcall_get(0, [FREE_INPUT]) -> [BN_F2_INV + 32]
	fcall_get(0, [FREE_INPUT]) -> [BN_F2_INV + 40]
	fcall_get(0, [FREE_INPUT]) -> [BN_F2_INV + 48]
	copyb(0, [FREE_INPUT]) -> [BN_F2_INV + 56]
	ltu([BN_F2_INV + 24], [BN_P + 24]), j(bf2_inv_c1)
	ltu([BN_P + 24], [BN_F2_INV + 24]), j(bf2_inv_panic)
	ltu([BN_F2_INV + 16], [BN_P + 16]), j(bf2_inv_c1)
	ltu([BN_P + 16], [BN_F2_INV + 16]), j(bf2_inv_panic)
	ltu([BN_F2_INV + 8], [BN_P + 8]), j(bf2_inv_c1)
	ltu([BN_P + 8], [BN_F2_INV + 8]), j(bf2_inv_panic)
	ltu([BN_F2_INV + 0], [BN_P + 0]), j(bf2_inv_c1)
	jump(bf2_inv_panic)
bf2_inv_c1:
	ltu([BN_F2_INV + 56], [BN_P + 24]), j(bf2_inv_vfy)
	ltu([BN_P + 24], [BN_F2_INV + 56]), j(bf2_inv_panic)
	ltu([BN_F2_INV + 48], [BN_P + 16]), j(bf2_inv_vfy)
	ltu([BN_P + 16], [BN_F2_INV + 48]), j(bf2_inv_panic)
	ltu([BN_F2_INV + 40], [BN_P + 8]), j(bf2_inv_vfy)
	ltu([BN_P + 8], [BN_F2_INV + 40]), j(bf2_inv_panic)
	ltu([BN_F2_INV + 32], [BN_P + 0]), j(bf2_inv_vfy)
	jump(bf2_inv_panic)
bf2_inv_vfy:
	; PROD = a * inv (Fp2), check == 1
	dma_xmemcpy(BN_F2_PROD, r10) -> r5, j(64, 4)
	bn254_complex_mul(BN_F2_PROD, BN_F2_INV)
	dma_xmemcmp(BN_F2_PROD, BN_F2_ONE) -> r5, j(64, 4)
	eq(r5, 0), j(bf2_inv_wr)
bf2_inv_panic:
	copyb(0, 0) -> r10, end
bf2_inv_wr:
	dma_xmemcpy(r11, BN_F2_INV) -> r5, j(64, 4)
	ret
bf2_inv_zero:
	dma_xmemcpy(r11, r10) -> r5, j(64, 4)
	ret
