; void zisklib_ml_line_eval_bn254()  uses ML_LAMMU, ML_XPP, ML_NEGYPP -> ML_L
zisklib_ml_line_eval_bn254:
	push r1
	dma_xmemcpy(BN_F2_SB, ML_XPP) -> r5, j(32, 4)
	dma_xmemcpy(ML_L, ML_LAMMU) -> r5, j(64, 4)
	bn254_complex_mul(ML_L, BN_F2_SB)
	dma_xmemcpy(BN_F2_SB, ML_NEGYPP) -> r5, j(32, 4)
	dma_xmemcpy(ML_L + 64, ML_LAMMU + 64) -> r5, j(64, 4)
	bn254_complex_mul(ML_L + 64, BN_F2_SB)
	copyb(0, ML_LAMMU + 64) -> r10
	copyb(0, ML_NEGYPP) -> r11
	copyb(0, ML_L + 64) -> r12
	pop r1
	ret

; void zisklib_ml_dbl_wh_bn254(const u64* q)  [r10=&q] uses ML_LAMMU -> ML_R2
zisklib_ml_dbl_wh_bn254:
	push r1
	copyb(0, r10) -> [ML_WP1]
	dma_xmemcpy(ML_T1, r10) -> r5, j(64, 4)
