	dma_xmemcpy(ML_C2, r5) -> r5, j(64, 4)
	dma_xmemcpy(ML_C3, ML_LAMMU) -> r5, j(64, 4)
	bn254_complex_mul(ML_C3, ML_C2)
	bn254_complex_add(ML_C3, ML_C3)
	dma_xmemcpy(ML_C2, ML_C1) -> r5, j(64, 4)
	bn254_complex_mul(ML_C2, ML_C1)
	dma_xmemcpy(BN_F2_SB, BN_THREE) -> r5, j(32, 4)
