	dma_xmemcmp(ML_C3, ML_C2) -> r5, j(64, 4)
	eq(r5, 0) -> r10
	copyb(0, ML_C2) -> r11
	copyb(0, 8) -> r12
	pop r1
	ret
mit_false:
	copyb(0, 0) -> r10
	pop r1
	ret

; u64 zisklib_ml_is_line_bn254(const u64* q1, const u64* q2)  [r10,r11] uses ML_LAMMU -> r10 bool
zisklib_ml_is_line_bn254:
