	bn254_complex_mul(ML_X3, ML_LAMMU)
	dma_xmemcpy(ML_T2, ML_T1) -> r5, j(64, 4)
	bn254_complex_add(ML_T2, ML_T1)
	bn254_complex_sub(ML_X3, ML_T2)
	dma_xmemcpy(ML_Y3, ML_LAMMU) -> r5, j(64, 4)
	bn254_complex_mul(ML_Y3, ML_X3)
	dma_xmemcpy(ML_T2, ML_LAMMU + 64) -> r5, j(64, 4)
	bn254_complex_add(ML_T2, ML_Y3)
	dma_xmemcpy(ML_Y3, ML_T2) -> r5, j(64, 4)
	bn254_complex_mul(ML_Y3, BN_F2_NEGMUL)
	dma_xmemcpy(ML_R2, ML_X3) -> r5, j(64, 4)
	dma_xmemcpy(ML_R2 + 64, ML_Y3) -> r5, j(64, 4)
	copyb(0, ML_Y3) -> r10
	copyb(0, ML_R2 + 64) -> r11
	copyb(0, 8) -> r12
	pop r1
	ret

; void zisklib_ml_add_wh_bn254(const u64* q1, const u64* q2)  [r10,r11] uses ML_LAMMU -> ML_R2
zisklib_ml_add_wh_bn254:
