; u64 zisklib_ml_line_check_bn254(const u64* q)  [r10=&q] uses ML_LAMMU -> r10 (y==lam*x+mu)
zisklib_ml_line_check_bn254:
	push r1
	copyb(0, r10) -> [ML_WP1]
	dma_xmemcpy(ML_C1, r10) -> r5, j(64, 4)
