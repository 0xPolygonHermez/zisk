	eq(r5, 0) -> r10
	copyb(0, ML_C2) -> r11
	copyb(0, 8) -> r12
	pop r1
	ret

; u64 zisklib_ml_is_tangent_bn254(const u64* q)  [r10=&q] uses ML_LAMMU -> r10 bool
zisklib_ml_is_tangent_bn254:
	push r1
	copyb(0, r10) -> [ML_WP2]
	add(r10, 64) -> r5
	dma_xmemcmp(r5, BN_G1_IDENTITY) -> r5, j(64, 4)
	eq(r5, 0) -> r10
	copyb(0, BN_G1_IDENTITY) -> r11
	copyb(0, 8) -> r12
	ltu(0, r10), j(mit_false)
	copyb(0, [ML_WP2]) -> r10
	call zisklib_ml_line_check_bn254
	eq(r10, 0), j(mit_false)
	copyb(0, [ML_WP2]) -> r5
	dma_xmemcpy(ML_C1, r5) -> r5, j(64, 4)
