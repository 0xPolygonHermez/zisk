	sll(r15, 1) -> r15
	jump(bsm_done)
bsm_done:
	copyb(0, [BN_SM_RESPTR]) -> r5
	dma_xmemcpy(r5, BN_SM_Q) -> r5, j(64, 4)
	copyb(0, 0) -> r10
	copyb(0, [BN_SM_RESPTR]) -> r11
	copyb(0, 8) -> r12
	pop r1
	ret
bsm_zero:
	copyb(0, [BN_SM_RESPTR]) -> r11
	copyb(r11, 0) -> 8[a + 0]
	copyb(r11, 0) -> 8[a + 8]
	copyb(r11, 0) -> 8[a + 16]
	copyb(r11, 0) -> 8[a + 24]
	copyb(r11, 0) -> 8[a + 32]
	copyb(r11, 0) -> 8[a + 40]
	copyb(r11, 0) -> 8[a + 48]
	copyb(r11, 0) -> 8[a + 56]
	copyb(0, 1) -> r10
	pop r1
	ret
bsm_one:
	copyb(0, [BN_SM_PPTR]) -> r10
	copyb(0, [BN_SM_RESPTR]) -> r11
	copyb(0, 8) -> r12
	call bn254_memcpy
	copyb(0, 0) -> r10
	pop r1
	ret
bsm_two:
	copyb(0, [BN_SM_PPTR]) -> r10
	copyb(0, [BN_SM_RESPTR]) -> r11
	call zisklib_dbl_bn254
	copyb(0, 0) -> r10
	pop r1
	ret

; void zisklib_jacobian_to_affine_bn254(const u64* p, u64* result)
;   [r10=p (12 u64 x‖y‖z), r11=result (8 u64)]. z==0 -> identity; z==1 -> (x,y);
;   else affine = (x/z², y/z³).
zisklib_jacobian_to_affine_bn254:
	push r1
	copyb(0, r10) -> [BN_J2A_P]
	; save result ptr in BN_ADD_RES (reuse scratch, add not active here)
	copyb(0, r11) -> [BN_ADD_RES]
	; z == 0 ? (p[8..12] all zero) -> identity
	add(r10, 64) -> r5
	copyb(r5, 8[a + 0]) -> r6
	copyb(r5, 8[a + 8]) -> r7
	or(r6, r7) -> r6
	copyb(r5, 8[a + 16]) -> r7
	or(r6, r7) -> r6
	copyb(r5, 8[a + 24]) -> r7
	or(r6, r7) -> r6
	ltu(0, r6), j(bj2a_nz)
	; identity
	copyb(0, [BN_ADD_RES]) -> r11
	copyb(r11, 0) -> 8[a + 0]
	copyb(r11, 0) -> 8[a + 8]
	copyb(r11, 0) -> 8[a + 16]
	copyb(r11, 0) -> 8[a + 24]
	copyb(r11, 0) -> 8[a + 32]
	copyb(r11, 0) -> 8[a + 40]
	copyb(r11, 0) -> 8[a + 48]
	copyb(r11, 0) -> 8[a + 56]
	pop r1
	ret
bj2a_nz:
	; zinv = inv_fp(z)
	copyb(0, BN_J2A_P) -> r5
	add([BN_J2A_P], 64) -> r10
	copyb(0, BN_J2A_ZINV) -> r11
	call zisklib_inv_fp_bn254
	; zsq = zinv²
	arith256_mod(0, ZBN2_CURVE_H5)
	; result.x = x · zsq
	copyb(0, [BN_J2A_P]) -> [ZBN2_CURVE_H6]
	copyb(0, [BN_ADD_RES]) -> [ZBN2_CURVE_H6 + 32]
	arith256_mod(0, ZBN2_CURVE_H6)
	; t = y · zsq
	add([BN_J2A_P], 32) -> [ZBN2_CURVE_H7]
	arith256_mod(0, ZBN2_CURVE_H7)
	; result.y = t · zinv
	add([BN_ADD_RES], 32) -> [ZBN2_CURVE_H8 + 32]
	arith256_mod(0, ZBN2_CURVE_H8)
	copyb(0, BN_J2A_T) -> r10
	copyb(0, BN_J2A_ZINV) -> r11
	add([BN_ADD_RES], 32) -> r12
	pop r1
	ret
