; ============================================================================
; bn254/curve.zisk - G1 point arithmetic on E/Fp: y² = x³ + 3. Mirrors
; ziskos/entrypoint/src/zisklib/lib/bn254/curve.rs. Uses bn254_curve_add
; (header [&p1,&p2], p1+=p2 in place) and bn254_curve_dbl (b=&point, in place).
; G1 point = 8 u64 (x‖y). Identity = all-zero. Prefixes bcv_/boc_/bsm_/bj2a_.
; ============================================================================

; inline-op headers (zopt): precompile parameter blocks
const u64 ZBN2_CURVE_H3[5] = BN_OC_X3, BN_ONE, BN_E_B, BN_P, BN_OC_RHS
const u64 ZBN2_CURVE_H5[5] = BN_J2A_ZINV, BN_J2A_ZINV, BN_ZERO, BN_P, BN_J2A_ZSQ
u64 ZBN2_CURVE_H0[5] = 0, 0, BN_ZERO, BN_P, BN_OC_LHS
u64 ZBN2_CURVE_H1[5] = 0, 0, BN_ZERO, BN_P, BN_OC_X2
u64 ZBN2_CURVE_H2[5] = BN_OC_X2, 0, BN_ZERO, BN_P, BN_OC_X3
u64 ZBN2_CURVE_H4[5] = 0, BN_P_MINUS_ONE, BN_ZERO, BN_P, 0
u64 ZBN2_CURVE_H6[5] = 0, BN_J2A_ZSQ, BN_ZERO, BN_P, 0
u64 ZBN2_CURVE_H7[5] = 0, BN_J2A_ZSQ, BN_ZERO, BN_P, BN_J2A_T
u64 ZBN2_CURVE_H8[5] = BN_J2A_T, BN_J2A_ZINV, BN_ZERO, BN_P, 0

u64 BN_OC_P[1]     = 0
u64 BN_OC_LHS[4]   = 0, 0, 0, 0
u64 BN_OC_X2[4]    = 0, 0, 0, 0
u64 BN_OC_X3[4]    = 0, 0, 0, 0
u64 BN_OC_RHS[4]   = 0, 0, 0, 0

u64 BN_ADD_HDR[2]  = 0, 0
u64 BN_ADD_P1[1]   = 0
u64 BN_ADD_P2[1]   = 0
u64 BN_ADD_RES[1]  = 0

u64 BN_SM_PPTR[1]  = 0
u64 BN_SM_RESPTR[1]= 0
u64 BN_SM_K[4]     = 0, 0, 0, 0
u64 BN_SM_Q[8]     = 0, 0, 0, 0, 0, 0, 0, 0
u64 BN_SM_HDR[2]   = 0, 0

u64 BN_J2A_P[1]    = 0
u64 BN_J2A_ZINV[4] = 0, 0, 0, 0
u64 BN_J2A_ZSQ[4]  = 0, 0, 0, 0
u64 BN_J2A_T[4]    = 0, 0, 0, 0

; u64 zisklib_is_on_curve_bn254(const u64* p)  [r10=&p] -> r10 (1 if on curve)
;   y² == x³ + 3, or p is the all-zero identity.
zisklib_is_on_curve_bn254:
	push r1
	copyb(0, r10) -> [BN_OC_P]
	; lhs = y²   (y = p + 32)
	add(r10, 32) -> [ZBN2_CURVE_H0]
	add(r10, 32) -> [ZBN2_CURVE_H0 + 8]
	arith256_mod(0, ZBN2_CURVE_H0)
	; x2 = x²
	copyb(0, r10) -> [ZBN2_CURVE_H1]
	copyb(0, r10) -> [ZBN2_CURVE_H1 + 8]
	arith256_mod(0, ZBN2_CURVE_H1)
	; x3 = x2 · x
	copyb(0, r10) -> [ZBN2_CURVE_H2 + 8]
	arith256_mod(0, ZBN2_CURVE_H2)
	; rhs = x3 + 3
	arith256_mod(0, ZBN2_CURVE_H3)
	; lhs == rhs ?
	dma_xmemcmp(BN_OC_LHS, BN_OC_RHS) -> r5, j(32, 4)
	eq(r5, 0) -> r10
	copyb(0, BN_OC_RHS) -> r11
	copyb(0, 4) -> r12
	ltu(0, r10), j(boc_true)
	; else: p == identity ?
	copyb(0, [BN_OC_P]) -> r5
	dma_xmemcmp(r5, BN_G1_IDENTITY) -> r5, j(64, 4)
	eq(r5, 0) -> r10
	copyb(0, BN_G1_IDENTITY) -> r11
	copyb(0, 8) -> r12
	pop r1
	ret
boc_true:
	copyb(0, 1) -> r10
	pop r1
	ret

; void zisklib_dbl_bn254(const u64* p, u64* result)  [r10=p, r11=result]
;   result = 2·p (p non-identity). Leaf.
zisklib_dbl_bn254:
	copyb(r10, 8[a + 0]) -> r14
	copyb(r11, r14) -> 8[a + 0]
	copyb(r10, 8[a + 8]) -> r14
	copyb(r11, r14) -> 8[a + 8]
	copyb(r10, 8[a + 16]) -> r14
	copyb(r11, r14) -> 8[a + 16]
	copyb(r10, 8[a + 24]) -> r14
	copyb(r11, r14) -> 8[a + 24]
	copyb(r10, 8[a + 32]) -> r14
	copyb(r11, r14) -> 8[a + 32]
	copyb(r10, 8[a + 40]) -> r14
	copyb(r11, r14) -> 8[a + 40]
	copyb(r10, 8[a + 48]) -> r14
	copyb(r11, r14) -> 8[a + 48]
	copyb(r10, 8[a + 56]) -> r14
	copyb(r11, r14) -> 8[a + 56]
	bn254_curve_dbl(0, r11) -> r14
	ret

; void zisklib_neg_bn254(const u64* p, u64* result)  [r10=p, r11=result]
;   result = (x, -y).
zisklib_neg_bn254:
	push r1
	; result[0..4] = x = p[0..4]
	copyb(r10, 8[a + 0]) -> r14
	copyb(r11, r14) -> 8[a + 0]
	copyb(r10, 8[a + 8]) -> r14
	copyb(r11, r14) -> 8[a + 8]
	copyb(r10, 8[a + 16]) -> r14
	copyb(r11, r14) -> 8[a + 16]
	copyb(r10, 8[a + 24]) -> r14
	copyb(r11, r14) -> 8[a + 24]
	; result[4..8] = neg_fp(p[4..8])
	add(r10, 32) -> [ZBN2_CURVE_H4]
	add(r11, 32) -> [ZBN2_CURVE_H4 + 32]
	arith256_mod(0, ZBN2_CURVE_H4)
	add(r10, 32) -> r10
	add(r11, 32) -> r11
	pop r1
	ret

; void zisklib_add_bn254(const u64* p1, const u64* p2, u64* result)  [r10,r11,r12]
;   result = p1 + p2 (both non-identity, on-curve). x1==x2 -> dbl (if y1==y2) or
;   identity; else the chord addition via the precompile.
zisklib_add_bn254:
	push r1
	copyb(0, r10) -> [BN_ADD_P1]
	copyb(0, r11) -> [BN_ADD_P2]
	copyb(0, r12) -> [BN_ADD_RES]
	; x1 == x2 ?
	dma_xmemcmp(r10, r11) -> r5, j(32, 4)
	eq(r5, 0) -> r10
	copyb(0, 4) -> r12
	eq(r10, 0), j(bcv_add_generic)
	; x1 == x2: y1 == y2 ?
	add([BN_ADD_P1], 32) -> r5
	add([BN_ADD_P2], 32) -> r10
	dma_xmemcmp(r5, r10) -> r5, j(32, 4)
	eq(r5, 0) -> r10
	add([BN_ADD_P2], 32) -> r11
	eq(r10, 0), j(bcv_add_inf)
	; y1 == y2: doubling
	copyb(0, BN_ADD_RES) -> r5
	copyb(0, [BN_ADD_P1]) -> r10
	copyb(0, [BN_ADD_RES]) -> r11
	call zisklib_dbl_bn254
	pop r1
	ret
bcv_add_inf:
	; result = identity (all zero)
	copyb(0, [BN_ADD_RES]) -> r11
	copyb(r11, 0) -> 8[a + 0]
	copyb(r11, 0) -> 8[a + 8]
	copyb(r11, 0) -> 8[a + 16]
	copyb(r11, 0) -> 8[a + 24]
	copyb(r11, 0) -> 8[a + 32]
	copyb(r11, 0) -> 8[a + 40]
	copyb(r11, 0) -> 8[a + 48]
	copyb(r11, 0) -> 8[a + 56]
	copyb(0, BN_ADD_RES) -> r5
	pop r1
	ret
bcv_add_generic:
	; result = p1, then result += p2 via bn254_curve_add
	copyb(0, [BN_ADD_P1]) -> r10
	copyb(0, [BN_ADD_RES]) -> r11
	copyb(0, 8) -> r12
	call bn254_memcpy
	copyb(0, [BN_ADD_RES]) -> r6
	copyb(0, r6) -> [BN_ADD_HDR]
	copyb(0, BN_ADD_HDR) -> r5
	copyb(0, [BN_ADD_P2]) -> r7
	copyb(r5, r7) -> 8[a + 8]
	bn254_curve_add(0, r5) -> r14
	pop r1
	ret

; u64 zisklib_scalar_mul_bn254(const u64* p, const u64* k, u64* result)
;   [r10=p, r11=k, r12=result] -> r10 = 1 if result is identity, else 0.
;   result = k·p; k reduced mod R first. Reads k bits directly (trusted memory).
u64 BN_SM_P[8] = 0, 0, 0, 0, 0, 0, 0, 0
const u64 BN_SM_HDRC[2] = BN_SM_Q, BN_SM_P
const u64 BSM_TAB[256] = bsm_done, bsm_s1, bsm_s2, bsm_s3, bsm_s4, bsm_s5, bsm_s6, bsm_s7, bsm_s8, bsm_s9, bsm_s10, bsm_s11, bsm_s12, bsm_s13, bsm_s14, bsm_s15, bsm_s16, bsm_s17, bsm_s18, bsm_s19, bsm_s20, bsm_s21, bsm_s22, bsm_s23, bsm_s24, bsm_s25, bsm_s26, bsm_s27, bsm_s28, bsm_s29, bsm_s30, bsm_s31, bsm_s32, bsm_s33, bsm_s34, bsm_s35, bsm_s36, bsm_s37, bsm_s38, bsm_s39, bsm_s40, bsm_s41, bsm_s42, bsm_s43, bsm_s44, bsm_s45, bsm_s46, bsm_s47, bsm_s48, bsm_s49, bsm_s50, bsm_s51, bsm_s52, bsm_s53, bsm_s54, bsm_s55, bsm_s56, bsm_s57, bsm_s58, bsm_s59, bsm_s60, bsm_s61, bsm_s62, bsm_s63, bsm_t64, bsm_s65, bsm_s66, bsm_s67, bsm_s68, bsm_s69, bsm_s70, bsm_s71, bsm_s72, bsm_s73, bsm_s74, bsm_s75, bsm_s76, bsm_s77, bsm_s78, bsm_s79, bsm_s80, bsm_s81, bsm_s82, bsm_s83, bsm_s84, bsm_s85, bsm_s86, bsm_s87, bsm_s88, bsm_s89, bsm_s90, bsm_s91, bsm_s92, bsm_s93, bsm_s94, bsm_s95, bsm_s96, bsm_s97, bsm_s98, bsm_s99, bsm_s100, bsm_s101, bsm_s102, bsm_s103, bsm_s104, bsm_s105, bsm_s106, bsm_s107, bsm_s108, bsm_s109, bsm_s110, bsm_s111, bsm_s112, bsm_s113, bsm_s114, bsm_s115, bsm_s116, bsm_s117, bsm_s118, bsm_s119, bsm_s120, bsm_s121, bsm_s122, bsm_s123, bsm_s124, bsm_s125, bsm_s126, bsm_s127, bsm_t128, bsm_s129, bsm_s130, bsm_s131, bsm_s132, bsm_s133, bsm_s134, bsm_s135, bsm_s136, bsm_s137, bsm_s138, bsm_s139, bsm_s140, bsm_s141, bsm_s142, bsm_s143, bsm_s144, bsm_s145, bsm_s146, bsm_s147, bsm_s148, bsm_s149, bsm_s150, bsm_s151, bsm_s152, bsm_s153, bsm_s154, bsm_s155, bsm_s156, bsm_s157, bsm_s158, bsm_s159, bsm_s160, bsm_s161, bsm_s162, bsm_s163, bsm_s164, bsm_s165, bsm_s166, bsm_s167, bsm_s168, bsm_s169, bsm_s170, bsm_s171, bsm_s172, bsm_s173, bsm_s174, bsm_s175, bsm_s176, bsm_s177, bsm_s178, bsm_s179, bsm_s180, bsm_s181, bsm_s182, bsm_s183, bsm_s184, bsm_s185, bsm_s186, bsm_s187, bsm_s188, bsm_s189, bsm_s190, bsm_s191, bsm_t192, bsm_s193, bsm_s194, bsm_s195, bsm_s196, bsm_s197, bsm_s198, bsm_s199, bsm_s200, bsm_s201, bsm_s202, bsm_s203, bsm_s204, bsm_s205, bsm_s206, bsm_s207, bsm_s208, bsm_s209, bsm_s210, bsm_s211, bsm_s212, bsm_s213, bsm_s214, bsm_s215, bsm_s216, bsm_s217, bsm_s218, bsm_s219, bsm_s220, bsm_s221, bsm_s222, bsm_s223, bsm_s224, bsm_s225, bsm_s226, bsm_s227, bsm_s228, bsm_s229, bsm_s230, bsm_s231, bsm_s232, bsm_s233, bsm_s234, bsm_s235, bsm_s236, bsm_s237, bsm_s238, bsm_s239, bsm_s240, bsm_s241, bsm_s242, bsm_s243, bsm_s244, bsm_s245, bsm_s246, bsm_s247, bsm_s248, bsm_s249, bsm_s250, bsm_s251, bsm_s252, bsm_s253, bsm_s254, bsm_s255

zisklib_scalar_mul_bn254:
	push r1
	copyb(0, r10) -> [BN_SM_PPTR]
	copyb(0, r12) -> [BN_SM_RESPTR]
	copyb(0, BN_SM_RESPTR) -> r5
	copyb(0, r11) -> r10
	copyb(0, BN_SM_K) -> r11
	call zisklib_reduce_fr_bn254
	; dispatch on small k
	copyb(0, BN_SM_K) -> r5
	copyb(r5, 8[a + 8]) -> r6
	copyb(r5, 8[a + 16]) -> r7
	or(r6, r7) -> r6
	copyb(r5, 8[a + 24]) -> r7
	or(r6, r7) -> r6
	ltu(0, r6), j(bsm_general)
	copyb(0, [BN_SM_K]) -> r7
	eq(r7, 0), j(bsm_zero)
	eq(r7, 1), j(bsm_one)
	eq(r7, 2), j(bsm_two)
bsm_general:
	copyb(0, [BN_SM_PPTR]) -> r5
	dma_xmemcpy(BN_SM_P, r5) -> r5, j(64, 4)
	dma_xmemcpy(BN_SM_Q, BN_SM_P) -> r5, j(64, 4)
	copyb(0, [BN_SM_K + 24]) -> r15
	copyb(0, 0) -> r13
	ltu(0, r15), j(bsm_lz)
	copyb(0, [BN_SM_K + 16]) -> r15
	copyb(0, 64) -> r13
	ltu(0, r15), j(bsm_lz)
	copyb(0, [BN_SM_K + 8]) -> r15
	copyb(0, 128) -> r13
	ltu(0, r15), j(bsm_lz)
	copyb(0, [BN_SM_K]) -> r15
	copyb(0, 192) -> r13
bsm_lz:
	lt(r15, 0), j(bsm_msb)
	sll(r15, 1) -> r15
	add(r13, 1) -> r13
	jump(bsm_lz)
bsm_msb:
	sll(r15, 1) -> r15
	add(r13, 1) -> r13
	eq(r13, 256), j(bsm_done)
	sll(r13, 3) -> r13
	add(r13, BSM_TAB) -> r13
	copyb(r13, 8[a + 0]), setpc(0)
bsm_s1:
	bn254_curve_dbl(0, BN_SM_Q)
	lt(r15, 0), j(bsm_a1)
	sll(r15, 1) -> r15
bsm_s2:
	bn254_curve_dbl(0, BN_SM_Q)
	lt(r15, 0), j(bsm_a2)
	sll(r15, 1) -> r15
