; ============================================================================
; bn254/fr.zisk - scalar-field (Fr) arithmetic for BN254. Mirrors
; ziskos/entrypoint/src/zisklib/lib/bn254/fr.rs: only reduce_fr is needed
; (fast-path if x < R, else arith256_mod with modulus R). Leaf. Prefix `bfr_`.
; ============================================================================

u64 BN_FR_HDR[5] = 0, 0, 0, 0, 0

; void zisklib_reduce_fr_bn254(const u64* x, u64* result)  [r10=x, r11=result]
;   result = x mod R.
zisklib_reduce_fr_bn254:
	; fast path: if x < R (MSW-first compare) just copy x
	copyb(0, r10) -> r5
	add(r5, 24) -> r5
	copyb(0, BN_R) -> r6
	add(r6, 24) -> r6
	copyb(0, 4) -> r7
bfr_red_lt:
	eq(r7, 0), j(bfr_red_mod)
	copyb(r5, 8[a + 0]) -> r14
	copyb(r6, 8[a + 0]) -> r15
	ltu(r14, r15), j(bfr_red_copy)
	ltu(r15, r14), j(bfr_red_mod)
	sub(r5, 8) -> r5
	sub(r6, 8) -> r6
	sub(r7, 1) -> r7
	jump(bfr_red_lt)
bfr_red_copy:
	copyb(0, r10) -> r5
	copyb(0, 4) -> r7
bfr_red_cp:
	eq(r7, 0), j(bfr_red_done)
	copyb(r5, 8[a + 0]) -> r14
	copyb(r11, r14) -> 8[a + 0]
	add(r5, 8) -> r5
	add(r11, 8) -> r11
	sub(r7, 1) -> r7
	jump(bfr_red_cp)
bfr_red_done:
	ret
bfr_red_mod:
	copyb(0, BN_FR_HDR) -> r5
	copyb(r5, r10) -> 8[a + 0]
	copyb(0, BN_ONE) -> r7
	copyb(r5, r7) -> 8[a + 8]
	copyb(0, BN_ZERO) -> r7
	copyb(r5, r7) -> 8[a + 16]
	copyb(0, BN_R) -> r7
	copyb(r5, r7) -> 8[a + 24]
	copyb(r5, r11) -> 8[a + 32]
	arith256_mod(0, r5) -> r14
	ret
