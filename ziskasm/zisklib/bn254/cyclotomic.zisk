	dma_xmemcpy(CY_A5, r5) -> r5, j(64, 4)
	dma_xmemcmp(CY_A2, BN_G1_IDENTITY) -> r5, j(64, 4)
	eq(r5, 0) -> r10
	copyb(0, BN_G1_IDENTITY) -> r11
	copyb(0, 8) -> r12
	eq(r10, 0), j(dec_gen)
	copyb(0, CY_A3) -> r10
	copyb(0, CY_T1) -> r11
	call zisklib_inv_fp2_bn254
	dma_xmemcpy(CY_A1, CY_A4) -> r5, j(64, 4)
