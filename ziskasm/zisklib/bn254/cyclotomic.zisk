	dma_xmemcpy(CY_A3, r5) -> r5, j(64, 4)
	add(r10, 64) -> r5
	dma_xmemcpy(CY_A4, r5) -> r5, j(64, 4)
	add(r10, 320) -> r5
	dma_xmemcpy(CY_A5, r5) -> r5, j(64, 4)
	dma_xmemcpy(r11, CY_A2) -> r5, j(64, 4)
	add(r11, 64) -> r5
