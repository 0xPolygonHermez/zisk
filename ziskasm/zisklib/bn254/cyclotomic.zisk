; void zisklib_exp_by_x_cyclo_bn254(const u64* a, u64* result)  [48,48]
zisklib_exp_by_x_cyclo_bn254:
	push r1
	copyb(0, r10) -> [EXPX_A]
	copyb(0, r11) -> [EXPX_R]
	dma_xmemcpy(EXPX_RES, r10) -> r5, j(384, 4)
	copyb(0, EXPX_COMP) -> r11
	copyb(0, 48) -> r12
	call zisklib_compress_cyclo_bn254
	copyb(0, 1) -> r13
expx_loop:
	eq(r13, 63), j(expx_done)
	copyb(0, EXPX_COMP) -> r10
	copyb(0, EXPX_COMP2) -> r11
	call zisklib_square_cyclo_bn254
	dma_xmemcpy(EXPX_COMP, EXPX_COMP2) -> r5, j(256, 4)
	sll(r13, 3) -> r6
	copyb(0, BN_X_BIN_LE) -> r5
	add(r5, r6) -> r5
	copyb(r5, 1[a + 0]) -> r6
	copyb(0, EXPX_COMP2) -> r10
	copyb(0, EXPX_COMP) -> r11
	copyb(0, 32) -> r12
	eq(r6, 0), j(expx_next)
	copyb(0, EXPX_COMP) -> r10
	copyb(0, EXPX_DEC) -> r11
	call zisklib_decompress_cyclo_bn254
	copyb(0, EXPX_RES) -> r10
	copyb(0, EXPX_DEC) -> r11
	copyb(0, EXPX_RES) -> r12
	call zisklib_mul_fp12_bn254
expx_next:
	add(r13, 1) -> r13
	jump(expx_loop)
expx_done:
	copyb(0, [EXPX_R]) -> r5
	dma_xmemcpy(r5, EXPX_RES) -> r5, j(384, 4)
	copyb(0, EXPX_RES) -> r10
	copyb(0, [EXPX_R]) -> r11
	copyb(0, 48) -> r12
	pop r1
	ret

