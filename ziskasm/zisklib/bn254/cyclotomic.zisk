	dma_xmemcpy(BN_F2_SB, BN_THREE) -> r5, j(32, 4)
	dma_xmemcpy(CY_T3, CY_T2) -> r5, j(64, 4)
	bn254_complex_mul(0, ZBN2_CYCLOTOMIC_H8)
	bn254_complex_sub(0, ZBN2_CYCLOTOMIC_H26)
	bn254_complex_mul(0, ZBN2_CYCLOTOMIC_H27)
	bn254_complex_add(0, ZBN2_CYCLOTOMIC_H28)
	copyb(0, CY_A0) -> r10
	copyb(0, BN_FP2_ONE) -> r11
	copyb(0, CY_A0) -> r12
	jump(dec_out)
dec_gen:
	dma_xmemcpy(BN_F2_SB, BN_FOUR) -> r5, j(32, 4)
	dma_xmemcpy(CY_T1, CY_A2) -> r5, j(64, 4)
	bn254_complex_mul(0, ZBN2_CYCLOTOMIC_H29)
