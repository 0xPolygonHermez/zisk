	add(r10, 64) -> r5
	dma_xmemcpy(BNK_T0, r5) -> r5, j(64, 4)
	add(r10, 64) -> r5
	bn254_complex_mul(BNK_T0, r5)
	bn254_complex_add(r14, BNK_T0)
	ret
bnk_square_fp6_al0:
	dma_xmemcpy(BNK_SAVE0, r10) -> r5, j(192, 4)
	copyb(0, BNK_SAVE0) -> r10
	jump(bnk_square_fp6_c0)

