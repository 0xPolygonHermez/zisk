	bn254_complex_add(r14, r5)
	add(r10, 128) -> r5
	dma_xmemcpy(BNK_T0, r5) -> r5, j(64, 4)
	add(r10, 128) -> r5
	bn254_complex_mul(BNK_T0, r5)
