; void zisklib_exp_fp12_bn254(u64 e, const u64* a, u64* result)  [r10=e, r11=a, r12=result]
zisklib_exp_fp12_bn254:
	push r1
	copyb(0, r10) -> [F12_E]
	copyb(0, r11) -> [F12_EA]
	copyb(0, r12) -> [F12_ER]
	copyb(0, F12_E) -> r5
	copyb(0, r10) -> r6
	eq(r6, 0), j(bx12_one)
	eq(r6, 1), j(bx12_copya)
	copyb(0, [F12_EA]) -> r5
	dma_xmemcpy(F12_ERES, r5) -> r5, j(384, 4)
	copyb(0, [F12_EA]) -> r10
	copyb(0, F12_ERES) -> r11
	copyb(0, 48) -> r12
	copyb(0, 63) -> r13
bx12_msb:
	copyb(0, [F12_E]) -> r5
	srl(r5, r13) -> r5
	and(r5, 1) -> r5
	ltu(0, r5), j(bx12_loopstart)
	sub(r13, 1) -> r13
	jump(bx12_msb)
bx12_loopstart:
	eq(r13, 0), j(bx12_writeres)
	sub(r13, 1) -> r13
bx12_loop:
	copyb(0, F12_ERES) -> r10
	copyb(0, F12_ERES) -> r11
	call zisklib_square_fp12_bn254
	copyb(0, [F12_E]) -> r5
	srl(r5, r13) -> r5
	and(r5, 1) -> r5
	eq(r5, 0), j(bx12_nomul)
	copyb(0, F12_ERES) -> r10
	copyb(0, [F12_EA]) -> r11
	copyb(0, F12_ERES) -> r12
	call zisklib_mul_fp12_bn254
bx12_nomul:
	eq(r13, 0), j(bx12_writeres)
	sub(r13, 1) -> r13
	jump(bx12_loop)
bx12_writeres:
	copyb(0, [F12_ER]) -> r5
	dma_xmemcpy(r5, F12_ERES) -> r5, j(384, 4)
	copyb(0, F12_ERES) -> r10
	copyb(0, [F12_ER]) -> r11
	copyb(0, 48) -> r12
	pop r1
	ret
bx12_copya:
