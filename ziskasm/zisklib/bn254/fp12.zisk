	dma_xmemcpy(r5, F12_C2) -> r5, j(192, 4)
	copyb(0, F12_C2) -> r10
	add([F12_PR], 192) -> r11
	copyb(0, 24) -> r12
	pop r1
	ret

; void zisklib_conjugate_fp12_bn254(const u64* a, u64* result)  [48,48]
zisklib_conjugate_fp12_bn254:
