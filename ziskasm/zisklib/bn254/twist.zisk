; void zisklib_add_complete_twist_bn254(const u64* p1, const u64* p2, u64* result)
zisklib_add_complete_twist_bn254:
	push r1
	copyb(0, AC_P1) -> r5
	copyb(r5, r10) -> 8[a + 0]
	copyb(0, AC_P2) -> r5
	copyb(r5, r11) -> 8[a + 0]
	copyb(0, AC_PR) -> r5
	copyb(r5, r12) -> 8[a + 0]
	copyb(0, AC_P1) -> r10
	copyb(r10, 8[a + 0]) -> r10
	copyb(0, BN_G2_IDENTITY) -> r11
	copyb(0, 16) -> r12
	call bn254_eqn
	eq(r10, 0), j(act_chk2)
	copyb(0, AC_P2) -> r10
	copyb(r10, 8[a + 0]) -> r10
	copyb(0, AC_PR) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(0, 16) -> r12
	call bn254_memcpy
	pop r1
	ret
act_chk2:
	copyb(0, AC_P2) -> r10
	copyb(r10, 8[a + 0]) -> r10
	copyb(0, BN_G2_IDENTITY) -> r11
	copyb(0, 16) -> r12
	call bn254_eqn
	eq(r10, 0), j(act_add)
	copyb(0, AC_P1) -> r10
	copyb(r10, 8[a + 0]) -> r10
	copyb(0, AC_PR) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(0, 16) -> r12
	call bn254_memcpy
	pop r1
	ret
act_add:
	copyb(0, AC_P1) -> r10
	copyb(r10, 8[a + 0]) -> r10
	copyb(0, AC_P2) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(0, AC_PR) -> r12
	copyb(r12, 8[a + 0]) -> r12
	call zisklib_add_twist_bn254
	pop r1
	ret

; void zisklib_dbl_complete_twist_bn254(const u64* p, u64* result)
zisklib_dbl_complete_twist_bn254:
	push r1
	copyb(0, DC_P) -> r5
	copyb(r5, r10) -> 8[a + 0]
	copyb(0, DC_PR) -> r5
	copyb(r5, r11) -> 8[a + 0]
	copyb(0, DC_P) -> r10
	copyb(r10, 8[a + 0]) -> r10
	copyb(0, BN_G2_IDENTITY) -> r11
	copyb(0, 16) -> r12
	call bn254_eqn
	eq(r10, 0), j(dct_dbl)
	copyb(0, DC_PR) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(r11, 0) -> 8[a + 0]
	copyb(r11, 0) -> 8[a + 8]
	copyb(r11, 0) -> 8[a + 16]
	copyb(r11, 0) -> 8[a + 24]
	copyb(r11, 0) -> 8[a + 32]
	copyb(r11, 0) -> 8[a + 40]
	copyb(r11, 0) -> 8[a + 48]
	copyb(r11, 0) -> 8[a + 56]
	copyb(r11, 0) -> 8[a + 64]
	copyb(r11, 0) -> 8[a + 72]
	copyb(r11, 0) -> 8[a + 80]
	copyb(r11, 0) -> 8[a + 88]
	copyb(r11, 0) -> 8[a + 96]
	copyb(r11, 0) -> 8[a + 104]
	copyb(r11, 0) -> 8[a + 112]
	copyb(r11, 0) -> 8[a + 120]
	pop r1
	ret
dct_dbl:
	copyb(0, DC_P) -> r10
	copyb(r10, 8[a + 0]) -> r10
	copyb(0, DC_PR) -> r11
	copyb(r11, 8[a + 0]) -> r11
	call zisklib_dbl_twist_bn254
	pop r1
	ret

; void zisklib_scalar_mul_by_x_complete_twist_bn254(const u64* p, u64* result)  [16,16]
zisklib_scalar_mul_by_x_complete_twist_bn254:
	push r1
	copyb(0, SMX_P) -> r5
	copyb(r5, r10) -> 8[a + 0]
	copyb(0, SMX_PRSLOT) -> r5
	copyb(r5, r11) -> 8[a + 0]
	copyb(0, SMX_P) -> r10
	copyb(r10, 8[a + 0]) -> r10
	copyb(0, BN_G2_IDENTITY) -> r11
	copyb(0, 16) -> r12
	call bn254_eqn
	eq(r10, 0), j(smx_run)
	copyb(0, SMX_PRSLOT) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(r11, 0) -> 8[a + 0]
	copyb(r11, 0) -> 8[a + 8]
	copyb(r11, 0) -> 8[a + 16]
	copyb(r11, 0) -> 8[a + 24]
	copyb(r11, 0) -> 8[a + 32]
	copyb(r11, 0) -> 8[a + 40]
	copyb(r11, 0) -> 8[a + 48]
	copyb(r11, 0) -> 8[a + 56]
	copyb(r11, 0) -> 8[a + 64]
	copyb(r11, 0) -> 8[a + 72]
	copyb(r11, 0) -> 8[a + 80]
	copyb(r11, 0) -> 8[a + 88]
	copyb(r11, 0) -> 8[a + 96]
	copyb(r11, 0) -> 8[a + 104]
	copyb(r11, 0) -> 8[a + 112]
	copyb(r11, 0) -> 8[a + 120]
	pop r1
	ret
smx_run:
	copyb(0, SMX_P) -> r10
	copyb(r10, 8[a + 0]) -> r10
	copyb(0, SMX_R) -> r11
	copyb(0, 16) -> r12
	call bn254_memcpy
	copyb(0, 1) -> r13
smx_loop:
	eq(r13, 63), j(smx_done)
	copyb(0, SMX_R) -> r10
	copyb(0, SMX_RR) -> r11
	call zisklib_dbl_complete_twist_bn254
	copyb(0, SMX_RR) -> r10
	copyb(0, SMX_R) -> r11
	copyb(0, 16) -> r12
	call bn254_memcpy
	copyb(0, BN_X_BIN_BE) -> r5
	sll(r13, 3) -> r6
	add(r5, r6) -> r5
	copyb(r5, 1[a + 0]) -> r6
	eq(r6, 0), j(smx_next)
	copyb(0, SMX_R) -> r10
	copyb(0, SMX_P) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(0, SMX_RR) -> r12
	call zisklib_add_complete_twist_bn254
	copyb(0, SMX_RR) -> r10
	copyb(0, SMX_R) -> r11
	copyb(0, 16) -> r12
	call bn254_memcpy
smx_next:
	add(r13, 1) -> r13
	jump(smx_loop)
smx_done:
	copyb(0, SMX_R) -> r10
	copyb(0, SMX_PRSLOT) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(0, 16) -> r12
	call bn254_memcpy
