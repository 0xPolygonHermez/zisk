	call zisklib_dbl_fp2_bn254
	copyb(0, TW_L) -> r10
	copyb(0, TW_L) -> r11
	call zisklib_inv_fp2_bn254
	copyb(0, TW_L) -> r10
	copyb(0, BN_E_B) -> r11
	copyb(0, TW_L) -> r12
	call zisklib_scalar_mul_fp2_bn254
	copyb(0, TW_L) -> r10
	copyb(0, TW_X1) -> r11
	copyb(0, TW_L) -> r12
	call zisklib_mul_fp2_bn254
	copyb(0, TW_L) -> r10
	copyb(0, TW_X1) -> r11
	copyb(0, TW_L) -> r12
	call zisklib_mul_fp2_bn254
	copyb(0, TW_L) -> r10
	copyb(0, TW_X3) -> r11
	call zisklib_square_fp2_bn254
	copyb(0, TW_X3) -> r10
	copyb(0, TW_X1) -> r11
	copyb(0, TW_X3) -> r12
	call zisklib_sub_fp2_bn254
	copyb(0, TW_X3) -> r10
	copyb(0, TW_X1) -> r11
	copyb(0, TW_X3) -> r12
	call zisklib_sub_fp2_bn254
	copyb(0, TW_X1) -> r10
	copyb(0, TW_X3) -> r11
	copyb(0, TW_Y3) -> r12
	call zisklib_sub_fp2_bn254
	copyb(0, TW_L) -> r10
	copyb(0, TW_Y3) -> r11
	copyb(0, TW_T2) -> r12
	call zisklib_mul_fp2_bn254
	copyb(0, TW_T2) -> r10
	copyb(0, TW_Y1) -> r11
	copyb(0, TW_Y3) -> r12
	call zisklib_sub_fp2_bn254
	copyb(0, TW_X3) -> r10
	copyb(0, TW_PR) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(0, 8) -> r12
	call bn254_memcpy
	copyb(0, TW_Y3) -> r10
	copyb(0, TW_PR) -> r11
	copyb(r11, 8[a + 0]) -> r11
	add(r11, 64) -> r11
	copyb(0, 8) -> r12
	call bn254_memcpy
	pop r1
	ret

; void zisklib_add_twist_bn254(const u64* p1, const u64* p2, u64* result)  [16,16,16]
zisklib_add_twist_bn254:
	push r1
	copyb(0, TW_P1) -> r5
	copyb(r5, r10) -> 8[a + 0]
	copyb(0, TW_P2) -> r5
	copyb(r5, r11) -> 8[a + 0]
	copyb(0, TW_PR) -> r5
	copyb(r5, r12) -> 8[a + 0]
	copyb(0, TW_P1) -> r10
	copyb(r10, 8[a + 0]) -> r10
	copyb(0, TW_P2) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(0, 8) -> r12
	call bn254_eqn
	eq(r10, 0), j(twadd_generic)
	copyb(0, TW_P1) -> r10
	copyb(r10, 8[a + 0]) -> r10
	add(r10, 64) -> r10
	copyb(0, TW_P2) -> r11
	copyb(r11, 8[a + 0]) -> r11
	add(r11, 64) -> r11
	copyb(0, 8) -> r12
	call bn254_eqn
	eq(r10, 0), j(twadd_inf)
	copyb(0, TW_P1) -> r10
	copyb(r10, 8[a + 0]) -> r10
	copyb(0, TW_PR) -> r11
	copyb(r11, 8[a + 0]) -> r11
	call zisklib_dbl_twist_bn254
	pop r1
	ret
twadd_inf:
	copyb(0, TW_PR) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(r11, 0) -> 8[a + 0]
	copyb(r11, 0) -> 8[a + 8]
	copyb(r11, 0) -> 8[a + 16]
	copyb(r11, 0) -> 8[a + 24]
	copyb(r11, 0) -> 8[a + 32]
	copyb(r11, 0) -> 8[a + 40]
	copyb(r11, 0) -> 8[a + 48]
	copyb(r11, 0) -> 8[a + 56]
	copyb(r11, 0) -> 8[a + 64]
	copyb(r11, 0) -> 8[a + 72]
	copyb(r11, 0) -> 8[a + 80]
	copyb(r11, 0) -> 8[a + 88]
	copyb(r11, 0) -> 8[a + 96]
	copyb(r11, 0) -> 8[a + 104]
	copyb(r11, 0) -> 8[a + 112]
	copyb(r11, 0) -> 8[a + 120]
	pop r1
	ret
twadd_generic:
	copyb(0, TW_P1) -> r10
	copyb(r10, 8[a + 0]) -> r10
	copyb(0, TW_X1) -> r11
	copyb(0, 8) -> r12
	call bn254_memcpy
	copyb(0, TW_P1) -> r10
	copyb(r10, 8[a + 0]) -> r10
	add(r10, 64) -> r10
	copyb(0, TW_Y1) -> r11
	copyb(0, 8) -> r12
	call bn254_memcpy
	copyb(0, TW_P2) -> r10
	copyb(r10, 8[a + 0]) -> r10
	copyb(0, TW_X2) -> r11
	copyb(0, 8) -> r12
	call bn254_memcpy
	copyb(0, TW_P2) -> r10
	copyb(r10, 8[a + 0]) -> r10
	add(r10, 64) -> r10
	copyb(0, TW_Y2) -> r11
	copyb(0, 8) -> r12
	call bn254_memcpy
	copyb(0, TW_X2) -> r10
	copyb(0, TW_X1) -> r11
	copyb(0, TW_DEN) -> r12
	call zisklib_sub_fp2_bn254
	copyb(0, TW_DEN) -> r10
	copyb(0, TW_DEN) -> r11
	call zisklib_inv_fp2_bn254
	copyb(0, TW_Y2) -> r10
	copyb(0, TW_Y1) -> r11
	copyb(0, TW_L) -> r12
	call zisklib_sub_fp2_bn254
	copyb(0, TW_L) -> r10
	copyb(0, TW_DEN) -> r11
	copyb(0, TW_L) -> r12
	call zisklib_mul_fp2_bn254
	copyb(0, TW_L) -> r10
	copyb(0, TW_X3) -> r11
	call zisklib_square_fp2_bn254
	copyb(0, TW_X3) -> r10
	copyb(0, TW_X1) -> r11
	copyb(0, TW_X3) -> r12
	call zisklib_sub_fp2_bn254
	copyb(0, TW_X3) -> r10
	copyb(0, TW_X2) -> r11
	copyb(0, TW_X3) -> r12
	call zisklib_sub_fp2_bn254
	copyb(0, TW_X1) -> r10
	copyb(0, TW_X3) -> r11
	copyb(0, TW_Y3) -> r12
	call zisklib_sub_fp2_bn254
	copyb(0, TW_L) -> r10
	copyb(0, TW_Y3) -> r11
	copyb(0, TW_T2) -> r12
	call zisklib_mul_fp2_bn254
	copyb(0, TW_T2) -> r10
	copyb(0, TW_Y1) -> r11
	copyb(0, TW_Y3) -> r12
	call zisklib_sub_fp2_bn254
	copyb(0, TW_X3) -> r10
	copyb(0, TW_PR) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(0, 8) -> r12
	call bn254_memcpy
	copyb(0, TW_Y3) -> r10
	copyb(0, TW_PR) -> r11
	copyb(r11, 8[a + 0]) -> r11
	add(r11, 64) -> r11
