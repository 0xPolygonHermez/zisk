; ============================================================================
; secp256k1/glv.zisk - GLV-endomorphism-accelerated scalar multiplication.
; Mirrors ziskos/entrypoint/src/zisklib/lib/secp256k1/glv.rs. The endomorphism
; phi(x,y) = (beta*x, y) satisfies phi(P) = lambda*P, so k*P decomposes as
; k1*P1 + k2*phi-adjusted with k1,k2 < 2^128 (glv_decompose, already verified),
; halving the doublings via an interleaved Strauss-Shamir loop.
;
; glv_double_scalar_mul_with_g computes k1*G + k2*p as
; glv_scalar_mul(k1,G) + glv_scalar_mul(k2,p) (each ~128 doublings) -- a 2x
; speedup over the plain double_scalar_mul. The full 4-way interleave (ziskos'
; 11-precompute Strauss-Shamir, ~4x) is a further optimization left for later.
;
; Internal labels: `gsm_` (glv_scalar_mul), `gd_` (glv_double).
; ============================================================================

u64 SECP_GLV_K1[4]     = 0, 0, 0, 0
u64 SECP_GLV_K2[4]     = 0, 0, 0, 0
u64 SECP_GLV_SIG[1]    = 0
u64 SECP_GLV_P1[8]     = 0, 0, 0, 0, 0, 0, 0, 0
u64 SECP_GLV_P2[8]     = 0, 0, 0, 0, 0, 0, 0, 0
u64 SECP_GLV_T[8]      = 0, 0, 0, 0, 0, 0, 0, 0
u64 SECP_GLV_TINF[1]   = 0
u64 SECP_GLV_RES[8]    = 0, 0, 0, 0, 0, 0, 0, 0
u64 SECP_GLV_HDR[2]    = 0, 0
u64 SECP_GLV_PPTR[1]   = 0
u64 SECP_GLV_RESPTR[1] = 0
u64 SECP_GLV_PTPTR[1]  = 0

; u64 zisklib_glv_scalar_mul_secp256k1(const u64* k, const u64* p, u64* result)
;   [r10=k, r11=p, r12=result] -> r10 = 1 if k*p is infinity, else 0 (result=k*p).
;   p must be on-curve, non-identity, canonical. Uses the GLV endomorphism.
zisklib_glv_scalar_mul_secp256k1:
	push r1
	copyb(0, SECP_GLV_PPTR) -> r5
	copyb(r5, r11) -> 8[a + 0]
	copyb(0, SECP_GLV_RESPTR) -> r5
	copyb(r5, r12) -> 8[a + 0]
	; (k1, k2, sig) = glv_decompose(k)
	copyb(0, SECP_GLV_K1) -> r11
	copyb(0, SECP_GLV_K2) -> r12
	call zisklib_glv_decompose_fn_secp256k1
	copyb(0, SECP_GLV_SIG) -> r5
	copyb(r5, r10) -> 8[a + 0]

	; --- P1.x = p.x ---
	copyb(0, SECP_GLV_PPTR) -> r5
	copyb(r5, 8[a + 0]) -> r5
	copyb(0, SECP_GLV_P1) -> r6
	copyb(0, 4) -> r7
gsm_p1x:
	eq(r7, 0), j(gsm_p1y)
	copyb(r5, 8[a + 0]) -> r14
	copyb(r6, r14) -> 8[a + 0]
	add(r5, 8) -> r5
	add(r6, 8) -> r6
	sub(r7, 1) -> r7
	jump(gsm_p1x)
gsm_p1y:
	; P1.y = sig1 ? -p.y : p.y
	copyb(0, SECP_GLV_SIG) -> r5
	copyb(r5, 8[a + 0]) -> r6
	and(r6, 1) -> r6
	eq(r6, 0), j(gsm_p1y_cp)
	copyb(0, SECP_GLV_PPTR) -> r5
	copyb(r5, 8[a + 0]) -> r10
	add(r10, 32) -> r10
	copyb(0, SECP_GLV_P1) -> r11
	add(r11, 32) -> r11
	call zisklib_neg_fp_secp256k1
	jump(gsm_phi)
gsm_p1y_cp:
	copyb(0, SECP_GLV_PPTR) -> r5
	copyb(r5, 8[a + 0]) -> r5
	add(r5, 32) -> r5
	copyb(0, SECP_GLV_P1) -> r6
	add(r6, 32) -> r6
	copyb(0, 4) -> r7
gsm_p1yl:
	eq(r7, 0), j(gsm_phi)
	copyb(r5, 8[a + 0]) -> r14
	copyb(r6, r14) -> 8[a + 0]
	add(r5, 8) -> r5
	add(r6, 8) -> r6
	sub(r7, 1) -> r7
	jump(gsm_p1yl)
gsm_phi:
	; P2.x = beta * p.x (mod P)
	copyb(0, SECP_BETA) -> r10
	copyb(0, SECP_GLV_PPTR) -> r5
	copyb(r5, 8[a + 0]) -> r11
	copyb(0, SECP_GLV_P2) -> r12
	call zisklib_mul_fp_secp256k1
	; P2.y = sig2 ? -p.y : p.y
	copyb(0, SECP_GLV_SIG) -> r5
	copyb(r5, 8[a + 0]) -> r6
	srl(r6, 1) -> r6
	and(r6, 1) -> r6
	eq(r6, 0), j(gsm_p2y_cp)
	copyb(0, SECP_GLV_PPTR) -> r5
	copyb(r5, 8[a + 0]) -> r10
	add(r10, 32) -> r10
	copyb(0, SECP_GLV_P2) -> r11
	add(r11, 32) -> r11
	call zisklib_neg_fp_secp256k1
	jump(gsm_t)
gsm_p2y_cp:
	copyb(0, SECP_GLV_PPTR) -> r5
	copyb(r5, 8[a + 0]) -> r5
	add(r5, 32) -> r5
	copyb(0, SECP_GLV_P2) -> r6
	add(r6, 32) -> r6
	copyb(0, 4) -> r7
gsm_p2yl:
	eq(r7, 0), j(gsm_t)
	copyb(r5, 8[a + 0]) -> r14
	copyb(r6, r14) -> 8[a + 0]
	add(r5, 8) -> r5
	add(r6, 8) -> r6
	sub(r7, 1) -> r7
	jump(gsm_p2yl)
gsm_t:
	; T = P1 + P2 ; t_inf
	copyb(0, SECP_GLV_P1) -> r10
	copyb(0, SECP_GLV_P2) -> r11
	copyb(0, SECP_GLV_T) -> r12
	call zisklib_point_add_secp256k1
	copyb(0, SECP_GLV_TINF) -> r5
	copyb(r5, r10) -> 8[a + 0]

	; --- interleaved Strauss-Shamir: p_idx = 127..0, res_is_inf in r13 ---
	copyb(0, 127) -> r15
	copyb(0, 1) -> r13                 ; res_is_inf = 1
gsm_iter:
	eq(r13, 0), j(gsm_dbl)
	jump(gsm_bits)
gsm_dbl:
	copyb(0, SECP_GLV_RES) -> r5
	secp256k1_dbl(0, r5)
gsm_bits:
	; b1 = bit_p(K1) -> r5 ; b2 = bit_p(K2) -> r6
	srl(r15, 6) -> r7
	sll(r7, 3) -> r7                   ; word byte offset (0 or 8)
	copyb(0, SECP_GLV_K1) -> r5
	add(r5, r7) -> r5
	copyb(r5, 8[a + 0]) -> r5
	and(r15, 63) -> r14
	srl(r5, r14) -> r5
	and(r5, 1) -> r5                   ; b1
	copyb(0, SECP_GLV_K2) -> r6
	add(r6, r7) -> r6
	copyb(r6, 8[a + 0]) -> r6
	srl(r6, r14) -> r6
	and(r6, 1) -> r6                   ; b2
	; select point into r6 (as a pointer); no add if both zero
	eq(r5, 0), j(gsm_b1z)
	eq(r6, 0), j(gsm_useP1)            ; b1=1, b2=0 -> P1
	; b1=1, b2=1 -> T (unless T is infinity)
	copyb(0, SECP_GLV_TINF) -> r6
	copyb(r6, 8[a + 0]) -> r6
	ltu(0, r6), j(gsm_next)            ; T infinity -> add nothing
	copyb(0, SECP_GLV_T) -> r6
	jump(gsm_addpt)
gsm_useP1:
	copyb(0, SECP_GLV_P1) -> r6
	jump(gsm_addpt)
gsm_b1z:
	eq(r6, 0), j(gsm_next)             ; b1=0, b2=0 -> no add
	copyb(0, SECP_GLV_P2) -> r6        ; b1=0, b2=1 -> P2
gsm_addpt:
	; save the selected point's base pointer, then add it to res
	copyb(0, SECP_GLV_PTPTR) -> r5
	copyb(r5, r6) -> 8[a + 0]
	eq(r13, 0), j(gsm_addni)
	; res is infinity -> res = pt
	copyb(0, SECP_GLV_PTPTR) -> r5
	copyb(r5, 8[a + 0]) -> r5
	copyb(0, SECP_GLV_RES) -> r6
	copyb(0, 8) -> r7
gsm_setpt:
	eq(r7, 0), j(gsm_set0)
	copyb(r5, 8[a + 0]) -> r14
	copyb(r6, r14) -> 8[a + 0]
	add(r5, 8) -> r5
	add(r6, 8) -> r6
	sub(r7, 1) -> r7
	jump(gsm_setpt)
gsm_set0:
	copyb(0, 0) -> r13
	jump(gsm_next)
gsm_addni:
	; add_non_infinity(res, pt): compare res.x vs pt.x (fresh walking pointers)
	copyb(0, SECP_GLV_RES) -> r5
	copyb(0, SECP_GLV_PTPTR) -> r6
	copyb(r6, 8[a + 0]) -> r6
	copyb(0, 4) -> r7
gsm_xl:
	eq(r7, 0), j(gsm_ycmp)
	copyb(r5, 8[a + 0]) -> r14
	copyb(r6, 8[a + 0]) -> r28
	eq(r14, r28), j(gsm_xn)
	jump(gsm_doadd)
gsm_xn:
	add(r5, 8) -> r5
	add(r6, 8) -> r6
	sub(r7, 1) -> r7
	jump(gsm_xl)
gsm_ycmp:
	copyb(0, SECP_GLV_RES) -> r5
	add(r5, 32) -> r5
	copyb(0, SECP_GLV_PTPTR) -> r6
	copyb(r6, 8[a + 0]) -> r6
	add(r6, 32) -> r6
	copyb(0, 4) -> r7
gsm_yl:
	eq(r7, 0), j(gsm_dodbl)
	copyb(r5, 8[a + 0]) -> r14
	copyb(r6, 8[a + 0]) -> r28
	eq(r14, r28), j(gsm_yn)
	copyb(0, 1) -> r13                 ; res == -pt -> infinity
	jump(gsm_next)
gsm_yn:
	add(r5, 8) -> r5
	add(r6, 8) -> r6
	sub(r7, 1) -> r7
	jump(gsm_yl)
gsm_doadd:
	copyb(0, SECP_GLV_HDR) -> r5
	copyb(0, SECP_GLV_RES) -> r6
	copyb(r5, r6) -> 8[a + 0]          ; &res
	copyb(0, SECP_GLV_PTPTR) -> r6
	copyb(r6, 8[a + 0]) -> r6
	copyb(r5, r6) -> 8[a + 8]          ; &pt
	secp256k1_add(0, r5)
	jump(gsm_next)
gsm_dodbl:
	copyb(0, SECP_GLV_RES) -> r5
	secp256k1_dbl(0, r5)
gsm_next:
	eq(r15, 0), j(gsm_finish)
	sub(r15, 1) -> r15
	jump(gsm_iter)
gsm_finish:
	eq(r13, 0), j(gsm_store)
	copyb(0, 1) -> r10
	pop r1
	ret
gsm_store:
	copyb(0, SECP_GLV_RES) -> r5
	copyb(0, SECP_GLV_RESPTR) -> r6
	copyb(r6, 8[a + 0]) -> r6
	copyb(0, 8) -> r7
gsm_st:
	eq(r7, 0), j(gsm_ret0)
	copyb(r5, 8[a + 0]) -> r14
	copyb(r6, r14) -> 8[a + 0]
	add(r5, 8) -> r5
	add(r6, 8) -> r6
	sub(r7, 1) -> r7
	jump(gsm_st)
gsm_ret0:
	copyb(0, 0) -> r10
	pop r1
	ret

u64 SECP_GLD_A[8]    = 0, 0, 0, 0, 0, 0, 0, 0
u64 SECP_GLD_B[8]    = 0, 0, 0, 0, 0, 0, 0, 0
u64 SECP_GLD_K2[1]   = 0
u64 SECP_GLD_P[1]    = 0
u64 SECP_GLD_RES[1]  = 0
u64 SECP_GLD_AINF[1] = 0
u64 SECP_GLD_BINF[1] = 0

; u64 zisklib_glv_double_scalar_mul_with_g_secp256k1(const u64* k1, const u64* k2,
;                                                    const u64* p, u64* result)
;   [r10=k1, r11=k2, r12=p, r13=result] -> r10 = 1 if k1*G + k2*p is infinity,
;   else 0. GLV-accelerated: A = glv_scalar_mul(k1, G), B = glv_scalar_mul(k2, p),
;   then combine (each half via the endomorphism -> ~128 doublings). Labels `gd_`.
zisklib_glv_double_scalar_mul_with_g_secp256k1:
	push r1
	copyb(0, SECP_GLD_K2) -> r5
	copyb(r5, r11) -> 8[a + 0]
	copyb(0, SECP_GLD_P) -> r5
	copyb(r5, r12) -> 8[a + 0]
	copyb(0, SECP_GLD_RES) -> r5
	copyb(r5, r13) -> 8[a + 0]
	; A = glv_scalar_mul(k1, G)
	copyb(0, SECP_G_X) -> r11
	copyb(0, SECP_GLD_A) -> r12
	call zisklib_glv_scalar_mul_secp256k1
	copyb(0, SECP_GLD_AINF) -> r5
	copyb(r5, r10) -> 8[a + 0]
	; B = glv_scalar_mul(k2, p)
	copyb(0, SECP_GLD_K2) -> r5
	copyb(r5, 8[a + 0]) -> r10
	copyb(0, SECP_GLD_P) -> r5
	copyb(r5, 8[a + 0]) -> r11
	copyb(0, SECP_GLD_B) -> r12
	call zisklib_glv_scalar_mul_secp256k1
	copyb(0, SECP_GLD_BINF) -> r5
	copyb(r5, r10) -> 8[a + 0]
	; combine
	copyb(0, SECP_GLD_AINF) -> r5
	copyb(r5, 8[a + 0]) -> r6
	copyb(0, SECP_GLD_BINF) -> r5
	copyb(r5, 8[a + 0]) -> r7
	eq(r6, 0), j(gd_afin)
	eq(r7, 0), j(gd_copyB)
	copyb(0, 1) -> r10
	pop r1
	ret
gd_copyB:
	copyb(0, SECP_GLD_B) -> r5
	copyb(0, SECP_GLD_RES) -> r6
	copyb(r6, 8[a + 0]) -> r6
	copyb(0, 8) -> r7
gd_cB:
	eq(r7, 0), j(gd_fin0)
	copyb(r5, 8[a + 0]) -> r14
	copyb(r6, r14) -> 8[a + 0]
	add(r5, 8) -> r5
	add(r6, 8) -> r6
	sub(r7, 1) -> r7
	jump(gd_cB)
gd_afin:
	eq(r7, 0), j(gd_add)
	copyb(0, SECP_GLD_A) -> r5
	copyb(0, SECP_GLD_RES) -> r6
	copyb(r6, 8[a + 0]) -> r6
	copyb(0, 8) -> r7
gd_cA:
	eq(r7, 0), j(gd_fin0)
	copyb(r5, 8[a + 0]) -> r14
	copyb(r6, r14) -> 8[a + 0]
	add(r5, 8) -> r5
	add(r6, 8) -> r6
	sub(r7, 1) -> r7
	jump(gd_cA)
gd_fin0:
	copyb(0, 0) -> r10
	pop r1
	ret
gd_add:
	copyb(0, SECP_GLD_A) -> r10
	copyb(0, SECP_GLD_B) -> r11
	copyb(0, SECP_GLD_RES) -> r5
	copyb(r5, 8[a + 0]) -> r12
	call zisklib_point_add_secp256k1
	pop r1
	ret
