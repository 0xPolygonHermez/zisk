	eq(c, [SECP_G4_RES]), j(g4_s6)
	secp256k1_add(0, SECP_G4_HDR)
g4_b7:
	secp256k1_dbl(0, SECP_G4_RES)
	srl(r5, 54)
	and(c, 0x3C0) -> r6
	sll(r5, 4) -> r5
	eq(r6, 0), j(g4_b8)
	add(r6, SECP_G4_T) -> [SECP_G4_HDR + 8]
	copyb(c, 8[a + 0])
	eq(c, [SECP_G4_RES]), j(g4_s7)
	secp256k1_add(0, SECP_G4_HDR)
g4_b8:
	secp256k1_dbl(0, SECP_G4_RES)
	srl(r5, 54)
	and(c, 0x3C0) -> r6
	sll(r5, 4) -> r5
	eq(r6, 0), j(g4_b9)
	add(r6, SECP_G4_T) -> [SECP_G4_HDR + 8]
	copyb(c, 8[a + 0])
	eq(c, [SECP_G4_RES]), j(g4_s8)
	secp256k1_add(0, SECP_G4_HDR)
g4_b9:
	secp256k1_dbl(0, SECP_G4_RES)
	srl(r5, 54)
	and(c, 0x3C0) -> r6
	sll(r5, 4) -> r5
	eq(r6, 0), j(g4_b10)
	add(r6, SECP_G4_T) -> [SECP_G4_HDR + 8]
	copyb(c, 8[a + 0])
	eq(c, [SECP_G4_RES]), j(g4_s9)
	secp256k1_add(0, SECP_G4_HDR)
g4_b10:
	secp256k1_dbl(0, SECP_G4_RES)
	srl(r5, 54)
	and(c, 0x3C0) -> r6
	sll(r5, 4) -> r5
	eq(r6, 0), j(g4_b11)
	add(r6, SECP_G4_T) -> [SECP_G4_HDR + 8]
	copyb(c, 8[a + 0])
	eq(c, [SECP_G4_RES]), j(g4_s10)
	secp256k1_add(0, SECP_G4_HDR)
g4_b11:
	secp256k1_dbl(0, SECP_G4_RES)
	srl(r5, 54)
	and(c, 0x3C0) -> r6
	sll(r5, 4) -> r5
	eq(r6, 0), j(g4_b12)
	add(r6, SECP_G4_T) -> [SECP_G4_HDR + 8]
	copyb(c, 8[a + 0])
	eq(c, [SECP_G4_RES]), j(g4_s11)
	secp256k1_add(0, SECP_G4_HDR)
g4_b12:
	secp256k1_dbl(0, SECP_G4_RES)
	srl(r5, 54)
	and(c, 0x3C0) -> r6
	sll(r5, 4) -> r5
	eq(r6, 0), j(g4_b13)
	add(r6, SECP_G4_T) -> [SECP_G4_HDR + 8]
	copyb(c, 8[a + 0])
	eq(c, [SECP_G4_RES]), j(g4_s12)
	secp256k1_add(0, SECP_G4_HDR)
g4_b13:
	secp256k1_dbl(0, SECP_G4_RES)
	srl(r5, 54)
	and(c, 0x3C0) -> r6
	sll(r5, 4) -> r5
	eq(r6, 0), j(g4_b14)
	add(r6, SECP_G4_T) -> [SECP_G4_HDR + 8]
	copyb(c, 8[a + 0])
	eq(c, [SECP_G4_RES]), j(g4_s13)
	secp256k1_add(0, SECP_G4_HDR)
g4_b14:
	secp256k1_dbl(0, SECP_G4_RES)
	srl(r5, 54)
	and(c, 0x3C0) -> r6
	sll(r5, 4) -> r5
	eq(r6, 0), j(g4_b15)
	add(r6, SECP_G4_T) -> [SECP_G4_HDR + 8]
	copyb(c, 8[a + 0])
	eq(c, [SECP_G4_RES]), j(g4_s14)
	secp256k1_add(0, SECP_G4_HDR)
g4_b15:
	secp256k1_dbl(0, SECP_G4_RES)
	srl(r5, 54)
	and(c, 0x3C0) -> r6
	sll(r5, 4) -> r5
	eq(r6, 0), j(g4_b16)
	add(r6, SECP_G4_T) -> [SECP_G4_HDR + 8]
	copyb(c, 8[a + 0])
	eq(c, [SECP_G4_RES]), j(g4_s15)
	secp256k1_add(0, SECP_G4_HDR)
g4_b16:
	eq(r7, SECP_G4_NIB), j(g4_done)
	sub(r7, 8) -> r7
	copyb(r7, 8[a + 0]) -> r5
	jump(g4_b0)
g4_s0:
	call secp_g4_slow_add
	eq(r10, 0), j(g4_b1, g4_a1)
g4_s1:
	call secp_g4_slow_add
	eq(r10, 0), j(g4_b2, g4_a2)
g4_s2:
	call secp_g4_slow_add
	eq(r10, 0), j(g4_b3, g4_a3)
g4_s3:
	call secp_g4_slow_add
	eq(r10, 0), j(g4_b4, g4_a4)
g4_s4:
	call secp_g4_slow_add
	eq(r10, 0), j(g4_b5, g4_a5)
g4_s5:
	call secp_g4_slow_add
	eq(r10, 0), j(g4_b6, g4_a6)
g4_s6:
	call secp_g4_slow_add
	eq(r10, 0), j(g4_b7, g4_a7)
g4_s7:
	call secp_g4_slow_add
	eq(r10, 0), j(g4_b8, g4_a8)
g4_s8:
	call secp_g4_slow_add
	eq(r10, 0), j(g4_b9, g4_a9)
g4_s9:
	call secp_g4_slow_add
	eq(r10, 0), j(g4_b10, g4_a10)
g4_s10:
	call secp_g4_slow_add
	eq(r10, 0), j(g4_b11, g4_a11)
g4_s11:
	call secp_g4_slow_add
	eq(r10, 0), j(g4_b12, g4_a12)
g4_s12:
	call secp_g4_slow_add
	eq(r10, 0), j(g4_b13, g4_a13)
g4_s13:
	call secp_g4_slow_add
	eq(r10, 0), j(g4_b14, g4_a14)
g4_s14:
	call secp_g4_slow_add
	eq(r10, 0), j(g4_b15, g4_a15)
g4_s15:
	call secp_g4_slow_add
	eq(r10, 0), j(g4_b16, g4_a16)
g4_done:
	copyb(0, [SECP_G4_ARGS + 24]) -> r5
	dma_xmemcpy(r5, SECP_G4_RES) -> r6, j(64, 4)
	copyb(0, 0) -> r10
	pop r1
	ret
g4_inf:
	copyb(0, 1) -> r10
	pop r1
	ret
g4_general:
	copyb(0, [SECP_G4_ARGS + 0]) -> r10
	copyb(0, [SECP_G4_ARGS + 8]) -> r11
	copyb(0, [SECP_G4_ARGS + 16]) -> r12
	copyb(0, [SECP_G4_ARGS + 24]) -> r13
	pop r1
	jump(secp_glv_dsm_general)

; secp_g4_slow_add [leaf]: RES += T (T = [SECP_G4_HDR + 8]) when x limb 0 matched.
;   Different x: add. Same point: double. Opposite points: r10 = 1 (infinity).
;   Else r10 = 0. Uses r10, r11.
secp_g4_slow_add:
	copyb(0, [SECP_G4_HDR + 8]) -> r11
	copyb(r11, 8[a + 8])
	eq(c, [SECP_G4_RES + 8]), j(g4_sx1)
	jump(g4_sadd)
g4_sx1:
	copyb(r11, 8[a + 16])
	eq(c, [SECP_G4_RES + 16]), j(g4_sx2)
	jump(g4_sadd)
g4_sx2:
	copyb(r11, 8[a + 24])
	eq(c, [SECP_G4_RES + 24]), j(g4_sx3)
	jump(g4_sadd)
g4_sx3:
	copyb(r11, 8[a + 32])
	eq(c, [SECP_G4_RES + 32]), j(g4_sy0)
	copyb(0, 1) -> r10
	ret
g4_sy0:
	copyb(r11, 8[a + 40])
	eq(c, [SECP_G4_RES + 40]), j(g4_sy1)
	copyb(0, 1) -> r10
	ret
g4_sy1:
	copyb(r11, 8[a + 48])
	eq(c, [SECP_G4_RES + 48]), j(g4_sy2)
	copyb(0, 1) -> r10
	ret
g4_sy2:
	copyb(r11, 8[a + 56])
	eq(c, [SECP_G4_RES + 56]), j(g4_sy3)
	copyb(0, 1) -> r10
	ret
g4_sy3:
	secp256k1_dbl(0, SECP_G4_RES)
	copyb(0, 0) -> r10
	ret
g4_sadd:
	secp256k1_add(0, SECP_G4_HDR)
	copyb(0, 0) -> r10
	ret
