zisklib_glv_double_scalar_mul_with_g_secp256k1:
	push r1
	copyb(0, r10) -> [SECP_G4_ARGS + 0]
	copyb(0, r11) -> [SECP_G4_ARGS + 8]
	copyb(0, r12) -> [SECP_G4_ARGS + 16]
	copyb(0, r13) -> [SECP_G4_ARGS + 24]
	; (a1, a2, sa) = glv_decompose(k1); (b1, b2, sb) = glv_decompose(k2)
	copyb(0, SECP_G4_SC + 0) -> r11
	copyb(0, SECP_G4_SC + 32) -> r12
	call zisklib_glv_decompose_fn_secp256k1
	copyb(0, r10) -> [SECP_G4_SIG + 0]
	copyb(0, [SECP_G4_ARGS + 8]) -> r10
	copyb(0, SECP_G4_SC + 64) -> r11
	copyb(0, SECP_G4_SC + 96) -> r12
	call zisklib_glv_decompose_fn_secp256k1
	copyb(0, r10) -> [SECP_G4_SIG + 8]

	; ---- T[1..3] = the constant block for (sa & 1, sa >> 1) ----
	copyb(0, [SECP_G4_SIG + 0]) -> r5
	sll(r5, 6) -> r6
	sll(r5, 7)
	add(c, r6)
	add(c, SECP_G4_CG)
	dma_xmemcpy(SECP_G4_T + 64, c) -> r6, j(192, 4)
	; ---- T[4] = sb & 1 ? -p : p ----
	copyb(0, [SECP_G4_ARGS + 16]) -> r5
	dma_xmemcpy(SECP_G4_T + 256, r5) -> r6, j(64, 4)
	copyb(0, [SECP_G4_SIG + 8])
	and(c, 1)
	eq(c, 0), j(g4_t4pos)
	add(r5, 32) -> r10
	copyb(0, SECP_G4_T + 288) -> r11
	call zisklib_neg_fp_secp256k1
g4_t4pos:
	; ---- T[8] = (beta * p.x, sb & 2 ? -p.y : p.y) ----
	copyb(0, SECP_BETA) -> r10
	copyb(0, [SECP_G4_ARGS + 16]) -> r11
	copyb(0, SECP_G4_T + 512) -> r12
	call zisklib_mul_fp_secp256k1
	copyb(0, [SECP_G4_ARGS + 16]) -> r10
	add(r10, 32) -> r10
	copyb(0, [SECP_G4_SIG + 8])
	and(c, 2)
	eq(c, 0), j(g4_t8pos)
	copyb(0, SECP_G4_T + 544) -> r11
	call zisklib_neg_fp_secp256k1
	jump(g4_sums)
g4_t8pos:
	dma_xmemcpy(SECP_G4_T + 544, r10) -> r6, j(32, 4)
g4_sums:
	; ---- the other 10 entries: T[m] = T[lo] + T[hi] (x match -> general) ----
	dma_xmemcpy(SECP_G4_T + 320, SECP_G4_T + 64) -> r6, j(64, 4)
	copyb(0, [SECP_G4_T + 320])
	eq(c, [SECP_G4_T + 256]), j(g4_general)
	copyb(0, SECP_G4_T + 320) -> [SECP_G4_HDRB + 0]
	copyb(0, SECP_G4_T + 256) -> [SECP_G4_HDRB + 8]
	secp256k1_add(0, SECP_G4_HDRB)
	dma_xmemcpy(SECP_G4_T + 384, SECP_G4_T + 128) -> r6, j(64, 4)
	copyb(0, [SECP_G4_T + 384])
	eq(c, [SECP_G4_T + 256]), j(g4_general)
	copyb(0, SECP_G4_T + 384) -> [SECP_G4_HDRB + 0]
	copyb(0, SECP_G4_T + 256) -> [SECP_G4_HDRB + 8]
	secp256k1_add(0, SECP_G4_HDRB)
	dma_xmemcpy(SECP_G4_T + 448, SECP_G4_T + 192) -> r6, j(64, 4)
	copyb(0, [SECP_G4_T + 448])
	eq(c, [SECP_G4_T + 256]), j(g4_general)
	copyb(0, SECP_G4_T + 448) -> [SECP_G4_HDRB + 0]
	copyb(0, SECP_G4_T + 256) -> [SECP_G4_HDRB + 8]
	secp256k1_add(0, SECP_G4_HDRB)
	dma_xmemcpy(SECP_G4_T + 576, SECP_G4_T + 64) -> r6, j(64, 4)
	copyb(0, [SECP_G4_T + 576])
	eq(c, [SECP_G4_T + 512]), j(g4_general)
	copyb(0, SECP_G4_T + 576) -> [SECP_G4_HDRB + 0]
	copyb(0, SECP_G4_T + 512) -> [SECP_G4_HDRB + 8]
	secp256k1_add(0, SECP_G4_HDRB)
	dma_xmemcpy(SECP_G4_T + 640, SECP_G4_T + 128) -> r6, j(64, 4)
	copyb(0, [SECP_G4_T + 640])
	eq(c, [SECP_G4_T + 512]), j(g4_general)
	copyb(0, SECP_G4_T + 640) -> [SECP_G4_HDRB + 0]
	copyb(0, SECP_G4_T + 512) -> [SECP_G4_HDRB + 8]
	secp256k1_add(0, SECP_G4_HDRB)
	dma_xmemcpy(SECP_G4_T + 704, SECP_G4_T + 192) -> r6, j(64, 4)
	copyb(0, [SECP_G4_T + 704])
	eq(c, [SECP_G4_T + 512]), j(g4_general)
	copyb(0, SECP_G4_T + 704) -> [SECP_G4_HDRB + 0]
	copyb(0, SECP_G4_T + 512) -> [SECP_G4_HDRB + 8]
	secp256k1_add(0, SECP_G4_HDRB)
	dma_xmemcpy(SECP_G4_T + 768, SECP_G4_T + 256) -> r6, j(64, 4)
	copyb(0, [SECP_G4_T + 768])
	eq(c, [SECP_G4_T + 512]), j(g4_general)
	copyb(0, SECP_G4_T + 768) -> [SECP_G4_HDRB + 0]
	copyb(0, SECP_G4_T + 512) -> [SECP_G4_HDRB + 8]
	secp256k1_add(0, SECP_G4_HDRB)
	dma_xmemcpy(SECP_G4_T + 832, SECP_G4_T + 320) -> r6, j(64, 4)
	copyb(0, [SECP_G4_T + 832])
