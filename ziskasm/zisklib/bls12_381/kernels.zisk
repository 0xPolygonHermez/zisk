	add(r11, 96) -> r5
	bls12_381_complex_add(r14, r5)
	add(r10, 192) -> r5
	dma_xmemcpy(BLK_T0, r5) -> r5, j(96, 4)
	add(r10, 192) -> r5
	bls12_381_complex_mul(BLK_T0, r5)
	bls12_381_complex_mul(BLK_T0, BLK_CXI)
	bls12_381_complex_add(r14, BLK_T0)
	add(r11, 192) -> r14
	dma_xmemcpy(r14, r10) -> r5, j(96, 4)
	add(r10, 192) -> r5
	bls12_381_complex_mul(r14, r5)
	add(r11, 192) -> r5
	bls12_381_complex_add(r14, r5)
	add(r10, 96) -> r5
	dma_xmemcpy(BLK_T0, r5) -> r5, j(96, 4)
	add(r10, 96) -> r5
