; u64 zisklib_is_on_subgroup_bls12_381(const u64* p)  [r10=p] -> r10 (1/0)
zisklib_is_on_subgroup_bls12_381:
	push r1
	copyb(0, r10) -> [BLS_SGP]
	copyb(0, BLS_SGP) -> r5
	copyb(0, BLS_SG1_S1) -> r11
	call zisklib_sigma_endomorphism_bls12_381
	copyb(0, BLS_SG1_S1) -> r10
	copyb(0, BLS_SG1_S2) -> r11
	call zisklib_sigma_endomorphism_bls12_381
	copyb(0, BLS_SG1_S1) -> r10
	copyb(0, BLS_SG1_LHS) -> r11
	call zisklib_dbl_complete_bls12_381
	copyb(0, BLS_SG1_LHS) -> r10
	copyb(0, [BLS_SGP]) -> r11
	copyb(0, BLS_SG1_T) -> r12
	call zisklib_sub_complete_bls12_381
	dma_xmemcpy(BLS_SG1_LHS, BLS_SG1_T) -> r5, j(96, 4)
	copyb(0, BLS_SG1_LHS) -> r10
	copyb(0, BLS_SG1_S2) -> r11
	copyb(0, BLS_SG1_T) -> r12
	call zisklib_sub_complete_bls12_381
	dma_xmemcpy(BLS_SG1_LHS, BLS_SG1_T) -> r5, j(96, 4)
	copyb(0, BLS_SG1_LHS) -> r10
	copyb(0, BLS_SG1_T) -> r11
	copyb(0, 12) -> r12
	call zisklib_scalar_mul_by_x2div3_complete_bls12_381
	dma_xmemcmp(BLS_SG1_T, BLS_SG1_S2) -> r5, j(96, 4)
	eq(r5, 0) -> r10
	copyb(0, BLS_SG1_S2) -> r11
	copyb(0, 12) -> r12
	pop r1
	ret

; void zisklib_utf_endomorphism_twist_bls12_381(const u64* p, u64* result)  [24,24]
zisklib_utf_endomorphism_twist_bls12_381:
	push r1
	copyb(0, r11) -> [BLS_SGR]
	copyb(0, r10) -> [BLS_SGP]
	dma_xmemcpy(BLS_SG2_XA, r10) -> r5, j(96, 4)
	add(r10, 96) -> r5
	dma_xmemcpy(BLS_SG2_YA, r5) -> r5, j(96, 4)
	dma_xmemcpy(BLS_SG2_XB, BLS_SG2_XA) -> r5, j(96, 4)
	bls12_381_complex_mul(0, ZBLS_SUBGROUP_H0)
	dma_xmemcpy(BLS_SG2_YB, BLS_SG2_YA) -> r5, j(96, 4)
	bls12_381_complex_mul(0, ZBLS_SUBGROUP_H1)
	copyb(0, BLS_SG2_XB) -> r10
	copyb(0, BLS_SG2_XA) -> r11
	copyb(0, BLS_SG2_YB) -> r12
	call zisklib_conjugate_fp2_bls12_381
	dma_xmemcpy(BLS_F2_SB, BLS_FROBENIUS_GAMMA14) -> r5, j(48, 4)
	dma_xmemcpy(BLS_SG2_XB, BLS_SG2_XA) -> r5, j(96, 4)
	bls12_381_complex_mul(0, ZBLS_SUBGROUP_H2)
	copyb(0, BLS_SG2_YB) -> r10
	copyb(0, BLS_SG2_YA) -> r11
	copyb(0, BLS_SG2_XB) -> r12
	call zisklib_conjugate_fp2_bls12_381
	dma_xmemcpy(BLS_SG2_YB, BLS_SG2_YA) -> r5, j(96, 4)
	bls12_381_complex_mul(0, ZBLS_SUBGROUP_H3)
	dma_xmemcpy(BLS_SG2_XA, BLS_SG2_XB) -> r5, j(96, 4)
	bls12_381_complex_mul(0, ZBLS_SUBGROUP_H4)
	dma_xmemcpy(BLS_SG2_YA, BLS_SG2_YB) -> r5, j(96, 4)
	bls12_381_complex_mul(0, ZBLS_SUBGROUP_H5)
	copyb(0, [BLS_SGR]) -> r5
	dma_xmemcpy(r5, BLS_SG2_XA) -> r5, j(96, 4)
	add([BLS_SGR], 96) -> r5
	dma_xmemcpy(r5, BLS_SG2_YA) -> r5, j(96, 4)
	copyb(0, BLS_SG2_YA) -> r10
	add([BLS_SGR], 96) -> r11
	copyb(0, 12) -> r12
	pop r1
	ret

