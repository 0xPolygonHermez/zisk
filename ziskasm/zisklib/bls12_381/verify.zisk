	ltu([BLS_V_YR + 24], [BLS_V_YNR + 24]), j(zbls_verify_ge5)
	ltu([BLS_V_YNR + 16], [BLS_V_YR + 16]), j(zbls_verify_lt5)
	ltu([BLS_V_YR + 16], [BLS_V_YNR + 16]), j(zbls_verify_ge5)
	ltu([BLS_V_YNR + 8], [BLS_V_YR + 8]), j(zbls_verify_lt5)
	ltu([BLS_V_YR + 8], [BLS_V_YNR + 8]), j(zbls_verify_ge5)
	ltu([BLS_V_YNR], [BLS_V_YR]), j(zbls_verify_lt5)
	ltu([BLS_V_YR], [BLS_V_YNR]), j(zbls_verify_ge5)
zbls_verify_ge5:
	copyb(0, 0) -> r10
	jump(zbls_verify_le5)
zbls_verify_lt5:
	copyb(0, 1) -> r10
zbls_verify_le5:
	copyb(0, BLS_V_YR) -> r11
	copyb(0, 6) -> r12
lv_dg2_havelarge:
	copyb(0, BLS_V_YSIGN) -> r5
	copyb(0, [BLS_V_YSIGN]) -> r6
	eq(r10, r6), j(lv_dg2_usey)
	dma_xmemcpy(BLS_V_SIG, BLS_V_XF) -> r5, j(96, 4)
	dma_xmemcpy(BLS_V_SIG + 96, BLS_V_MILL) -> r5, j(96, 4)
	copyb(0, 0) -> r10
	copyb(0, BLS_V_SIG + 96) -> r11
	copyb(0, 12) -> r12
	pop r1
	ret
lv_dg2_usey:
	dma_xmemcpy(BLS_V_SIG, BLS_V_XF) -> r5, j(96, 4)
	dma_xmemcpy(BLS_V_SIG + 96, BLS_V_YF) -> r5, j(96, 4)
	copyb(0, 0) -> r10
	copyb(0, BLS_V_SIG + 96) -> r11
	copyb(0, 12) -> r12
	pop r1
	ret
lv_dg2_err:
	copyb(0, 1) -> r10
	pop r1
	ret

; void zisklib_pairing_bls12_381(const u64* p12, const u64* q24, u64* dest72)
zisklib_pairing_bls12_381:
	push r1
	copyb(0, r12) -> [BLS_V_DEST]
	copyb(0, BLS_V_DEST) -> r5
	copyb(0, BLS_V_MILL) -> r12
	call zisklib_miller_loop_bls12_381
	copyb(0, BLS_V_MILL) -> r10
	copyb(0, [BLS_V_DEST]) -> r11
	call zisklib_final_exp_bls12_381
	pop r1
	ret

; u64 zisklib_bls_verify(const u8* pk48, const u8* msg, u64 msglen, const u8* sig96) -> r10
zisklib_bls_verify_bls12_381:
	push r1
	copyb(0, r10) -> [BLS_V_PKP]
	copyb(0, r11) -> [BLS_V_MSG]
	copyb(0, r12) -> [BLS_V_MSGLEN]
	copyb(0, r13) -> [BLS_V_SIGP]
	copyb(0, BLS_V_SIGP) -> r5
	copyb(0, r13) -> r10
	call zisklib_decompress_g2_bls12_381
	ltu(0, r10), j(lv_bv_bad)
	copyb(0, BLS_V_G2INF) -> r5
	copyb(0, [BLS_V_G2INF]) -> r6
	ltu(0, r6), j(lv_bv_sigok)
	copyb(0, BLS_V_SIG) -> r10
	call zisklib_is_on_subgroup_twist_bls12_381
	eq(r10, 0), j(lv_bv_bad)
lv_bv_sigok:
	copyb(0, [BLS_V_PKP]) -> r10
	call zisklib_decompress_g1_bls12_381
	ltu(0, r10), j(lv_bv_bad)
	copyb(0, BLS_V_G1INF) -> r5
	copyb(0, [BLS_V_G1INF]) -> r6
	ltu(0, r6), j(lv_bv_bad)
	copyb(0, BLS_V_PK) -> r10
	call zisklib_is_on_subgroup_bls12_381
	eq(r10, 0), j(lv_bv_bad)
	copyb(0, [BLS_V_MSG]) -> r10
	copyb(0, [BLS_V_MSGLEN]) -> r11
	copyb(0, BLS_DST_STR) -> r12
	copyb(0, BLS_DST_LEN) -> r13
	copyb(0, BLS_V_Q) -> r14
	call zisklib_hash_to_curve_g2_bls12_381
	copyb(0, BLS_V_PK) -> r10
	copyb(0, BLS_V_Q) -> r11
	copyb(0, BLS_V_C1) -> r12
	call zisklib_pairing_bls12_381
	copyb(0, BLS_G1_GENERATOR) -> r10
	copyb(0, BLS_V_SIG) -> r11
	copyb(0, BLS_V_C2) -> r12
	call zisklib_pairing_bls12_381
	dma_xmemcmp(BLS_V_C1, BLS_V_C2) -> r5, j(576, 4)
	eq(r5, 0) -> r10
	copyb(0, BLS_V_C2) -> r11
	copyb(0, 72) -> r12
	pop r1
	ret
lv_bv_bad:
	copyb(0, 0) -> r10
	pop r1
	ret

