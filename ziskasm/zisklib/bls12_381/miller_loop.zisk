; u64 zisklib_ml_line_check_bls12_381(const u64* q)  uses LAMMU -> r10
zisklib_ml_line_check_bls12_381:
	push r1
	copyb(0, r10) -> [BLS_ML_WP1]
	dma_xmemcpy(BLS_ML_C1, r10) -> r5, j(96, 4)
	add(r10, 96) -> r5
	dma_xmemcpy(BLS_ML_C2, r5) -> r5, j(96, 4)
	dma_xmemcpy(BLS_ML_T1, BLS_ML_LAMMU) -> r5, j(96, 4)
	bls12_381_complex_mul(BLS_ML_T1, BLS_ML_C1)
	bls12_381_complex_add(BLS_ML_T1, BLS_ML_LAMMU + 96)
	dma_xmemcmp(BLS_ML_T1, BLS_ML_C2) -> r5, j(96, 4)
	eq(r5, 0) -> r10
	copyb(0, BLS_ML_C2) -> r11
	copyb(0, 12) -> r12
	pop r1
	ret

; u64 zisklib_ml_is_tangent_bls12_381(const u64* q)  uses LAMMU -> r10
zisklib_ml_is_tangent_bls12_381:
	push r1
	copyb(0, r10) -> [BLS_ML_WP2]
	add(r10, 96) -> r5
	dma_xmemcmp(r5, BLS_ZERO) -> r5, j(96, 4)
	eq(r5, 0) -> r10
	copyb(0, BLS_ZERO) -> r11
	copyb(0, 12) -> r12
	ltu(0, r10), j(lml_it_false)
	copyb(0, [BLS_ML_WP2]) -> r10
	call zisklib_ml_line_check_bls12_381
	eq(r10, 0), j(lml_it_false)
	copyb(0, [BLS_ML_WP2]) -> r5
	dma_xmemcpy(BLS_ML_C1, r5) -> r5, j(96, 4)
	add([BLS_ML_WP2], 96) -> r5
	dma_xmemcpy(BLS_ML_C2, r5) -> r5, j(96, 4)
	dma_xmemcpy(BLS_ML_T1, BLS_ML_LAMMU) -> r5, j(96, 4)
	bls12_381_complex_mul(BLS_ML_T1, BLS_ML_C2)
	bls12_381_complex_add(BLS_ML_T1, BLS_ML_T1)
	dma_xmemcpy(BLS_ML_C2, BLS_ML_C1) -> r5, j(96, 4)
	bls12_381_complex_mul(BLS_ML_C2, BLS_ML_C1)
	dma_xmemcpy(BLS_F2_SB, BLS_ML_THREE) -> r5, j(48, 4)
	bls12_381_complex_mul(BLS_ML_C2, BLS_F2_SB)
	dma_xmemcmp(BLS_ML_T1, BLS_ML_C2) -> r5, j(96, 4)
	eq(r5, 0) -> r10
	copyb(0, BLS_ML_C2) -> r11
	copyb(0, 12) -> r12
	pop r1
	ret
lml_it_false:
	copyb(0, 0) -> r10
	pop r1
	ret

; u64 zisklib_ml_is_line_bls12_381(const u64* q1, const u64* q2)  uses LAMMU -> r10
zisklib_ml_is_line_bls12_381:
	push r1
	copyb(0, r10) -> [BLS_ML_ILQ1]
	copyb(0, r11) -> [BLS_ML_ILQ2]
	dma_xmemcmp(r10, r11) -> r5, j(96, 4)
	eq(r5, 0) -> r10
	copyb(0, 12) -> r12
	ltu(0, r10), j(lml_il_false)
	copyb(0, [BLS_ML_ILQ1]) -> r10
	call zisklib_ml_line_check_bls12_381
	eq(r10, 0), j(lml_il_false)
	copyb(0, [BLS_ML_ILQ2]) -> r10
	call zisklib_ml_line_check_bls12_381
	pop r1
	ret
lml_il_false:
	copyb(0, 0) -> r10
	pop r1
	ret

; void zisklib_miller_loop_bls12_381(const u64* p, const u64* q, u64* result)  [12,24,72]
zisklib_miller_loop_bls12_381:
