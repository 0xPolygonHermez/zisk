	copyb(0, BLS_ML_R) -> r10
	copyb(0, BLS_ML_Q) -> r11
	copyb(r11, 8[a + 0]) -> r11
	call zisklib_ml_add_wh_bls12_381
	copyb(0, BLS_ML_R2) -> r10
	copyb(0, BLS_ML_R) -> r11
	copyb(0, 24) -> r12
	call bn254_memcpy
lml_next:
	add(r13, 1) -> r13
	jump(lml_loop)
lml_final:
	copyb(0, BLS_ML_F) -> r10
	copyb(0, BLS_ML_PR) -> r11
	copyb(r11, 8[a + 0]) -> r11
	call zisklib_conjugate_fp12_bls12_381
	pop r1
	ret
lml_bad:
	copyb(0, 0) -> r10, end

