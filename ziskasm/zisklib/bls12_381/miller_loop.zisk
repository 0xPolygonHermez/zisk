	bls12_381_complex_add(BLS_ML_T2, BLS_ML_T1)
	bls12_381_complex_sub(BLS_ML_X3, BLS_ML_T2)
	dma_xmemcpy(BLS_ML_Y3, BLS_ML_LAMMU) -> r5, j(96, 4)
	bls12_381_complex_mul(BLS_ML_Y3, BLS_ML_X3)
	dma_xmemcpy(BLS_ML_T2, BLS_ML_LAMMU + 96) -> r5, j(96, 4)
	bls12_381_complex_add(BLS_ML_T2, BLS_ML_Y3)
	dma_xmemcpy(BLS_ML_Y3, BLS_ML_T2) -> r5, j(96, 4)
	bls12_381_complex_mul(BLS_ML_Y3, BLS_F2_NEGMUL)
	dma_xmemcpy(BLS_ML_R2, BLS_ML_X3) -> r5, j(96, 4)
	dma_xmemcpy(BLS_ML_R2 + 96, BLS_ML_Y3) -> r5, j(96, 4)
	copyb(0, BLS_ML_Y3) -> r10
	copyb(0, BLS_ML_R2 + 96) -> r11
	copyb(0, 12) -> r12
	pop r1
	ret

; void zisklib_ml_add_wh_bls12_381(const u64* q1, const u64* q2)  uses LAMMU -> BLS_ML_R2
zisklib_ml_add_wh_bls12_381:
	push r1
	copyb(0, r10) -> [BLS_ML_WP1]
	copyb(0, r11) -> [BLS_ML_WP2]
	dma_xmemcpy(BLS_ML_T1, r10) -> r5, j(96, 4)
	dma_xmemcpy(BLS_ML_T2, r11) -> r5, j(96, 4)
