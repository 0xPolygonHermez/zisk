; void zisklib_ml_line_eval_bls12_381()  uses LAMMU, XPP, NEGYPP -> BLS_ML_L
zisklib_ml_line_eval_bls12_381:
	push r1
	dma_xmemcpy(BLS_ML_L, BLS_ML_LAMMU + 96) -> r5, j(96, 4)
	bls12_381_complex_mul(BLS_ML_L, BLS_ML_NEGYPP)
	dma_xmemcpy(BLS_ML_L + 96, BLS_ML_LAMMU) -> r5, j(96, 4)
	bls12_381_complex_mul(BLS_ML_L + 96, BLS_ML_XPP)
	copyb(0, BLS_ML_LAMMU) -> r10
	copyb(0, BLS_ML_XPP) -> r11
	copyb(0, BLS_ML_L + 96) -> r12
	pop r1
	ret

; void zisklib_ml_dbl_wh_bls12_381(const u64* q)  uses LAMMU -> BLS_ML_R2
zisklib_ml_dbl_wh_bls12_381:
	push r1
	copyb(0, r10) -> [BLS_ML_WP1]
	dma_xmemcpy(BLS_ML_T1, r10) -> r5, j(96, 4)
	dma_xmemcpy(BLS_ML_X3, BLS_ML_LAMMU) -> r5, j(96, 4)
