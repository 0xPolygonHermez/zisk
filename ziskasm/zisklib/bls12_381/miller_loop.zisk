	bls12_381_complex_mul(BLS_ML_X3, BLS_ML_LAMMU)
	bls12_381_complex_sub(BLS_ML_X3, BLS_ML_T1)
	bls12_381_complex_sub(BLS_ML_X3, BLS_ML_T2)
