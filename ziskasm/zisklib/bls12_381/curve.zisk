	copyb(r11, 0) -> 8[a + 56]
	copyb(r11, 0) -> 8[a + 64]
	copyb(r11, 0) -> 8[a + 72]
	copyb(r11, 0) -> 8[a + 80]
	copyb(r11, 0) -> 8[a + 88]
	copyb(0, 1) -> r10
	pop r1
	ret
lsm_one:
	copyb(0, [BLS_SM_PPTR]) -> r10
	copyb(0, [BLS_SM_RESPTR]) -> r11
	copyb(0, 12) -> r12
	call bn254_memcpy
	copyb(0, 0) -> r10
	pop r1
