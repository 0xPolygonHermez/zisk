lsm_done:
	copyb(0, [BLS_SM_RESPTR]) -> r5
	dma_xmemcpy(r5, BLS_SM_Q) -> r5, j(96, 4)
	copyb(0, 0) -> r10
	copyb(0, [BLS_SM_RESPTR]) -> r11
	copyb(0, 12) -> r12
	pop r1
	ret
lsm_zero:
	copyb(0, [BLS_SM_RESPTR]) -> r11
	copyb(r11, 0) -> 8[a + 0]
	copyb(r11, 0) -> 8[a + 8]
	copyb(r11, 0) -> 8[a + 16]
	copyb(r11, 0) -> 8[a + 24]
	copyb(r11, 0) -> 8[a + 32]
	copyb(r11, 0) -> 8[a + 40]
