lsm_two:
	copyb(0, [BLS_SM_PPTR]) -> r10
	copyb(0, [BLS_SM_RESPTR]) -> r11
	call zisklib_dbl_bls12_381
	copyb(0, 0) -> r10
	pop r1
	ret

; void zisklib_sigma_endomorphism_bls12_381(const u64* p, u64* result)  [12,12]
;   result = (ɣ·x, y).
zisklib_sigma_endomorphism_bls12_381:
	push r1
	copyb(0, r10) -> [BLS_SIG_P]
	copyb(0, r11) -> [BLS_J2A_R]
	; result.x = x · GAMMA
	copyb(0, r10) -> [ZBLS_CURVE_H5]
	copyb(0, r11) -> [ZBLS_CURVE_H5 + 32]
	arith384_mod(0, ZBLS_CURVE_H5)
	; result.y = y
	add(r11, 48) -> r5
	add(r10, 48) -> r14
	dma_xmemcpy(r5, r14) -> r5, j(48, 4)
	add(r10, 48) -> r10
	add(r11, 48) -> r11
	copyb(0, 6) -> r12
	pop r1
	ret

; void zisklib_jacobian_to_affine_bls12_381(const u64* p, u64* result)  [18,12]
;   p = x‖y‖z (each 6). z==0 -> identity; else affine = (x/z², y/z³).
zisklib_jacobian_to_affine_bls12_381:
	push r1
	copyb(0, r10) -> [BLS_J2A_P]
	copyb(0, r11) -> [BLS_J2A_R]
	; z == 0 ? (p[12..18], byte offset 96)
	add(r10, 96) -> r5
	copyb(r5, 8[a + 0]) -> r6
	copyb(r5, 8[a + 8]) -> r7
	or(r6, r7) -> r6
	copyb(r5, 8[a + 16]) -> r7
	or(r6, r7) -> r6
	copyb(r5, 8[a + 24]) -> r7
	or(r6, r7) -> r6
	copyb(r5, 8[a + 32]) -> r7
	or(r6, r7) -> r6
	copyb(r5, 8[a + 40]) -> r7
	or(r6, r7) -> r6
	ltu(0, r6), j(lj2a_nz)
	copyb(0, [BLS_J2A_R]) -> r11
	copyb(r11, 0) -> 8[a + 0]
	copyb(r11, 0) -> 8[a + 8]
	copyb(r11, 0) -> 8[a + 16]
	copyb(r11, 0) -> 8[a + 24]
	copyb(r11, 0) -> 8[a + 32]
	copyb(r11, 0) -> 8[a + 40]
	copyb(r11, 0) -> 8[a + 48]
	copyb(r11, 0) -> 8[a + 56]
	copyb(r11, 0) -> 8[a + 64]
	copyb(r11, 0) -> 8[a + 72]
	copyb(r11, 0) -> 8[a + 80]
	copyb(r11, 0) -> 8[a + 88]
	pop r1
	ret
lj2a_nz:
	; zinv = inv_fp(z)
	add([BLS_J2A_P], 96) -> r10
	copyb(0, BLS_J2A_ZINV) -> r11
	call zisklib_inv_fp_bls12_381
	arith384_mod(0, ZBLS_CURVE_H6)
	; result.x = x · zsq
	copyb(0, [BLS_J2A_P]) -> [ZBLS_CURVE_H7]
	copyb(0, [BLS_J2A_R]) -> [ZBLS_CURVE_H7 + 32]
	arith384_mod(0, ZBLS_CURVE_H7)
	; t = y · zsq
	add([BLS_J2A_P], 48) -> [ZBLS_CURVE_H8]
	arith384_mod(0, ZBLS_CURVE_H8)
	; result.y = t · zinv
	add([BLS_J2A_R], 48) -> [ZBLS_CURVE_H9 + 32]
	arith384_mod(0, ZBLS_CURVE_H9)
	copyb(0, BLS_J2A_T) -> r10
	copyb(0, BLS_J2A_ZINV) -> r11
	add([BLS_J2A_R], 48) -> r12
	pop r1
	ret
