; ============================================================================
; bls12_381/fr.zisk - scalar-field (Fr, 255-bit / 4 u64) arithmetic. Mirrors
; ziskos/.../bls12_381/fr.rs. Fr fits in 4 limbs so it uses arith256_mod (mod R).
; M0 provides reduce_fr (fast path if x<R, else arith256_mod). Leaf. Prefix lfr_.
; ============================================================================

u64 BLS_FR_HDR[5] = 0, 0, 0, 0, 0

; void zisklib_reduce_fr_bls12_381(const u64* x, u64* result)  [r10=x, r11=result]
zisklib_reduce_fr_bls12_381:
	copyb(0, r10) -> r5
	add(r5, 24) -> r5
	copyb(0, BLS_R) -> r6
	add(r6, 24) -> r6
	copyb(0, 4) -> r7
lfr_red_lt:
	eq(r7, 0), j(lfr_red_mod)
	copyb(r5, 8[a + 0]) -> r14
	copyb(r6, 8[a + 0]) -> r15
	ltu(r14, r15), j(lfr_red_copy)
	ltu(r15, r14), j(lfr_red_mod)
	sub(r5, 8) -> r5
	sub(r6, 8) -> r6
	sub(r7, 1) -> r7
	jump(lfr_red_lt)
lfr_red_copy:
	copyb(0, r10) -> r5
	copyb(0, 4) -> r7
lfr_red_cp:
	eq(r7, 0), j(lfr_red_done)
	copyb(r5, 8[a + 0]) -> r14
	copyb(r11, r14) -> 8[a + 0]
	add(r5, 8) -> r5
	add(r11, 8) -> r11
	sub(r7, 1) -> r7
	jump(lfr_red_cp)
lfr_red_done:
	ret
lfr_red_mod:
	copyb(0, BLS_FR_HDR) -> r5
	copyb(r5, r10) -> 8[a + 0]
	copyb(0, BLS_ONE) -> r7
	copyb(r5, r7) -> 8[a + 8]
	copyb(0, BLS_ZERO) -> r7
	copyb(r5, r7) -> 8[a + 16]
	copyb(0, BLS_R) -> r7
	copyb(r5, r7) -> 8[a + 24]
	copyb(r5, r11) -> 8[a + 32]
	arith256_mod(0, r5) -> r14
	ret
