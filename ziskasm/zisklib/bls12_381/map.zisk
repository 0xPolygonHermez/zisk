; scalar-mul by COFACTOR_G1=(1-x)=0xD201000000010001, complete add/dbl. r10=p -> BLS_MP_CR
zisklib_cofactor_mul_g1_bls12_381:
	push r1
	copyb(0, BLS_MP_CO) -> r5
	copyb(r5, r10) -> 8[a + 0]
	copyb(0, BLS_MP_CO) -> r10
	copyb(r10, 8[a + 0]) -> r10
	copyb(0, BLS_MP_CR) -> r11
	copyb(0, 12) -> r12
	call bn254_memcpy
	copyb(0, 1) -> r13
lmp_cof_loop:
	eq(r13, 64), j(lmp_cof_done)
	copyb(0, BLS_MP_CR) -> r10
	copyb(0, BLS_MP_CR2) -> r11
	call zisklib_dbl_complete_bls12_381
	copyb(0, BLS_MP_CR2) -> r10
	copyb(0, BLS_MP_CR) -> r11
	copyb(0, 12) -> r12
	call bn254_memcpy
	copyb(0, BLS_COFACTOR_G1_BE) -> r5
	sll(r13, 3) -> r6
	add(r5, r6) -> r5
	copyb(r5, 8[a + 0]) -> r6
	eq(r6, 0), j(lmp_cof_next)
	copyb(0, BLS_MP_CR) -> r10
	copyb(0, BLS_MP_CO) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(0, BLS_MP_CR2) -> r12
	call zisklib_add_complete_bls12_381
	copyb(0, BLS_MP_CR2) -> r10
	copyb(0, BLS_MP_CR) -> r11
	copyb(0, 12) -> r12
	call bn254_memcpy
lmp_cof_next:
	add(r13, 1) -> r13
	jump(lmp_cof_loop)
lmp_cof_done:
	pop r1
	ret

; SSWU: u(6) -> point on E' (BLS_MP_PP[12]). r10=u
zisklib_simple_swu_g1_bls12_381:
	push r1
	copyb(0, BLS_MP_U) -> r10
	copyb(0, BLS_MP_T) -> r11
