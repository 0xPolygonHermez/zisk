	copyb(0, BLS_MP_PP) -> r11
	copyb(0, 6) -> r12
	call bn254_memcpy
	copyb(0, BLS_MP_Y) -> r10
	copyb(0, BLS_MP_PP) -> r11
	add(r11, 48) -> r11
	copyb(0, 6) -> r12
	call bn254_memcpy
	pop r1
