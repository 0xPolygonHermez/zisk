; u64 zisklib_map_to_curve_g1_bls12_381(const u64* u, u64* result)  [r10=u(6), r11=result(12)] -> r10 status
zisklib_map_to_curve_g1_bls12_381:
	push r1
	copyb(0, BLS_MP_RESP) -> r5
	copyb(r5, r11) -> 8[a + 0]
	copyb(0, BLS_MP_CO) -> r5
	copyb(r5, r10) -> 8[a + 0]
	copyb(0, BLS_P) -> r11
	copyb(0, 6) -> r12
	call bn254_ltn
	eq(r10, 0), j(lmp_mtc_err)
	copyb(0, BLS_MP_CO) -> r10
	copyb(r10, 8[a + 0]) -> r10
	copyb(0, BLS_MP_U) -> r11
	copyb(0, 6) -> r12
	call bn254_memcpy
	copyb(0, BLS_MP_U) -> r10
	call zisklib_simple_swu_g1_bls12_381
	copyb(0, BLS_MP_PP) -> r10
	call zisklib_isogeny_map_g1_bls12_381
	copyb(0, BLS_MP_ISOP) -> r10
	call zisklib_cofactor_mul_g1_bls12_381
	copyb(0, BLS_MP_CR) -> r10
	copyb(0, BLS_MP_RESP) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(0, 12) -> r12
	call bn254_memcpy
	copyb(0, 0) -> r10
	pop r1
	ret
lmp_mtc_err:
	copyb(0, 1) -> r10
	pop r1
	ret

