	copyb(0, BLS_SWU_Z2_G1) -> r10
	copyb(0, BLS_MP_T2) -> r11
	copyb(0, BLS_MP_T2) -> r12
	call zisklib_mul_fp_bls12_381
	copyb(0, BLS_MP_T2) -> r10
	copyb(0, BLS_MP_ZU2) -> r11
	copyb(0, BLS_MP_T) -> r12
	call zisklib_add_fp_bls12_381
	copyb(0, BLS_MP_T) -> r10
	copyb(0, BLS_ZERO) -> r11
	copyb(0, 6) -> r12
	call bn254_eqn
	ltu(0, r10), j(lmp_swu_tv0)
	copyb(0, BLS_MP_T) -> r10
	copyb(0, BLS_MP_T) -> r11
	call zisklib_inv_fp_bls12_381
	copyb(0, BLS_ISO_B_G1) -> r10
	copyb(0, BLS_MP_T2) -> r11
	call zisklib_neg_fp_bls12_381
	copyb(0, BLS_ISO_A_G1) -> r10
	copyb(0, BLS_MP_Y) -> r11
	call zisklib_inv_fp_bls12_381
	copyb(0, BLS_MP_T2) -> r10
	copyb(0, BLS_MP_Y) -> r11
	copyb(0, BLS_MP_T2) -> r12
	call zisklib_mul_fp_bls12_381
	copyb(0, BLS_FP_ONE_6) -> r10
	copyb(0, BLS_MP_T) -> r11
	copyb(0, BLS_MP_Y) -> r12
	call zisklib_add_fp_bls12_381
	copyb(0, BLS_MP_T2) -> r10
	copyb(0, BLS_MP_Y) -> r11
	copyb(0, BLS_MP_X1) -> r12
	call zisklib_mul_fp_bls12_381
	jump(lmp_swu_havex1)
lmp_swu_tv0:
	copyb(0, BLS_SWU_Z_G1) -> r10
	copyb(0, BLS_ISO_A_G1) -> r11
	copyb(0, BLS_MP_T) -> r12
	call zisklib_mul_fp_bls12_381
	copyb(0, BLS_MP_T) -> r10
	copyb(0, BLS_MP_T) -> r11
	call zisklib_inv_fp_bls12_381
	copyb(0, BLS_ISO_B_G1) -> r10
	copyb(0, BLS_MP_T) -> r11
	copyb(0, BLS_MP_X1) -> r12
	call zisklib_mul_fp_bls12_381
lmp_swu_havex1:
	copyb(0, BLS_MP_X1) -> r10
	call zisklib_compute_y2_iso_g1_bls12_381
	copyb(0, BLS_MP_GX) -> r10
	copyb(0, BLS_MP_Y) -> r11
	call zisklib_sqrt_fp_bls12_381
	eq(r10, 0), j(lmp_swu_nqr)
	copyb(0, BLS_MP_X1) -> r10
	copyb(0, BLS_MP_PX) -> r11
	copyb(0, 6) -> r12
	call bn254_memcpy
	jump(lmp_swu_sgn)
lmp_swu_nqr:
	copyb(0, BLS_MP_ZU2) -> r10
	copyb(0, BLS_MP_X1) -> r11
	copyb(0, BLS_MP_X2) -> r12
	call zisklib_mul_fp_bls12_381
	copyb(0, BLS_MP_X2) -> r10
	call zisklib_compute_y2_iso_g1_bls12_381
	copyb(0, BLS_MP_GX) -> r10
	copyb(0, BLS_MP_Y) -> r11
	call zisklib_sqrt_fp_bls12_381
	copyb(0, BLS_MP_X2) -> r10
	copyb(0, BLS_MP_PX) -> r11
	copyb(0, 6) -> r12
	call bn254_memcpy
lmp_swu_sgn:
	copyb(0, BLS_MP_U) -> r10
	call zisklib_sgn0_fp_bls12_381
	copyb(0, BLS_MP_SGNU) -> r5
	copyb(r5, r10) -> 8[a + 0]
	copyb(0, BLS_MP_Y) -> r10
	call zisklib_sgn0_fp_bls12_381
	copyb(0, BLS_MP_SGNU) -> r5
	copyb(r5, 8[a + 0]) -> r6
