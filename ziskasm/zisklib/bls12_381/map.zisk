; Horner eval of a degree-(n-1) Fp poly. r10=coeffs, r11=n, r12=x -> BLS_MP_POLYR
zisklib_eval_poly_fp_bls12_381:
	push r1
	copyb(0, BLS_MP_CO) -> r5
	copyb(r5, r10) -> 8[a + 0]
	copyb(0, BLS_MP_N) -> r5
	copyb(r5, r11) -> 8[a + 0]
	copyb(0, BLS_MP_XP) -> r5
	copyb(r5, r12) -> 8[a + 0]
	sub(r11, 1) -> r6
	sll(r6, 5) -> r7
	sll(r6, 4) -> r5
	add(r7, r5) -> r7
	add(r10, r7) -> r10
	copyb(0, BLS_MP_POLYR) -> r11
	copyb(0, 6) -> r12
	call bn254_memcpy
	copyb(0, BLS_MP_N) -> r5
	copyb(r5, 8[a + 0]) -> r5
	sub(r5, 2) -> r6
	copyb(0, BLS_MP_I) -> r5
	copyb(r5, r6) -> 8[a + 0]
lmp_ep_loop:
	copyb(0, BLS_MP_XP) -> r10
	copyb(r10, 8[a + 0]) -> r11
	copyb(0, BLS_MP_POLYR) -> r10
	copyb(0, BLS_MP_POLYR) -> r12
	call zisklib_mul_fp_bls12_381
	copyb(0, BLS_MP_I) -> r5
	copyb(r5, 8[a + 0]) -> r13
	copyb(0, BLS_MP_CO) -> r10
	copyb(r10, 8[a + 0]) -> r10
	sll(r13, 5) -> r7
	sll(r13, 4) -> r5
	add(r7, r5) -> r7
	add(r10, r7) -> r11
	copyb(0, BLS_MP_POLYR) -> r10
	copyb(0, BLS_MP_POLYR) -> r12
	call zisklib_add_fp_bls12_381
	copyb(0, BLS_MP_I) -> r5
	copyb(r5, 8[a + 0]) -> r13
	eq(r13, 0), j(lmp_ep_done)
	sub(r13, 1) -> r13
	copyb(0, BLS_MP_I) -> r5
	copyb(r5, r13) -> 8[a + 0]
	jump(lmp_ep_loop)
lmp_ep_done:
	pop r1
	ret

; y2 = x^3 + A'x + B'. r10=x -> BLS_MP_GX
zisklib_compute_y2_iso_g1_bls12_381:
	push r1
	copyb(0, BLS_MP_XP) -> r5
	copyb(r5, r10) -> 8[a + 0]
	copyb(0, BLS_MP_XP) -> r10
	copyb(r10, 8[a + 0]) -> r10
	copyb(0, BLS_MP_T) -> r11
	call zisklib_square_fp_bls12_381
	copyb(0, BLS_MP_T) -> r10
	copyb(0, BLS_MP_XP) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(0, BLS_MP_T) -> r12
	call zisklib_mul_fp_bls12_381
	copyb(0, BLS_ISO_A_G1) -> r10
	copyb(0, BLS_MP_XP) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(0, BLS_MP_T2) -> r12
	call zisklib_mul_fp_bls12_381
	copyb(0, BLS_MP_T) -> r10
	copyb(0, BLS_MP_T2) -> r11
	copyb(0, BLS_MP_T) -> r12
	call zisklib_add_fp_bls12_381
	copyb(0, BLS_MP_T) -> r10
	copyb(0, BLS_ISO_B_G1) -> r11
	copyb(0, BLS_MP_GX) -> r12
	call zisklib_add_fp_bls12_381
	pop r1
	ret

; 11-isogeny E'->E. r10=p(12) -> BLS_MP_ISOP(12)
zisklib_isogeny_map_g1_bls12_381:
	push r1
