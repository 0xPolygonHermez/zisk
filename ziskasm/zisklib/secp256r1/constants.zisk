; ============================================================================
; secp256r1/constants.zisk - NIST P-256 (secp256r1) curve constants. Mirrors
; ziskos/entrypoint/src/zisklib/lib/secp256r1/constants.rs. Const data only;
; referenced cross-file via the library's global symbol table. Prefix `R1_`.
; Curve E: y^2 = x^3 + a*x + b, with a = -3 (= P-3 = R1_E_A) and b = R1_E_B.
; ============================================================================

const u64 R1_ONE[4]  = 1, 0, 0, 0
const u64 R1_ZERO[4] = 0, 0, 0, 0

; a = -3 mod P (= P - 3), and b.
const u64 R1_E_A[4] =
	0xFFFFFFFFFFFFFFFC, 0x00000000FFFFFFFF, 0x0000000000000000, 0xFFFFFFFF00000001
const u64 R1_E_B[4] =
	0x3BCE3C3E27D2604B, 0x651D06B0CC53B0F6, 0xB3EBBD55769886BC, 0x5AC635D8AA3A93E7

; Base field size P and P-1.
const u64 R1_P[4] =
	0xFFFFFFFFFFFFFFFF, 0x00000000FFFFFFFF, 0x0000000000000000, 0xFFFFFFFF00000001
const u64 R1_P_MINUS_ONE[4] =
	0xFFFFFFFFFFFFFFFE, 0x00000000FFFFFFFF, 0x0000000000000000, 0xFFFFFFFF00000001

; Scalar field size N and N-1.
const u64 R1_N[4] =
	0xF3B9CAC2FC632551, 0xBCE6FAADA7179E84, 0xFFFFFFFFFFFFFFFF, 0xFFFFFFFF00000000
const u64 R1_N_MINUS_ONE[4] =
	0xF3B9CAC2FC632550, 0xBCE6FAADA7179E84, 0xFFFFFFFFFFFFFFFF, 0xFFFFFFFF00000000

; Generator G = (G_X, G_Y) and -G_Y.
const u64 R1_G_X[4] =
	0xF4A13945D898C296, 0x77037D812DEB33A0, 0xF8BCE6E563A440F2, 0x6B17D1F2E12C4247
const u64 R1_G_Y[4] =
	0xCBB6406837BF51F5, 0x2BCE33576B315ECE, 0x8EE7EB4A7C0F9E16, 0x4FE342E2FE1A7F9B
const u64 R1_G_NEG_Y[4] =
	0x3449BF97C840AE0A, 0xD431CCA994CEA131, 0x711814B583F061E9, 0xB01CBD1C01E58065
