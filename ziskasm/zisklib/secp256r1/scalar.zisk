; ============================================================================
; secp256r1/scalar.zisk - scalar-field (Fn) arithmetic for NIST P-256. Mirrors
; ziskos/entrypoint/src/zisklib/lib/secp256r1/scalar.rs (same shape as the
; secp256k1 scalar file but with modulus N and FCALL_SECP256R1_FN_INV). Leaves.
; Internal labels: `rfn_`.
; ============================================================================

u64 R1_FN_HDR[5] = 0, 0, 0, 0, 0
u64 R1_FN_DL[4]  = 0, 0, 0, 0
u64 R1_FN_INV[4] = 0, 0, 0, 0

; void zisklib_reduce_fn_secp256r1(const u64* x, u64* result)  [r10=x, r11=result]
zisklib_reduce_fn_secp256r1:
	copyb(0, r10) -> r5
	add(r5, 24) -> r5
	copyb(0, R1_N) -> r6
	add(r6, 24) -> r6
	copyb(0, 4) -> r7
rfn_red_lt:
	eq(r7, 0), j(rfn_red_mod)
	copyb(r5, 8[a + 0]) -> r14
	copyb(r6, 8[a + 0]) -> r15
	ltu(r14, r15), j(rfn_red_copy)
	ltu(r15, r14), j(rfn_red_mod)
	sub(r5, 8) -> r5
	sub(r6, 8) -> r6
	sub(r7, 1) -> r7
	jump(rfn_red_lt)
rfn_red_copy:
	copyb(0, r10) -> r5
	copyb(0, 4) -> r7
rfn_red_cp:
	eq(r7, 0), j(rfn_red_done)
	copyb(r5, 8[a + 0]) -> r14
	copyb(r11, r14) -> 8[a + 0]
	add(r5, 8) -> r5
	add(r11, 8) -> r11
	sub(r7, 1) -> r7
	jump(rfn_red_cp)
rfn_red_done:
	ret
rfn_red_mod:
	copyb(0, R1_FN_HDR) -> r5
	copyb(r5, r10) -> 8[a + 0]
	copyb(0, R1_ONE) -> r7
	copyb(r5, r7) -> 8[a + 8]
	copyb(0, R1_ZERO) -> r7
	copyb(r5, r7) -> 8[a + 16]
	copyb(0, R1_N) -> r7
	copyb(r5, r7) -> 8[a + 24]
	copyb(r5, r11) -> 8[a + 32]
	arith256_mod(0, r5) -> r14
	ret

; void zisklib_add_fn_secp256r1(const u64* x, const u64* y, u64* result)
zisklib_add_fn_secp256r1:
	copyb(0, R1_FN_HDR) -> r5
	copyb(r5, r10) -> 8[a + 0]
	copyb(0, R1_ONE) -> r7
	copyb(r5, r7) -> 8[a + 8]
	copyb(r5, r11) -> 8[a + 16]
	copyb(0, R1_N) -> r7
	copyb(r5, r7) -> 8[a + 24]
	copyb(r5, r12) -> 8[a + 32]
	arith256_mod(0, r5) -> r14
	ret

; void zisklib_neg_fn_secp256r1(const u64* x, u64* result)
zisklib_neg_fn_secp256r1:
	copyb(0, R1_FN_HDR) -> r5
	copyb(r5, r10) -> 8[a + 0]
	copyb(0, R1_N_MINUS_ONE) -> r7
	copyb(r5, r7) -> 8[a + 8]
	copyb(0, R1_ZERO) -> r7
	copyb(r5, r7) -> 8[a + 16]
	copyb(0, R1_N) -> r7
	copyb(r5, r7) -> 8[a + 24]
	copyb(r5, r11) -> 8[a + 32]
	arith256_mod(0, r5) -> r14
	ret

; void zisklib_sub_fn_secp256r1(const u64* x, const u64* y, u64* result)
zisklib_sub_fn_secp256r1:
	copyb(0, R1_FN_HDR) -> r5
	copyb(r5, r11) -> 8[a + 0]         ; &y (a)
	copyb(0, R1_N_MINUS_ONE) -> r7
	copyb(r5, r7) -> 8[a + 8]
	copyb(r5, r10) -> 8[a + 16]        ; &x (c addend)
	copyb(0, R1_N) -> r7
	copyb(r5, r7) -> 8[a + 24]
	copyb(r5, r12) -> 8[a + 32]
	arith256_mod(0, r5) -> r14
	ret

; void zisklib_mul_fn_secp256r1(const u64* x, const u64* y, u64* result)
zisklib_mul_fn_secp256r1:
	copyb(0, R1_FN_HDR) -> r5
	copyb(r5, r10) -> 8[a + 0]
	copyb(r5, r11) -> 8[a + 8]
	copyb(0, R1_ZERO) -> r7
	copyb(r5, r7) -> 8[a + 16]
	copyb(0, R1_N) -> r7
	copyb(r5, r7) -> 8[a + 24]
	copyb(r5, r12) -> 8[a + 32]
	arith256_mod(0, r5) -> r14
	ret

; void zisklib_inv_fn_secp256r1(const u64* x, u64* result)  [r10=x, r11=result]
;   result = x^(-1) mod N (0 if x == 0). Hint FCALL_SECP256R1_FN_INV + verify.
zisklib_inv_fn_secp256r1:
	copyb(0, r10) -> r5
	copyb(0, 4) -> r6
rfn_inv_zchk:
	eq(r6, 0), j(rfn_inv_zero)
	copyb(r5, 8[a + 0]) -> r7
	ltu(0, r7), j(rfn_inv_hint)
	add(r5, 8) -> r5
	sub(r6, 1) -> r6
	jump(rfn_inv_zchk)
rfn_inv_zero:
	copyb(0, r11) -> r5
	copyb(0, 4) -> r6
rfn_inv_zl:
	eq(r6, 0), j(rfn_inv_done)
	copyb(r5, 0) -> 8[a + 0]
	add(r5, 8) -> r5
	sub(r6, 1) -> r6
	jump(rfn_inv_zl)
rfn_inv_done:
	ret
rfn_inv_hint:
	fcall_param(4, r10) -> r14
	fcall(FCALL_SECP256R1_FN_INV, 0) -> r14
	copyb(0, R1_FN_INV) -> r6
	copyb(0, [FREE_INPUT]) -> r7
	copyb(r6, r7) -> 8[a + 0]
	add(r6, 8) -> r6
	copyb(0, 3) -> r15
rfn_inv_rd:
	eq(r15, 0), j(rfn_inv_lt)
	fcall_get(0, 0) -> r14
	copyb(0, [FREE_INPUT]) -> r7
	copyb(r6, r7) -> 8[a + 0]
	add(r6, 8) -> r6
	sub(r15, 1) -> r15
	jump(rfn_inv_rd)
rfn_inv_lt:
	copyb(0, R1_FN_INV) -> r5
	add(r5, 24) -> r5
	copyb(0, R1_N) -> r6
	add(r6, 24) -> r6
	copyb(0, 4) -> r7
rfn_inv_ltl:
	eq(r7, 0), j(rfn_inv_panic)
	copyb(r5, 8[a + 0]) -> r14
	copyb(r6, 8[a + 0]) -> r15
	ltu(r14, r15), j(rfn_inv_vfy)
	ltu(r15, r14), j(rfn_inv_panic)
	sub(r5, 8) -> r5
	sub(r6, 8) -> r6
	sub(r7, 1) -> r7
	jump(rfn_inv_ltl)
rfn_inv_vfy:
	copyb(0, R1_FN_HDR) -> r5
	copyb(r5, r10) -> 8[a + 0]
	copyb(0, R1_FN_INV) -> r7
	copyb(r5, r7) -> 8[a + 8]
	copyb(0, R1_ZERO) -> r7
	copyb(r5, r7) -> 8[a + 16]
	copyb(0, R1_N) -> r7
	copyb(r5, r7) -> 8[a + 24]
	copyb(0, R1_FN_DL) -> r7
	copyb(r5, r7) -> 8[a + 32]
	arith256_mod(0, r5) -> r14
	copyb(0, R1_FN_DL) -> r5
	copyb(r5, 8[a + 0]) -> r14
	eq(r14, 1), j(rfn_inv_hi)
	jump(rfn_inv_panic)
rfn_inv_hi:
	copyb(0, 3) -> r7
	add(r5, 8) -> r5
rfn_inv_hil:
	eq(r7, 0), j(rfn_inv_wr)
	copyb(r5, 8[a + 0]) -> r14
	eq(r14, 0), j(rfn_inv_hin)
	jump(rfn_inv_panic)
rfn_inv_hin:
	add(r5, 8) -> r5
	sub(r7, 1) -> r7
	jump(rfn_inv_hil)
rfn_inv_wr:
	copyb(0, R1_FN_INV) -> r5
	copyb(0, 4) -> r7
rfn_inv_wrl:
	eq(r7, 0), j(rfn_inv_ret)
	copyb(r5, 8[a + 0]) -> r14
	copyb(r11, r14) -> 8[a + 0]
	add(r5, 8) -> r5
	add(r11, 8) -> r11
	sub(r7, 1) -> r7
	jump(rfn_inv_wrl)
rfn_inv_ret:
	ret
rfn_inv_panic:
	copyb(0, 0) -> r10, end
