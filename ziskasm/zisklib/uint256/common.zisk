; ============================================================================
; uint256/common.zisk - shared data for the 256-bit unsigned integer
; routines. The uint256 library is split one file per ziskos source file
; (mirroring ziskos/entrypoint/src/zisklib/lib/uint256/{add,mul,div,modular,pow}.rs);
; this file holds the constants and scratch buffers those files share, analogous
; to the `constants`/`utils` modules each `uint256/*.rs` imports from. It declares
; no routines. The ziskasm library is assembled as one program with a global
; symbol table, so these labels resolve from every sibling file.
;
; Scratch is static (ZISKLIB_RAM), not stack-allocated; the routines are
; non-reentrant, so sharing these buffers across families is safe.
;
; The FREE_INPUT address and the FCALL_* ids these routines use are library-wide
; `pub define`s in mem.zisk / fcall.zisk, not declared here.
; ============================================================================

; ROM constants: the 256-bit zero (the `c` addend for a verification multiply)
; and the 256-bit one (the `b` multiplier for the modular reduce/add).
const u64 U256_ZERO[4] =
	0, 0, 0, 0
const u64 U256_ONE[4] =
	1, 0, 0, 0

; Shared arith256 / arith256_mod pointer header [&a, &b, &c, &(module|dl), &(d|dh)]
; and the precompile output words. U256_INV holds a hinted inverse (inv256 /
; inv_mod256); U256_POW_RES/TMP are the running result and ping-pong temp for the
; square-and-multiply in pow256 / pow_mod256.
u64 U256_HDR[5] = 0, 0, 0, 0, 0
u64 U256_DL[4] = 0, 0, 0, 0
u64 U256_DH[4] = 0, 0, 0, 0
u64 U256_INV[4] = 0, 0, 0, 0
u64 U256_POW_RES[4] = 0, 0, 0, 0
u64 U256_POW_TMP[4] = 0, 0, 0, 0
