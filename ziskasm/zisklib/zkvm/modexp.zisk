u64 ZMS_ER[1] = 0                     ; per call: entry pcs
u64 ZMS_EDB[1] = 0
u64 ZMS_EDG[1] = 0
u64 ZMS_EDA[1] = 0
u64 ZMS_Q0[1] = 0                     ; per call: the first reduction row's add block
