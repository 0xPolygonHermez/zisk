	arith256(0, ZMM_A2_28)
	add256(0, ZMM_D2 + 896) -> [ZMM_D2 + 944]
	arith256(0, ZMM_A2_29)
	add256(0, ZMM_D2 + 928) -> [ZMM_D2 + 976]
	arith256(0, ZMM_A2_30)
	add256(0, ZMM_D2 + 960) -> [ZMM_D2 + 1008]
	arith256(0, ZMM_A2_31)
	add256(0, ZMM_D2 + 992) -> [ZMM_D2 + 1040]
	arith256(0, ZMM_A2_32)
	add256(0, ZMM_D2 + 1024) -> [ZMM_D2 + 1072]
	add256(0, ZMM_D2 + 1056) -> [ZMM_D3 + 16]
	add256(0, ZMM_D3)
	add(r30, 32) -> r30
	sub(r11, 1) -> r11
	ltu(0, r11), j(zms_row)
	jump(zmm_sub)

; --- the Montgomery path: r17 = the modulus' first nonzero byte, r28 = its length ---
zmm:
	add(r14, r15) -> r5
	copyb(r5, 1[a - 1]) -> r5          ; the modulus' last byte
	and(r5, 1) -> r5
	eq(r5, 0), j(zme_legacy)            ; even modulus: the general path
	ltu(1056, r28), j(zme_legacy)       ; over 33 digits: the general path
	copyb(0, r10) -> [ZMM_A_BASE]
	copyb(0, r11) -> [ZMM_A_BLEN]
	copyb(0, r12) -> [ZMM_A_EXP]
	copyb(0, r13) -> [ZMM_A_ELEN]
	copyb(0, r15) -> [ZMM_A_MLEN]
	copyb(0, r16) -> [ZMM_A_OUT]
	; --- per-call values: k, idx0 = 33 - k, the addresses and entries of position idx0 ---
	add(r28, 31) -> r5
	srl(r5, 5) -> r5
	copyb(0, r5) -> r34
	sll(r5, 5) -> r39
	add(r5, 3) -> r6
	sll(r6, 5) -> r33
	sub(33, r5) -> r6                ; idx0
	sll(r6, 3) -> r7
	add(r7, zmm_p1) -> r35         ; 2 instructions (8 bytes) per position
	add(r7, zmm_p2) -> r36
	sll(r6, 2) -> r7
	add(r7, zmm_ps) -> r37         ; 1 instruction per position
	sll(r6, 5) -> r6                    ; idx0 * 32
	copyb(0, r6) -> [ZMM_I32]
	add(r6, ZMM_X) -> r38
	add(r6, ZMM_T + 32) -> [ZMM_TP]
	add(r6, ZMM_T + 32) -> [ZMM_HM]
	add(r6, ZMM_T) -> r32
	add(r6, ZMM_S) -> [ZMM_SP]
	add(r6, ZMM_TT - 1056) -> [ZMM_TVM]
	; the chains start at idx0: no carry in (1 for t - M), no high half below
	add(r6, ZMM_D1) -> r7
	copyb(r7, 0) -> 8[a + 16]
	add(r6, ZMM_D2) -> r7
	copyb(r7, 0) -> 8[a + 16]
	add(r6, ZMM_DS) -> r7
	copyb(r7, 1) -> 8[a + 16]
	add(r6, ZMM_H1) -> r7
	dma_xmemset(r7, 32) -> r0, j(0, 4)
	add(r6, ZMM_H2) -> r7
	dma_xmemset(r7, 32) -> r0, j(0, 4)
	; --- the squaring's per-call values (k <= 16); r28 = the modulus length, still needed ---
	ltu(16, r34), j(zms_noset)
	add(r6, r6) -> r7                   ; 2 * idx0 * 32
	add(r7, ZMS_P - 1088) -> [ZMS_PLO]
	add(r7, ZMS_DB - 1088) -> r29
	copyb(r29, 0) -> 8[a + 16]
	add(r7, ZMS_DA - 1088) -> r29
	copyb(r29, 0) -> 8[a + 16]
	srl(r6, 2) -> r29                   ; 2 * idx0 * 4
	add(r29, zms_db - 136) -> [ZMS_EDB]
	add(r29, zms_da - 136) -> [ZMS_EDA]
	add(r29, ZMS_ROWS - 136) -> r29
	copyb(r29, 8[a + 0]) -> [ZMS_ER]
	srl(r6, 3) -> r29                   ; idx0 * 4
	add(r29, zms_dg - 68) -> [ZMS_EDG]
	add(r6, ZMS_ADDS - 544) -> [ZMS_Q0]
zms_noset:
	; --- M, ~M, M's lowest digit ---
	copyb(0, r17) -> r5
	copyb(0, r28) -> r6
	copyb(0, [ZMM_I32])
	add(c, ZMM_M) -> r7
	copyb(0, r34) -> r28
	call zmm_ldl
	copyb(0, [ZMM_I32]) -> r6
	add(r6, ZMM_M) -> r5
	dma_xmemcpy(ZMM_M0, r5) -> r0, j(32, 4)
	add(r6, ZMM_NM) -> r7
	copyb(0, r34) -> r29
	sll(r29, 2) -> r29                  ; limbs
zmm_nm:
	copyb(r5, 8[a + 0])
	xor(c, 0xffffffffffffffff)
	copyb(r7, c) -> 8[a + 0]
	add(r5, 8) -> r5
	add(r7, 8) -> r7
	sub(r29, 1) -> r29
	ltu(0, r29), j(zmm_nm)
	; --- np = -M^-1 mod 2^256: Newton from inv = M0 (right mod 8), 7 doublings ---
	dma_xmemcpy(ZMM_INV, ZMM_M0) -> r0, j(32, 4)
	arith256(0, ZMM_HN1)
	xor([ZMM_Y + 0], 0xffffffffffffffff) -> [ZMM_NY + 0]
	xor([ZMM_Y + 8], 0xffffffffffffffff) -> [ZMM_NY + 8]
	xor([ZMM_Y + 16], 0xffffffffffffffff) -> [ZMM_NY + 16]
	xor([ZMM_Y + 24], 0xffffffffffffffff) -> [ZMM_NY + 24]
	add256(0, ZMM_HN2)
	arith256(0, ZMM_HN3)
	arith256(0, ZMM_HN1)
	xor([ZMM_Y + 0], 0xffffffffffffffff) -> [ZMM_NY + 0]
	xor([ZMM_Y + 8], 0xffffffffffffffff) -> [ZMM_NY + 8]
	xor([ZMM_Y + 16], 0xffffffffffffffff) -> [ZMM_NY + 16]
	xor([ZMM_Y + 24], 0xffffffffffffffff) -> [ZMM_NY + 24]
	add256(0, ZMM_HN2)
	arith256(0, ZMM_HN3)
	arith256(0, ZMM_HN1)
	xor([ZMM_Y + 0], 0xffffffffffffffff) -> [ZMM_NY + 0]
	xor([ZMM_Y + 8], 0xffffffffffffffff) -> [ZMM_NY + 8]
	xor([ZMM_Y + 16], 0xffffffffffffffff) -> [ZMM_NY + 16]
	xor([ZMM_Y + 24], 0xffffffffffffffff) -> [ZMM_NY + 24]
	add256(0, ZMM_HN2)
	arith256(0, ZMM_HN3)
	arith256(0, ZMM_HN1)
	xor([ZMM_Y + 0], 0xffffffffffffffff) -> [ZMM_NY + 0]
	xor([ZMM_Y + 8], 0xffffffffffffffff) -> [ZMM_NY + 8]
	xor([ZMM_Y + 16], 0xffffffffffffffff) -> [ZMM_NY + 16]
	xor([ZMM_Y + 24], 0xffffffffffffffff) -> [ZMM_NY + 24]
	add256(0, ZMM_HN2)
	arith256(0, ZMM_HN3)
	arith256(0, ZMM_HN1)
	xor([ZMM_Y + 0], 0xffffffffffffffff) -> [ZMM_NY + 0]
	xor([ZMM_Y + 8], 0xffffffffffffffff) -> [ZMM_NY + 8]
	xor([ZMM_Y + 16], 0xffffffffffffffff) -> [ZMM_NY + 16]
	xor([ZMM_Y + 24], 0xffffffffffffffff) -> [ZMM_NY + 24]
	add256(0, ZMM_HN2)
	arith256(0, ZMM_HN3)
	arith256(0, ZMM_HN1)
	xor([ZMM_Y + 0], 0xffffffffffffffff) -> [ZMM_NY + 0]
	xor([ZMM_Y + 8], 0xffffffffffffffff) -> [ZMM_NY + 8]
	xor([ZMM_Y + 16], 0xffffffffffffffff) -> [ZMM_NY + 16]
	xor([ZMM_Y + 24], 0xffffffffffffffff) -> [ZMM_NY + 24]
	add256(0, ZMM_HN2)
	arith256(0, ZMM_HN3)
	arith256(0, ZMM_HN1)
	xor([ZMM_Y + 0], 0xffffffffffffffff) -> [ZMM_NY + 0]
	xor([ZMM_Y + 8], 0xffffffffffffffff) -> [ZMM_NY + 8]
	xor([ZMM_Y + 16], 0xffffffffffffffff) -> [ZMM_NY + 16]
	xor([ZMM_Y + 24], 0xffffffffffffffff) -> [ZMM_NY + 24]
	add256(0, ZMM_HN2)
	arith256(0, ZMM_HN3)
	xor([ZMM_INV + 0], 0xffffffffffffffff) -> [ZMM_NY + 0]
	xor([ZMM_INV + 8], 0xffffffffffffffff) -> [ZMM_NY + 8]
	xor([ZMM_INV + 16], 0xffffffffffffffff) -> [ZMM_NY + 16]
	xor([ZMM_INV + 24], 0xffffffffffffffff) -> [ZMM_NY + 24]
	add256(0, ZMM_HN4)
	; --- BR = base mod M (base without leading zero bytes, >= 1 digit) ---
	copyb(0, [ZMM_A_BASE]) -> r5
	copyb(0, [ZMM_A_BLEN]) -> r6
zmm_bz:
	eq(r6, 0), j(zmm_bzd)
	copyb(r5, 1[a + 0])
	ltu(0, c), j(zmm_bzd)
	add(r5, 1) -> r5
	sub(r6, 1) -> r6
	jump(zmm_bz)
zmm_bzd:
	add(r6, 31) -> r28
	srl(r28, 5) -> r28
	ltu(0, r28), j(zmm_bnz)
	copyb(0, 1) -> r28
zmm_bnz:
	copyb(0, r28) -> [ZKVM_ME_BU]       ; the base's digits (the general path's spill slot)
	copyb(0, ZKVM_ME_BASE_LIMBS) -> r7
	call zmm_ldl
	copyb(0, [ZMM_I32]) -> r6
	add(r6, ZMM_BR) -> r7
	copyb(0, r39) -> r29
	dma_xmemset(r7, r29) -> r0, j(0, 4)
	copyb(0, ZKVM_ME_BASE_LIMBS) -> r10
	copyb(0, [ZKVM_ME_BU]) -> r11
	add(r6, ZMM_M) -> r12
	copyb(0, r34) -> r13
	copyb(0, r7) -> r14
	call zisklib_rem_long
	; --- X = R^2 mod M. Up to 31 digits it is one rem_long of R^2 (a 1 in digit
	; 2k); beyond, R^2 and M overflow the division hint's 386 parameter words,
	; so it is 2^k * R mod M squared 8 times (2^k * R -> 2^(256k) * R = R^2) ---
	copyb(0, r34) -> r5
	ltu(31, r5), j(zmm_r2big)
	sll(r5, 1) -> r11
	add(r11, 1) -> r11                  ; 2k + 1 digits
	sll(r11, 5) -> r6
	dma_xmemset(ZMM_RA2, r6) -> r0, j(0, 4)
	sll(r5, 6) -> r6
	add(r6, ZMM_RA2) -> r7
	copyb(r7, 1) -> 8[a + 0]
	copyb(0, r38) -> r14
	copyb(0, r39) -> r29
	dma_xmemset(r14, r29) -> r0, j(0, 4)
	copyb(0, ZMM_RA2) -> r10
	copyb(0, [ZMM_I32]) -> r6
	add(r6, ZMM_M) -> r12
	copyb(0, r5) -> r13
	call zisklib_rem_long
	jump(zmm_r2done)
zmm_r2big:
	add(r5, 1) -> r6
	sll(r6, 5) -> r6
	copyb(0, ZMM_RA2) -> r7
	dma_xmemset(r7, r6) -> r0, j(0, 4)
	sll(r5, 5) -> r6
	add(r6, ZMM_RA2) -> r7
	sll(1, r5) -> r6
	copyb(r7, r6) -> 8[a + 0]
	copyb(0, r38) -> r14
	copyb(0, r39) -> r29
	dma_xmemset(r14, r29) -> r0, j(0, 4)
	copyb(0, ZMM_RA2) -> r10
	add(r5, 1) -> r11
	copyb(0, [ZMM_I32]) -> r6
	add(r6, ZMM_M) -> r12
	copyb(0, r5) -> r13
	call zisklib_rem_long
	; --- 8 squarings: 2^k * R -> 2^(256k) * R = R^2 (mod M) ---
	copyb(0, 8) -> r12
zmm_r2:
	copyb(0, r38) -> r10
	call zmm_mul
	sub(r12, 1) -> r12
	ltu(0, r12), j(zmm_r2)
zmm_r2done:
	; --- R2 = X; X = BR; X = BR * R2 / R = B * R (mod M); T[1] = X ---
	copyb(0, r39) -> [ZME_DMA_COUNT]
	copyb(0, [ZMM_I32]) -> r6
	add(r6, ZMM_R2) -> r5
	dma_memcpy(r5, r38) -> r0
	add(r6, ZMM_BR) -> r7
	dma_memcpy(r38, r7) -> r0
	copyb(0, r5) -> r10
	call zmm_mul
	copyb(0, r39) -> [ZME_DMA_COUNT]
	copyb(0, [ZMM_I32]) -> r6
	add(r6, ZMM_TT) -> r5
	dma_memcpy(r5, r38) -> r0
	; --- the exponent without its leading zero bytes: r12 = next byte, r13 = count;
	; r14 = &T[1][idx0], r17 = &T[v][idx0] - v * 1056, r16 = zmm_sqr's choice
	; (zmm_mul and zmm_sqr keep all three) ---
	copyb(0, [ZMM_I32]) -> r6
	add(r6, ZMM_TT) -> r14
	copyb(0, [ZMM_TVM]) -> r17
	sub(r34, 3) -> r16
	ltu(r16, 14) -> r16            ; r16 = 1 for 3 <= k <= 16: zmm_sqr squares with zms_go
	copyb(0, [ZMM_A_EXP]) -> r12
	copyb(0, [ZMM_A_ELEN]) -> r13
zmm_exp:
	eq(r13, 0), j(zmm_e0)
	copyb(r12, 1[a + 0]) -> r6
	add(r12, 1) -> r12
	sub(r13, 1) -> r13
	ltu(0, r6), j(zmm_e1)
	jump(zmm_exp)
zmm_e0:
	; exp == 0: the result is 1 (M > 1), as mod_len bytes
	copyb(0, [ZMM_A_OUT]) -> r16
	copyb(0, [ZMM_A_MLEN]) -> r15
	dma_xmemset(r16, r15) -> r0, j(0, 4)
	add(r16, r15) -> r5
	copyb(r5, 1) -> 1[a - 1]
	jump(zme_done)
zmm_e1:
	ltu(6, r13), j(zmm_w)               ; 8+ significant exponent bytes: 4-bit window
	; --- bit at a time: X = B is the leading bit; enter the byte body below it ---
	ltu(r6, 128), j(zmm_t7)
	jump(zmm_b6)
zmm_t7:
	ltu(r6, 64), j(zmm_t6)
	jump(zmm_b5)
zmm_t6:
	ltu(r6, 32), j(zmm_t5)
	jump(zmm_b4)
zmm_t5:
	ltu(r6, 16), j(zmm_t4)
	jump(zmm_b3)
zmm_t4:
	ltu(r6, 8), j(zmm_t3)
	jump(zmm_b2)
zmm_t3:
	ltu(r6, 4), j(zmm_t2)
	jump(zmm_b1)
zmm_t2:
	ltu(r6, 2), j(zmm_t1)
	jump(zmm_b0)
zmm_t1:
	jump(zmm_next)
zmm_b7:
	call zmm_sqr
	and(r6, 128)
	eq(c, 0), j(zmm_b6)
	copyb(0, r14) -> r10
	call zmm_mul
zmm_b6:
	call zmm_sqr
	and(r6, 64)
	eq(c, 0), j(zmm_b5)
	copyb(0, r14) -> r10
	call zmm_mul
zmm_b5:
	call zmm_sqr
	and(r6, 32)
	eq(c, 0), j(zmm_b4)
	copyb(0, r14) -> r10
	call zmm_mul
zmm_b4:
	call zmm_sqr
	and(r6, 16)
	eq(c, 0), j(zmm_b3)
	copyb(0, r14) -> r10
	call zmm_mul
zmm_b3:
	call zmm_sqr
	and(r6, 8)
	eq(c, 0), j(zmm_b2)
	copyb(0, r14) -> r10
	call zmm_mul
zmm_b2:
	call zmm_sqr
	and(r6, 4)
	eq(c, 0), j(zmm_b1)
	copyb(0, r14) -> r10
	call zmm_mul
zmm_b1:
	call zmm_sqr
	and(r6, 2)
	eq(c, 0), j(zmm_b0)
	copyb(0, r14) -> r10
	call zmm_mul
zmm_b0:
	call zmm_sqr
	and(r6, 1)
	eq(c, 0), j(zmm_next)
	copyb(0, r14) -> r10
	call zmm_mul
zmm_next:
	eq(r13, 0), j(zmm_out)
	copyb(r12, 1[a + 0]) -> r6
	add(r12, 1) -> r12
	sub(r13, 1) -> r13
	jump(zmm_b7)
	; --- 4-bit fixed window: T[v] = T[v - 1] * B, v = 2..15 ---
zmm_w:
	copyb(0, 2) -> r7
zmm_wt:
	copyb(0, r14) -> r10
	call zmm_mul
	copyb(0, r39) -> [ZME_DMA_COUNT]
	sll(r7, 10) -> r5
	sll(r7, 5)
	add(c, r5)
	add(c, r17) -> r5
	dma_memcpy(r5, r38) -> r0
	add(r7, 1) -> r7
	ltu(r7, 16), j(zmm_wt)
	copyb(0, r39) -> [ZME_DMA_COUNT]
	srl(r6, 4) -> r7                    ; the first byte's top nibble
	eq(r7, 0), j(zmm_wl0)
	sll(r7, 10) -> r5
	sll(r7, 5)
	add(c, r5)
	add(c, r17) -> r5
	dma_memcpy(r38, r5) -> r0      ; X = T[top nibble]
	jump(zmm_wlo)
zmm_wl0:
	and(r6, 15) -> r7
	sll(r7, 10) -> r5
	sll(r7, 5)
	add(c, r5)
	add(c, r17) -> r5
	dma_memcpy(r38, r5) -> r0      ; X = T[low nibble]
zmm_wnext:
	eq(r13, 0), j(zmm_out)
	copyb(r12, 1[a + 0]) -> r6
	add(r12, 1) -> r12
	sub(r13, 1) -> r13
	call zmm_sqr
	call zmm_sqr
	call zmm_sqr
	call zmm_sqr
	srl(r6, 4) -> r7
	eq(r7, 0), j(zmm_wlo)
	sll(r7, 10) -> r5
	sll(r7, 5)
	add(c, r5)
	add(c, r17) -> r10
	call zmm_mul
zmm_wlo:
	call zmm_sqr
	call zmm_sqr
	call zmm_sqr
	call zmm_sqr
	and(r6, 15) -> r7
	eq(r7, 0), j(zmm_wnext)
	sll(r7, 10) -> r5
	sll(r7, 5)
	add(c, r5)
	add(c, r17) -> r10
	call zmm_mul
	jump(zmm_wnext)
	; --- out of Montgomery form: X = X * 1 / R ---
zmm_out:
	copyb(0, [ZMM_I32]) -> r6
	add(r6, ZMM_R2) -> r10
	copyb(0, r39) -> r29
	dma_xmemset(r10, r29) -> r0, j(0, 4)
	copyb(r10, 1) -> 8[a + 0]
	call zmm_mul
	; --- X (k digits, < M) as mod_len big-endian bytes ---
	copyb(0, r39) -> r29
	add(r29, ZMM_BUFL - 8) -> r30      ; the last big-endian word
	srl(r29, 3) -> r31
	copyb(0, r38) -> r7
zmm_st:
	rev8(r7, 8[a + 0])
	copyb(r30, c) -> 8[a + 0]
	add(r7, 8) -> r7
	sub(r30, 8) -> r30
	sub(r31, 1) -> r31
	ltu(0, r31), j(zmm_st)
	copyb(0, [ZMM_A_OUT]) -> r16
	copyb(0, [ZMM_A_MLEN]) -> r15
	ltu(r15, r29), j(zmm_narrow)
	sub(r15, r29) -> r5
	dma_xmemset(r16, r5) -> r0, j(0, 4)  ; the zero bytes above the k-digit result
	add(r16, r5) -> r5
	copyb(0, r29) -> [ZME_DMA_COUNT]
	dma_memcpy(r5, ZMM_BUFL) -> r0
	jump(zme_done)
zmm_narrow:
	add(r29, ZMM_BUFL) -> r5
	sub(r5, r15) -> r5
	copyb(0, r15) -> [ZME_DMA_COUNT]
	dma_memcpy(r16, r5) -> r0
	jump(zme_done)

zme_done:
	copyb(0, [ZME_RA]) -> r1
	copyb(0, 0) -> r10                  ; ZKVM_EOK
	ret

; --- moduli above 48 bytes: the general path (r10..r16 are still the arguments) ---
zme_legacy:
	push r1
	; --- spill the seven EF arguments ---
	copyb(0, ZKVM_ME_BASEP) -> r5
	copyb(r5, r10) -> 8[a + 0]
	copyb(0, ZKVM_ME_BASEB) -> r5
	copyb(r5, r11) -> 8[a + 0]
	copyb(0, ZKVM_ME_EXPP2) -> r5
	copyb(r5, r12) -> 8[a + 0]
	copyb(0, ZKVM_ME_EXPB) -> r5
	copyb(r5, r13) -> 8[a + 0]
	copyb(0, ZKVM_ME_MODP) -> r5
	copyb(r5, r14) -> 8[a + 0]
	copyb(0, ZKVM_ME_MODB) -> r5
	copyb(r5, r15) -> 8[a + 0]
	copyb(0, ZKVM_ME_OUTP) -> r5
	copyb(r5, r16) -> 8[a + 0]

	; --- base bytes -> LE limbs ; BU = nlimbs ---
	copyb(0, ZKVM_ME_BASEP) -> r10
	copyb(r10, 8[a + 0]) -> r10
	copyb(0, ZKVM_ME_BASEB) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(0, ZKVM_ME_BASE_LIMBS) -> r12
	call zkvm_be_bytes_to_limbs
	copyb(0, ZKVM_ME_BU) -> r5
	copyb(r5, r10) -> 8[a + 0]
	; --- exp bytes -> LE limbs ; EU = nlimbs ---
	copyb(0, ZKVM_ME_EXPP2) -> r10
	copyb(r10, 8[a + 0]) -> r10
	copyb(0, ZKVM_ME_EXPB) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(0, ZKVM_ME_EXP_LIMBS) -> r12
	call zkvm_be_bytes_to_limbs
	copyb(0, ZKVM_ME_EU) -> r5
	copyb(r5, r10) -> 8[a + 0]
	; --- mod bytes -> LE limbs ; MU = nlimbs ---
	copyb(0, ZKVM_ME_MODP) -> r10
	copyb(r10, 8[a + 0]) -> r10
	copyb(0, ZKVM_ME_MODB) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(0, ZKVM_ME_MOD_LIMBS) -> r12
	call zkvm_be_bytes_to_limbs
	copyb(0, ZKVM_ME_MU) -> r5
	copyb(r5, r10) -> 8[a + 0]

	; --- zero the result limb buffer (bytes above the result read as 0) ---
	copyb(0, ZKVM_ME_RES_LIMBS) -> r6
	copyb(0, 132) -> r7
zme_rz:
	eq(r7, 0), j(zme_rzd)
	copyb(r6, 0) -> 8[a + 0]
	add(r6, 8) -> r6
	sub(r7, 1) -> r7
	jump(zme_rz)
zme_rzd:
	; --- dispatcher args: base_limbs, BU, exp_limbs, EU, mod_limbs, MU, res_limbs ---
	copyb(0, ZKVM_ME_BASE_LIMBS) -> r10
	copyb(0, ZKVM_ME_BU) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(0, ZKVM_ME_EXP_LIMBS) -> r12
	copyb(0, ZKVM_ME_EU) -> r13
	copyb(r13, 8[a + 0]) -> r13
	copyb(0, ZKVM_ME_MOD_LIMBS) -> r14
	copyb(0, ZKVM_ME_MU) -> r15
	copyb(r15, 8[a + 0]) -> r15
	copyb(0, ZKVM_ME_RES_LIMBS) -> r16
	call zme_dispatch

	; --- result LE limbs -> mod_len big-endian output bytes ---
	copyb(0, ZKVM_ME_RES_LIMBS) -> r10
	copyb(0, ZKVM_ME_OUTP) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(0, ZKVM_ME_MODB) -> r12
	copyb(r12, 8[a + 0]) -> r12
	call zkvm_limbs_to_be_bytes

	copyb(0, 0) -> r10                  ; return ZKVM_EOK
	pop r1
	ret

; ---------------------------------------------------------------------------
; zme_dispatch: verbatim lift of zisklib_modexp_u64_c's dispatcher body.
;   [r10=base, r11=blen_u64, r12=exp, r13=elen_u64, r14=mod, r15=mlen_u64,
;    r16=result] -> r10 = result_len (u64 count; unused by the caller).
; ---------------------------------------------------------------------------
zme_dispatch:
	push r1
	copyb(0, ZKVM_ME_APTR) -> r5
	copyb(r5, r10) -> 8[a + 0]
	copyb(0, ZKVM_ME_LEN) -> r5
	copyb(r5, r11) -> 8[a + 0]
	copyb(0, ZKVM_ME_DP_EXP) -> r5
	copyb(r5, r12) -> 8[a + 0]
	copyb(0, ZKVM_ME_DP_ELEN) -> r5
	copyb(r5, r13) -> 8[a + 0]
	copyb(0, ZKVM_ME_BPTR) -> r5
	copyb(r5, r14) -> 8[a + 0]
	copyb(0, ZKVM_ME_LENB) -> r5
	copyb(r5, r15) -> 8[a + 0]
	copyb(0, ZKVM_ME_DP_RES) -> r5
	copyb(r5, r16) -> 8[a + 0]
	copyb(0, ZKVM_ME_LEN) -> r5
	copyb(r5, 8[a + 0]) -> r6
	add(r6, 3) -> r6
	srl(r6, 2) -> r6
	copyb(0, ZKVM_ME_DP_BLEN) -> r5
	copyb(r5, r6) -> 8[a + 0]
	copyb(0, ZKVM_ME_LENB) -> r5
	copyb(r5, 8[a + 0]) -> r6
	add(r6, 3) -> r6
	srl(r6, 2) -> r6
	copyb(0, ZKVM_ME_DP_MLEN) -> r5
	copyb(r5, r6) -> 8[a + 0]
	copyb(0, ZKVM_ME_DP_BLEN) -> r5
	copyb(r5, 8[a + 0]) -> r6
	sll(r6, 5) -> r6
	copyb(0, ZKVM_ME_BASEPAD) -> r7
	dma_xmemset(r7, r6) -> r5, j(0, 4)
	copyb(0, ZKVM_ME_APTR) -> r10
	copyb(r10, 8[a + 0]) -> r10
	copyb(0, ZKVM_ME_BASEPAD) -> r11
	copyb(0, ZKVM_ME_LEN) -> r12
	copyb(r12, 8[a + 0]) -> r12
	call bn254_memcpy
	copyb(0, ZKVM_ME_DP_MLEN) -> r5
	copyb(r5, 8[a + 0]) -> r6
	sll(r6, 5) -> r6
	copyb(0, ZKVM_ME_MODPAD) -> r7
	dma_xmemset(r7, r6) -> r5, j(0, 4)
	copyb(0, ZKVM_ME_BPTR) -> r10
	copyb(r10, 8[a + 0]) -> r10
	copyb(0, ZKVM_ME_MODPAD) -> r11
	copyb(0, ZKVM_ME_LENB) -> r12
	copyb(r12, 8[a + 0]) -> r12
	call bn254_memcpy
	copyb(0, ZKVM_ME_DP_MLEN) -> r5
	copyb(r5, 8[a + 0]) -> r6
	copyb(0, 1) -> r7
	eq(r6, r7), j(zme_dp_m1)
	jump(zme_dp_expchk)
zme_dp_m1:
	copyb(0, ZKVM_ME_MODPAD) -> r10
	copyb(0, BI_ZERO) -> r11
	copyb(0, 4) -> r12
	call bn254_eqn
	ltu(0, r10), j(zme_dp_ret0)
	copyb(0, ZKVM_ME_MODPAD) -> r10
	copyb(0, BI_ONE) -> r11
	copyb(0, 4) -> r12
	call bn254_eqn
	ltu(0, r10), j(zme_dp_ret0)
zme_dp_expchk:
	copyb(0, ZKVM_ME_DP_EXP) -> r10
	copyb(r10, 8[a + 0]) -> r10
	copyb(0, ZKVM_ME_DP_ELEN) -> r11
	copyb(r11, 8[a + 0]) -> r11
	call zisklib_bi_iszero
	ltu(0, r10), j(zme_dp_ret1)
	copyb(0, ZKVM_ME_DP_BLEN) -> r5
	copyb(r5, 8[a + 0]) -> r6
	copyb(0, 1) -> r7
	eq(r6, r7), j(zme_dp_b1)
	jump(zme_dp_dispatch)
zme_dp_b1:
	copyb(0, ZKVM_ME_BASEPAD) -> r10
	copyb(0, BI_ZERO) -> r11
	copyb(0, 4) -> r12
	call bn254_eqn
	ltu(0, r10), j(zme_dp_ret0)
	copyb(0, ZKVM_ME_BASEPAD) -> r10
	copyb(0, BI_ONE) -> r11
	copyb(0, 4) -> r12
	call bn254_eqn
	ltu(0, r10), j(zme_dp_ret1)
zme_dp_dispatch:
	copyb(0, ZKVM_ME_DP_MLEN) -> r5
	copyb(r5, 8[a + 0]) -> r6
	copyb(0, 1) -> r7
	eq(r6, r7), j(zme_dp_short)
	copyb(0, ZKVM_ME_BASEPAD) -> r10
	copyb(0, ZKVM_ME_DP_BLEN) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(0, ZKVM_ME_DP_EXP) -> r12
	copyb(r12, 8[a + 0]) -> r12
	copyb(0, ZKVM_ME_DP_ELEN) -> r13
	copyb(r13, 8[a + 0]) -> r13
	copyb(0, ZKVM_ME_MODPAD) -> r14
	copyb(0, ZKVM_ME_DP_MLEN) -> r15
	copyb(r15, 8[a + 0]) -> r15
	copyb(0, ZKVM_ME_DP_RES) -> r16
	copyb(r16, 8[a + 0]) -> r16
	call zisklib_modexp_long
	sll(r10, 2) -> r10
	pop r1
	ret
zme_dp_short:
	copyb(0, ZKVM_ME_BASEPAD) -> r10
	copyb(0, ZKVM_ME_DP_BLEN) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(0, ZKVM_ME_DP_EXP) -> r12
	copyb(r12, 8[a + 0]) -> r12
	copyb(0, ZKVM_ME_DP_ELEN) -> r13
	copyb(r13, 8[a + 0]) -> r13
	copyb(0, ZKVM_ME_MODPAD) -> r14
	copyb(0, ZKVM_ME_DP_RES) -> r15
	copyb(r15, 8[a + 0]) -> r15
	call zisklib_modexp_short
	copyb(0, 4) -> r10
	pop r1
	ret
zme_dp_ret0:
	copyb(0, ZKVM_ME_DP_RES) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(r11, 0) -> 8[a + 0]
	copyb(r11, 0) -> 8[a + 8]
	copyb(r11, 0) -> 8[a + 16]
	copyb(r11, 0) -> 8[a + 24]
	copyb(0, 4) -> r10
	pop r1
	ret
zme_dp_ret1:
	copyb(0, ZKVM_ME_DP_RES) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(r11, 1) -> 8[a + 0]
	copyb(r11, 0) -> 8[a + 8]
	copyb(r11, 0) -> 8[a + 16]
	copyb(r11, 0) -> 8[a + 24]
	copyb(0, 4) -> r10
	pop r1
	ret
