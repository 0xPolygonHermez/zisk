; ============================================================================
; zkvm/secp256k1.zisk - secp256k1 for the EF zkVM accelerator C ABI.
; Entry `ziskasm_zkvm_secp256k1_verify`, redirect target of `zkvm_secp256k1_verify`.
;
; New, self-contained EF-native routine: it marshals the EF big-endian byte inputs
; to LE limbs in line (`rev8(ptr, 8[a + off]) -> [limb]`, one step per limb), then
; runs the ECDSA verify flow authored here (lifted from ziskasm/zisklib/secp256k1/ecdsa.zisk, NOT
; calling zisklib_ecdsa_verify_secp256k1). It reuses the shared PRIMITIVES:
; ecu_is_zero/ecu_gt/ecu_eq, zisklib_is_on_curve/inv_fn/mul_fn/reduce_fn_secp256k1,
; and zisklib_glv_double_scalar_mul_with_g_secp256k1.
;
;   zkvm_status zkvm_secp256k1_verify(const zkvm_secp256k1_hash* msg,      (32B, BE)
;                                     const zkvm_secp256k1_signature* sig, (64B = r||s, BE)
;                                     const zkvm_secp256k1_pubkey* pubkey, (64B = x||y, BE)
;                                     bool* verified)
;     [r10=msg, r11=sig, r12=pubkey, r13=verified] -> a0 = ZKVM_EOK (0);
;     *verified = 1 iff the signature is valid, else 0.
; Labels `zv_`, data `ZKVM_K1_*`.
; ============================================================================

u64 ZKVM_K1_Z[4]    = 0, 0, 0, 0
u64 ZKVM_K1_R[4]    = 0, 0, 0, 0
u64 ZKVM_K1_S[4]    = 0, 0, 0, 0
u64 ZKVM_K1_PK[8]   = 0, 0, 0, 0, 0, 0, 0, 0
u64 ZKVM_K1_SINV[4] = 0, 0, 0, 0
u64 ZKVM_K1_U1[4]   = 0, 0, 0, 0
u64 ZKVM_K1_U2[4]   = 0, 0, 0, 0
u64 ZKVM_K1_PT[8]   = 0, 0, 0, 0, 0, 0, 0, 0
u64 ZKVM_K1_XR[4]   = 0, 0, 0, 0

ziskasm_zkvm_secp256k1_verify:
	push r1
	copyb(0, r13) -> r32                ; the verified pointer, for the end (no callee uses r32..r39)
	; --- marshal z, r, s, pk (BE bytes -> LE limbs, 1 step per limb) ---
	rev8(r10, 8[a + 24]) -> [ZKVM_K1_Z + 0]
	rev8(r10, 8[a + 16]) -> [ZKVM_K1_Z + 8]
	rev8(r10, 8[a + 8]) -> [ZKVM_K1_Z + 16]
	rev8(r10, 8[a + 0]) -> [ZKVM_K1_Z + 24]
	rev8(r11, 8[a + 24]) -> [ZKVM_K1_R + 0]
	rev8(r11, 8[a + 16]) -> [ZKVM_K1_R + 8]
	rev8(r11, 8[a + 8]) -> [ZKVM_K1_R + 16]
	rev8(r11, 8[a + 0]) -> [ZKVM_K1_R + 24]
	rev8(r11, 8[a + 56]) -> [ZKVM_K1_S + 0]
	rev8(r11, 8[a + 48]) -> [ZKVM_K1_S + 8]
	rev8(r11, 8[a + 40]) -> [ZKVM_K1_S + 16]
	rev8(r11, 8[a + 32]) -> [ZKVM_K1_S + 24]
	rev8(r12, 8[a + 24]) -> [ZKVM_K1_PK + 0]
	rev8(r12, 8[a + 16]) -> [ZKVM_K1_PK + 8]
	rev8(r12, 8[a + 8]) -> [ZKVM_K1_PK + 16]
	rev8(r12, 8[a + 0]) -> [ZKVM_K1_PK + 24]
	rev8(r12, 8[a + 56]) -> [ZKVM_K1_PK + 32 + 0]
	rev8(r12, 8[a + 48]) -> [ZKVM_K1_PK + 32 + 8]
	rev8(r12, 8[a + 40]) -> [ZKVM_K1_PK + 32 + 16]
	rev8(r12, 8[a + 32]) -> [ZKVM_K1_PK + 32 + 24]

	; ================= verify (limb arrays ZKVM_K1_*) =================
	; --- r, s in [1, n-1] ---
	copyb(0, [ZKVM_K1_R + 24])
	sub(c, 1)
	ltu(c, 0xfffffffffffffffe), j(zv_rok)   ; top limb in [1, 2^64-2]: in range
	copyb(0, ZKVM_K1_R) -> r10
	call ecu_is_zero
	ltu(0, r10), j(zv_false)
	copyb(0, ZKVM_K1_R) -> r10
	copyb(0, SECP_N_MINUS_ONE) -> r11
	call ecu_gt
	ltu(0, r10), j(zv_false)
zv_rok:
	copyb(0, [ZKVM_K1_S + 24])
	sub(c, 1)
	ltu(c, 0xfffffffffffffffe), j(zv_sok)   ; top limb in [1, 2^64-2]: in range
	copyb(0, ZKVM_K1_S) -> r10
	call ecu_is_zero
	ltu(0, r10), j(zv_false)
	copyb(0, ZKVM_K1_S) -> r10
	copyb(0, SECP_N_MINUS_ONE) -> r11
	call ecu_gt
	ltu(0, r10), j(zv_false)
zv_sok:
	; --- pk != identity ---
	copyb(0, [ZKVM_K1_PK + 24])
	ltu(0, c), j(zv_pkxok)              ; x's top limb nonzero: not the identity
	copyb(0, ZKVM_K1_PK) -> r10
	call ecu_is_zero
	eq(r10, 0), j(zv_pkxok)
	copyb(0, ZKVM_K1_PK) -> r10
	add(r10, 32) -> r10
	call ecu_is_zero
	ltu(0, r10), j(zv_false)
zv_pkxok:
	; --- pk_x, pk_y in [0, p-1] ---
	copyb(0, [ZKVM_K1_PK + 24])
	ltu(c, 0xffffffffffffffff), j(zv_pxok)   ; top limb below 2^64-1: in range
	copyb(0, ZKVM_K1_PK) -> r10
	copyb(0, SECP_P_MINUS_ONE) -> r11
	call ecu_gt
	ltu(0, r10), j(zv_false)
zv_pxok:
	copyb(0, [ZKVM_K1_PK + 32 + 24])
	ltu(c, 0xffffffffffffffff), j(zv_pyok)   ; top limb below 2^64-1: in range
	copyb(0, ZKVM_K1_PK + 32) -> r10
	copyb(0, SECP_P_MINUS_ONE) -> r11
	call ecu_gt
	ltu(0, r10), j(zv_false)
zv_pyok:
	; --- pk on curve ---
	copyb(0, ZKVM_K1_PK) -> r10
	call zisklib_is_on_curve_secp256k1
	eq(r10, 0), j(zv_false)
	; --- s_inv = s^-1 (mod n) ---
	copyb(0, ZKVM_K1_S) -> r10
	copyb(0, ZKVM_K1_SINV) -> r11
	call zisklib_inv_fn_secp256k1
	; --- u1 = z * s_inv ---
	copyb(0, ZKVM_K1_Z) -> r10
	copyb(0, ZKVM_K1_SINV) -> r11
	copyb(0, ZKVM_K1_U1) -> r12
	call zisklib_mul_fn_secp256k1
	; --- u2 = r * s_inv ---
	copyb(0, ZKVM_K1_R) -> r10
	copyb(0, ZKVM_K1_SINV) -> r11
	copyb(0, ZKVM_K1_U2) -> r12
	call zisklib_mul_fn_secp256k1
	; --- (x,y) = u1*G + u2*pk ---
	copyb(0, ZKVM_K1_U1) -> r10
	copyb(0, ZKVM_K1_U2) -> r11
	copyb(0, ZKVM_K1_PK) -> r12
	copyb(0, ZKVM_K1_PT) -> r13
	call zisklib_glv_double_scalar_mul_with_g_secp256k1
	ltu(0, r10), j(zv_false)            ; infinity -> invalid
	; --- accept iff x == r (mod n) ---
	copyb(0, ZKVM_K1_PT) -> r10
	copyb(0, ZKVM_K1_R) -> r11
	call ecu_eq
	ltu(0, r10), j(zv_true)
	copyb(0, ZKVM_K1_PT) -> r10
	copyb(0, ZKVM_K1_XR) -> r11
	call zisklib_reduce_fn_secp256k1
	copyb(0, ZKVM_K1_XR) -> r10
	copyb(0, ZKVM_K1_R) -> r11
	call ecu_eq
	ltu(0, r10), j(zv_true)

zv_false:
	copyb(0, 0) -> r14
	jump(zv_store)
zv_true:
	copyb(0, 1) -> r14
zv_store:
	copyb(r32, r14) -> 1[a + 0]          ; *verified = r14 (1 byte, bool)
	copyb(0, 0) -> r10                  ; return ZKVM_EOK (a0 = 0)
	pop r1
	ret

; ----------------------------------------------------------------------------
; zkvm_status zkvm_secp256k1_ecrecover(const zkvm_secp256k1_hash* msg,   (32B, BE)
;                                      const zkvm_secp256k1_signature* sig, (64B r||s, BE)
;                                      uint8_t recid,
;                                      zkvm_secp256k1_pubkey* output)     (64B x||y, BE)
;   [r10=msg, r11=sig, r12=recid, r13=output] -> a0 = ZKVM_EOK on success (output
;   = recovered pubkey), ZKVM_EFAIL (-1) on any failure. Recover flow lifted from
;   secp256k1/ecdsa.zisk (reuses lift_x/inv_fn/neg_fn/mul_fn/glv + ecu_* primitives);
;   x‖y limbs converted back to big-endian bytes in line (rev8 + store per limb).
;   The range checks read only the top limb unless it is 0 or 2^64-1, where they
;   fall back to the exact ecu_* comparisons. Labels `zr_`, data `ZKVM_KR_*`.
; ----------------------------------------------------------------------------
u64 ZKVM_KR_Z[4]    = 0, 0, 0, 0
u64 ZKVM_KR_R[4]    = 0, 0, 0, 0
u64 ZKVM_KR_S[4]    = 0, 0, 0, 0
u64 ZKVM_KR_RPT[8]  = 0, 0, 0, 0, 0, 0, 0, 0
u64 ZKVM_KR_RINV[4] = 0, 0, 0, 0
u64 ZKVM_KR_NEGZ[4] = 0, 0, 0, 0
u64 ZKVM_KR_U1[4]   = 0, 0, 0, 0
u64 ZKVM_KR_U2[4]   = 0, 0, 0, 0
u64 ZKVM_KR_RES[8]  = 0, 0, 0, 0, 0, 0, 0, 0

ziskasm_zkvm_secp256k1_ecrecover:
	; --- recid <= 1 ; parity = recid & 1 ---
	ltu(1, r12), j(zr_fail0)
	copyb(0, r12) -> r33                ; parity (no callee uses r32..r39)
	push r1
	copyb(0, r13) -> r32                ; the output pointer, for the end
	; --- marshal z, r, s (BE bytes -> LE limbs, 1 step per limb) ---
	rev8(r10, 8[a + 24]) -> [ZKVM_KR_Z + 0]
	rev8(r10, 8[a + 16]) -> [ZKVM_KR_Z + 8]
	rev8(r10, 8[a + 8]) -> [ZKVM_KR_Z + 16]
	rev8(r10, 8[a + 0]) -> [ZKVM_KR_Z + 24]
	rev8(r11, 8[a + 24]) -> [ZKVM_KR_R + 0]
	rev8(r11, 8[a + 16]) -> [ZKVM_KR_R + 8]
	rev8(r11, 8[a + 8]) -> [ZKVM_KR_R + 16]
	rev8(r11, 8[a + 0]) -> [ZKVM_KR_R + 24]
	rev8(r11, 8[a + 56]) -> [ZKVM_KR_S + 0]
	rev8(r11, 8[a + 48]) -> [ZKVM_KR_S + 8]
	rev8(r11, 8[a + 40]) -> [ZKVM_KR_S + 16]
	rev8(r11, 8[a + 32]) -> [ZKVM_KR_S + 24]

	; --- r, s in [1, n-1] ---
	copyb(0, [ZKVM_KR_R + 24])
	sub(c, 1)
	ltu(c, 0xfffffffffffffffe), j(zr_rok)   ; top limb in [1, 2^64-2]: in range
	copyb(0, ZKVM_KR_R) -> r10
	call ecu_is_zero
	ltu(0, r10), j(zr_fail)
	copyb(0, ZKVM_KR_R) -> r10
	copyb(0, SECP_N_MINUS_ONE) -> r11
	call ecu_gt
	ltu(0, r10), j(zr_fail)
zr_rok:
	copyb(0, [ZKVM_KR_S + 24])
	sub(c, 1)
	ltu(c, 0xfffffffffffffffe), j(zr_sok)   ; top limb in [1, 2^64-2]: in range
	copyb(0, ZKVM_KR_S) -> r10
	call ecu_is_zero
	ltu(0, r10), j(zr_fail)
	copyb(0, ZKVM_KR_S) -> r10
	copyb(0, SECP_N_MINUS_ONE) -> r11
	call ecu_gt
	ltu(0, r10), j(zr_fail)
zr_sok:
	; --- R = lift_x(r, parity) ---
	copyb(0, ZKVM_KR_R) -> r10
	copyb(0, r33) -> r11
	copyb(0, ZKVM_KR_RPT) -> r12
	call zisklib_lift_x_secp256k1
	ltu(0, r10), j(zr_fail)
	; --- r_inv = r^-1 (mod n) ---
	copyb(0, ZKVM_KR_R) -> r10
	copyb(0, ZKVM_KR_RINV) -> r11
	call zisklib_inv_fn_secp256k1
	; --- neg_z = -z (mod n) ---
	copyb(0, ZKVM_KR_Z) -> r10
	copyb(0, ZKVM_KR_NEGZ) -> r11
	call zisklib_neg_fn_secp256k1
	; --- u1 = neg_z * r_inv ; u2 = s * r_inv (mod n) ---
	copyb(0, ZKVM_KR_NEGZ) -> r10
	copyb(0, ZKVM_KR_RINV) -> r11
	copyb(0, ZKVM_KR_U1) -> r12
	call zisklib_mul_fn_secp256k1
	copyb(0, ZKVM_KR_S) -> r10
	copyb(0, ZKVM_KR_RINV) -> r11
	copyb(0, ZKVM_KR_U2) -> r12
	call zisklib_mul_fn_secp256k1
	; --- pk = u1*G + u2*R ; infinity -> fail ---
	copyb(0, ZKVM_KR_U1) -> r10
	copyb(0, ZKVM_KR_U2) -> r11
	copyb(0, ZKVM_KR_RPT) -> r12
	copyb(0, ZKVM_KR_RES) -> r13
	call zisklib_glv_double_scalar_mul_with_g_secp256k1
	ltu(0, r10), j(zr_fail)

	; --- success: output = x‖y (4 LE limbs each -> 32 BE bytes) ---
	rev8(0, [ZKVM_KR_RES + 0])
	copyb(r32, c) -> 8[a + 24]
	rev8(0, [ZKVM_KR_RES + 8])
	copyb(r32, c) -> 8[a + 16]
	rev8(0, [ZKVM_KR_RES + 16])
	copyb(r32, c) -> 8[a + 8]
	rev8(0, [ZKVM_KR_RES + 24])
	copyb(r32, c) -> 8[a + 0]
	rev8(0, [ZKVM_KR_RES + 32 + 0])
	copyb(r32, c) -> 8[a + 56]
	rev8(0, [ZKVM_KR_RES + 32 + 8])
	copyb(r32, c) -> 8[a + 48]
	rev8(0, [ZKVM_KR_RES + 32 + 16])
	copyb(r32, c) -> 8[a + 40]
	rev8(0, [ZKVM_KR_RES + 32 + 24])
	copyb(r32, c) -> 8[a + 32]
	copyb(0, 0) -> r10                          ; ZKVM_EOK
	pop r1
	ret
zr_fail:
	pop r1
zr_fail0:
	copyb(0, 0xffffffffffffffff) -> r10         ; ZKVM_EFAIL (-1)
	ret
