zubshr_q1:
	and(r33, 63) -> r34
	eq(c, 0), j(zubshr_q1_w)
	sub(64, r34) -> r35
	rev8(r11, 8[a + 16])
	srl(c, r34) -> r36
	rev8(r11, 8[a + 8]) -> r37
	sll(c, r35)
