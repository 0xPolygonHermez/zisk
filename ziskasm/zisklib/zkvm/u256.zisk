; zkvm_status zkvm_u256_sar(shift, value, result) : arithmetic shift right;
; shift >= 256 -> all sign bits. Inline zkvmcall. r33 = shift (< 256), r34 = b =
; shift % 64, r35 = 64 - b; a case per word shift q, each output limb built from
; two input limbs read in ascending order (so the result may alias the value),
; r38 = fill.
ziskasm_zkvm_u256_sar:
	rev8(r11, 8[a + 0])
	sra(c, 63) -> r38                   ; fill: 0, or all ones if negative
	rev8(r10, 8[a + 16]) -> r32
	rev8(r10, 8[a + 8])
	or(r32, c) -> r32
	rev8(r10, 8[a + 0])
	or(r32, c)
	eq(c, 0), j(zubsar_lo)
	jump(zubsar_big)
zubsar_lo:
	rev8(r10, 8[a + 24]) -> r33
	ltu(c, 256), j(zubsar_ok)
	jump(zubsar_big)
zubsar_ok:
	ltu(r33, 64), j(zubsar_q0)
	ltu(r33, 128), j(zubsar_q1)
	ltu(r33, 192), j(zubsar_q2)
	jump(zubsar_q3)
zubsar_q0:
	and(r33, 63) -> r34
	eq(c, 0), j(zubsar_q0_w)
	sub(64, r34) -> r35
	rev8(r11, 8[a + 24])
	srl(c, r34) -> r36
	rev8(r11, 8[a + 16]) -> r37
	sll(c, r35)
	or(r36, c)
	rev8(r12, c) -> 8[a + 24]
	srl(r37, r34) -> r36
	rev8(r11, 8[a + 8]) -> r37
	sll(c, r35)
	or(r36, c)
	rev8(r12, c) -> 8[a + 16]
	srl(r37, r34) -> r36
	rev8(r11, 8[a + 0]) -> r37
	sll(c, r35)
	or(r36, c)
	rev8(r12, c) -> 8[a + 8]
	sra(r37, r34)
	rev8(r12, c) -> 8[a + 0]
	ret
zubsar_q0_w:
	rev8(r11, 8[a + 24])
	rev8(r12, c) -> 8[a + 24]
	rev8(r11, 8[a + 16])
	rev8(r12, c) -> 8[a + 16]
	rev8(r11, 8[a + 8])
	rev8(r12, c) -> 8[a + 8]
	rev8(r11, 8[a + 0])
	rev8(r12, c) -> 8[a + 0]
	ret
zubsar_q1:
	and(r33, 63) -> r34
	eq(c, 0), j(zubsar_q1_w)
	sub(64, r34) -> r35
	rev8(r11, 8[a + 16])
	srl(c, r34) -> r36
	rev8(r11, 8[a + 8]) -> r37
	sll(c, r35)
	or(r36, c)
	rev8(r12, c) -> 8[a + 24]
	srl(r37, r34) -> r36
	rev8(r11, 8[a + 0]) -> r37
	sll(c, r35)
	or(r36, c)
	rev8(r12, c) -> 8[a + 16]
	sra(r37, r34)
	rev8(r12, c) -> 8[a + 8]
	rev8(r12, r38) -> 8[a + 0]
	ret
zubsar_q1_w:
	rev8(r11, 8[a + 16])
	rev8(r12, c) -> 8[a + 24]
	rev8(r11, 8[a + 8])
	rev8(r12, c) -> 8[a + 16]
	rev8(r11, 8[a + 0])
	rev8(r12, c) -> 8[a + 8]
	rev8(r12, r38) -> 8[a + 0]
	ret
zubsar_q2:
	and(r33, 63) -> r34
	eq(c, 0), j(zubsar_q2_w)
	sub(64, r34) -> r35
	rev8(r11, 8[a + 8])
	srl(c, r34) -> r36
	rev8(r11, 8[a + 0]) -> r37
	sll(c, r35)
	or(r36, c)
	rev8(r12, c) -> 8[a + 24]
	sra(r37, r34)
	rev8(r12, c) -> 8[a + 16]
	rev8(r12, r38) -> 8[a + 8]
	rev8(r12, r38) -> 8[a + 0]
	ret
zubsar_q2_w:
	rev8(r11, 8[a + 8])
	rev8(r12, c) -> 8[a + 24]
	rev8(r11, 8[a + 0])
	rev8(r12, c) -> 8[a + 16]
	rev8(r12, r38) -> 8[a + 8]
	rev8(r12, r38) -> 8[a + 0]
	ret
zubsar_q3:
	and(r33, 63) -> r34
	eq(c, 0), j(zubsar_q3_w)
