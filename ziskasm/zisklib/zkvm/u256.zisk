zubsar_q3_w:
	rev8(r11, 8[a + 0])
	rev8(r12, c) -> 8[a + 24]
	rev8(r12, r38) -> 8[a + 16]
	rev8(r12, r38) -> 8[a + 8]
	rev8(r12, r38) -> 8[a + 0]
