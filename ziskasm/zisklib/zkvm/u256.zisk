; ============================================================================
; zkvm/u256.zisk - 256-bit EVM-word arithmetic for the Ethereum Foundation zkVM
; accelerator C ABI (zkvm_u256.h). Entry points `ziskasm_zkvm_u256_*`, redirect
; targets of the standard `zkvm_u256_*` symbols.
;
; The EF U256 ABI represents every value as a 32-byte BIG-ENDIAN array (EVM word
; encoding); ZisK's uint256 cores (uint256/{add,mul,div,modular,pow}.zisk, which
; are the arith256 / arith256_mod / add256 precompile front-ends) work on
; LITTLE-ENDIAN u64[4] limbs. So each wrapper (a) byte-reverses its big-endian
; operands to LE limbs (zkvm_be_to_limbs, nlimbs = 4), (b) runs the shared
; precompile-backed core, applying the EVM edge cases the cores don't (div/mod/
; addmod/mulmod with a zero divisor/modulus return 0 rather than panicking; signed
; ops go through abs + sign), then (c) byte-reverses the result limbs back to a
; big-endian output (zkvm_limbs_to_be). Bitwise / equality ops are byte-order
; agnostic and act on the raw words directly (no marshalling). The result pointer
; may alias any input: every wrapper reads all inputs into private scratch before
; writing the output, so aliasing is always safe.
;
; Every value is 4 u64 words. Labels `zu*`; scratch `ZU_*` (static, non-reentrant,
; shared across the wrappers). The uint256 cores and marshal helpers, and the
; U256_ZERO/U256_ONE consts, resolve from their sibling files via the library-wide
; symbol table.
; ============================================================================

; ---- pointer arg spills (reloaded after each reg-clobbering `call`) ----------
u64 ZU_PA[1]    = 0
u64 ZU_PB[1]    = 0
u64 ZU_PN[1]    = 0
u64 ZU_POUT[1]  = 0
u64 ZU_POUT2[1] = 0
u64 ZU_S[1]     = 0    ; shift/byte/signextend amount (low limb)
u64 ZU_SA[1]    = 0    ; sign of a (signed ops) / of value (sar)
u64 ZU_SB[1]    = 0    ; sign of b (signed ops)

; ---- marshalled limb buffers (little-endian, limb 0 = least significant) ----
u64 ZU_A[4]  = 0, 0, 0, 0
u64 ZU_B[4]  = 0, 0, 0, 0
u64 ZU_N[4]  = 0, 0, 0, 0
u64 ZU_V[4]  = 0, 0, 0, 0    ; value operand (shifts)
u64 ZU_AA[4] = 0, 0, 0, 0    ; |a|
u64 ZU_BB[4] = 0, 0, 0, 0    ; |b|
u64 ZU_Q[4]  = 0, 0, 0, 0    ; quotient
u64 ZU_R[4]  = 0, 0, 0, 0    ; result / remainder
u64 ZU_T[4]  = 0, 0, 0, 0    ; temp

; ============================================================================
; Shared internal helpers
; ============================================================================

; ---- zu_load2: spill result ptr, marshal a,b (big-endian) -> ZU_A, ZU_B -------
;   [r10=a_ptr, r11=b_ptr, r12=result_ptr]. Also spills b_ptr to ZU_PB.
zu_load2:
	push r1
	copyb(0, ZU_POUT) -> r5
	copyb(r5, r12) -> 8[a + 0]
	copyb(0, ZU_PB) -> r5
	copyb(r5, r11) -> 8[a + 0]
	copyb(0, ZU_A) -> r11              ; marshal a (r10 = a_ptr)
	copyb(0, 4) -> r12
	call zkvm_be_to_limbs
	copyb(0, ZU_PB) -> r10             ; marshal b
	copyb(r10, 8[a + 0]) -> r10
	copyb(0, ZU_B) -> r11
	copyb(0, 4) -> r12
	call zkvm_be_to_limbs
	pop r1
	ret

; ---- zu_load3: spill result ptr, marshal a,b,n -> ZU_A, ZU_B, ZU_N ------------
;   [r10=a_ptr, r11=b_ptr, r12=n_ptr, r13=result_ptr].
zu_load3:
	push r1
	copyb(0, ZU_POUT) -> r5
	copyb(r5, r13) -> 8[a + 0]
	copyb(0, ZU_PB) -> r5
	copyb(r5, r11) -> 8[a + 0]
	copyb(0, ZU_PN) -> r5
	copyb(r5, r12) -> 8[a + 0]
	copyb(0, ZU_A) -> r11              ; marshal a
	copyb(0, 4) -> r12
	call zkvm_be_to_limbs
	copyb(0, ZU_PB) -> r10             ; marshal b
	copyb(r10, 8[a + 0]) -> r10
	copyb(0, ZU_B) -> r11
	copyb(0, 4) -> r12
	call zkvm_be_to_limbs
	copyb(0, ZU_PN) -> r10             ; marshal n
	copyb(r10, 8[a + 0]) -> r10
	copyb(0, ZU_N) -> r11
	copyb(0, 4) -> r12
	call zkvm_be_to_limbs
	pop r1
	ret

; ---- zu_wr_r: marshal ZU_R (LE limbs) -> big-endian output at ZU_POUT ---------
zu_wr_r:
	push r1
	copyb(0, ZU_R) -> r10
	copyb(0, ZU_POUT) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(0, 4) -> r12
	call zkvm_limbs_to_be
	pop r1
	ret

; ---- zu_wr_zero: write 32 zero bytes to the output at ZU_POUT (leaf) ----------
zu_wr_zero:
	copyb(0, ZU_POUT) -> r5
	copyb(r5, 8[a + 0]) -> r5
	copyb(r5, 0) -> 8[a + 0]
	copyb(r5, 0) -> 8[a + 8]
	copyb(r5, 0) -> 8[a + 16]
	copyb(r5, 0) -> 8[a + 24]
	ret

; ---- zu_wr_bool: write big-endian U256 = r10 (0/1) to the output (leaf) -------
;   The boolean lands in the least-significant byte = output byte 31.
zu_wr_bool:
	copyb(0, ZU_POUT) -> r5
	copyb(r5, 8[a + 0]) -> r5
	copyb(r5, 0) -> 8[a + 0]
	copyb(r5, 0) -> 8[a + 8]
	copyb(r5, 0) -> 8[a + 16]
	copyb(r5, 0) -> 8[a + 24]
	add(r5, 31) -> r6
	copyb(r6, r10) -> 1[a + 0]
	ret

; ---- zu_iszero: r10 = 1 if the 4-limb value at r10 is all zero, else 0 (leaf) -
zu_iszero:
	copyb(0, r10) -> r5
	copyb(r5, 8[a + 0]) -> r6
	copyb(r5, 8[a + 8]) -> r7
	or(r6, r7) -> r6
	copyb(r5, 8[a + 16]) -> r7
	or(r6, r7) -> r6
	copyb(r5, 8[a + 24]) -> r7
	or(r6, r7) -> r6
	eq(r6, 0), j(zuiz_yes)
	copyb(0, 0) -> r10
	ret
zuiz_yes:
	copyb(0, 1) -> r10
	ret

; ---- zu_neg: dst = -src (two's complement) = 0 - src, over 4 limbs ------------
;   [r10=src_limbs, r11=dst_limbs]. Reuses the proven overflowing_sub256 core.
zu_neg:
	push r1
	copyb(0, r11) -> r5                ; save dst
	copyb(0, r10) -> r11               ; b = src
	copyb(0, r5) -> r12                ; result = dst
	copyb(0, U256_ZERO) -> r10         ; a = 0
	call zisklib_overflowing_sub256    ; dst = 0 - src
	pop r1
	ret

; ---- zu_amount: decode a shift/index amount from a big-endian U256 -----------
;   [r10=be_ptr] -> r10 = low limb (numeric value of the least-significant 8
;   bytes), r11 = 1 if the high 24 bytes are all zero (amount < 2^64) else 0.
;   A caller treats "amount >= threshold" as (r11 == 0) OR (r10 >= threshold),
;   valid for any threshold <= 2^64. (leaf)
zu_amount:
	copyb(0, r10) -> r5
	copyb(r5, 8[a + 0]) -> r6          ; big-endian bytes 0..7  (most significant)
	copyb(r5, 8[a + 8]) -> r7          ; bytes 8..15
	or(r6, r7) -> r6
	copyb(r5, 8[a + 16]) -> r7         ; bytes 16..23
	or(r6, r7) -> r6                   ; nonzero iff amount >= 2^64
	copyb(r5, 8[a + 24]) -> r7         ; bytes 24..31 (least significant, reversed)
	rev8(0, r7) -> r7
	copyb(0, r7) -> r10                ; low limb value
	eq(r6, 0), j(zuam_in)
	copyb(0, 0) -> r11
	ret
zuam_in:
	copyb(0, 1) -> r11
	ret

; ---- zu_cmp_u: unsigned compare of two big-endian U256 -----------------------
;   [r10=a_ptr, r11=b_ptr] -> r10 = 0 (a<b) / 1 (a==b) / 2 (a>b). Compares the
;   raw words most-significant first, using rev8 to recover each word's value.
;   Preserves r11,r12,r13. (leaf)
zu_cmp_u:
	copyb(0, r10) -> r6                ; &a walk (byte 0 = MSW)
	copyb(0, r11) -> r7                ; &b walk
	copyb(0, 4) -> r5
zucu_loop:
	eq(r5, 0), j(zucu_eq)
	copyb(r6, 8[a + 0]) -> r14
	rev8(0, r14) -> r14
	copyb(r7, 8[a + 0]) -> r15
	rev8(0, r15) -> r15
	ltu(r14, r15), j(zucu_lt)
	ltu(r15, r14), j(zucu_gt)
	add(r6, 8) -> r6
	add(r7, 8) -> r7
	sub(r5, 1) -> r5
	jump(zucu_loop)
zucu_lt:
	copyb(0, 0) -> r10
	ret
zucu_gt:
	copyb(0, 2) -> r10
	ret
zucu_eq:
	copyb(0, 1) -> r10
	ret

; ---- zu_scmp: signed (two's complement) compare of two big-endian U256 -------
;   [r10=a_ptr, r11=b_ptr] -> r10 = 1 if a < b (signed) else 0.
zu_scmp:
	push r1
	copyb(r10, 8[a + 0]) -> r6         ; MSW of a (raw, byte 0)
	rev8(0, r6) -> r6
	srl(r6, 63) -> r6                  ; sign(a)
	copyb(r11, 8[a + 0]) -> r7
	rev8(0, r7) -> r7
	srl(r7, 63) -> r7                  ; sign(b)
	eq(r6, r7), j(zuscmp_same)
	copyb(0, r6) -> r10                ; differing signs: a<b iff a negative
	pop r1
	ret
zuscmp_same:
	call zu_cmp_u                      ; same sign: unsigned order == signed order
	eq(r10, 0), j(zuscmp_lt)
	copyb(0, 0) -> r10
	pop r1
	ret
zuscmp_lt:
	copyb(0, 1) -> r10
	pop r1
	ret

; ---- zu_abs: dst = |src|, returns sign ---------------------------------------
;   [r10=src_limbs, r11=dst_limbs] -> r10 = sign (1 if src negative else 0).
zu_abs:
	push r1
	copyb(0, r10) -> r5
	add(r5, 24) -> r5
	copyb(r5, 8[a + 0]) -> r6          ; src[3] (most significant limb)
	srl(r6, 63) -> r6                  ; sign
	eq(r6, 0), j(zuabs_copy)
	call zu_neg                        ; dst = -src   (r10=src, r11=dst intact)
	copyb(0, 1) -> r10
	pop r1
	ret
zuabs_copy:
	copyb(0, r10) -> r5                ; dst = src
	copyb(0, r11) -> r6
	copyb(r5, 8[a + 0]) -> r7
	copyb(r6, r7) -> 8[a + 0]
	copyb(r5, 8[a + 8]) -> r7
	copyb(r6, r7) -> 8[a + 8]
	copyb(r5, 8[a + 16]) -> r7
	copyb(r6, r7) -> 8[a + 16]
	copyb(r5, 8[a + 24]) -> r7
	copyb(r6, r7) -> 8[a + 24]
	copyb(0, 0) -> r10
	pop r1
	ret

; ---- zu_shl_limbs: dst = src << s (256-bit), 0 <= s <= 255 -------------------
;   [r10=src_limbs, r11=dst_limbs, r12=s]. (leaf)
zu_shl_limbs:
	copyb(0, r12) -> r5
	srl(r5, 6) -> r6                   ; word shift ws
	and(r5, 63) -> r7                  ; bit shift bs
	copyb(0, 3) -> r13                 ; dst word index i, high -> low
zushl_loop:
	ltu(r13, r6), j(zushl_zero)        ; i < ws -> dst[i] = 0
	sub(r13, r6) -> r14                ; j = i - ws
	sll(r14, 3) -> r15
	copyb(0, r10) -> r16
	add(r16, r15) -> r16
	copyb(r16, 8[a + 0]) -> r16        ; src[j]
	sll(r16, r7) -> r28                ; lo = src[j] << bs
	eq(r7, 0), j(zushl_put)            ; bs == 0 -> no carry-in
	eq(r14, 0), j(zushl_put)           ; j == 0 -> no lower word
	sub(r14, 1) -> r29
	sll(r29, 3) -> r29
	copyb(0, r10) -> r30
	add(r30, r29) -> r30
	copyb(r30, 8[a + 0]) -> r30        ; src[j-1]
	copyb(0, 64) -> r31
	sub(r31, r7) -> r31                ; 64 - bs
	srl(r30, r31) -> r30               ; hi = src[j-1] >> (64-bs)
	or(r28, r30) -> r28
zushl_put:
	sll(r13, 3) -> r15
	copyb(0, r11) -> r16
	add(r16, r15) -> r16
	copyb(r16, r28) -> 8[a + 0]        ; dst[i] = lo | hi
	jump(zushl_next)
zushl_zero:
	sll(r13, 3) -> r15
	copyb(0, r11) -> r16
	add(r16, r15) -> r16
	copyb(r16, 0) -> 8[a + 0]
zushl_next:
	eq(r13, 0), j(zushl_done)
	sub(r13, 1) -> r13
	jump(zushl_loop)
zushl_done:
	ret

; ---- zu_shr_limbs: dst = src >> s (256-bit logical), 0 <= s <= 255 -----------
;   [r10=src_limbs, r11=dst_limbs, r12=s]. (leaf)
zu_shr_limbs:
	copyb(0, r12) -> r5
	srl(r5, 6) -> r6                   ; ws
	and(r5, 63) -> r7                  ; bs
	copyb(0, 0) -> r13                 ; dst word index i, low -> high
zushr_loop:
	add(r13, r6) -> r14                ; j = i + ws
	ltu(r14, 4), j(zushr_have)
	sll(r13, 3) -> r15                 ; j >= 4 -> dst[i] = 0
	copyb(0, r11) -> r16
	add(r16, r15) -> r16
	copyb(r16, 0) -> 8[a + 0]
	jump(zushr_next)
zushr_have:
	sll(r14, 3) -> r15
	copyb(0, r10) -> r16
	add(r16, r15) -> r16
	copyb(r16, 8[a + 0]) -> r16        ; src[j]
	srl(r16, r7) -> r28                ; lo = src[j] >> bs
	eq(r7, 0), j(zushr_put)
	copyb(0, 3) -> r15
	eq(r14, r15), j(zushr_put)         ; j == 3 -> no higher word
	add(r14, 1) -> r29
	sll(r29, 3) -> r29
	copyb(0, r10) -> r30
	add(r30, r29) -> r30
	copyb(r30, 8[a + 0]) -> r30        ; src[j+1]
	copyb(0, 64) -> r31
	sub(r31, r7) -> r31
	sll(r30, r31) -> r30               ; hi = src[j+1] << (64-bs)
	or(r28, r30) -> r28
zushr_put:
	sll(r13, 3) -> r15
	copyb(0, r11) -> r16
	add(r16, r15) -> r16
	copyb(r16, r28) -> 8[a + 0]
zushr_next:
	copyb(0, 3) -> r15
	eq(r13, r15), j(zushr_done)
	add(r13, 1) -> r13
	jump(zushr_loop)
zushr_done:
	ret

; ---- zu_not4: dst = ~src over 4 limbs (leaf) [r10=src, r11=dst] --------------
zu_not4:
	copyb(0, r10) -> r5
	copyb(0, r11) -> r6
	copyb(r5, 8[a + 0]) -> r7
	xor(r7, 0xffffffffffffffff) -> r7
	copyb(r6, r7) -> 8[a + 0]
	copyb(r5, 8[a + 8]) -> r7
	xor(r7, 0xffffffffffffffff) -> r7
	copyb(r6, r7) -> 8[a + 8]
	copyb(r5, 8[a + 16]) -> r7
	xor(r7, 0xffffffffffffffff) -> r7
	copyb(r6, r7) -> 8[a + 16]
	copyb(r5, 8[a + 24]) -> r7
	xor(r7, 0xffffffffffffffff) -> r7
	copyb(r6, r7) -> 8[a + 24]
	ret

; ============================================================================
; Arithmetic operations (marshal -> precompile core -> marshal back)
; ============================================================================

; ---- BE scratch: the operands and result as LE limbs --------------------------
; The precompiles consume LE limbs, so the routines that fire one convert their
; big-endian operands here (one rev8 per limb) and their result back; with every
; pointer a fixed scratch word, their parameter blocks are fully preset.
u64 ZUB_A0[1] = 0
u64 ZUB_A1[1] = 0
u64 ZUB_A2[1] = 0
u64 ZUB_A3[1] = 0
u64 ZUB_B0[1] = 0       ; b, or ~b for sub
u64 ZUB_B1[1] = 0
u64 ZUB_B2[1] = 0
u64 ZUB_B3[1] = 0
u64 ZUB_N0[1] = 0
u64 ZUB_N1[1] = 0
u64 ZUB_N2[1] = 0
u64 ZUB_N3[1] = 0
u64 ZUB_R0[1] = 0
u64 ZUB_R1[1] = 0
u64 ZUB_R2[1] = 0
u64 ZUB_R3[1] = 0
u64 ZUB_HI[4] = 0, 0, 0, 0      ; discarded high halves
u64 ZUBA_A[1]   = ZUB_A0        ; add256 for add: &a, &b, cin = 0, &r
u64 ZUBA_B[1]   = ZUB_B0
u64 ZUBA_CIN[1] = 0
u64 ZUBA_C[1]   = ZUB_R0
u64 ZUBS_A[1]   = ZUB_A0        ; add256 for sub: &a, &~b, cin = 1, &r
u64 ZUBS_B[1]   = ZUB_B0
u64 ZUBS_CIN[1] = 1
u64 ZUBS_C[1]   = ZUB_R0
u64 ZUBM_A[1]   = ZUB_A0        ; arith256 for mul: &a, &b, &0, &r, &hi
u64 ZUBM_B[1]   = ZUB_B0
u64 ZUBM_C[1]   = U256_ZERO
u64 ZUBM_DL[1]  = ZUB_R0
u64 ZUBM_DH[1]  = ZUB_HI
u64 ZUBAM_A[1]  = ZUB_A0        ; arith256_mod for addmod: &a, &1, &b, &n, &r
u64 ZUBAM_B[1]  = U256_ONE
u64 ZUBAM_C[1]  = ZUB_B0
u64 ZUBAM_N[1]  = ZUB_N0
u64 ZUBAM_D[1]  = ZUB_R0
u64 ZUBMU_A[1]  = ZUB_A0        ; arith256_mod for mulmod: &a, &b, &0, &n, &r
u64 ZUBMU_B[1]  = ZUB_B0
u64 ZUBMU_C[1]  = U256_ZERO
u64 ZUBMU_N[1]  = ZUB_N0
u64 ZUBMU_D[1]  = ZUB_R0

; zkvm_status zkvm_u256_add(a, b, result) : (a + b) mod 2^256. Inline zkvmcall.
ziskasm_zkvm_u256_add:
	rev8(r10, 8[a + 24]) -> [ZUB_A0]
	rev8(r10, 8[a + 16]) -> [ZUB_A1]
	rev8(r10, 8[a + 8]) -> [ZUB_A2]
	rev8(r10, 8[a + 0]) -> [ZUB_A3]
	rev8(r11, 8[a + 24]) -> [ZUB_B0]
	rev8(r11, 8[a + 16]) -> [ZUB_B1]
	rev8(r11, 8[a + 8]) -> [ZUB_B2]
	rev8(r11, 8[a + 0]) -> [ZUB_B3]
	add256(0, ZUBA_A)                   ; carry out ignored (wrapping)
	rev8(r12, [ZUB_R0]) -> 8[a + 24]
	rev8(r12, [ZUB_R1]) -> 8[a + 16]
	rev8(r12, [ZUB_R2]) -> 8[a + 8]
	rev8(r12, [ZUB_R3]) -> 8[a + 0]
	ret

; zkvm_status zkvm_u256_sub(a, b, result) : (a - b) mod 2^256 = a + ~b + 1.
; Inline zkvmcall.
ziskasm_zkvm_u256_sub:
	rev8(r10, 8[a + 24]) -> [ZUB_A0]
	rev8(r10, 8[a + 16]) -> [ZUB_A1]
	rev8(r10, 8[a + 8]) -> [ZUB_A2]
	rev8(r10, 8[a + 0]) -> [ZUB_A3]
	rev8(r11, 8[a + 24])
	xor(c, 0xffffffffffffffff) -> [ZUB_B0]
	rev8(r11, 8[a + 16])
	xor(c, 0xffffffffffffffff) -> [ZUB_B1]
	rev8(r11, 8[a + 8])
	xor(c, 0xffffffffffffffff) -> [ZUB_B2]
	rev8(r11, 8[a + 0])
	xor(c, 0xffffffffffffffff) -> [ZUB_B3]
	add256(0, ZUBS_A)
	rev8(r12, [ZUB_R0]) -> 8[a + 24]
	rev8(r12, [ZUB_R1]) -> 8[a + 16]
	rev8(r12, [ZUB_R2]) -> 8[a + 8]
	rev8(r12, [ZUB_R3]) -> 8[a + 0]
	ret

; zkvm_status zkvm_u256_mul(a, b, result) : (a * b) mod 2^256. Inline zkvmcall.
ziskasm_zkvm_u256_mul:
	rev8(r10, 8[a + 24]) -> [ZUB_A0]
	rev8(r10, 8[a + 16]) -> [ZUB_A1]
	rev8(r10, 8[a + 8]) -> [ZUB_A2]
	rev8(r10, 8[a + 0]) -> [ZUB_A3]
	rev8(r11, 8[a + 24]) -> [ZUB_B0]
	rev8(r11, 8[a + 16]) -> [ZUB_B1]
	rev8(r11, 8[a + 8]) -> [ZUB_B2]
	rev8(r11, 8[a + 0]) -> [ZUB_B3]
	arith256(0, ZUBM_A)                 ; high 256 bits discarded (wrapping)
	rev8(r12, [ZUB_R0]) -> 8[a + 24]
	rev8(r12, [ZUB_R1]) -> 8[a + 16]
	rev8(r12, [ZUB_R2]) -> 8[a + 8]
	rev8(r12, [ZUB_R3]) -> 8[a + 0]
	ret

; zkvm_status zkvm_u256_div(a, b, quotient) : q = a / b; b == 0 -> 0 (EVM).
ziskasm_zkvm_u256_div:
	push r1
	call zu_load2
	copyb(0, ZU_B) -> r10
	call zu_iszero
	eq(r10, 0), j(zudiv_do)            ; b != 0 -> divide
	call zu_wr_zero
	copyb(0, 0) -> r10
	pop r1
	ret
zudiv_do:
	copyb(0, ZU_A) -> r10
	copyb(0, ZU_B) -> r11
	copyb(0, ZU_R) -> r12             ; q_out = ZU_R (written out)
	copyb(0, ZU_Q) -> r13             ; r_out = ZU_Q (discarded)
	call zisklib_div_rem256
	call zu_wr_r
	copyb(0, 0) -> r10
	pop r1
	ret

; zkvm_status zkvm_u256_mod(a, b, remainder) : r = a % b; b == 0 -> 0 (EVM).
ziskasm_zkvm_u256_mod:
	push r1
	call zu_load2
	copyb(0, ZU_B) -> r10
	call zu_iszero
	eq(r10, 0), j(zumod_do)
	call zu_wr_zero
	copyb(0, 0) -> r10
	pop r1
	ret
zumod_do:
	copyb(0, ZU_A) -> r10
	copyb(0, ZU_B) -> r11
	copyb(0, ZU_Q) -> r12             ; q_out discarded
	copyb(0, ZU_R) -> r13             ; r_out = ZU_R (written out)
	call zisklib_div_rem256
	call zu_wr_r
	copyb(0, 0) -> r10
	pop r1
	ret

; zkvm_status zkvm_u256_divmod(a, b, quotient, remainder) : b == 0 -> both 0.
ziskasm_zkvm_u256_divmod:
	push r1
	copyb(0, ZU_POUT) -> r5           ; quotient ptr
	copyb(r5, r12) -> 8[a + 0]
	copyb(0, ZU_POUT2) -> r5          ; remainder ptr
	copyb(r5, r13) -> 8[a + 0]
	copyb(0, ZU_PB) -> r5
	copyb(r5, r11) -> 8[a + 0]
	copyb(0, ZU_A) -> r11             ; marshal a
	copyb(0, 4) -> r12
	call zkvm_be_to_limbs
	copyb(0, ZU_PB) -> r10            ; marshal b
	copyb(r10, 8[a + 0]) -> r10
	copyb(0, ZU_B) -> r11
	copyb(0, 4) -> r12
	call zkvm_be_to_limbs
	copyb(0, ZU_B) -> r10
	call zu_iszero
	eq(r10, 0), j(zudm_do)
	; b == 0 -> quotient = remainder = 0
	copyb(0, ZU_POUT) -> r5
	copyb(r5, 8[a + 0]) -> r5
	copyb(r5, 0) -> 8[a + 0]
	copyb(r5, 0) -> 8[a + 8]
	copyb(r5, 0) -> 8[a + 16]
	copyb(r5, 0) -> 8[a + 24]
	copyb(0, ZU_POUT2) -> r5
	copyb(r5, 8[a + 0]) -> r5
	copyb(r5, 0) -> 8[a + 0]
	copyb(r5, 0) -> 8[a + 8]
	copyb(r5, 0) -> 8[a + 16]
	copyb(r5, 0) -> 8[a + 24]
	copyb(0, 0) -> r10
	pop r1
	ret
zudm_do:
	copyb(0, ZU_A) -> r10
	copyb(0, ZU_B) -> r11
	copyb(0, ZU_Q) -> r12
	copyb(0, ZU_R) -> r13
	call zisklib_div_rem256
	copyb(0, ZU_Q) -> r10             ; quotient -> POUT
	copyb(0, ZU_POUT) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(0, 4) -> r12
	call zkvm_limbs_to_be
	copyb(0, ZU_R) -> r10             ; remainder -> POUT2
	copyb(0, ZU_POUT2) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(0, 4) -> r12
	call zkvm_limbs_to_be
	copyb(0, 0) -> r10
	pop r1
	ret

; zkvm_status zkvm_u256_addmod(a, b, n, result) : (a * 1 + b) mod n; n == 0 -> 0.
; Inline zkvmcall. The operands are converted to LE scratch, n last, so c holds
; its top limb; n is tested from there down.
ziskasm_zkvm_u256_addmod:
	rev8(r10, 8[a + 24]) -> [ZUB_A0]
	rev8(r10, 8[a + 16]) -> [ZUB_A1]
	rev8(r10, 8[a + 8]) -> [ZUB_A2]
	rev8(r10, 8[a + 0]) -> [ZUB_A3]
	rev8(r11, 8[a + 24]) -> [ZUB_B0]
	rev8(r11, 8[a + 16]) -> [ZUB_B1]
	rev8(r11, 8[a + 8]) -> [ZUB_B2]
	rev8(r11, 8[a + 0]) -> [ZUB_B3]
	rev8(r12, 8[a + 24]) -> [ZUB_N0]
	rev8(r12, 8[a + 16]) -> [ZUB_N1]
	rev8(r12, 8[a + 8]) -> [ZUB_N2]
	rev8(r12, 8[a + 0]) -> [ZUB_N3]
	ltu(0, c), j(zubaddmod_go)                 ; n != 0
	copyb(0, [ZUB_N2])
	ltu(0, c), j(zubaddmod_go)
	copyb(0, [ZUB_N1])
	ltu(0, c), j(zubaddmod_go)
	copyb(0, [ZUB_N0])
	ltu(0, c), j(zubaddmod_go)
	copyb(r13, 0) -> 8[a + 0]
	copyb(r13, 0) -> 8[a + 8]
	copyb(r13, 0) -> 8[a + 16]
	copyb(r13, 0) -> 8[a + 24]
	ret
zubaddmod_go:
	arith256_mod(0, ZUBAM_A)
	rev8(r13, [ZUB_R0]) -> 8[a + 24]
	rev8(r13, [ZUB_R1]) -> 8[a + 16]
	rev8(r13, [ZUB_R2]) -> 8[a + 8]
	rev8(r13, [ZUB_R3]) -> 8[a + 0]
	ret

; zkvm_status zkvm_u256_mulmod(a, b, n, result) : (a * b + 0) mod n; n == 0 -> 0.
; Inline zkvmcall. The operands are converted to LE scratch, n last, so c holds
; its top limb; n is tested from there down.
ziskasm_zkvm_u256_mulmod:
	rev8(r10, 8[a + 24]) -> [ZUB_A0]
	rev8(r10, 8[a + 16]) -> [ZUB_A1]
	rev8(r10, 8[a + 8]) -> [ZUB_A2]
	rev8(r10, 8[a + 0]) -> [ZUB_A3]
	rev8(r11, 8[a + 24]) -> [ZUB_B0]
	rev8(r11, 8[a + 16]) -> [ZUB_B1]
	rev8(r11, 8[a + 8]) -> [ZUB_B2]
	rev8(r11, 8[a + 0]) -> [ZUB_B3]
	rev8(r12, 8[a + 24]) -> [ZUB_N0]
	rev8(r12, 8[a + 16]) -> [ZUB_N1]
	rev8(r12, 8[a + 8]) -> [ZUB_N2]
	rev8(r12, 8[a + 0]) -> [ZUB_N3]
	ltu(0, c), j(zubmulmod_go)                 ; n != 0
	copyb(0, [ZUB_N2])
	ltu(0, c), j(zubmulmod_go)
	copyb(0, [ZUB_N1])
	ltu(0, c), j(zubmulmod_go)
	copyb(0, [ZUB_N0])
	ltu(0, c), j(zubmulmod_go)
	copyb(r13, 0) -> 8[a + 0]
	copyb(r13, 0) -> 8[a + 8]
	copyb(r13, 0) -> 8[a + 16]
	copyb(r13, 0) -> 8[a + 24]
	ret
zubmulmod_go:
	arith256_mod(0, ZUBMU_A)
	rev8(r13, [ZUB_R0]) -> 8[a + 24]
	rev8(r13, [ZUB_R1]) -> 8[a + 16]
	rev8(r13, [ZUB_R2]) -> 8[a + 8]
	rev8(r13, [ZUB_R3]) -> 8[a + 0]
	ret

; zkvm_status zkvm_u256_exp(base, exponent, result) : base^exp mod 2^256.
ziskasm_zkvm_u256_exp:
	push r1
	call zu_load2                     ; ZU_A = base, ZU_B = exponent
	copyb(0, ZU_A) -> r10
	copyb(0, ZU_B) -> r11
	copyb(0, ZU_R) -> r12
	call zisklib_overflowing_pow256   ; wrapping (mod 2^256), overflow ignored
	call zu_wr_r
	copyb(0, 0) -> r10
	pop r1
	ret

; ============================================================================
; Signed arithmetic (two's complement via abs + sign)
; ============================================================================

; zkvm_status zkvm_u256_sdiv(a, b, quotient) : signed a / b, toward zero.
;   b == 0 -> 0. -2^255 / -1 = -2^255 falls out of abs (negate(2^255)=2^255).
ziskasm_zkvm_u256_sdiv:
	push r1
	call zu_load2
	copyb(0, ZU_B) -> r10
	call zu_iszero
	eq(r10, 0), j(zusd_do)
	call zu_wr_zero
	copyb(0, 0) -> r10
	pop r1
	ret
zusd_do:
	copyb(0, ZU_A) -> r10             ; |a| -> ZU_AA, sign_a
	copyb(0, ZU_AA) -> r11
	call zu_abs
	copyb(0, ZU_SA) -> r5
	copyb(r5, r10) -> 8[a + 0]
	copyb(0, ZU_B) -> r10             ; |b| -> ZU_BB, sign_b
	copyb(0, ZU_BB) -> r11
	call zu_abs
	copyb(0, ZU_SB) -> r5
	copyb(r5, r10) -> 8[a + 0]
	copyb(0, ZU_AA) -> r10            ; q = |a| / |b|
	copyb(0, ZU_BB) -> r11
	copyb(0, ZU_Q) -> r12
	copyb(0, ZU_R) -> r13
	call zisklib_div_rem256
	copyb(0, ZU_SA) -> r5             ; sign(q) = sign_a XOR sign_b
	copyb(r5, 8[a + 0]) -> r6
	copyb(0, ZU_SB) -> r5
	copyb(r5, 8[a + 0]) -> r7
	xor(r6, r7) -> r6
	eq(r6, 0), j(zusd_pos)
	copyb(0, ZU_Q) -> r10             ; negative quotient
	copyb(0, ZU_R) -> r11
	call zu_neg
	call zu_wr_r
	copyb(0, 0) -> r10
	pop r1
	ret
zusd_pos:
	copyb(0, ZU_Q) -> r10             ; positive quotient
	copyb(0, ZU_POUT) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(0, 4) -> r12
	call zkvm_limbs_to_be
	copyb(0, 0) -> r10
	pop r1
	ret

; zkvm_status zkvm_u256_smod(a, b, remainder) : signed a % b, sign follows a.
;   b == 0 -> 0.
ziskasm_zkvm_u256_smod:
	push r1
	call zu_load2
	copyb(0, ZU_B) -> r10
	call zu_iszero
	eq(r10, 0), j(zusm_do)
	call zu_wr_zero
	copyb(0, 0) -> r10
	pop r1
	ret
zusm_do:
	copyb(0, ZU_A) -> r10             ; |a| -> ZU_AA, sign_a
	copyb(0, ZU_AA) -> r11
	call zu_abs
	copyb(0, ZU_SA) -> r5
	copyb(r5, r10) -> 8[a + 0]
	copyb(0, ZU_B) -> r10             ; |b| -> ZU_BB
	copyb(0, ZU_BB) -> r11
	call zu_abs
	copyb(0, ZU_AA) -> r10            ; r = |a| % |b|
	copyb(0, ZU_BB) -> r11
	copyb(0, ZU_Q) -> r12
	copyb(0, ZU_R) -> r13
	call zisklib_div_rem256
	copyb(0, ZU_SA) -> r5             ; sign(r) = sign_a
	copyb(r5, 8[a + 0]) -> r6
	eq(r6, 0), j(zusm_pos)
	copyb(0, ZU_R) -> r10             ; negative remainder
	copyb(0, ZU_T) -> r11
	call zu_neg
	copyb(0, ZU_T) -> r10
	copyb(0, ZU_POUT) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(0, 4) -> r12
	call zkvm_limbs_to_be
	copyb(0, 0) -> r10
	pop r1
	ret
zusm_pos:
	call zu_wr_r                      ; remainder in ZU_R
	copyb(0, 0) -> r10
	pop r1
	ret

; zkvm_status zkvm_u256_sdivmod(a, b, quotient, remainder) : signed, b == 0 -> 0.
ziskasm_zkvm_u256_sdivmod:
	push r1
	copyb(0, ZU_POUT) -> r5           ; quotient ptr
	copyb(r5, r12) -> 8[a + 0]
	copyb(0, ZU_POUT2) -> r5          ; remainder ptr
	copyb(r5, r13) -> 8[a + 0]
	copyb(0, ZU_PB) -> r5
	copyb(r5, r11) -> 8[a + 0]
	copyb(0, ZU_A) -> r11             ; marshal a
	copyb(0, 4) -> r12
	call zkvm_be_to_limbs
	copyb(0, ZU_PB) -> r10            ; marshal b
	copyb(r10, 8[a + 0]) -> r10
	copyb(0, ZU_B) -> r11
	copyb(0, 4) -> r12
	call zkvm_be_to_limbs
	copyb(0, ZU_B) -> r10
	call zu_iszero
	eq(r10, 0), j(zusdm_do)
	; b == 0 -> quotient = remainder = 0
	copyb(0, ZU_POUT) -> r5
	copyb(r5, 8[a + 0]) -> r5
	copyb(r5, 0) -> 8[a + 0]
	copyb(r5, 0) -> 8[a + 8]
	copyb(r5, 0) -> 8[a + 16]
	copyb(r5, 0) -> 8[a + 24]
	copyb(0, ZU_POUT2) -> r5
	copyb(r5, 8[a + 0]) -> r5
	copyb(r5, 0) -> 8[a + 0]
	copyb(r5, 0) -> 8[a + 8]
	copyb(r5, 0) -> 8[a + 16]
	copyb(r5, 0) -> 8[a + 24]
	copyb(0, 0) -> r10
	pop r1
	ret
zusdm_do:
	copyb(0, ZU_A) -> r10             ; |a|, sign_a
	copyb(0, ZU_AA) -> r11
	call zu_abs
	copyb(0, ZU_SA) -> r5
	copyb(r5, r10) -> 8[a + 0]
	copyb(0, ZU_B) -> r10             ; |b|, sign_b
	copyb(0, ZU_BB) -> r11
	call zu_abs
	copyb(0, ZU_SB) -> r5
	copyb(r5, r10) -> 8[a + 0]
	copyb(0, ZU_AA) -> r10
	copyb(0, ZU_BB) -> r11
	copyb(0, ZU_Q) -> r12
	copyb(0, ZU_R) -> r13
	call zisklib_div_rem256
	; quotient: sign = sign_a XOR sign_b
	copyb(0, ZU_SA) -> r5
	copyb(r5, 8[a + 0]) -> r6
	copyb(0, ZU_SB) -> r5
	copyb(r5, 8[a + 0]) -> r7
	xor(r6, r7) -> r6
	eq(r6, 0), j(zusdm_qpos)
	copyb(0, ZU_Q) -> r10
	copyb(0, ZU_T) -> r11
	call zu_neg
	copyb(0, ZU_T) -> r10
	jump(zusdm_qwr)
zusdm_qpos:
	copyb(0, ZU_Q) -> r10
zusdm_qwr:
	copyb(0, ZU_POUT) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(0, 4) -> r12
	call zkvm_limbs_to_be
	; remainder: sign = sign_a
	copyb(0, ZU_SA) -> r5
	copyb(r5, 8[a + 0]) -> r6
	eq(r6, 0), j(zusdm_rpos)
	copyb(0, ZU_R) -> r10
	copyb(0, ZU_T) -> r11
	call zu_neg
	copyb(0, ZU_T) -> r10
	jump(zusdm_rwr)
zusdm_rpos:
	copyb(0, ZU_R) -> r10
zusdm_rwr:
	copyb(0, ZU_POUT2) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(0, 4) -> r12
	call zkvm_limbs_to_be
	copyb(0, 0) -> r10
	pop r1
	ret

; ============================================================================
; Comparison operations (result is a big-endian U256, 0 or 1)
; ============================================================================

; zkvm_status zkvm_u256_lt(a, b, result) : a < b (unsigned). Inline zkvmcall:
; from the most significant limb down, the first that differs decides.
ziskasm_zkvm_u256_lt:
	rev8(r10, 8[a + 0]) -> r32
	rev8(r11, 8[a + 0]) -> r33
zublt_3:                                ; r32/r33 = most significant limbs of a/b
	ltu(r32, r33), j(zublt_one)
	ltu(r33, r32), j(zublt_zero)
	rev8(r10, 8[a + 8]) -> r32
	rev8(r11, 8[a + 8]) -> r33
	ltu(r32, r33), j(zublt_one)
	ltu(r33, r32), j(zublt_zero)
	rev8(r10, 8[a + 16]) -> r32
	rev8(r11, 8[a + 16]) -> r33
	ltu(r32, r33), j(zublt_one)
	ltu(r33, r32), j(zublt_zero)
	rev8(r10, 8[a + 24]) -> r32
	rev8(r11, 8[a + 24]) -> r33
	ltu(r32, r33), j(zublt_one)
	jump(zublt_zero)                    ; equal
zublt_zero:
	copyb(r12, 0) -> 8[a + 24]
	jump(zublt_w)
zublt_one:
	copyb(r12, 0x100000000000000) -> 8[a + 24]
zublt_w:
	copyb(r12, 0) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 0]
	ret

; zkvm_status zkvm_u256_gt(a, b, result) : a > b (unsigned). Inline zkvmcall:
; from the most significant limb down, the first that differs decides.
ziskasm_zkvm_u256_gt:
	rev8(r10, 8[a + 0]) -> r32
	rev8(r11, 8[a + 0]) -> r33
zubgt_3:                                ; r32/r33 = most significant limbs of a/b
	ltu(r33, r32), j(zubgt_one)
	ltu(r32, r33), j(zubgt_zero)
	rev8(r10, 8[a + 8]) -> r32
	rev8(r11, 8[a + 8]) -> r33
	ltu(r33, r32), j(zubgt_one)
	ltu(r32, r33), j(zubgt_zero)
	rev8(r10, 8[a + 16]) -> r32
	rev8(r11, 8[a + 16]) -> r33
	ltu(r33, r32), j(zubgt_one)
	ltu(r32, r33), j(zubgt_zero)
	rev8(r10, 8[a + 24]) -> r32
	rev8(r11, 8[a + 24]) -> r33
	ltu(r33, r32), j(zubgt_one)
	jump(zubgt_zero)                    ; equal
zubgt_zero:
	copyb(r12, 0) -> 8[a + 24]
	jump(zubgt_w)
zubgt_one:
	copyb(r12, 0x100000000000000) -> 8[a + 24]
zubgt_w:
	copyb(r12, 0) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 0]
	ret

; zkvm_status zkvm_u256_slt(a, b, result) : a < b (signed). Inline zkvmcall.
; Signs differ: the result is the sign of a; same sign: the unsigned order.
ziskasm_zkvm_u256_slt:
	rev8(r10, 8[a + 0]) -> r32
	rev8(r11, 8[a + 0]) -> r33
	xor(r32, r33)
	lt(c, 0), j(zubslt_diff)         ; the signs differ
	jump(zublt_3)
zubslt_diff:
	srl(r32, 63)
	rev8(r12, c) -> 8[a + 24]
	copyb(r12, 0) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 0]
	ret

; zkvm_status zkvm_u256_sgt(a, b, result) : a > b (signed). Inline zkvmcall.
; Signs differ: the result is the sign of b; same sign: the unsigned order.
ziskasm_zkvm_u256_sgt:
	rev8(r10, 8[a + 0]) -> r32
	rev8(r11, 8[a + 0]) -> r33
	xor(r32, r33)
	lt(c, 0), j(zubsgt_diff)         ; the signs differ
	jump(zubgt_3)
zubsgt_diff:
	srl(r33, 63)
	rev8(r12, c) -> 8[a + 24]
	copyb(r12, 0) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 0]
	ret

; zkvm_status zkvm_u256_eq(a, b, result) : a == b. Inline zkvmcall,
; branchless: the limb differences OR-ed into r33, then eq leaves the 0/1 result
; in c. The result is written after every load, so it may alias a or b.
ziskasm_zkvm_u256_eq:
	rev8(r10, 8[a + 24]) -> r32
	rev8(r11, 8[a + 24])
	xor(r32, c) -> r33
	rev8(r10, 8[a + 16]) -> r32
	rev8(r11, 8[a + 16])
	xor(r32, c)
	or(r33, c) -> r33
	rev8(r10, 8[a + 8]) -> r32
	rev8(r11, 8[a + 8])
	xor(r32, c)
	or(r33, c) -> r33
	rev8(r10, 8[a + 0]) -> r32
	rev8(r11, 8[a + 0])
	xor(r32, c)
	or(r33, c)
	eq(c, 0)
	rev8(r12, c) -> 8[a + 24]
	copyb(r12, 0) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 0]
	ret

; zkvm_status zkvm_u256_iszero(a, result) : a == 0. Inline zkvmcall,
; branchless: the limbs OR-ed through r32 and c, then eq leaves the 0/1 result
; in c.
ziskasm_zkvm_u256_iszero:
	rev8(r10, 8[a + 24]) -> r32
	rev8(r10, 8[a + 16])
	or(r32, c) -> r32
	rev8(r10, 8[a + 8])
	or(r32, c) -> r32
	rev8(r10, 8[a + 0])
	or(r32, c)
	eq(c, 0)
	rev8(r11, c) -> 8[a + 24]
	copyb(r11, 0) -> 8[a + 16]
	copyb(r11, 0) -> 8[a + 8]
	copyb(r11, 0) -> 8[a + 0]
	ret

; zkvm_status zkvm_u256_and(a, b, result). Inline zkvmcall: a's limb in r32,
; b's in c.
ziskasm_zkvm_u256_and:
	rev8(r10, 8[a + 24]) -> r32
	rev8(r11, 8[a + 24])
	and(r32, c)
	rev8(r12, c) -> 8[a + 24]
	rev8(r10, 8[a + 16]) -> r32
	rev8(r11, 8[a + 16])
	and(r32, c)
	rev8(r12, c) -> 8[a + 16]
	rev8(r10, 8[a + 8]) -> r32
	rev8(r11, 8[a + 8])
	and(r32, c)
	rev8(r12, c) -> 8[a + 8]
	rev8(r10, 8[a + 0]) -> r32
	rev8(r11, 8[a + 0])
	and(r32, c)
	rev8(r12, c) -> 8[a + 0]
	ret

; zkvm_status zkvm_u256_or(a, b, result). Inline zkvmcall: a's limb in r32,
; b's in c.
ziskasm_zkvm_u256_or:
	rev8(r10, 8[a + 24]) -> r32
	rev8(r11, 8[a + 24])
	or(r32, c)
	rev8(r12, c) -> 8[a + 24]
	rev8(r10, 8[a + 16]) -> r32
	rev8(r11, 8[a + 16])
	or(r32, c)
	rev8(r12, c) -> 8[a + 16]
	rev8(r10, 8[a + 8]) -> r32
	rev8(r11, 8[a + 8])
	or(r32, c)
	rev8(r12, c) -> 8[a + 8]
	rev8(r10, 8[a + 0]) -> r32
	rev8(r11, 8[a + 0])
	or(r32, c)
	rev8(r12, c) -> 8[a + 0]
	ret

; zkvm_status zkvm_u256_xor(a, b, result). Inline zkvmcall: a's limb in r32,
; b's in c.
ziskasm_zkvm_u256_xor:
	rev8(r10, 8[a + 24]) -> r32
	rev8(r11, 8[a + 24])
	xor(r32, c)
	rev8(r12, c) -> 8[a + 24]
	rev8(r10, 8[a + 16]) -> r32
	rev8(r11, 8[a + 16])
	xor(r32, c)
	rev8(r12, c) -> 8[a + 16]
	rev8(r10, 8[a + 8]) -> r32
	rev8(r11, 8[a + 8])
	xor(r32, c)
	rev8(r12, c) -> 8[a + 8]
	rev8(r10, 8[a + 0]) -> r32
	rev8(r11, 8[a + 0])
	xor(r32, c)
	rev8(r12, c) -> 8[a + 0]
	ret

; zkvm_status zkvm_u256_not(a, result). An inline zkvmcall: the transpiler
; expands the body (up to the `ret`) at the call site, on the caller's registers
; for a (r10) and result (r11). Each limb goes through c (load, xor, store), so
; it writes no register at all, only memory, and needs no temporary.
ziskasm_zkvm_u256_not:
	rev8(r10, 8[a + 24])
	xor(c, 0xffffffffffffffff)
	rev8(r11, c) -> 8[a + 24]
	rev8(r10, 8[a + 16])
	xor(c, 0xffffffffffffffff)
	rev8(r11, c) -> 8[a + 16]
	rev8(r10, 8[a + 8])
	xor(c, 0xffffffffffffffff)
	rev8(r11, c) -> 8[a + 8]
	rev8(r10, 8[a + 0])
	xor(c, 0xffffffffffffffff)
	rev8(r11, c) -> 8[a + 0]
	ret

; zkvm_status zkvm_u256_byte(i, a, result) : byte i of a counting from the
; most significant (EVM BYTE), which in big-endian memory is at a + i.
; Inline zkvmcall.
ziskasm_zkvm_u256_byte:
	rev8(r10, 8[a + 16]) -> r32
	rev8(r10, 8[a + 8])
	or(r32, c) -> r32
	rev8(r10, 8[a + 0])
	or(r32, c)
	eq(c, 0), j(zubby_lo)
	jump(zubby_big)
zubby_lo:
	rev8(r10, 8[a + 24]) -> r33
	ltu(c, 32), j(zubby_ok)
	jump(zubby_big)
zubby_ok:
	add(r11, r33)                      ; BE: byte i is at a + i
	copyb(c, 1[a + 0])
	rev8(r12, c) -> 8[a + 24]
	copyb(r12, 0) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 0]
	ret
zubby_big:
	copyb(r12, 0) -> 8[a + 24]
	copyb(r12, 0) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 0]
	ret

; zkvm_status zkvm_u256_shl(shift, value, result) : value << shift; shift >=
; 256 -> 0. Inline zkvmcall. r33 = shift (< 256), r34 = b = shift % 64, r35 = 64
; - b; a case per word shift q, each output limb built from two input limbs read
; in descending order (so the result may alias the value).
ziskasm_zkvm_u256_shl:
	rev8(r10, 8[a + 16]) -> r32
	rev8(r10, 8[a + 8])
	or(r32, c) -> r32
	rev8(r10, 8[a + 0])
	or(r32, c)
	eq(c, 0), j(zubshl_lo)
	jump(zubshl_big)
zubshl_lo:
	rev8(r10, 8[a + 24]) -> r33
	ltu(c, 256), j(zubshl_ok)
	jump(zubshl_big)
zubshl_ok:
	ltu(r33, 64), j(zubshl_q0)
	ltu(r33, 128), j(zubshl_q1)
	ltu(r33, 192), j(zubshl_q2)
	jump(zubshl_q3)
zubshl_q0:
	and(r33, 63) -> r34
	eq(c, 0), j(zubshl_q0_w)
	sub(64, r34) -> r35
	rev8(r11, 8[a + 0])
	sll(c, r34) -> r36
	rev8(r11, 8[a + 8]) -> r37
	srl(c, r35)
	or(r36, c)
	rev8(r12, c) -> 8[a + 0]
	sll(r37, r34) -> r36
	rev8(r11, 8[a + 16]) -> r37
	srl(c, r35)
	or(r36, c)
	rev8(r12, c) -> 8[a + 8]
	sll(r37, r34) -> r36
	rev8(r11, 8[a + 24]) -> r37
	srl(c, r35)
	or(r36, c)
	rev8(r12, c) -> 8[a + 16]
	sll(r37, r34)
	rev8(r12, c) -> 8[a + 24]
	ret
zubshl_q0_w:
	rev8(r11, 8[a + 0])
	rev8(r12, c) -> 8[a + 0]
	rev8(r11, 8[a + 8])
	rev8(r12, c) -> 8[a + 8]
	rev8(r11, 8[a + 16])
	rev8(r12, c) -> 8[a + 16]
	rev8(r11, 8[a + 24])
	rev8(r12, c) -> 8[a + 24]
	ret
zubshl_q1:
	and(r33, 63) -> r34
	eq(c, 0), j(zubshl_q1_w)
	sub(64, r34) -> r35
	rev8(r11, 8[a + 8])
	sll(c, r34) -> r36
	rev8(r11, 8[a + 16]) -> r37
	srl(c, r35)
	or(r36, c)
	rev8(r12, c) -> 8[a + 0]
	sll(r37, r34) -> r36
	rev8(r11, 8[a + 24]) -> r37
	srl(c, r35)
	or(r36, c)
	rev8(r12, c) -> 8[a + 8]
	sll(r37, r34)
	rev8(r12, c) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 24]
	ret
zubshl_q1_w:
	rev8(r11, 8[a + 8])
	rev8(r12, c) -> 8[a + 0]
	rev8(r11, 8[a + 16])
	rev8(r12, c) -> 8[a + 8]
	rev8(r11, 8[a + 24])
	rev8(r12, c) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 24]
	ret
zubshl_q2:
	and(r33, 63) -> r34
	eq(c, 0), j(zubshl_q2_w)
	sub(64, r34) -> r35
	rev8(r11, 8[a + 16])
	sll(c, r34) -> r36
	rev8(r11, 8[a + 24]) -> r37
	srl(c, r35)
	or(r36, c)
	rev8(r12, c) -> 8[a + 0]
	sll(r37, r34)
	rev8(r12, c) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 24]
	ret
zubshl_q2_w:
	rev8(r11, 8[a + 16])
	rev8(r12, c) -> 8[a + 0]
	rev8(r11, 8[a + 24])
	rev8(r12, c) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 24]
	ret
zubshl_q3:
	and(r33, 63) -> r34
	eq(c, 0), j(zubshl_q3_w)
	sub(64, r34) -> r35
	rev8(r11, 8[a + 24])
	sll(c, r34)
	rev8(r12, c) -> 8[a + 0]
	copyb(r12, 0) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 24]
	ret
zubshl_q3_w:
	rev8(r11, 8[a + 24])
	rev8(r12, c) -> 8[a + 0]
	copyb(r12, 0) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 24]
	ret
zubshl_big:
	copyb(r12, 0) -> 8[a + 24]
	copyb(r12, 0) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 0]
	ret

; zkvm_status zkvm_u256_shr(shift, value, result) : value >> shift; shift >=
