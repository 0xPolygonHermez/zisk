	copyb(r11, 8[a + 0])
	srl(c, r34) -> r36
	copyb(r11, 8[a + 8]) -> r37
	sll(c, r35)
	or(r36, c)
	copyb(r12, c) -> 8[a + 0]
	srl(r37, r34) -> r36
	copyb(r11, 8[a + 16]) -> r37
	sll(c, r35)
	or(r36, c)
	copyb(r12, c) -> 8[a + 8]
	srl(r37, r34) -> r36
	copyb(r11, 8[a + 24]) -> r37
	sll(c, r35)
	or(r36, c)
	copyb(r12, c) -> 8[a + 16]
	sra(r37, r34)
	copyb(r12, c) -> 8[a + 24]
