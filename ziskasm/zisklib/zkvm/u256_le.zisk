; void zkvm_u256_le_signextend(b, value, result) : extend the sign of byte b
; (0 = least significant); b >= 31 -> value unchanged. Inline zkvmcall. Byte b
; is in limb q = b / 8, whose top bit is 8 * (b % 8) + 7: shifting the limb left
; and then arithmetically right by r34 = t = 8 * (7 - b % 8) extends it, and its
; sign fills the limbs above.
ziskasm_zkvm_u256_le_signextend:
	copyb(r10, 8[a + 8]) -> r32
	copyb(r10, 8[a + 16])
	or(r32, c) -> r32
	copyb(r10, 8[a + 24])
	or(r32, c)
	eq(c, 0), j(zulse_lo)
	jump(zulse_big)
zulse_lo:
	copyb(r10, 8[a + 0]) -> r33
	ltu(c, 31), j(zulse_ok)
	jump(zulse_big)
zulse_ok:
	and(r33, 7)
	xor(c, 7)                           ; 7 - b % 8
	sll(c, 3) -> r34
	ltu(r33, 8), j(zulse_q0)
	ltu(r33, 16), j(zulse_q1)
	ltu(r33, 24), j(zulse_q2)
	jump(zulse_q3)
zulse_q0:
	copyb(r11, 8[a + 0])
	sll(c, r34)
	sra(c, r34)
	copyb(r12, c) -> 8[a + 0]
	sra(c, 63)
	copyb(r12, c) -> 8[a + 8]
	copyb(r12, c) -> 8[a + 16]
	copyb(r12, c) -> 8[a + 24]
	ret
zulse_q1:
	copyb(r11, 8[a + 0])
	copyb(r12, c) -> 8[a + 0]
	copyb(r11, 8[a + 8])
	sll(c, r34)
	sra(c, r34)
	copyb(r12, c) -> 8[a + 8]
	sra(c, 63)
	copyb(r12, c) -> 8[a + 16]
	copyb(r12, c) -> 8[a + 24]
	ret
zulse_q2:
	copyb(r11, 8[a + 0])
	copyb(r12, c) -> 8[a + 0]
	copyb(r11, 8[a + 8])
	copyb(r12, c) -> 8[a + 8]
	copyb(r11, 8[a + 16])
	sll(c, r34)
	sra(c, r34)
	copyb(r12, c) -> 8[a + 16]
	sra(c, 63)
	copyb(r12, c) -> 8[a + 24]
	ret
zulse_q3:
	copyb(r11, 8[a + 0])
	copyb(r12, c) -> 8[a + 0]
	copyb(r11, 8[a + 8])
	copyb(r12, c) -> 8[a + 8]
	copyb(r11, 8[a + 16])
	copyb(r12, c) -> 8[a + 16]
	copyb(r11, 8[a + 24])
	sll(c, r34)
	sra(c, r34)
	copyb(r12, c) -> 8[a + 24]
	ret
zulse_big:
	copyb(r11, 8[a + 0])
	copyb(r12, c) -> 8[a + 0]
	copyb(r11, 8[a + 8])
	copyb(r12, c) -> 8[a + 8]
	copyb(r11, 8[a + 16])
	copyb(r12, c) -> 8[a + 16]
	copyb(r11, 8[a + 24])
	copyb(r12, c) -> 8[a + 24]
	ret
