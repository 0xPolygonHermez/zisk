	or(r36, c)
	copyb(r12, c) -> 8[a + 0]
	srl(r37, r34) -> r36
	copyb(r11, 8[a + 24]) -> r37
	sll(c, r35)
	or(r36, c)
	copyb(r12, c) -> 8[a + 8]
	sra(r37, r34)
	copyb(r12, c) -> 8[a + 16]
	copyb(r12, r38) -> 8[a + 24]
	ret
zulsar_q1_w:
	copyb(r11, 8[a + 8])
	copyb(r12, c) -> 8[a + 0]
	copyb(r11, 8[a + 16])
	copyb(r12, c) -> 8[a + 8]
	copyb(r11, 8[a + 24])
	copyb(r12, c) -> 8[a + 16]
	copyb(r12, r38) -> 8[a + 24]
