	copyb(r11, 8[a + 8])
	copyb(r12, c) -> 8[a + 8]
	copyb(r11, 8[a + 16])
	copyb(r12, c) -> 8[a + 16]
	copyb(r11, 8[a + 24])
	copyb(r12, c) -> 8[a + 24]
	ret
zulsar_q1:
	and(r33, 63) -> r34
	eq(c, 0), j(zulsar_q1_w)
	sub(64, r34) -> r35
	copyb(r11, 8[a + 8])
	srl(c, r34) -> r36
	copyb(r11, 8[a + 16]) -> r37
