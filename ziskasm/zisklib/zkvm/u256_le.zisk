; ============================================================================
; zkvm/u256_le.zisk - the little-endian U256 ABI (ziskasm/lang/c/include/
; zkvm_u256_le.h). Entry points `ziskasm_zkvm_u256_le_*`, reached through
; zkvmcalls: the header's default implementation calls all 27 functions here
; (-DZKVM_U256_LE_INLINE switches all but the division family to inline C).
;
; Every value is 4 little-endian u64 limbs (limb 0 least significant), the layout
; the precompiles consume, so there is nothing to byte-reverse. Apart from the
; division family, every routine is a leaf: straight-line code in caller-saved
; registers, firing its precompile itself on parameter blocks written with
; absolute stores (no push/pop, no nested calls, no pointer spills). div, mod
; and divmod are straight-line leaves too, around the division hint; the signed
; division family keeps the bodies of zkvm/u256.zisk with the big-endian
; marshalling replaced by plain 4-word copies. Every routine reads
; all of its inputs before writing its output, so results may alias inputs.
; Scratch (ZU_*) and the zu_* limb helpers are shared with zkvm/u256.zisk.
; Labels `zul*`.
; ============================================================================

; ---- LE helpers -------------------------------------------------------------

; zul_load2: [r10=a_ptr, r11=b_ptr, r12=result_ptr]. Spills result_ptr to ZU_POUT
; and b_ptr to ZU_PB, copies a -> ZU_A and b -> ZU_B. Leaf (no nested call).
zul_load2:
	copyb(0, ZU_POUT) -> r5
	copyb(r5, r12) -> 8[a + 0]
	copyb(0, ZU_PB) -> r5
	copyb(r5, r11) -> 8[a + 0]
	copyb(0, ZU_A) -> r5
	copyb(r10, 8[a + 0]) -> r6
	copyb(r5, r6) -> 8[a + 0]
	copyb(r10, 8[a + 8]) -> r6
	copyb(r5, r6) -> 8[a + 8]
	copyb(r10, 8[a + 16]) -> r6
	copyb(r5, r6) -> 8[a + 16]
	copyb(r10, 8[a + 24]) -> r6
	copyb(r5, r6) -> 8[a + 24]
	copyb(0, ZU_B) -> r5
	copyb(r11, 8[a + 0]) -> r6
	copyb(r5, r6) -> 8[a + 0]
	copyb(r11, 8[a + 8]) -> r6
	copyb(r5, r6) -> 8[a + 8]
	copyb(r11, 8[a + 16]) -> r6
	copyb(r5, r6) -> 8[a + 16]
	copyb(r11, 8[a + 24]) -> r6
	copyb(r5, r6) -> 8[a + 24]
	ret

; zul_wr_r: copy ZU_R to the result pointer spilled in ZU_POUT. Leaf.
zul_wr_r:
	copyb(0, ZU_POUT) -> r5
	copyb(r5, 8[a + 0]) -> r5
	copyb(0, ZU_R) -> r7
	copyb(r7, 8[a + 0]) -> r6
	copyb(r5, r6) -> 8[a + 0]
	copyb(r7, 8[a + 8]) -> r6
	copyb(r5, r6) -> 8[a + 8]
	copyb(r7, 8[a + 16]) -> r6
	copyb(r5, r6) -> 8[a + 16]
	copyb(r7, 8[a + 24]) -> r6
	copyb(r5, r6) -> 8[a + 24]
	ret

; zul_copy4: [r10=src, r11=dst] copy 4 words (r12, the limb count, is ignored:
; the call sites are the former zkvm_be_to_limbs / zkvm_limbs_to_be calls with
; nlimbs = 4). Leaf.
zul_copy4:
	copyb(r10, 8[a + 0]) -> r6
	copyb(r11, r6) -> 8[a + 0]
	copyb(r10, 8[a + 8]) -> r6
	copyb(r11, r6) -> 8[a + 8]
	copyb(r10, 8[a + 16]) -> r6
	copyb(r11, r6) -> 8[a + 16]
	copyb(r10, 8[a + 24]) -> r6
	copyb(r11, r6) -> 8[a + 24]
	ret

; ============================================================================
; Entry points
; ============================================================================

; zkvm_status zkvm_u256_le_div(a, b, quotient) : q = a / b; b == 0 -> 0 (EVM).
; The division family's unsigned routines are straight-line leaves around the
; FCALL_UINT256_DIV hint: q and r are read into ZULD_Q/ZULD_R, checked with one
; arith256 (a == q * b + r, no high part) and r < b, and only then written out,
; so the results may alias a or b. A failed check halts (zuld_panic).
ziskasm_zkvm_u256_le_div:
	copyb(r11, 8[a + 24])
	ltu(0, c), j(zuldiv_go)          ; b != 0
	copyb(r11, 8[a + 16])
	ltu(0, c), j(zuldiv_go)          ; b != 0
	copyb(r11, 8[a + 8])
	ltu(0, c), j(zuldiv_go)          ; b != 0
	copyb(r11, 8[a + 0])
	ltu(0, c), j(zuldiv_go)          ; b != 0
	; b == 0 -> 0
	copyb(r12, 0) -> 8[a + 0]
	copyb(r12, 0) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 24]
	copyb(0, 0) -> r10
	ret
zuldiv_go:
	fcall_param(4, r10)                 ; hint q, r = a / b, a % b
	fcall_param(4, r11)
	fcall(FCALL_UINT256_DIV, 0)
	fcall_get(0, [FREE_INPUT]) -> [ZULD_Q0]
	fcall_get(0, [FREE_INPUT]) -> [ZULD_Q1]
	fcall_get(0, [FREE_INPUT]) -> [ZULD_Q2]
	fcall_get(0, [FREE_INPUT]) -> [ZULD_Q3]
	fcall_get(0, [FREE_INPUT]) -> [ZULD_R0]
	fcall_get(0, [FREE_INPUT]) -> [ZULD_R1]
	fcall_get(0, [FREE_INPUT]) -> [ZULD_R2]
	copyb(0, [FREE_INPUT]) -> [ZULD_R3]
	copyb(0, r11) -> [ZULD_HB]
	arith256(0, ZULD_HA)                ; dl:dh = q * b + r
	copyb(r10, 8[a + 0])
	eq(c, [ZULD_DL0]), j(zuldiv_dl0)
	jump(zuld_panic)
zuldiv_dl0:
	copyb(r10, 8[a + 8])
	eq(c, [ZULD_DL1]), j(zuldiv_dl1)
	jump(zuld_panic)
zuldiv_dl1:
	copyb(r10, 8[a + 16])
	eq(c, [ZULD_DL2]), j(zuldiv_dl2)
	jump(zuld_panic)
zuldiv_dl2:
	copyb(r10, 8[a + 24])
	eq(c, [ZULD_DL3]), j(zuldiv_dl3)
	jump(zuld_panic)
zuldiv_dl3:
	copyb(0, [ZULD_DH0])                ; dh == 0
	or(c, [ZULD_DH1])
	or(c, [ZULD_DH2])
	or(c, [ZULD_DH3])
	eq(c, 0), j(zuldiv_lt)
	jump(zuld_panic)
zuldiv_lt:
	copyb(r11, 8[a + 24]) -> r5
	ltu([ZULD_R3], r5), j(zuldiv_ok)
	ltu(r5, [ZULD_R3]), j(zuld_panic)
	copyb(r11, 8[a + 16]) -> r5
	ltu([ZULD_R2], r5), j(zuldiv_ok)
	ltu(r5, [ZULD_R2]), j(zuld_panic)
	copyb(r11, 8[a + 8]) -> r5
	ltu([ZULD_R1], r5), j(zuldiv_ok)
	ltu(r5, [ZULD_R1]), j(zuld_panic)
	copyb(r11, 8[a + 0]) -> r5
	ltu([ZULD_R0], r5), j(zuldiv_ok)
	ltu(r5, [ZULD_R0]), j(zuld_panic)
	jump(zuld_panic)                    ; r == b
zuldiv_ok:
	copyb(r12, [ZULD_Q0]) -> 8[a + 0]
	copyb(r12, [ZULD_Q1]) -> 8[a + 8]
	copyb(r12, [ZULD_Q2]) -> 8[a + 16]
	copyb(r12, [ZULD_Q3]) -> 8[a + 24]
	copyb(0, 0) -> r10
	ret

; zkvm_status zkvm_u256_le_mod(a, b, remainder) : r = a % b; b == 0 -> 0 (EVM).
ziskasm_zkvm_u256_le_mod:
	copyb(r11, 8[a + 24])
	ltu(0, c), j(zulmod_go)          ; b != 0
	copyb(r11, 8[a + 16])
	ltu(0, c), j(zulmod_go)          ; b != 0
	copyb(r11, 8[a + 8])
	ltu(0, c), j(zulmod_go)          ; b != 0
	copyb(r11, 8[a + 0])
	ltu(0, c), j(zulmod_go)          ; b != 0
	; b == 0 -> 0
	copyb(r12, 0) -> 8[a + 0]
	copyb(r12, 0) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 24]
	copyb(0, 0) -> r10
	ret
zulmod_go:
	fcall_param(4, r10)                 ; hint q, r = a / b, a % b
	fcall_param(4, r11)
	fcall(FCALL_UINT256_DIV, 0)
	fcall_get(0, [FREE_INPUT]) -> [ZULD_Q0]
	fcall_get(0, [FREE_INPUT]) -> [ZULD_Q1]
	fcall_get(0, [FREE_INPUT]) -> [ZULD_Q2]
	fcall_get(0, [FREE_INPUT]) -> [ZULD_Q3]
	fcall_get(0, [FREE_INPUT]) -> [ZULD_R0]
	fcall_get(0, [FREE_INPUT]) -> [ZULD_R1]
	fcall_get(0, [FREE_INPUT]) -> [ZULD_R2]
	copyb(0, [FREE_INPUT]) -> [ZULD_R3]
	copyb(0, r11) -> [ZULD_HB]
	arith256(0, ZULD_HA)                ; dl:dh = q * b + r
	copyb(r10, 8[a + 0])
	eq(c, [ZULD_DL0]), j(zulmod_dl0)
	jump(zuld_panic)
zulmod_dl0:
	copyb(r10, 8[a + 8])
	eq(c, [ZULD_DL1]), j(zulmod_dl1)
	jump(zuld_panic)
zulmod_dl1:
	copyb(r10, 8[a + 16])
	eq(c, [ZULD_DL2]), j(zulmod_dl2)
	jump(zuld_panic)
zulmod_dl2:
	copyb(r10, 8[a + 24])
	eq(c, [ZULD_DL3]), j(zulmod_dl3)
	jump(zuld_panic)
zulmod_dl3:
	copyb(0, [ZULD_DH0])                ; dh == 0
	or(c, [ZULD_DH1])
	or(c, [ZULD_DH2])
	or(c, [ZULD_DH3])
	eq(c, 0), j(zulmod_lt)
	jump(zuld_panic)
zulmod_lt:
	copyb(r11, 8[a + 24]) -> r5
	ltu([ZULD_R3], r5), j(zulmod_ok)
	ltu(r5, [ZULD_R3]), j(zuld_panic)
	copyb(r11, 8[a + 16]) -> r5
	ltu([ZULD_R2], r5), j(zulmod_ok)
	ltu(r5, [ZULD_R2]), j(zuld_panic)
	copyb(r11, 8[a + 8]) -> r5
	ltu([ZULD_R1], r5), j(zulmod_ok)
	ltu(r5, [ZULD_R1]), j(zuld_panic)
	copyb(r11, 8[a + 0]) -> r5
	ltu([ZULD_R0], r5), j(zulmod_ok)
	ltu(r5, [ZULD_R0]), j(zuld_panic)
	jump(zuld_panic)                    ; r == b
zulmod_ok:
	copyb(r12, [ZULD_R0]) -> 8[a + 0]
	copyb(r12, [ZULD_R1]) -> 8[a + 8]
	copyb(r12, [ZULD_R2]) -> 8[a + 16]
	copyb(r12, [ZULD_R3]) -> 8[a + 24]
	copyb(0, 0) -> r10
	ret

; zkvm_status zkvm_u256_le_divmod(a, b, quotient, remainder) : b == 0 -> both 0.
ziskasm_zkvm_u256_le_divmod:
	copyb(r11, 8[a + 24])
	ltu(0, c), j(zuldm_go)          ; b != 0
	copyb(r11, 8[a + 16])
	ltu(0, c), j(zuldm_go)          ; b != 0
	copyb(r11, 8[a + 8])
	ltu(0, c), j(zuldm_go)          ; b != 0
	copyb(r11, 8[a + 0])
	ltu(0, c), j(zuldm_go)          ; b != 0
	; b == 0 -> 0 and 0
	copyb(r12, 0) -> 8[a + 0]
	copyb(r12, 0) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 24]
	copyb(r13, 0) -> 8[a + 0]
	copyb(r13, 0) -> 8[a + 8]
	copyb(r13, 0) -> 8[a + 16]
	copyb(r13, 0) -> 8[a + 24]
	copyb(0, 0) -> r10
	ret
zuldm_go:
	fcall_param(4, r10)                 ; hint q, r = a / b, a % b
	fcall_param(4, r11)
	fcall(FCALL_UINT256_DIV, 0)
	fcall_get(0, [FREE_INPUT]) -> [ZULD_Q0]
	fcall_get(0, [FREE_INPUT]) -> [ZULD_Q1]
	fcall_get(0, [FREE_INPUT]) -> [ZULD_Q2]
	fcall_get(0, [FREE_INPUT]) -> [ZULD_Q3]
	fcall_get(0, [FREE_INPUT]) -> [ZULD_R0]
	fcall_get(0, [FREE_INPUT]) -> [ZULD_R1]
	fcall_get(0, [FREE_INPUT]) -> [ZULD_R2]
	copyb(0, [FREE_INPUT]) -> [ZULD_R3]
	copyb(0, r11) -> [ZULD_HB]
	arith256(0, ZULD_HA)                ; dl:dh = q * b + r
	copyb(r10, 8[a + 0])
	eq(c, [ZULD_DL0]), j(zuldm_dl0)
	jump(zuld_panic)
zuldm_dl0:
	copyb(r10, 8[a + 8])
	eq(c, [ZULD_DL1]), j(zuldm_dl1)
	jump(zuld_panic)
zuldm_dl1:
	copyb(r10, 8[a + 16])
	eq(c, [ZULD_DL2]), j(zuldm_dl2)
	jump(zuld_panic)
zuldm_dl2:
	copyb(r10, 8[a + 24])
	eq(c, [ZULD_DL3]), j(zuldm_dl3)
	jump(zuld_panic)
zuldm_dl3:
	copyb(0, [ZULD_DH0])                ; dh == 0
	or(c, [ZULD_DH1])
	or(c, [ZULD_DH2])
	or(c, [ZULD_DH3])
	eq(c, 0), j(zuldm_lt)
	jump(zuld_panic)
zuldm_lt:
	copyb(r11, 8[a + 24]) -> r5
	ltu([ZULD_R3], r5), j(zuldm_ok)
	ltu(r5, [ZULD_R3]), j(zuld_panic)
	copyb(r11, 8[a + 16]) -> r5
	ltu([ZULD_R2], r5), j(zuldm_ok)
	ltu(r5, [ZULD_R2]), j(zuld_panic)
	copyb(r11, 8[a + 8]) -> r5
	ltu([ZULD_R1], r5), j(zuldm_ok)
	ltu(r5, [ZULD_R1]), j(zuld_panic)
	copyb(r11, 8[a + 0]) -> r5
	ltu([ZULD_R0], r5), j(zuldm_ok)
	ltu(r5, [ZULD_R0]), j(zuld_panic)
	jump(zuld_panic)                    ; r == b
zuldm_ok:
	copyb(r12, [ZULD_Q0]) -> 8[a + 0]
	copyb(r12, [ZULD_Q1]) -> 8[a + 8]
	copyb(r12, [ZULD_Q2]) -> 8[a + 16]
	copyb(r12, [ZULD_Q3]) -> 8[a + 24]
	copyb(r13, [ZULD_R0]) -> 8[a + 0]
	copyb(r13, [ZULD_R1]) -> 8[a + 8]
	copyb(r13, [ZULD_R2]) -> 8[a + 16]
	copyb(r13, [ZULD_R3]) -> 8[a + 24]
	copyb(0, 0) -> r10
	ret

zuld_panic:                             ; a hint that failed verification
	copyb(0, 0) -> r10, end

; zkvm_status zkvm_u256_le_sdiv(a, b, quotient) : signed a / b, toward zero.
;   b == 0 -> 0. -2^255 / -1 = -2^255 falls out of abs (negate(2^255)=2^255).
ziskasm_zkvm_u256_le_sdiv:
	push r1
	call zul_load2
	copyb(0, ZU_B) -> r10
	call zu_iszero
	eq(r10, 0), j(zulsd_do)
	call zu_wr_zero
	copyb(0, 0) -> r10
	pop r1
	ret
zulsd_do:
	copyb(0, ZU_A) -> r10             ; |a| -> ZU_AA, sign_a
	copyb(0, ZU_AA) -> r11
	call zu_abs
	copyb(0, ZU_SA) -> r5
	copyb(r5, r10) -> 8[a + 0]
	copyb(0, ZU_B) -> r10             ; |b| -> ZU_BB, sign_b
	copyb(0, ZU_BB) -> r11
	call zu_abs
	copyb(0, ZU_SB) -> r5
	copyb(r5, r10) -> 8[a + 0]
	copyb(0, ZU_AA) -> r10            ; q = |a| / |b|
	copyb(0, ZU_BB) -> r11
	copyb(0, ZU_Q) -> r12
	copyb(0, ZU_R) -> r13
	call zisklib_div_rem256
	copyb(0, ZU_SA) -> r5             ; sign(q) = sign_a XOR sign_b
	copyb(r5, 8[a + 0]) -> r6
	copyb(0, ZU_SB) -> r5
	copyb(r5, 8[a + 0]) -> r7
	xor(r6, r7) -> r6
	eq(r6, 0), j(zulsd_pos)
	copyb(0, ZU_Q) -> r10             ; negative quotient
	copyb(0, ZU_R) -> r11
	call zu_neg
	call zul_wr_r
	copyb(0, 0) -> r10
	pop r1
	ret
zulsd_pos:
	copyb(0, ZU_Q) -> r10             ; positive quotient
	copyb(0, ZU_POUT) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(0, 4) -> r12
	call zul_copy4
	copyb(0, 0) -> r10
	pop r1
	ret

; zkvm_status zkvm_u256_le_smod(a, b, remainder) : signed a % b, sign follows a.
;   b == 0 -> 0.
ziskasm_zkvm_u256_le_smod:
	push r1
	call zul_load2
	copyb(0, ZU_B) -> r10
	call zu_iszero
	eq(r10, 0), j(zulsm_do)
	call zu_wr_zero
	copyb(0, 0) -> r10
	pop r1
	ret
zulsm_do:
	copyb(0, ZU_A) -> r10             ; |a| -> ZU_AA, sign_a
	copyb(0, ZU_AA) -> r11
	call zu_abs
	copyb(0, ZU_SA) -> r5
	copyb(r5, r10) -> 8[a + 0]
	copyb(0, ZU_B) -> r10             ; |b| -> ZU_BB
	copyb(0, ZU_BB) -> r11
	call zu_abs
	copyb(0, ZU_AA) -> r10            ; r = |a| % |b|
	copyb(0, ZU_BB) -> r11
	copyb(0, ZU_Q) -> r12
	copyb(0, ZU_R) -> r13
	call zisklib_div_rem256
	copyb(0, ZU_SA) -> r5             ; sign(r) = sign_a
	copyb(r5, 8[a + 0]) -> r6
	eq(r6, 0), j(zulsm_pos)
	copyb(0, ZU_R) -> r10             ; negative remainder
	copyb(0, ZU_T) -> r11
	call zu_neg
	copyb(0, ZU_T) -> r10
	copyb(0, ZU_POUT) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(0, 4) -> r12
	call zul_copy4
	copyb(0, 0) -> r10
	pop r1
	ret
zulsm_pos:
	call zul_wr_r                      ; remainder in ZU_R
	copyb(0, 0) -> r10
	pop r1
	ret

; zkvm_status zkvm_u256_le_sdivmod(a, b, quotient, remainder) : signed, b == 0 -> 0.
ziskasm_zkvm_u256_le_sdivmod:
	push r1
	copyb(0, ZU_POUT) -> r5           ; quotient ptr
	copyb(r5, r12) -> 8[a + 0]
	copyb(0, ZU_POUT2) -> r5          ; remainder ptr
	copyb(r5, r13) -> 8[a + 0]
	copyb(0, ZU_PB) -> r5
	copyb(r5, r11) -> 8[a + 0]
	copyb(0, ZU_A) -> r11             ; copy a
	copyb(0, 4) -> r12
	call zul_copy4
	copyb(0, ZU_PB) -> r10            ; copy b
	copyb(r10, 8[a + 0]) -> r10
	copyb(0, ZU_B) -> r11
	copyb(0, 4) -> r12
	call zul_copy4
	copyb(0, ZU_B) -> r10
	call zu_iszero
	eq(r10, 0), j(zulsdm_do)
	; b == 0 -> quotient = remainder = 0
	copyb(0, ZU_POUT) -> r5
	copyb(r5, 8[a + 0]) -> r5
	copyb(r5, 0) -> 8[a + 0]
	copyb(r5, 0) -> 8[a + 8]
	copyb(r5, 0) -> 8[a + 16]
	copyb(r5, 0) -> 8[a + 24]
	copyb(0, ZU_POUT2) -> r5
	copyb(r5, 8[a + 0]) -> r5
	copyb(r5, 0) -> 8[a + 0]
	copyb(r5, 0) -> 8[a + 8]
	copyb(r5, 0) -> 8[a + 16]
	copyb(r5, 0) -> 8[a + 24]
	copyb(0, 0) -> r10
	pop r1
	ret
zulsdm_do:
	copyb(0, ZU_A) -> r10             ; |a|, sign_a
	copyb(0, ZU_AA) -> r11
	call zu_abs
	copyb(0, ZU_SA) -> r5
	copyb(r5, r10) -> 8[a + 0]
	copyb(0, ZU_B) -> r10             ; |b|, sign_b
	copyb(0, ZU_BB) -> r11
	call zu_abs
	copyb(0, ZU_SB) -> r5
	copyb(r5, r10) -> 8[a + 0]
	copyb(0, ZU_AA) -> r10
	copyb(0, ZU_BB) -> r11
	copyb(0, ZU_Q) -> r12
	copyb(0, ZU_R) -> r13
	call zisklib_div_rem256
	; quotient: sign = sign_a XOR sign_b
	copyb(0, ZU_SA) -> r5
	copyb(r5, 8[a + 0]) -> r6
	copyb(0, ZU_SB) -> r5
	copyb(r5, 8[a + 0]) -> r7
	xor(r6, r7) -> r6
	eq(r6, 0), j(zulsdm_qpos)
	copyb(0, ZU_Q) -> r10
	copyb(0, ZU_T) -> r11
	call zu_neg
	copyb(0, ZU_T) -> r10
	jump(zulsdm_qwr)
zulsdm_qpos:
	copyb(0, ZU_Q) -> r10
zulsdm_qwr:
	copyb(0, ZU_POUT) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(0, 4) -> r12
	call zul_copy4
	; remainder: sign = sign_a
	copyb(0, ZU_SA) -> r5
	copyb(r5, 8[a + 0]) -> r6
	eq(r6, 0), j(zulsdm_rpos)
	copyb(0, ZU_R) -> r10
	copyb(0, ZU_T) -> r11
	call zu_neg
	copyb(0, ZU_T) -> r10
	jump(zulsdm_rwr)
zulsdm_rpos:
	copyb(0, ZU_R) -> r10
zulsdm_rwr:
	copyb(0, ZU_POUT2) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(0, 4) -> r12
	call zul_copy4
	copyb(0, 0) -> r10
	pop r1
	ret

; ---- precompile parameter blocks --------------------------------------------
; Each block is a run of one-word symbols (consecutive declarations are laid out
; contiguously), so a routine fills it with absolute stores and passes its first
; symbol to the precompile as an immediate: no register holds the block address.
; Constant fields are preset, so a routine only writes the caller's pointers: the
; add/sub carry-in, and the fixed operand addresses (sub's ~b, mul's zero addend
; and discarded high half, addmod's multiplier 1 and mulmod's zero addend). So
; each block belongs to one routine.

u64 ZULA_A[1]   = 0     ; add256 for add: &a, &b, cin = 0, &result
u64 ZULA_B[1]   = 0
u64 ZULA_CIN[1] = 0
u64 ZULA_C[1]   = 0
u64 ZULS_A[1]   = 0     ; add256 for sub (a + ~b + 1): &a, &ZUL_NB, cin = 1, &result
u64 ZULS_B[1]   = ZUL_NB0
u64 ZULS_CIN[1] = 1
u64 ZULS_C[1]   = 0
u64 ZUL_NB0[1]  = 0     ; ~b
u64 ZUL_NB1[1]  = 0
u64 ZUL_NB2[1]  = 0
u64 ZUL_NB3[1]  = 0
u64 ZULM_A[1]   = 0     ; arith256 for mul: &a, &b, &0, &dl = result, &dh
u64 ZULM_B[1]   = 0
u64 ZULM_C[1]   = U256_ZERO
u64 ZULM_DL[1]  = 0
u64 ZULM_DH[1]  = ZUL_HI
u64 ZULAM_A[1]  = 0     ; arith256_mod for addmod: &a, &1, &b, &n, &result
u64 ZULAM_B[1]  = U256_ONE
u64 ZULAM_C[1]  = 0
u64 ZULAM_N[1]  = 0
u64 ZULAM_D[1]  = 0
u64 ZULMU_A[1]  = 0     ; arith256_mod for mulmod: &a, &b, &0, &n, &result
u64 ZULMU_B[1]  = 0
u64 ZULMU_C[1]  = U256_ZERO
u64 ZULMU_N[1]  = 0
u64 ZULMU_D[1]  = 0
u64 ZULD_Q0[1]  = 0     ; the division hint: q, then r
u64 ZULD_Q1[1]  = 0
u64 ZULD_Q2[1]  = 0
u64 ZULD_Q3[1]  = 0
u64 ZULD_R0[1]  = 0
u64 ZULD_R1[1]  = 0
u64 ZULD_R2[1]  = 0
u64 ZULD_R3[1]  = 0
u64 ZULD_DL0[1] = 0     ; its check: dl:dh = q * b + r
u64 ZULD_DL1[1] = 0
u64 ZULD_DL2[1] = 0
u64 ZULD_DL3[1] = 0
u64 ZULD_DH0[1] = 0
u64 ZULD_DH1[1] = 0
u64 ZULD_DH2[1] = 0
u64 ZULD_DH3[1] = 0
u64 ZULD_HA[1]  = ZULD_Q0   ; arith256 for the check: &q, &b, &r, &dl, &dh
u64 ZULD_HB[1]  = 0
u64 ZULD_HC[1]  = ZULD_R0
u64 ZULD_HDL[1] = ZULD_DL0
u64 ZULD_HDH[1] = ZULD_DH0
u64 ZULE_SQ[5]  = 0, 0, 0, 0, 0   ; arith256 for exp: acc = acc * acc
u64 ZULE_MU[5]  = 0, 0, 0, 0, 0   ; arith256 for exp: acc = acc * base
u64 ZUL_HI[4]   = 0, 0, 0, 0      ; discarded high halves
u64 ZUL_ACC[4]  = 0, 0, 0, 0      ; exp accumulator
u64 ZUL_EB[4]   = 0, 0, 0, 0      ; exp base (private copy: result may alias it)

; ============================================================================
; Arithmetic: straight-line leaves around one precompile
; ============================================================================

; void zkvm_u256_le_add(a, b, result) : (a + b) mod 2^256. Inline zkvmcall.
ziskasm_zkvm_u256_le_add:
	copyb(0, r10) -> [ZULA_A]
	copyb(0, r11) -> [ZULA_B]
	copyb(0, r12) -> [ZULA_C]
	add256(0, ZULA_A)                   ; carry out ignored (wrapping)
	ret

; void zkvm_u256_le_sub(a, b, result) : (a - b) mod 2^256 = a + ~b + 1. Inline
; zkvmcall.
ziskasm_zkvm_u256_le_sub:
	copyb(r11, 8[a + 0])
	xor(c, 0xffffffffffffffff) -> [ZUL_NB0]
	copyb(r11, 8[a + 8])
	xor(c, 0xffffffffffffffff) -> [ZUL_NB1]
	copyb(r11, 8[a + 16])
	xor(c, 0xffffffffffffffff) -> [ZUL_NB2]
	copyb(r11, 8[a + 24])
	xor(c, 0xffffffffffffffff) -> [ZUL_NB3]
	copyb(0, r10) -> [ZULS_A]
	copyb(0, r12) -> [ZULS_C]
	add256(0, ZULS_A)
	ret

; void zkvm_u256_le_mul(a, b, result) : (a * b) mod 2^256. Inline zkvmcall.
ziskasm_zkvm_u256_le_mul:
	copyb(0, r10) -> [ZULM_A]
	copyb(0, r11) -> [ZULM_B]
	copyb(0, r12) -> [ZULM_DL]
	arith256(0, ZULM_A)                 ; high 256 bits discarded (wrapping)
	ret

; void zkvm_u256_le_addmod(a, b, n, result) : (a * 1 + b) mod n; n == 0 -> 0.
; Inline zkvmcall. n is tested from its top limb down, so a modulus with a
; nonzero top limb costs one test (the jumps cost nothing inline).
ziskasm_zkvm_u256_le_addmod:
	copyb(r12, 8[a + 24])
	eq(c, 0), j(zuladdmod_2)
zuladdmod_go:
	copyb(0, r10) -> [ZULAM_A]
	copyb(0, r11) -> [ZULAM_C]
	copyb(0, r12) -> [ZULAM_N]
	copyb(0, r13) -> [ZULAM_D]
	arith256_mod(0, ZULAM_A)
	ret
zuladdmod_2:
	copyb(r12, 8[a + 16])
	eq(c, 0), j(zuladdmod_1)
	jump(zuladdmod_go)
zuladdmod_1:
	copyb(r12, 8[a + 8])
	eq(c, 0), j(zuladdmod_0)
	jump(zuladdmod_go)
zuladdmod_0:
	copyb(r12, 8[a + 0])
	eq(c, 0), j(zuladdmod_zero)
	jump(zuladdmod_go)
zuladdmod_zero:
	copyb(r13, 0) -> 8[a + 0]
	copyb(r13, 0) -> 8[a + 8]
	copyb(r13, 0) -> 8[a + 16]
	copyb(r13, 0) -> 8[a + 24]
	ret

; void zkvm_u256_le_mulmod(a, b, n, result) : (a * b + 0) mod n; n == 0 -> 0.
; Inline zkvmcall. n is tested from its top limb down, so a modulus with a
; nonzero top limb costs one test (the jumps cost nothing inline).
ziskasm_zkvm_u256_le_mulmod:
	copyb(r12, 8[a + 24])
	eq(c, 0), j(zulmulmod_2)
zulmulmod_go:
	copyb(0, r10) -> [ZULMU_A]
	copyb(0, r11) -> [ZULMU_B]
	copyb(0, r12) -> [ZULMU_N]
	copyb(0, r13) -> [ZULMU_D]
	arith256_mod(0, ZULMU_A)
	ret
zulmulmod_2:
	copyb(r12, 8[a + 16])
	eq(c, 0), j(zulmulmod_1)
	jump(zulmulmod_go)
zulmulmod_1:
	copyb(r12, 8[a + 8])
	eq(c, 0), j(zulmulmod_0)
	jump(zulmulmod_go)
zulmulmod_0:
	copyb(r12, 8[a + 0])
	eq(c, 0), j(zulmulmod_zero)
	jump(zulmulmod_go)
zulmulmod_zero:
	copyb(r13, 0) -> 8[a + 0]
	copyb(r13, 0) -> 8[a + 8]
	copyb(r13, 0) -> 8[a + 16]
	copyb(r13, 0) -> 8[a + 24]
	ret

; zkvm_status zkvm_u256_le_exp(base, exponent, result) : base^exponent mod 2^256.
; Left-to-right square-and-multiply from the exponent's top set bit, with both
; arith256 parameter blocks built once: each exponent bit costs one squaring, one
; multiply if the bit is set, a shift and a compare (a sentinel bit, no counter).
ziskasm_zkvm_u256_le_exp:
	copyb(0, ZUL_EB) -> r5              ; private copy of the base
	copyb(r10, 8[a + 0]) -> r6
	copyb(r10, 8[a + 8]) -> r7
	copyb(r10, 8[a + 16]) -> r28
	copyb(r10, 8[a + 24]) -> r29
	copyb(r5, r6) -> 8[a + 0]
	copyb(r5, r7) -> 8[a + 8]
	copyb(r5, r28) -> 8[a + 16]
	copyb(r5, r29) -> 8[a + 24]
	copyb(0, ZUL_ACC) -> r5             ; acc = 1
	copyb(r5, 1) -> 8[a + 0]
	copyb(r5, 0) -> 8[a + 8]
	copyb(r5, 0) -> 8[a + 16]
	copyb(r5, 0) -> 8[a + 24]
	copyb(0, ZULE_SQ) -> r6             ; SQ = {&acc, &acc, &0, &acc, &hi}
	copyb(r6, r5) -> 8[a + 0]
	copyb(r6, r5) -> 8[a + 8]
	copyb(r6, U256_ZERO) -> 8[a + 16]
	copyb(r6, r5) -> 8[a + 24]
	copyb(r6, ZUL_HI) -> 8[a + 32]
	copyb(0, ZULE_MU) -> r6             ; MU = {&acc, &base, &0, &acc, &hi}
	copyb(r6, r5) -> 8[a + 0]
	copyb(r6, ZUL_EB) -> 8[a + 8]
	copyb(r6, U256_ZERO) -> 8[a + 16]
	copyb(r6, r5) -> 8[a + 24]
	copyb(r6, ZUL_HI) -> 8[a + 32]
	copyb(r11, 8[a + 0]) -> r13
	copyb(r11, 8[a + 8]) -> r14
	copyb(r11, 8[a + 16]) -> r15
	copyb(r11, 8[a + 24]) -> r16
	copyb(0, 4) -> r6                   ; limbs left, top limb in r16
zulex_find:                             ; skip zero limbs from the top
	eq(r6, 0), j(zulex_done)            ; exponent 0 -> acc = 1
	ltu(0, r16), j(zulex_found)
	copyb(0, r15) -> r16
	copyb(0, r14) -> r15
	copyb(0, r13) -> r14
	sub(r6, 1) -> r6
	jump(zulex_find)
zulex_found:                            ; r7 = r16 << 1 | 1: the bits below the MSB,
	sll(r16, 1) -> r7                   ; then a sentinel that reaches bit 63 exactly
	or(r7, 1) -> r7                     ; when they are used up
	ltu(r16, 0x8000000000000000), j(zulex_skip, zulex_top)
zulex_skip:                             ; skip leading zero bits of the top limb
	sll(r16, 1) -> r16
	sll(r7, 1) -> r7
	ltu(r16, 0x8000000000000000), j(zulex_skip, zulex_top)
zulex_top:                              ; the top limb's MSB (a 1)
	arith256(0, ZULE_SQ) -> r5
	arith256(0, ZULE_MU) -> r5
	eq(r7, 0x8000000000000000), j(zulex_next, zulex_bit)
zulex_limb:                             ; a lower limb's MSB
	arith256(0, ZULE_SQ) -> r5
	ltu(r16, 0x8000000000000000), j(zulex_limbnomul)
	arith256(0, ZULE_MU) -> r5
zulex_limbnomul:
	sll(r16, 1) -> r7
	or(r7, 1) -> r7                     ; != 2^63: its low bit is set
zulex_bit:                              ; r7's MSB is the next exponent bit
	arith256(0, ZULE_SQ) -> r5
	ltu(r7, 0x8000000000000000), j(zulex_nomul)
	arith256(0, ZULE_MU) -> r5
zulex_nomul:
	sll(r7, 1) -> r7
	eq(r7, 0x8000000000000000), j(zulex_next, zulex_bit)
zulex_next:
	sub(r6, 1) -> r6                    ; next limb down
	eq(r6, 0), j(zulex_done)
	copyb(0, r15) -> r16
	copyb(0, r14) -> r15
	copyb(0, r13) -> r14
	jump(zulex_limb)
zulex_done:
	copyb(0, ZUL_ACC) -> r5
	copyb(r5, 8[a + 0]) -> r6
	copyb(r5, 8[a + 8]) -> r7
	copyb(r5, 8[a + 16]) -> r28
	copyb(r5, 8[a + 24]) -> r29
	copyb(r12, r6) -> 8[a + 0]
	copyb(r12, r7) -> 8[a + 8]
	copyb(r12, r28) -> 8[a + 16]
	copyb(r12, r29) -> 8[a + 24]
	copyb(0, 0) -> r10
	ret

; ============================================================================
; Comparisons (result is 0 or 1): unrolled from the most significant limb
; ============================================================================

; void zkvm_u256_le_lt(a, b, result) : a < b (unsigned). Inline zkvmcall: from
; the most significant limb down, the first that differs decides.
ziskasm_zkvm_u256_le_lt:
	copyb(r10, 8[a + 24]) -> r32
	copyb(r11, 8[a + 24]) -> r33
zullt_3:                                ; r32/r33 = most significant limbs of a/b
	ltu(r32, r33), j(zullt_one)
	ltu(r33, r32), j(zullt_zero)
	copyb(r10, 8[a + 16]) -> r32
	copyb(r11, 8[a + 16]) -> r33
	ltu(r32, r33), j(zullt_one)
	ltu(r33, r32), j(zullt_zero)
	copyb(r10, 8[a + 8]) -> r32
	copyb(r11, 8[a + 8]) -> r33
	ltu(r32, r33), j(zullt_one)
	ltu(r33, r32), j(zullt_zero)
	copyb(r10, 8[a + 0]) -> r32
	copyb(r11, 8[a + 0]) -> r33
	ltu(r32, r33), j(zullt_one)
	jump(zullt_zero)                    ; equal
zullt_zero:
	copyb(r12, 0) -> 8[a + 0]
	jump(zullt_w)
zullt_one:
	copyb(r12, 1) -> 8[a + 0]
zullt_w:
	copyb(r12, 0) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 24]
	ret

; void zkvm_u256_le_gt(a, b, result) : a > b (unsigned). Inline zkvmcall: from
; the most significant limb down, the first that differs decides.
ziskasm_zkvm_u256_le_gt:
	copyb(r10, 8[a + 24]) -> r32
	copyb(r11, 8[a + 24]) -> r33
zulgt_3:                                ; r32/r33 = most significant limbs of a/b
	ltu(r33, r32), j(zulgt_one)
	ltu(r32, r33), j(zulgt_zero)
	copyb(r10, 8[a + 16]) -> r32
	copyb(r11, 8[a + 16]) -> r33
	ltu(r33, r32), j(zulgt_one)
	ltu(r32, r33), j(zulgt_zero)
	copyb(r10, 8[a + 8]) -> r32
	copyb(r11, 8[a + 8]) -> r33
	ltu(r33, r32), j(zulgt_one)
	ltu(r32, r33), j(zulgt_zero)
	copyb(r10, 8[a + 0]) -> r32
	copyb(r11, 8[a + 0]) -> r33
	ltu(r33, r32), j(zulgt_one)
	jump(zulgt_zero)                    ; equal
zulgt_zero:
	copyb(r12, 0) -> 8[a + 0]
	jump(zulgt_w)
zulgt_one:
	copyb(r12, 1) -> 8[a + 0]
zulgt_w:
	copyb(r12, 0) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 24]
	ret

; void zkvm_u256_le_slt(a, b, result) : a < b (signed). Inline zkvmcall. Signs
; differ: the result is the sign of a; same sign: the unsigned order.
ziskasm_zkvm_u256_le_slt:
	copyb(r10, 8[a + 24]) -> r32
	copyb(r11, 8[a + 24]) -> r33
	xor(r32, r33)
	lt(c, 0), j(zulslt_diff)         ; the signs differ
	jump(zullt_3)
zulslt_diff:
	srl(r32, 63)
	copyb(r12, c) -> 8[a + 0]
	copyb(r12, 0) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 24]
	ret

; void zkvm_u256_le_sgt(a, b, result) : a > b (signed). Inline zkvmcall. Signs
; differ: the result is the sign of b; same sign: the unsigned order.
ziskasm_zkvm_u256_le_sgt:
	copyb(r10, 8[a + 24]) -> r32
	copyb(r11, 8[a + 24]) -> r33
	xor(r32, r33)
	lt(c, 0), j(zulsgt_diff)         ; the signs differ
	jump(zulgt_3)
zulsgt_diff:
	srl(r33, 63)
	copyb(r12, c) -> 8[a + 0]
	copyb(r12, 0) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 24]
	ret

; void zkvm_u256_le_eq(a, b, result) : a == b. Inline zkvmcall, branchless: the
; limb differences OR-ed into r33, then eq leaves the 0/1 result in c. The result
; is written after every load, so it may alias a or b.
ziskasm_zkvm_u256_le_eq:
	copyb(r10, 8[a + 0]) -> r32
	copyb(r11, 8[a + 0])
	xor(r32, c) -> r33
	copyb(r10, 8[a + 8]) -> r32
	copyb(r11, 8[a + 8])
	xor(r32, c)
	or(r33, c) -> r33
	copyb(r10, 8[a + 16]) -> r32
	copyb(r11, 8[a + 16])
	xor(r32, c)
	or(r33, c) -> r33
	copyb(r10, 8[a + 24]) -> r32
	copyb(r11, 8[a + 24])
	xor(r32, c)
	or(r33, c)
	eq(c, 0)
	copyb(r12, c) -> 8[a + 0]
	copyb(r12, 0) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 24]
	ret

; void zkvm_u256_le_iszero(a, result) : a == 0. Inline zkvmcall, branchless: the
; limbs OR-ed through r32 and c, then eq leaves the 0/1 result in c.
ziskasm_zkvm_u256_le_iszero:
	copyb(r10, 8[a + 0]) -> r32
	copyb(r10, 8[a + 8])
	or(r32, c) -> r32
	copyb(r10, 8[a + 16])
	or(r32, c) -> r32
	copyb(r10, 8[a + 24])
	or(r32, c)
	eq(c, 0)
	copyb(r11, c) -> 8[a + 0]
	copyb(r11, 0) -> 8[a + 8]
	copyb(r11, 0) -> 8[a + 16]
	copyb(r11, 0) -> 8[a + 24]
	ret

; ============================================================================
; Bitwise
; ============================================================================

; void zkvm_u256_le_and(a, b, result). Inline zkvmcall: a's limb in r32, b's in c.
ziskasm_zkvm_u256_le_and:
	copyb(r10, 8[a + 0]) -> r32
	copyb(r11, 8[a + 0])
	and(r32, c)
	copyb(r12, c) -> 8[a + 0]
	copyb(r10, 8[a + 8]) -> r32
	copyb(r11, 8[a + 8])
	and(r32, c)
	copyb(r12, c) -> 8[a + 8]
	copyb(r10, 8[a + 16]) -> r32
	copyb(r11, 8[a + 16])
	and(r32, c)
	copyb(r12, c) -> 8[a + 16]
	copyb(r10, 8[a + 24]) -> r32
	copyb(r11, 8[a + 24])
	and(r32, c)
	copyb(r12, c) -> 8[a + 24]
	ret

; void zkvm_u256_le_or(a, b, result). Inline zkvmcall: a's limb in r32, b's in c.
ziskasm_zkvm_u256_le_or:
	copyb(r10, 8[a + 0]) -> r32
	copyb(r11, 8[a + 0])
	or(r32, c)
	copyb(r12, c) -> 8[a + 0]
	copyb(r10, 8[a + 8]) -> r32
	copyb(r11, 8[a + 8])
	or(r32, c)
	copyb(r12, c) -> 8[a + 8]
	copyb(r10, 8[a + 16]) -> r32
	copyb(r11, 8[a + 16])
	or(r32, c)
	copyb(r12, c) -> 8[a + 16]
	copyb(r10, 8[a + 24]) -> r32
	copyb(r11, 8[a + 24])
	or(r32, c)
	copyb(r12, c) -> 8[a + 24]
	ret

; void zkvm_u256_le_xor(a, b, result). Inline zkvmcall: a's limb in r32, b's in c.
ziskasm_zkvm_u256_le_xor:
	copyb(r10, 8[a + 0]) -> r32
	copyb(r11, 8[a + 0])
	xor(r32, c)
	copyb(r12, c) -> 8[a + 0]
	copyb(r10, 8[a + 8]) -> r32
	copyb(r11, 8[a + 8])
	xor(r32, c)
	copyb(r12, c) -> 8[a + 8]
	copyb(r10, 8[a + 16]) -> r32
	copyb(r11, 8[a + 16])
	xor(r32, c)
	copyb(r12, c) -> 8[a + 16]
	copyb(r10, 8[a + 24]) -> r32
	copyb(r11, 8[a + 24])
	xor(r32, c)
	copyb(r12, c) -> 8[a + 24]
	ret

; void zkvm_u256_le_not(a, result). An inline zkvmcall: the transpiler expands
; the body (up to the `ret`) at the call site, on the caller's registers for a
; (r10) and result (r11). Each limb goes through c (load, xor, store), so it
; writes no register at all, only memory, and needs no temporary.
ziskasm_zkvm_u256_le_not:
	copyb(r10, 8[a + 0])
	xor(c, 0xffffffffffffffff)
	copyb(r11, c) -> 8[a + 0]
	copyb(r10, 8[a + 8])
	xor(c, 0xffffffffffffffff)
	copyb(r11, c) -> 8[a + 8]
	copyb(r10, 8[a + 16])
	xor(c, 0xffffffffffffffff)
	copyb(r11, c) -> 8[a + 16]
	copyb(r10, 8[a + 24])
	xor(c, 0xffffffffffffffff)
	copyb(r11, c) -> 8[a + 24]
	ret

; ============================================================================
; Byte, shifts, sign extension: a case per word shift, no loops
; ============================================================================

; void zkvm_u256_le_byte(i, a, result) : byte i of a counting from the most
; significant (EVM BYTE), which in little-endian memory is at a + (31 - i). Inline
; zkvmcall.
ziskasm_zkvm_u256_le_byte:
	copyb(r10, 8[a + 8]) -> r32
	copyb(r10, 8[a + 16])
	or(r32, c) -> r32
	copyb(r10, 8[a + 24])
	or(r32, c)
	eq(c, 0), j(zulby_lo)
	jump(zulby_big)
zulby_lo:
	copyb(r10, 8[a + 0]) -> r33
	ltu(c, 32), j(zulby_ok)
	jump(zulby_big)
zulby_ok:
	add(r11, 31)
	sub(c, r33)
	copyb(c, 1[a + 0])
	copyb(r12, c) -> 8[a + 0]
	copyb(r12, 0) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 24]
	ret
zulby_big:
	copyb(r12, 0) -> 8[a + 0]
	copyb(r12, 0) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 24]
	ret

; void zkvm_u256_le_shr(shift, value, result) : value >> shift; shift >= 256 -> 0.
; Inline zkvmcall. r33 = shift (< 256), r34 = b = shift % 64, r35 = 64 - b; a
; case per word shift q, each output limb built from two input limbs read in
; ascending order (so the result may alias the value).
ziskasm_zkvm_u256_le_shr:
	copyb(r10, 8[a + 8]) -> r32
	copyb(r10, 8[a + 16])
	or(r32, c) -> r32
	copyb(r10, 8[a + 24])
	or(r32, c)
	eq(c, 0), j(zulshr_lo)
	jump(zulshr_big)
zulshr_lo:
	copyb(r10, 8[a + 0]) -> r33
	ltu(c, 256), j(zulshr_ok)
	jump(zulshr_big)
zulshr_ok:
	ltu(r33, 64), j(zulshr_q0)
	ltu(r33, 128), j(zulshr_q1)
	ltu(r33, 192), j(zulshr_q2)
	jump(zulshr_q3)
zulshr_q0:
	and(r33, 63) -> r34
	eq(c, 0), j(zulshr_q0_w)
	sub(64, r34) -> r35
	copyb(r11, 8[a + 0])
	srl(c, r34) -> r36
	copyb(r11, 8[a + 8]) -> r37
	sll(c, r35)
	or(r36, c)
	copyb(r12, c) -> 8[a + 0]
	srl(r37, r34) -> r36
	copyb(r11, 8[a + 16]) -> r37
	sll(c, r35)
	or(r36, c)
	copyb(r12, c) -> 8[a + 8]
	srl(r37, r34) -> r36
	copyb(r11, 8[a + 24]) -> r37
	sll(c, r35)
	or(r36, c)
	copyb(r12, c) -> 8[a + 16]
	srl(r37, r34)
	copyb(r12, c) -> 8[a + 24]
	ret
zulshr_q0_w:
	copyb(r11, 8[a + 0])
	copyb(r12, c) -> 8[a + 0]
	copyb(r11, 8[a + 8])
	copyb(r12, c) -> 8[a + 8]
	copyb(r11, 8[a + 16])
	copyb(r12, c) -> 8[a + 16]
	copyb(r11, 8[a + 24])
	copyb(r12, c) -> 8[a + 24]
	ret
zulshr_q1:
	and(r33, 63) -> r34
	eq(c, 0), j(zulshr_q1_w)
	sub(64, r34) -> r35
	copyb(r11, 8[a + 8])
	srl(c, r34) -> r36
	copyb(r11, 8[a + 16]) -> r37
	sll(c, r35)
	or(r36, c)
	copyb(r12, c) -> 8[a + 0]
	srl(r37, r34) -> r36
	copyb(r11, 8[a + 24]) -> r37
	sll(c, r35)
	or(r36, c)
	copyb(r12, c) -> 8[a + 8]
	srl(r37, r34)
	copyb(r12, c) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 24]
	ret
zulshr_q1_w:
	copyb(r11, 8[a + 8])
	copyb(r12, c) -> 8[a + 0]
	copyb(r11, 8[a + 16])
	copyb(r12, c) -> 8[a + 8]
	copyb(r11, 8[a + 24])
	copyb(r12, c) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 24]
	ret
zulshr_q2:
	and(r33, 63) -> r34
	eq(c, 0), j(zulshr_q2_w)
	sub(64, r34) -> r35
	copyb(r11, 8[a + 16])
	srl(c, r34) -> r36
	copyb(r11, 8[a + 24]) -> r37
	sll(c, r35)
	or(r36, c)
	copyb(r12, c) -> 8[a + 0]
	srl(r37, r34)
	copyb(r12, c) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 24]
	ret
zulshr_q2_w:
	copyb(r11, 8[a + 16])
	copyb(r12, c) -> 8[a + 0]
	copyb(r11, 8[a + 24])
	copyb(r12, c) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 24]
	ret
zulshr_q3:
	and(r33, 63) -> r34
	eq(c, 0), j(zulshr_q3_w)
	sub(64, r34) -> r35
	copyb(r11, 8[a + 24])
	srl(c, r34)
	copyb(r12, c) -> 8[a + 0]
	copyb(r12, 0) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 24]
	ret
zulshr_q3_w:
	copyb(r11, 8[a + 24])
	copyb(r12, c) -> 8[a + 0]
	copyb(r12, 0) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 24]
	ret
zulshr_big:
	copyb(r12, 0) -> 8[a + 0]
	copyb(r12, 0) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 24]
	ret

; void zkvm_u256_le_sar(shift, value, result) : arithmetic shift right; shift >= 256 -> all sign bits.
; Inline zkvmcall. r33 = shift (< 256), r34 = b = shift % 64, r35 = 64 - b; a
; case per word shift q, each output limb built from two input limbs read in
; ascending order (so the result may alias the value), r38 = fill.
ziskasm_zkvm_u256_le_sar:
	copyb(r11, 8[a + 24])
	sra(c, 63) -> r38                   ; fill: 0, or all ones if negative
	copyb(r10, 8[a + 8]) -> r32
	copyb(r10, 8[a + 16])
	or(r32, c) -> r32
	copyb(r10, 8[a + 24])
	or(r32, c)
	eq(c, 0), j(zulsar_lo)
	jump(zulsar_big)
zulsar_lo:
	copyb(r10, 8[a + 0]) -> r33
	ltu(c, 256), j(zulsar_ok)
	jump(zulsar_big)
zulsar_ok:
	ltu(r33, 64), j(zulsar_q0)
	ltu(r33, 128), j(zulsar_q1)
	ltu(r33, 192), j(zulsar_q2)
	jump(zulsar_q3)
zulsar_q0:
	and(r33, 63) -> r34
	eq(c, 0), j(zulsar_q0_w)
	sub(64, r34) -> r35
	copyb(r11, 8[a + 0])
	srl(c, r34) -> r36
	copyb(r11, 8[a + 8]) -> r37
	sll(c, r35)
	or(r36, c)
	copyb(r12, c) -> 8[a + 0]
	srl(r37, r34) -> r36
	copyb(r11, 8[a + 16]) -> r37
	sll(c, r35)
	or(r36, c)
	copyb(r12, c) -> 8[a + 8]
	srl(r37, r34) -> r36
	copyb(r11, 8[a + 24]) -> r37
	sll(c, r35)
	or(r36, c)
	copyb(r12, c) -> 8[a + 16]
	sra(r37, r34)
	copyb(r12, c) -> 8[a + 24]
	ret
zulsar_q0_w:
	copyb(r11, 8[a + 0])
	copyb(r12, c) -> 8[a + 0]
	copyb(r11, 8[a + 8])
	copyb(r12, c) -> 8[a + 8]
	copyb(r11, 8[a + 16])
	copyb(r12, c) -> 8[a + 16]
	copyb(r11, 8[a + 24])
	copyb(r12, c) -> 8[a + 24]
	ret
zulsar_q1:
	and(r33, 63) -> r34
	eq(c, 0), j(zulsar_q1_w)
	sub(64, r34) -> r35
	copyb(r11, 8[a + 8])
	srl(c, r34) -> r36
	copyb(r11, 8[a + 16]) -> r37
	sll(c, r35)
	or(r36, c)
	copyb(r12, c) -> 8[a + 0]
	srl(r37, r34) -> r36
	copyb(r11, 8[a + 24]) -> r37
	sll(c, r35)
	or(r36, c)
	copyb(r12, c) -> 8[a + 8]
	sra(r37, r34)
	copyb(r12, c) -> 8[a + 16]
	copyb(r12, r38) -> 8[a + 24]
	ret
zulsar_q1_w:
	copyb(r11, 8[a + 8])
	copyb(r12, c) -> 8[a + 0]
	copyb(r11, 8[a + 16])
	copyb(r12, c) -> 8[a + 8]
	copyb(r11, 8[a + 24])
	copyb(r12, c) -> 8[a + 16]
	copyb(r12, r38) -> 8[a + 24]
	ret
zulsar_q2:
	and(r33, 63) -> r34
	eq(c, 0), j(zulsar_q2_w)
	sub(64, r34) -> r35
	copyb(r11, 8[a + 16])
	srl(c, r34) -> r36
	copyb(r11, 8[a + 24]) -> r37
	sll(c, r35)
	or(r36, c)
	copyb(r12, c) -> 8[a + 0]
	sra(r37, r34)
	copyb(r12, c) -> 8[a + 8]
	copyb(r12, r38) -> 8[a + 16]
	copyb(r12, r38) -> 8[a + 24]
	ret
zulsar_q2_w:
	copyb(r11, 8[a + 16])
	copyb(r12, c) -> 8[a + 0]
	copyb(r11, 8[a + 24])
	copyb(r12, c) -> 8[a + 8]
	copyb(r12, r38) -> 8[a + 16]
	copyb(r12, r38) -> 8[a + 24]
	ret
zulsar_q3:
	and(r33, 63) -> r34
	eq(c, 0), j(zulsar_q3_w)
	sub(64, r34) -> r35
	copyb(r11, 8[a + 24])
	sra(c, r34)
	copyb(r12, c) -> 8[a + 0]
	copyb(r12, r38) -> 8[a + 8]
	copyb(r12, r38) -> 8[a + 16]
	copyb(r12, r38) -> 8[a + 24]
	ret
zulsar_q3_w:
	copyb(r11, 8[a + 24])
	copyb(r12, c) -> 8[a + 0]
	copyb(r12, r38) -> 8[a + 8]
	copyb(r12, r38) -> 8[a + 16]
	copyb(r12, r38) -> 8[a + 24]
	ret
zulsar_big:
	copyb(r12, r38) -> 8[a + 0]
	copyb(r12, r38) -> 8[a + 8]
	copyb(r12, r38) -> 8[a + 16]
	copyb(r12, r38) -> 8[a + 24]
	ret

; void zkvm_u256_le_shl(shift, value, result) : value << shift; shift >= 256 -> 0.
; Inline zkvmcall. r33 = shift (< 256), r34 = b = shift % 64, r35 = 64 - b; a
; case per word shift q, each output limb built from two input limbs read in
; descending order (so the result may alias the value).
ziskasm_zkvm_u256_le_shl:
	copyb(r10, 8[a + 8]) -> r32
	copyb(r10, 8[a + 16])
	or(r32, c) -> r32
	copyb(r10, 8[a + 24])
	or(r32, c)
	eq(c, 0), j(zulshl_lo)
	jump(zulshl_big)
zulshl_lo:
	copyb(r10, 8[a + 0]) -> r33
	ltu(c, 256), j(zulshl_ok)
	jump(zulshl_big)
zulshl_ok:
	ltu(r33, 64), j(zulshl_q0)
	ltu(r33, 128), j(zulshl_q1)
	ltu(r33, 192), j(zulshl_q2)
	jump(zulshl_q3)
zulshl_q0:
	and(r33, 63) -> r34
	eq(c, 0), j(zulshl_q0_w)
	sub(64, r34) -> r35
	copyb(r11, 8[a + 24])
	sll(c, r34) -> r36
	copyb(r11, 8[a + 16]) -> r37
	srl(c, r35)
	or(r36, c)
	copyb(r12, c) -> 8[a + 24]
	sll(r37, r34) -> r36
	copyb(r11, 8[a + 8]) -> r37
	srl(c, r35)
	or(r36, c)
	copyb(r12, c) -> 8[a + 16]
	sll(r37, r34) -> r36
	copyb(r11, 8[a + 0]) -> r37
	srl(c, r35)
	or(r36, c)
	copyb(r12, c) -> 8[a + 8]
	sll(r37, r34)
	copyb(r12, c) -> 8[a + 0]
	ret
zulshl_q0_w:
	copyb(r11, 8[a + 24])
	copyb(r12, c) -> 8[a + 24]
	copyb(r11, 8[a + 16])
	copyb(r12, c) -> 8[a + 16]
	copyb(r11, 8[a + 8])
	copyb(r12, c) -> 8[a + 8]
	copyb(r11, 8[a + 0])
	copyb(r12, c) -> 8[a + 0]
	ret
zulshl_q1:
	and(r33, 63) -> r34
	eq(c, 0), j(zulshl_q1_w)
	sub(64, r34) -> r35
	copyb(r11, 8[a + 16])
	sll(c, r34) -> r36
	copyb(r11, 8[a + 8]) -> r37
	srl(c, r35)
	or(r36, c)
	copyb(r12, c) -> 8[a + 24]
	sll(r37, r34) -> r36
	copyb(r11, 8[a + 0]) -> r37
	srl(c, r35)
	or(r36, c)
	copyb(r12, c) -> 8[a + 16]
	sll(r37, r34)
	copyb(r12, c) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 0]
	ret
zulshl_q1_w:
	copyb(r11, 8[a + 16])
	copyb(r12, c) -> 8[a + 24]
	copyb(r11, 8[a + 8])
	copyb(r12, c) -> 8[a + 16]
	copyb(r11, 8[a + 0])
	copyb(r12, c) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 0]
	ret
zulshl_q2:
	and(r33, 63) -> r34
	eq(c, 0), j(zulshl_q2_w)
	sub(64, r34) -> r35
	copyb(r11, 8[a + 8])
	sll(c, r34) -> r36
	copyb(r11, 8[a + 0]) -> r37
	srl(c, r35)
	or(r36, c)
	copyb(r12, c) -> 8[a + 24]
	sll(r37, r34)
	copyb(r12, c) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 0]
	ret
zulshl_q2_w:
	copyb(r11, 8[a + 8])
	copyb(r12, c) -> 8[a + 24]
	copyb(r11, 8[a + 0])
	copyb(r12, c) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 0]
	ret
zulshl_q3:
	and(r33, 63) -> r34
	eq(c, 0), j(zulshl_q3_w)
	sub(64, r34) -> r35
	copyb(r11, 8[a + 0])
	sll(c, r34)
	copyb(r12, c) -> 8[a + 24]
	copyb(r12, 0) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 0]
	ret
zulshl_q3_w:
	copyb(r11, 8[a + 0])
	copyb(r12, c) -> 8[a + 24]
	copyb(r12, 0) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 0]
	ret
zulshl_big:
	copyb(r12, 0) -> 8[a + 0]
	copyb(r12, 0) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 24]
	ret

; void zkvm_u256_le_signextend(b, value, result) : extend the sign of byte b
; (0 = least significant); b >= 31 -> value unchanged. Inline zkvmcall. Byte b
; is in limb q = b / 8, whose top bit is 8 * (b % 8) + 7: shifting the limb left
; and then arithmetically right by r34 = t = 8 * (7 - b % 8) extends it, and its
; sign fills the limbs above.
ziskasm_zkvm_u256_le_signextend:
	copyb(r10, 8[a + 8]) -> r32
	copyb(r10, 8[a + 16])
	or(r32, c) -> r32
	copyb(r10, 8[a + 24])
	or(r32, c)
	eq(c, 0), j(zulse_lo)
	jump(zulse_big)
zulse_lo:
	copyb(r10, 8[a + 0]) -> r33
	ltu(c, 31), j(zulse_ok)
	jump(zulse_big)
zulse_ok:
	and(r33, 7)
	xor(c, 7)                           ; 7 - b % 8
	sll(c, 3) -> r34
	ltu(r33, 8), j(zulse_q0)
	ltu(r33, 16), j(zulse_q1)
	ltu(r33, 24), j(zulse_q2)
	jump(zulse_q3)
zulse_q0:
	copyb(r11, 8[a + 0])
	sll(c, r34)
	sra(c, r34)
	copyb(r12, c) -> 8[a + 0]
	sra(c, 63)
	copyb(r12, c) -> 8[a + 8]
	copyb(r12, c) -> 8[a + 16]
	copyb(r12, c) -> 8[a + 24]
	ret
zulse_q1:
	copyb(r11, 8[a + 0])
	copyb(r12, c) -> 8[a + 0]
	copyb(r11, 8[a + 8])
	sll(c, r34)
	sra(c, r34)
	copyb(r12, c) -> 8[a + 8]
	sra(c, 63)
	copyb(r12, c) -> 8[a + 16]
	copyb(r12, c) -> 8[a + 24]
	ret
zulse_q2:
	copyb(r11, 8[a + 0])
	copyb(r12, c) -> 8[a + 0]
	copyb(r11, 8[a + 8])
	copyb(r12, c) -> 8[a + 8]
	copyb(r11, 8[a + 16])
	sll(c, r34)
	sra(c, r34)
	copyb(r12, c) -> 8[a + 16]
	sra(c, 63)
	copyb(r12, c) -> 8[a + 24]
	ret
zulse_q3:
	copyb(r11, 8[a + 0])
	copyb(r12, c) -> 8[a + 0]
	copyb(r11, 8[a + 8])
	copyb(r12, c) -> 8[a + 8]
	copyb(r11, 8[a + 16])
	copyb(r12, c) -> 8[a + 16]
	copyb(r11, 8[a + 24])
	sll(c, r34)
	sra(c, r34)
	copyb(r12, c) -> 8[a + 24]
	ret
zulse_big:
	copyb(r11, 8[a + 0])
	copyb(r12, c) -> 8[a + 0]
	copyb(r11, 8[a + 8])
	copyb(r12, c) -> 8[a + 8]
	copyb(r11, 8[a + 16])
	copyb(r12, c) -> 8[a + 16]
	copyb(r11, 8[a + 24])
	copyb(r12, c) -> 8[a + 24]
	ret
