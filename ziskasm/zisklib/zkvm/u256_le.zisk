; ============================================================================
; zkvm/u256_le.zisk - the little-endian U256 ABI (ziskasm/lang/c/include/
; zkvm_u256_le.h). Entry points `ziskasm_zkvm_u256_le_*`, reached through
; zkvmcalls: the header's default implementation calls all 27 functions here
; (-DZKVM_U256_LE_INLINE switches all but the division family to inline C).
;
; Every value is 4 little-endian u64 limbs (limb 0 least significant), the layout
; the precompiles consume, so there is nothing to byte-reverse. Apart from the
; division family, every routine is a leaf: straight-line code in caller-saved
; registers, firing its precompile itself on parameter blocks written with
; absolute stores (no push/pop, no nested calls, no pointer spills). The division
; family keeps the bodies of zkvm/u256.zisk with the big-endian marshalling
; replaced by plain 4-word copies. Every routine reads
; all of its inputs before writing its output, so results may alias inputs.
; Scratch (ZU_*) and the zu_* limb helpers are shared with zkvm/u256.zisk.
; Labels `zul*`.
; ============================================================================

; ---- LE helpers -------------------------------------------------------------

; zul_load2: [r10=a_ptr, r11=b_ptr, r12=result_ptr]. Spills result_ptr to ZU_POUT
; and b_ptr to ZU_PB, copies a -> ZU_A and b -> ZU_B. Leaf (no nested call).
zul_load2:
	copyb(0, ZU_POUT) -> r5
	copyb(r5, r12) -> 8[a + 0]
	copyb(0, ZU_PB) -> r5
	copyb(r5, r11) -> 8[a + 0]
	copyb(0, ZU_A) -> r5
	copyb(r10, 8[a + 0]) -> r6
	copyb(r5, r6) -> 8[a + 0]
	copyb(r10, 8[a + 8]) -> r6
	copyb(r5, r6) -> 8[a + 8]
	copyb(r10, 8[a + 16]) -> r6
	copyb(r5, r6) -> 8[a + 16]
	copyb(r10, 8[a + 24]) -> r6
	copyb(r5, r6) -> 8[a + 24]
	copyb(0, ZU_B) -> r5
	copyb(r11, 8[a + 0]) -> r6
	copyb(r5, r6) -> 8[a + 0]
	copyb(r11, 8[a + 8]) -> r6
	copyb(r5, r6) -> 8[a + 8]
	copyb(r11, 8[a + 16]) -> r6
	copyb(r5, r6) -> 8[a + 16]
	copyb(r11, 8[a + 24]) -> r6
	copyb(r5, r6) -> 8[a + 24]
	ret

; zul_wr_r: copy ZU_R to the result pointer spilled in ZU_POUT. Leaf.
zul_wr_r:
	copyb(0, ZU_POUT) -> r5
	copyb(r5, 8[a + 0]) -> r5
	copyb(0, ZU_R) -> r7
	copyb(r7, 8[a + 0]) -> r6
	copyb(r5, r6) -> 8[a + 0]
	copyb(r7, 8[a + 8]) -> r6
	copyb(r5, r6) -> 8[a + 8]
	copyb(r7, 8[a + 16]) -> r6
	copyb(r5, r6) -> 8[a + 16]
	copyb(r7, 8[a + 24]) -> r6
	copyb(r5, r6) -> 8[a + 24]
	ret

; zul_copy4: [r10=src, r11=dst] copy 4 words (r12, the limb count, is ignored:
; the call sites are the former zkvm_be_to_limbs / zkvm_limbs_to_be calls with
; nlimbs = 4). Leaf.
zul_copy4:
	copyb(r10, 8[a + 0]) -> r6
	copyb(r11, r6) -> 8[a + 0]
	copyb(r10, 8[a + 8]) -> r6
	copyb(r11, r6) -> 8[a + 8]
	copyb(r10, 8[a + 16]) -> r6
	copyb(r11, r6) -> 8[a + 16]
	copyb(r10, 8[a + 24]) -> r6
	copyb(r11, r6) -> 8[a + 24]
	ret

; ============================================================================
; Entry points
; ============================================================================

; zkvm_status zkvm_u256_le_div(a, b, quotient) : q = a / b; b == 0 -> 0 (EVM).
ziskasm_zkvm_u256_le_div:
	push r1
	call zul_load2
	copyb(0, ZU_B) -> r10
	call zu_iszero
	eq(r10, 0), j(zuldiv_do)            ; b != 0 -> divide
	call zu_wr_zero
	copyb(0, 0) -> r10
	pop r1
	ret
zuldiv_do:
	copyb(0, ZU_A) -> r10
	copyb(0, ZU_B) -> r11
	copyb(0, ZU_R) -> r12             ; q_out = ZU_R (written out)
	copyb(0, ZU_Q) -> r13             ; r_out = ZU_Q (discarded)
	call zisklib_div_rem256
	call zul_wr_r
	copyb(0, 0) -> r10
	pop r1
	ret

; zkvm_status zkvm_u256_le_mod(a, b, remainder) : r = a % b; b == 0 -> 0 (EVM).
ziskasm_zkvm_u256_le_mod:
	push r1
	call zul_load2
	copyb(0, ZU_B) -> r10
	call zu_iszero
	eq(r10, 0), j(zulmod_do)
	call zu_wr_zero
	copyb(0, 0) -> r10
	pop r1
	ret
zulmod_do:
	copyb(0, ZU_A) -> r10
	copyb(0, ZU_B) -> r11
	copyb(0, ZU_Q) -> r12             ; q_out discarded
	copyb(0, ZU_R) -> r13             ; r_out = ZU_R (written out)
	call zisklib_div_rem256
	call zul_wr_r
	copyb(0, 0) -> r10
	pop r1
	ret

; zkvm_status zkvm_u256_le_divmod(a, b, quotient, remainder) : b == 0 -> both 0.
ziskasm_zkvm_u256_le_divmod:
	push r1
	copyb(0, ZU_POUT) -> r5           ; quotient ptr
	copyb(r5, r12) -> 8[a + 0]
	copyb(0, ZU_POUT2) -> r5          ; remainder ptr
	copyb(r5, r13) -> 8[a + 0]
	copyb(0, ZU_PB) -> r5
	copyb(r5, r11) -> 8[a + 0]
	copyb(0, ZU_A) -> r11             ; copy a
	copyb(0, 4) -> r12
	call zul_copy4
	copyb(0, ZU_PB) -> r10            ; copy b
	copyb(r10, 8[a + 0]) -> r10
	copyb(0, ZU_B) -> r11
	copyb(0, 4) -> r12
	call zul_copy4
	copyb(0, ZU_B) -> r10
	call zu_iszero
	eq(r10, 0), j(zuldm_do)
	; b == 0 -> quotient = remainder = 0
	copyb(0, ZU_POUT) -> r5
	copyb(r5, 8[a + 0]) -> r5
	copyb(r5, 0) -> 8[a + 0]
	copyb(r5, 0) -> 8[a + 8]
	copyb(r5, 0) -> 8[a + 16]
	copyb(r5, 0) -> 8[a + 24]
	copyb(0, ZU_POUT2) -> r5
	copyb(r5, 8[a + 0]) -> r5
	copyb(r5, 0) -> 8[a + 0]
	copyb(r5, 0) -> 8[a + 8]
	copyb(r5, 0) -> 8[a + 16]
	copyb(r5, 0) -> 8[a + 24]
	copyb(0, 0) -> r10
	pop r1
	ret
zuldm_do:
	copyb(0, ZU_A) -> r10
	copyb(0, ZU_B) -> r11
	copyb(0, ZU_Q) -> r12
	copyb(0, ZU_R) -> r13
	call zisklib_div_rem256
	copyb(0, ZU_Q) -> r10             ; quotient -> *POUT
	copyb(0, ZU_POUT) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(0, 4) -> r12
	call zul_copy4
	copyb(0, ZU_R) -> r10             ; remainder -> *POUT2
	copyb(0, ZU_POUT2) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(0, 4) -> r12
	call zul_copy4
	copyb(0, 0) -> r10
	pop r1
	ret

; zkvm_status zkvm_u256_le_sdiv(a, b, quotient) : signed a / b, toward zero.
;   b == 0 -> 0. -2^255 / -1 = -2^255 falls out of abs (negate(2^255)=2^255).
ziskasm_zkvm_u256_le_sdiv:
	push r1
	call zul_load2
	copyb(0, ZU_B) -> r10
	call zu_iszero
	eq(r10, 0), j(zulsd_do)
	call zu_wr_zero
	copyb(0, 0) -> r10
	pop r1
	ret
zulsd_do:
	copyb(0, ZU_A) -> r10             ; |a| -> ZU_AA, sign_a
	copyb(0, ZU_AA) -> r11
	call zu_abs
	copyb(0, ZU_SA) -> r5
	copyb(r5, r10) -> 8[a + 0]
	copyb(0, ZU_B) -> r10             ; |b| -> ZU_BB, sign_b
	copyb(0, ZU_BB) -> r11
	call zu_abs
	copyb(0, ZU_SB) -> r5
	copyb(r5, r10) -> 8[a + 0]
	copyb(0, ZU_AA) -> r10            ; q = |a| / |b|
	copyb(0, ZU_BB) -> r11
	copyb(0, ZU_Q) -> r12
	copyb(0, ZU_R) -> r13
	call zisklib_div_rem256
	copyb(0, ZU_SA) -> r5             ; sign(q) = sign_a XOR sign_b
	copyb(r5, 8[a + 0]) -> r6
	copyb(0, ZU_SB) -> r5
	copyb(r5, 8[a + 0]) -> r7
	xor(r6, r7) -> r6
	eq(r6, 0), j(zulsd_pos)
	copyb(0, ZU_Q) -> r10             ; negative quotient
	copyb(0, ZU_R) -> r11
	call zu_neg
	call zul_wr_r
	copyb(0, 0) -> r10
	pop r1
	ret
zulsd_pos:
	copyb(0, ZU_Q) -> r10             ; positive quotient
	copyb(0, ZU_POUT) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(0, 4) -> r12
	call zul_copy4
	copyb(0, 0) -> r10
	pop r1
	ret

; zkvm_status zkvm_u256_le_smod(a, b, remainder) : signed a % b, sign follows a.
;   b == 0 -> 0.
ziskasm_zkvm_u256_le_smod:
	push r1
	call zul_load2
	copyb(0, ZU_B) -> r10
	call zu_iszero
	eq(r10, 0), j(zulsm_do)
	call zu_wr_zero
	copyb(0, 0) -> r10
	pop r1
	ret
zulsm_do:
	copyb(0, ZU_A) -> r10             ; |a| -> ZU_AA, sign_a
	copyb(0, ZU_AA) -> r11
	call zu_abs
	copyb(0, ZU_SA) -> r5
	copyb(r5, r10) -> 8[a + 0]
	copyb(0, ZU_B) -> r10             ; |b| -> ZU_BB
	copyb(0, ZU_BB) -> r11
	call zu_abs
	copyb(0, ZU_AA) -> r10            ; r = |a| % |b|
	copyb(0, ZU_BB) -> r11
	copyb(0, ZU_Q) -> r12
	copyb(0, ZU_R) -> r13
	call zisklib_div_rem256
	copyb(0, ZU_SA) -> r5             ; sign(r) = sign_a
	copyb(r5, 8[a + 0]) -> r6
	eq(r6, 0), j(zulsm_pos)
	copyb(0, ZU_R) -> r10             ; negative remainder
	copyb(0, ZU_T) -> r11
	call zu_neg
	copyb(0, ZU_T) -> r10
	copyb(0, ZU_POUT) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(0, 4) -> r12
	call zul_copy4
	copyb(0, 0) -> r10
	pop r1
	ret
zulsm_pos:
	call zul_wr_r                      ; remainder in ZU_R
	copyb(0, 0) -> r10
	pop r1
	ret

; zkvm_status zkvm_u256_le_sdivmod(a, b, quotient, remainder) : signed, b == 0 -> 0.
ziskasm_zkvm_u256_le_sdivmod:
	push r1
	copyb(0, ZU_POUT) -> r5           ; quotient ptr
	copyb(r5, r12) -> 8[a + 0]
	copyb(0, ZU_POUT2) -> r5          ; remainder ptr
	copyb(r5, r13) -> 8[a + 0]
	copyb(0, ZU_PB) -> r5
	copyb(r5, r11) -> 8[a + 0]
	copyb(0, ZU_A) -> r11             ; copy a
	copyb(0, 4) -> r12
	call zul_copy4
	copyb(0, ZU_PB) -> r10            ; copy b
	copyb(r10, 8[a + 0]) -> r10
	copyb(0, ZU_B) -> r11
	copyb(0, 4) -> r12
	call zul_copy4
	copyb(0, ZU_B) -> r10
	call zu_iszero
	eq(r10, 0), j(zulsdm_do)
	; b == 0 -> quotient = remainder = 0
	copyb(0, ZU_POUT) -> r5
	copyb(r5, 8[a + 0]) -> r5
	copyb(r5, 0) -> 8[a + 0]
	copyb(r5, 0) -> 8[a + 8]
	copyb(r5, 0) -> 8[a + 16]
	copyb(r5, 0) -> 8[a + 24]
	copyb(0, ZU_POUT2) -> r5
	copyb(r5, 8[a + 0]) -> r5
	copyb(r5, 0) -> 8[a + 0]
	copyb(r5, 0) -> 8[a + 8]
	copyb(r5, 0) -> 8[a + 16]
	copyb(r5, 0) -> 8[a + 24]
	copyb(0, 0) -> r10
	pop r1
	ret
zulsdm_do:
	copyb(0, ZU_A) -> r10             ; |a|, sign_a
	copyb(0, ZU_AA) -> r11
	call zu_abs
	copyb(0, ZU_SA) -> r5
	copyb(r5, r10) -> 8[a + 0]
	copyb(0, ZU_B) -> r10             ; |b|, sign_b
	copyb(0, ZU_BB) -> r11
	call zu_abs
	copyb(0, ZU_SB) -> r5
	copyb(r5, r10) -> 8[a + 0]
	copyb(0, ZU_AA) -> r10
	copyb(0, ZU_BB) -> r11
	copyb(0, ZU_Q) -> r12
	copyb(0, ZU_R) -> r13
	call zisklib_div_rem256
	; quotient: sign = sign_a XOR sign_b
	copyb(0, ZU_SA) -> r5
	copyb(r5, 8[a + 0]) -> r6
	copyb(0, ZU_SB) -> r5
	copyb(r5, 8[a + 0]) -> r7
	xor(r6, r7) -> r6
	eq(r6, 0), j(zulsdm_qpos)
	copyb(0, ZU_Q) -> r10
	copyb(0, ZU_T) -> r11
	call zu_neg
	copyb(0, ZU_T) -> r10
	jump(zulsdm_qwr)
zulsdm_qpos:
	copyb(0, ZU_Q) -> r10
zulsdm_qwr:
	copyb(0, ZU_POUT) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(0, 4) -> r12
	call zul_copy4
	; remainder: sign = sign_a
	copyb(0, ZU_SA) -> r5
	copyb(r5, 8[a + 0]) -> r6
	eq(r6, 0), j(zulsdm_rpos)
	copyb(0, ZU_R) -> r10
	copyb(0, ZU_T) -> r11
	call zu_neg
	copyb(0, ZU_T) -> r10
	jump(zulsdm_rwr)
zulsdm_rpos:
	copyb(0, ZU_R) -> r10
zulsdm_rwr:
	copyb(0, ZU_POUT2) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(0, 4) -> r12
	call zul_copy4
	copyb(0, 0) -> r10
	pop r1
	ret

; ---- precompile parameter blocks --------------------------------------------
; Each block is a run of one-word symbols (consecutive declarations are laid out
; contiguously), so a routine fills it with absolute stores and passes its first
; symbol to the precompile as an immediate: no register holds the block address.
; Constant fields are preset: the add/sub carry-in.

u64 ZULA_A[1]   = 0     ; add256 for add: &a, &b, cin = 0, &result
u64 ZULA_B[1]   = 0
u64 ZULA_CIN[1] = 0
u64 ZULA_C[1]   = 0
u64 ZULS_A[1]   = 0     ; add256 for sub (a + ~b + 1): &a, &ZUL_NB, cin = 1, &result
u64 ZULS_B[1]   = 0
u64 ZULS_CIN[1] = 1
u64 ZULS_C[1]   = 0
u64 ZUL_NB0[1]  = 0     ; ~b
u64 ZUL_NB1[1]  = 0
u64 ZUL_NB2[1]  = 0
u64 ZUL_NB3[1]  = 0
u64 ZULM_A[1]   = 0     ; arith256 for mul: &a, &b, &0, &dl = result, &dh
u64 ZULM_B[1]   = 0
u64 ZULM_C[1]   = 0
u64 ZULM_DL[1]  = 0
u64 ZULM_DH[1]  = 0
u64 ZULMM_A[1]  = 0     ; arith256_mod for addmod/mulmod: &a, &b, &c, &n, &result
u64 ZULMM_B[1]  = 0
u64 ZULMM_C[1]  = 0
u64 ZULMM_N[1]  = 0
u64 ZULMM_D[1]  = 0
u64 ZULE_SQ[5]  = 0, 0, 0, 0, 0   ; arith256 for exp: acc = acc * acc
u64 ZULE_MU[5]  = 0, 0, 0, 0, 0   ; arith256 for exp: acc = acc * base
u64 ZUL_HI[4]   = 0, 0, 0, 0      ; discarded high halves
u64 ZUL_ACC[4]  = 0, 0, 0, 0      ; exp accumulator
u64 ZUL_EB[4]   = 0, 0, 0, 0      ; exp base (private copy: result may alias it)

; ============================================================================
; Arithmetic: straight-line leaves around one precompile
; ============================================================================

; zkvm_status zkvm_u256_le_add(a, b, result) : (a + b) mod 2^256.
ziskasm_zkvm_u256_le_add:
	copyb(0, r10) -> [ZULA_A]
	copyb(0, r11) -> [ZULA_B]
	copyb(0, r12) -> [ZULA_C]
	add256(0, ZULA_A) -> r5             ; carry out ignored (wrapping)
	copyb(0, 0) -> r10
	ret

; zkvm_status zkvm_u256_le_sub(a, b, result) : (a - b) mod 2^256 = a + ~b + 1.
ziskasm_zkvm_u256_le_sub:
	copyb(r11, 8[a + 0]) -> r5
	xor(r5, 0xffffffffffffffff) -> [ZUL_NB0]
	copyb(r11, 8[a + 8]) -> r5
	xor(r5, 0xffffffffffffffff) -> [ZUL_NB1]
	copyb(r11, 8[a + 16]) -> r5
	xor(r5, 0xffffffffffffffff) -> [ZUL_NB2]
	copyb(r11, 8[a + 24]) -> r5
	xor(r5, 0xffffffffffffffff) -> [ZUL_NB3]
	copyb(0, r10) -> [ZULS_A]
	copyb(0, ZUL_NB0) -> [ZULS_B]
	copyb(0, r12) -> [ZULS_C]
	add256(0, ZULS_A) -> r5
	copyb(0, 0) -> r10
	ret

; zkvm_status zkvm_u256_le_mul(a, b, result) : (a * b) mod 2^256.
ziskasm_zkvm_u256_le_mul:
	copyb(0, r10) -> [ZULM_A]
	copyb(0, r11) -> [ZULM_B]
	copyb(0, U256_ZERO) -> [ZULM_C]
	copyb(0, r12) -> [ZULM_DL]
	copyb(0, ZUL_HI) -> [ZULM_DH]
	arith256(0, ZULM_A) -> r5           ; high 256 bits discarded (wrapping)
	copyb(0, 0) -> r10
	ret

; zkvm_status zkvm_u256_le_addmod(a, b, n, result) : (a * 1 + b) mod n; n == 0 -> 0.
ziskasm_zkvm_u256_le_addmod:
	copyb(r12, 8[a + 0]) -> r5
	copyb(r12, 8[a + 8]) -> r6
	copyb(r12, 8[a + 16]) -> r7
	copyb(r12, 8[a + 24]) -> r14
	or(r5, r6) -> r5
	or(r5, r7) -> r5
	or(r5, r14) -> r5
	eq(r5, 0), j(zuladdmod_zero)
	copyb(0, r10) -> [ZULMM_A]
	copyb(0, U256_ONE) -> [ZULMM_B]
	copyb(0, r11) -> [ZULMM_C]
	copyb(0, r12) -> [ZULMM_N]
	copyb(0, r13) -> [ZULMM_D]
	arith256_mod(0, ZULMM_A) -> r5
	copyb(0, 0) -> r10
	ret
zuladdmod_zero:
	copyb(r13, 0) -> 8[a + 0]
	copyb(r13, 0) -> 8[a + 8]
	copyb(r13, 0) -> 8[a + 16]
	copyb(r13, 0) -> 8[a + 24]
	copyb(0, 0) -> r10
	ret

; zkvm_status zkvm_u256_le_mulmod(a, b, n, result) : (a * b + 0) mod n; n == 0 -> 0.
ziskasm_zkvm_u256_le_mulmod:
	copyb(r12, 8[a + 0]) -> r5
	copyb(r12, 8[a + 8]) -> r6
	copyb(r12, 8[a + 16]) -> r7
	copyb(r12, 8[a + 24]) -> r14
	or(r5, r6) -> r5
	or(r5, r7) -> r5
	or(r5, r14) -> r5
	eq(r5, 0), j(zulmulmod_zero)
	copyb(0, r10) -> [ZULMM_A]
	copyb(0, r11) -> [ZULMM_B]
	copyb(0, U256_ZERO) -> [ZULMM_C]
	copyb(0, r12) -> [ZULMM_N]
	copyb(0, r13) -> [ZULMM_D]
	arith256_mod(0, ZULMM_A) -> r5
	copyb(0, 0) -> r10
	ret
zulmulmod_zero:
	copyb(r13, 0) -> 8[a + 0]
	copyb(r13, 0) -> 8[a + 8]
	copyb(r13, 0) -> 8[a + 16]
	copyb(r13, 0) -> 8[a + 24]
	copyb(0, 0) -> r10
	ret

; zkvm_status zkvm_u256_le_exp(base, exponent, result) : base^exponent mod 2^256.
; Left-to-right square-and-multiply from the exponent's top set bit, with both
; arith256 parameter blocks built once: each exponent bit costs one squaring, one
; multiply if the bit is set, a shift and a compare (a sentinel bit, no counter).
ziskasm_zkvm_u256_le_exp:
	copyb(0, ZUL_EB) -> r5              ; private copy of the base
	copyb(r10, 8[a + 0]) -> r6
	copyb(r10, 8[a + 8]) -> r7
	copyb(r10, 8[a + 16]) -> r28
	copyb(r10, 8[a + 24]) -> r29
	copyb(r5, r6) -> 8[a + 0]
	copyb(r5, r7) -> 8[a + 8]
	copyb(r5, r28) -> 8[a + 16]
	copyb(r5, r29) -> 8[a + 24]
	copyb(0, ZUL_ACC) -> r5             ; acc = 1
	copyb(r5, 1) -> 8[a + 0]
	copyb(r5, 0) -> 8[a + 8]
	copyb(r5, 0) -> 8[a + 16]
	copyb(r5, 0) -> 8[a + 24]
	copyb(0, ZULE_SQ) -> r6             ; SQ = {&acc, &acc, &0, &acc, &hi}
	copyb(r6, r5) -> 8[a + 0]
	copyb(r6, r5) -> 8[a + 8]
	copyb(r6, U256_ZERO) -> 8[a + 16]
	copyb(r6, r5) -> 8[a + 24]
	copyb(r6, ZUL_HI) -> 8[a + 32]
	copyb(0, ZULE_MU) -> r6             ; MU = {&acc, &base, &0, &acc, &hi}
	copyb(r6, r5) -> 8[a + 0]
	copyb(r6, ZUL_EB) -> 8[a + 8]
	copyb(r6, U256_ZERO) -> 8[a + 16]
	copyb(r6, r5) -> 8[a + 24]
	copyb(r6, ZUL_HI) -> 8[a + 32]
	copyb(r11, 8[a + 0]) -> r13
	copyb(r11, 8[a + 8]) -> r14
	copyb(r11, 8[a + 16]) -> r15
	copyb(r11, 8[a + 24]) -> r16
	copyb(0, 4) -> r6                   ; limbs left, top limb in r16
zulex_find:                             ; skip zero limbs from the top
	eq(r6, 0), j(zulex_done)            ; exponent 0 -> acc = 1
	ltu(0, r16), j(zulex_found)
	copyb(0, r15) -> r16
	copyb(0, r14) -> r15
	copyb(0, r13) -> r14
	sub(r6, 1) -> r6
	jump(zulex_find)
zulex_found:                            ; r7 = r16 << 1 | 1: the bits below the MSB,
	sll(r16, 1) -> r7                   ; then a sentinel that reaches bit 63 exactly
	or(r7, 1) -> r7                     ; when they are used up
	ltu(r16, 0x8000000000000000), j(zulex_skip, zulex_top)
zulex_skip:                             ; skip leading zero bits of the top limb
	sll(r16, 1) -> r16
	sll(r7, 1) -> r7
	ltu(r16, 0x8000000000000000), j(zulex_skip, zulex_top)
zulex_top:                              ; the top limb's MSB (a 1)
	arith256(0, ZULE_SQ) -> r5
	arith256(0, ZULE_MU) -> r5
	eq(r7, 0x8000000000000000), j(zulex_next, zulex_bit)
zulex_limb:                             ; a lower limb's MSB
	arith256(0, ZULE_SQ) -> r5
	ltu(r16, 0x8000000000000000), j(zulex_limbnomul)
	arith256(0, ZULE_MU) -> r5
zulex_limbnomul:
	sll(r16, 1) -> r7
	or(r7, 1) -> r7                     ; != 2^63: its low bit is set
zulex_bit:                              ; r7's MSB is the next exponent bit
	arith256(0, ZULE_SQ) -> r5
	ltu(r7, 0x8000000000000000), j(zulex_nomul)
	arith256(0, ZULE_MU) -> r5
zulex_nomul:
	sll(r7, 1) -> r7
	eq(r7, 0x8000000000000000), j(zulex_next, zulex_bit)
zulex_next:
	sub(r6, 1) -> r6                    ; next limb down
	eq(r6, 0), j(zulex_done)
	copyb(0, r15) -> r16
	copyb(0, r14) -> r15
	copyb(0, r13) -> r14
	jump(zulex_limb)
zulex_done:
	copyb(0, ZUL_ACC) -> r5
	copyb(r5, 8[a + 0]) -> r6
	copyb(r5, 8[a + 8]) -> r7
	copyb(r5, 8[a + 16]) -> r28
	copyb(r5, 8[a + 24]) -> r29
	copyb(r12, r6) -> 8[a + 0]
	copyb(r12, r7) -> 8[a + 8]
	copyb(r12, r28) -> 8[a + 16]
	copyb(r12, r29) -> 8[a + 24]
	copyb(0, 0) -> r10
	ret

; ============================================================================
; Comparisons (result is 0 or 1): unrolled from the most significant limb
; ============================================================================

; zkvm_status zkvm_u256_le_lt(a, b, result) : a < b (unsigned).
ziskasm_zkvm_u256_le_lt:
	copyb(r10, 8[a + 24]) -> r5
	copyb(r11, 8[a + 24]) -> r6
zullt_3:                                ; r5/r6 = most significant limbs of a/b
	ltu(r5, r6), j(zullt_one)
	ltu(r6, r5), j(zullt_zero)
	copyb(r10, 8[a + 16]) -> r5
	copyb(r11, 8[a + 16]) -> r6
	ltu(r5, r6), j(zullt_one)
	ltu(r6, r5), j(zullt_zero)
	copyb(r10, 8[a + 8]) -> r5
	copyb(r11, 8[a + 8]) -> r6
	ltu(r5, r6), j(zullt_one)
	ltu(r6, r5), j(zullt_zero)
	copyb(r10, 8[a + 0]) -> r5
	copyb(r11, 8[a + 0]) -> r6
	ltu(r5, r6), j(zullt_one)
	ltu(r6, r5), j(zullt_zero)
	jump(zullt_zero)
zullt_zero:
	copyb(r12, 0) -> 8[a + 0]
	jump(zullt_w)
zullt_one:
	copyb(r12, 1) -> 8[a + 0]
zullt_w:
	copyb(r12, 0) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 24]
	copyb(0, 0) -> r10
	ret

; zkvm_status zkvm_u256_le_gt(a, b, result) : a > b (unsigned).
ziskasm_zkvm_u256_le_gt:
	copyb(r10, 8[a + 24]) -> r5
	copyb(r11, 8[a + 24]) -> r6
zulgt_3:                                ; r5/r6 = most significant limbs of a/b
	ltu(r6, r5), j(zulgt_one)
	ltu(r5, r6), j(zulgt_zero)
	copyb(r11, 8[a + 16]) -> r5
	copyb(r10, 8[a + 16]) -> r6
	ltu(r5, r6), j(zulgt_one)
	ltu(r6, r5), j(zulgt_zero)
	copyb(r11, 8[a + 8]) -> r5
	copyb(r10, 8[a + 8]) -> r6
	ltu(r5, r6), j(zulgt_one)
	ltu(r6, r5), j(zulgt_zero)
	copyb(r11, 8[a + 0]) -> r5
	copyb(r10, 8[a + 0]) -> r6
	ltu(r5, r6), j(zulgt_one)
	ltu(r6, r5), j(zulgt_zero)
	jump(zulgt_zero)
zulgt_zero:
	copyb(r12, 0) -> 8[a + 0]
	jump(zulgt_w)
zulgt_one:
	copyb(r12, 1) -> 8[a + 0]
zulgt_w:
	copyb(r12, 0) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 24]
	copyb(0, 0) -> r10
	ret

; zkvm_status zkvm_u256_le_slt(a, b, result) : a < b (signed). Different signs:
; a < b iff a is negative; same sign: the unsigned order.
ziskasm_zkvm_u256_le_slt:
	copyb(r10, 8[a + 24]) -> r5
	copyb(r11, 8[a + 24]) -> r6
	srl(r5, 63) -> r13
	srl(r6, 63) -> r14
	eq(r13, r14), j(zullt_3)
	copyb(r12, r13) -> 8[a + 0]
	copyb(r12, 0) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 24]
	copyb(0, 0) -> r10
	ret

; zkvm_status zkvm_u256_le_sgt(a, b, result) : a > b (signed). Different signs:
; a > b iff b is negative; same sign: the unsigned order.
ziskasm_zkvm_u256_le_sgt:
	copyb(r10, 8[a + 24]) -> r5
	copyb(r11, 8[a + 24]) -> r6
	srl(r5, 63) -> r13
	srl(r6, 63) -> r14
	eq(r13, r14), j(zulgt_3)
	copyb(r12, r14) -> 8[a + 0]
	copyb(r12, 0) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 24]
	copyb(0, 0) -> r10
	ret

; zkvm_status zkvm_u256_le_eq(a, b, result) : a == b. Leaf.
ziskasm_zkvm_u256_le_eq:
	copyb(r10, 8[a + 0]) -> r5
	copyb(r11, 8[a + 0]) -> r6
	xor(r5, r6) -> r7
	copyb(r10, 8[a + 8]) -> r5
	copyb(r11, 8[a + 8]) -> r6
	xor(r5, r6) -> r5
	or(r7, r5) -> r7
	copyb(r10, 8[a + 16]) -> r5
	copyb(r11, 8[a + 16]) -> r6
	xor(r5, r6) -> r5
	or(r7, r5) -> r7
	copyb(r10, 8[a + 24]) -> r5
	copyb(r11, 8[a + 24]) -> r6
	xor(r5, r6) -> r5
	or(r7, r5) -> r7
	eq(r7, 0), j(zuleq_t)
	copyb(r12, 0) -> 8[a + 0]
	jump(zuleq_w)
zuleq_t:
	copyb(r12, 1) -> 8[a + 0]
zuleq_w:
	copyb(r12, 0) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 24]
	copyb(0, 0) -> r10
	ret

; zkvm_status zkvm_u256_le_iszero(a, result) : a == 0. Leaf.
ziskasm_zkvm_u256_le_iszero:
	copyb(r10, 8[a + 0]) -> r5
	copyb(r10, 8[a + 8]) -> r6
	or(r5, r6) -> r5
	copyb(r10, 8[a + 16]) -> r6
	or(r5, r6) -> r5
	copyb(r10, 8[a + 24]) -> r6
	or(r5, r6) -> r5
	eq(r5, 0), j(zuliz_t)
	copyb(r11, 0) -> 8[a + 0]
	jump(zuliz_w)
zuliz_t:
	copyb(r11, 1) -> 8[a + 0]
zuliz_w:
	copyb(r11, 0) -> 8[a + 8]
	copyb(r11, 0) -> 8[a + 16]
	copyb(r11, 0) -> 8[a + 24]
	copyb(0, 0) -> r10
	ret

; ============================================================================
; Bitwise
; ============================================================================

; zkvm_status zkvm_u256_le_and(a, b, result).
ziskasm_zkvm_u256_le_and:
	copyb(r10, 8[a + 0]) -> r5
	copyb(r11, 8[a + 0]) -> r6
	and(r5, r6) -> r5
	copyb(r12, r5) -> 8[a + 0]
	copyb(r10, 8[a + 8]) -> r5
	copyb(r11, 8[a + 8]) -> r6
	and(r5, r6) -> r5
	copyb(r12, r5) -> 8[a + 8]
	copyb(r10, 8[a + 16]) -> r5
	copyb(r11, 8[a + 16]) -> r6
	and(r5, r6) -> r5
	copyb(r12, r5) -> 8[a + 16]
	copyb(r10, 8[a + 24]) -> r5
	copyb(r11, 8[a + 24]) -> r6
	and(r5, r6) -> r5
	copyb(r12, r5) -> 8[a + 24]
	copyb(0, 0) -> r10
	ret

; zkvm_status zkvm_u256_le_or(a, b, result).
ziskasm_zkvm_u256_le_or:
	copyb(r10, 8[a + 0]) -> r5
	copyb(r11, 8[a + 0]) -> r6
	or(r5, r6) -> r5
	copyb(r12, r5) -> 8[a + 0]
	copyb(r10, 8[a + 8]) -> r5
	copyb(r11, 8[a + 8]) -> r6
	or(r5, r6) -> r5
	copyb(r12, r5) -> 8[a + 8]
	copyb(r10, 8[a + 16]) -> r5
	copyb(r11, 8[a + 16]) -> r6
	or(r5, r6) -> r5
	copyb(r12, r5) -> 8[a + 16]
	copyb(r10, 8[a + 24]) -> r5
	copyb(r11, 8[a + 24]) -> r6
	or(r5, r6) -> r5
	copyb(r12, r5) -> 8[a + 24]
	copyb(0, 0) -> r10
	ret

; zkvm_status zkvm_u256_le_xor(a, b, result).
ziskasm_zkvm_u256_le_xor:
	copyb(r10, 8[a + 0]) -> r5
	copyb(r11, 8[a + 0]) -> r6
	xor(r5, r6) -> r5
	copyb(r12, r5) -> 8[a + 0]
	copyb(r10, 8[a + 8]) -> r5
	copyb(r11, 8[a + 8]) -> r6
	xor(r5, r6) -> r5
	copyb(r12, r5) -> 8[a + 8]
	copyb(r10, 8[a + 16]) -> r5
	copyb(r11, 8[a + 16]) -> r6
	xor(r5, r6) -> r5
	copyb(r12, r5) -> 8[a + 16]
	copyb(r10, 8[a + 24]) -> r5
	copyb(r11, 8[a + 24]) -> r6
	xor(r5, r6) -> r5
	copyb(r12, r5) -> 8[a + 24]
	copyb(0, 0) -> r10
	ret

; zkvm_status zkvm_u256_le_not(a, result).
ziskasm_zkvm_u256_le_not:
	copyb(r10, 8[a + 0]) -> r5
	xor(r5, 0xffffffffffffffff) -> r5
	copyb(r11, r5) -> 8[a + 0]
	copyb(r10, 8[a + 8]) -> r5
	xor(r5, 0xffffffffffffffff) -> r5
	copyb(r11, r5) -> 8[a + 8]
	copyb(r10, 8[a + 16]) -> r5
	xor(r5, 0xffffffffffffffff) -> r5
	copyb(r11, r5) -> 8[a + 16]
	copyb(r10, 8[a + 24]) -> r5
	xor(r5, 0xffffffffffffffff) -> r5
	copyb(r11, r5) -> 8[a + 24]
	copyb(0, 0) -> r10
	ret

; ============================================================================
; Byte, shifts, sign extension: operands in registers, no loops
; ============================================================================

; zkvm_status zkvm_u256_le_byte(i, a, result) : byte i of a counting from the most
; significant (EVM BYTE), which in little-endian memory is at a + (31 - i).
ziskasm_zkvm_u256_le_byte:
	copyb(r10, 8[a + 8]) -> r5
	copyb(r10, 8[a + 16]) -> r6
	or(r5, r6) -> r5
	copyb(r10, 8[a + 24]) -> r6
	or(r5, r6) -> r5
	eq(r5, 0), j(zulby_lo)
	jump(zulby_zero)
zulby_lo:
	copyb(r10, 8[a + 0]) -> r5
	ltu(r5, 32), j(zulby_ok)
zulby_zero:
	copyb(0, 0) -> r5
	jump(zulby_w)
zulby_ok:
	add(r11, 31) -> r6
	sub(r6, r5) -> r6
	copyb(r6, 1[a + 0]) -> r5
zulby_w:
	copyb(r12, r5) -> 8[a + 0]
	copyb(r12, 0) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 24]
	copyb(0, 0) -> r10
	ret

; zkvm_status zkvm_u256_le_shr(shift, value, result) : value >> shift; >= 256 -> 0.
ziskasm_zkvm_u256_le_shr:
	copyb(r10, 8[a + 8]) -> r5
	copyb(r10, 8[a + 16]) -> r6
	or(r5, r6) -> r5
	copyb(r10, 8[a + 24]) -> r6
	or(r5, r6) -> r5
	eq(r5, 0), j(zulshr_lo)
	jump(zulshr_zero)
zulshr_lo:
	copyb(r10, 8[a + 0]) -> r5
	ltu(r5, 256), j(zulshr_ok)
zulshr_zero:
	copyb(r12, 0) -> 8[a + 0]
	copyb(r12, 0) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 24]
	copyb(0, 0) -> r10
	ret
zulshr_ok:
	copyb(r11, 8[a + 0]) -> r13
	copyb(r11, 8[a + 8]) -> r14
	copyb(r11, 8[a + 16]) -> r15
	copyb(r11, 8[a + 24]) -> r16
	copyb(0, 0) -> r31                  ; fill
; Shared with sar: r5 = shift (< 256), r13..r16 = value limbs, r31 = fill.
zulshr_core:
	srl(r5, 6) -> r6                    ; word shift q
	and(r5, 63) -> r7                   ; bit shift
	eq(r6, 0), j(zulshr_bits)
	eq(r6, 1), j(zulshr_q1)
	eq(r6, 2), j(zulshr_q2)
	copyb(0, r16) -> r13                ; q == 3
	copyb(0, r31) -> r14
	copyb(0, r31) -> r15
	copyb(0, r31) -> r16
	jump(zulshr_bits)
zulshr_q1:
	copyb(0, r14) -> r13
	copyb(0, r15) -> r14
	copyb(0, r16) -> r15
	copyb(0, r31) -> r16
	jump(zulshr_bits)
zulshr_q2:
	copyb(0, r15) -> r13
	copyb(0, r16) -> r14
	copyb(0, r31) -> r15
	copyb(0, r31) -> r16
zulshr_bits:
	eq(r7, 0), j(zulshr_st)
	sub(64, r7) -> r28
	srl(r13, r7) -> r13
	sll(r14, r28) -> r29
	or(r13, r29) -> r13
	srl(r14, r7) -> r14
	sll(r15, r28) -> r29
	or(r14, r29) -> r14
	srl(r15, r7) -> r15
	sll(r16, r28) -> r29
	or(r15, r29) -> r15
	srl(r16, r7) -> r16
	sll(r31, r28) -> r29
	or(r16, r29) -> r16
zulshr_st:
	copyb(r12, r13) -> 8[a + 0]
	copyb(r12, r14) -> 8[a + 8]
	copyb(r12, r15) -> 8[a + 16]
	copyb(r12, r16) -> 8[a + 24]
	copyb(0, 0) -> r10
	ret

; zkvm_status zkvm_u256_le_sar(shift, value, result) : arithmetic shift right;
; shift >= 256 -> all sign bits.
ziskasm_zkvm_u256_le_sar:
	copyb(r11, 8[a + 24]) -> r16
	srl(r16, 63) -> r31
	sub(0, r31) -> r31                  ; fill: 0, or all ones if negative
	copyb(r10, 8[a + 8]) -> r5
	copyb(r10, 8[a + 16]) -> r6
	or(r5, r6) -> r5
	copyb(r10, 8[a + 24]) -> r6
	or(r5, r6) -> r5
	eq(r5, 0), j(zulsar_lo)
	jump(zulsar_full)
zulsar_lo:
	copyb(r10, 8[a + 0]) -> r5
	ltu(r5, 256), j(zulsar_ok)
zulsar_full:
	copyb(r12, r31) -> 8[a + 0]
	copyb(r12, r31) -> 8[a + 8]
	copyb(r12, r31) -> 8[a + 16]
	copyb(r12, r31) -> 8[a + 24]
	copyb(0, 0) -> r10
	ret
zulsar_ok:
	copyb(r11, 8[a + 0]) -> r13
	copyb(r11, 8[a + 8]) -> r14
	copyb(r11, 8[a + 16]) -> r15
	jump(zulshr_core)

; zkvm_status zkvm_u256_le_shl(shift, value, result) : value << shift; >= 256 -> 0.
ziskasm_zkvm_u256_le_shl:
	copyb(r10, 8[a + 8]) -> r5
	copyb(r10, 8[a + 16]) -> r6
	or(r5, r6) -> r5
	copyb(r10, 8[a + 24]) -> r6
	or(r5, r6) -> r5
	eq(r5, 0), j(zulshl_lo)
	jump(zulshl_zero)
zulshl_lo:
	copyb(r10, 8[a + 0]) -> r5
	ltu(r5, 256), j(zulshl_ok)
zulshl_zero:
	copyb(r12, 0) -> 8[a + 0]
	copyb(r12, 0) -> 8[a + 8]
	copyb(r12, 0) -> 8[a + 16]
	copyb(r12, 0) -> 8[a + 24]
	copyb(0, 0) -> r10
	ret
zulshl_ok:
	copyb(r11, 8[a + 0]) -> r13
	copyb(r11, 8[a + 8]) -> r14
	copyb(r11, 8[a + 16]) -> r15
	copyb(r11, 8[a + 24]) -> r16
	srl(r5, 6) -> r6                    ; word shift q
	and(r5, 63) -> r7                   ; bit shift
	eq(r6, 0), j(zulshl_bits)
	eq(r6, 1), j(zulshl_q1)
	eq(r6, 2), j(zulshl_q2)
	copyb(0, r13) -> r16                ; q == 3
	copyb(0, 0) -> r15
	copyb(0, 0) -> r14
	copyb(0, 0) -> r13
	jump(zulshl_bits)
zulshl_q1:
	copyb(0, r15) -> r16
	copyb(0, r14) -> r15
	copyb(0, r13) -> r14
	copyb(0, 0) -> r13
	jump(zulshl_bits)
zulshl_q2:
	copyb(0, r14) -> r16
	copyb(0, r13) -> r15
	copyb(0, 0) -> r14
	copyb(0, 0) -> r13
zulshl_bits:
	eq(r7, 0), j(zulshl_st)
	sub(64, r7) -> r28
	sll(r16, r7) -> r16
	srl(r15, r28) -> r29
	or(r16, r29) -> r16
	sll(r15, r7) -> r15
	srl(r14, r28) -> r29
	or(r15, r29) -> r15
	sll(r14, r7) -> r14
	srl(r13, r28) -> r29
	or(r14, r29) -> r14
	sll(r13, r7) -> r13
zulshl_st:
	copyb(r12, r13) -> 8[a + 0]
	copyb(r12, r14) -> 8[a + 8]
	copyb(r12, r15) -> 8[a + 16]
	copyb(r12, r16) -> 8[a + 24]
	copyb(0, 0) -> r10
	ret

; zkvm_status zkvm_u256_le_signextend(b, value, result) : extend the sign of byte b
; (0 = least significant); b >= 31 -> value unchanged. With bit = 8b + 7, limb
; q = bit / 64 keeps its bits 0..s (s = bit % 64) and takes the sign above them,
; and the limbs above q become all sign bits.
ziskasm_zkvm_u256_le_signextend:
	copyb(r11, 8[a + 0]) -> r13
	copyb(r11, 8[a + 8]) -> r14
	copyb(r11, 8[a + 16]) -> r15
	copyb(r11, 8[a + 24]) -> r16
	copyb(r10, 8[a + 8]) -> r5
	copyb(r10, 8[a + 16]) -> r6
	or(r5, r6) -> r5
	copyb(r10, 8[a + 24]) -> r6
	or(r5, r6) -> r5
	eq(r5, 0), j(zulse_lo)
	jump(zulse_st)
zulse_lo:
	copyb(r10, 8[a + 0]) -> r5
	ltu(r5, 31), j(zulse_ext)
	jump(zulse_st)
zulse_ext:
	sll(r5, 3) -> r5
	add(r5, 7) -> r5                    ; bit
	srl(r5, 6) -> r6                    ; q
	and(r5, 63) -> r7                   ; s
	sll(2, r7) -> r28
	sub(r28, 1) -> r28                  ; keep = (2 << s) - 1 (all ones for s = 63)
	xor(r28, 0xffffffffffffffff) -> r29 ; ~keep
	eq(r6, 0), j(zulse_q0)
	eq(r6, 1), j(zulse_q1)
	eq(r6, 2), j(zulse_q2)
	srl(r16, r7) -> r30
	and(r30, 1) -> r30
	sub(0, r30) -> r30              ; fill
	and(r16, r28) -> r16
	and(r30, r29) -> r31
	or(r16, r31) -> r16
	jump(zulse_st)
zulse_q2:
	srl(r15, r7) -> r30
	and(r30, 1) -> r30
	sub(0, r30) -> r30              ; fill
	and(r15, r28) -> r15
	and(r30, r29) -> r31
	or(r15, r31) -> r15
	copyb(0, r30) -> r16
	jump(zulse_st)
zulse_q1:
	srl(r14, r7) -> r30
	and(r30, 1) -> r30
	sub(0, r30) -> r30              ; fill
	and(r14, r28) -> r14
	and(r30, r29) -> r31
	or(r14, r31) -> r14
	copyb(0, r30) -> r15
	copyb(0, r30) -> r16
	jump(zulse_st)
zulse_q0:
	srl(r13, r7) -> r30
	and(r30, 1) -> r30
	sub(0, r30) -> r30              ; fill
	and(r13, r28) -> r13
	and(r30, r29) -> r31
	or(r13, r31) -> r13
	copyb(0, r30) -> r14
	copyb(0, r30) -> r15
	copyb(0, r30) -> r16
zulse_st:
	copyb(r12, r13) -> 8[a + 0]
	copyb(r12, r14) -> 8[a + 8]
	copyb(r12, r15) -> 8[a + 16]
	copyb(r12, r16) -> 8[a + 24]
	copyb(0, 0) -> r10
	ret
