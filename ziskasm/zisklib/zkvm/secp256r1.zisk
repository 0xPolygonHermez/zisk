; ============================================================================
; zkvm/secp256r1.zisk - secp256r1 (P-256) for the EF zkVM accelerator C ABI.
; Entry `ziskasm_zkvm_secp256r1_verify`, zkvmcall target of `zkvm_secp256r1_verify`.
;
; Same shape as zkvm/secp256k1.zisk's verify: rev8-marshal the EF big-endian byte
; inputs to LE limbs in line, then run the verify flow lifted from secp256r1/ecdsa.zisk
; (NOT calling zisklib_ecdsa_verify_secp256r1). Reuses the shared 256-bit compare
; primitives ecu_is_zero/ecu_gt/ecu_eq and the r1 primitives is_on_curve/inv_fn/
; mul_fn/reduce_fn_secp256r1 + double_scalar_mul_with_g_secp256r1 (P-256 has no GLV).
;
;   zkvm_status zkvm_secp256r1_verify(const zkvm_secp256r1_hash* msg,      (32B, BE)
;                                     const zkvm_secp256r1_signature* sig, (64B = r||s, BE)
;                                     const zkvm_secp256r1_pubkey* pubkey, (64B = x||y, BE)
;                                     bool* verified)
;     [r10=msg, r11=sig, r12=pubkey, r13=verified] -> a0 = ZKVM_EOK (0).
; Labels `zrv_`, data `ZKVM_R1_*`.
; ============================================================================

u64 ZKVM_R1_Z[4]    = 0, 0, 0, 0
u64 ZKVM_R1_R[4]    = 0, 0, 0, 0
u64 ZKVM_R1_S[4]    = 0, 0, 0, 0
u64 ZKVM_R1_PK[8]   = 0, 0, 0, 0, 0, 0, 0, 0
u64 ZKVM_R1_SINV[4] = 0, 0, 0, 0
u64 ZKVM_R1_U1[4]   = 0, 0, 0, 0
u64 ZKVM_R1_U2[4]   = 0, 0, 0, 0
u64 ZKVM_R1_PT[8]   = 0, 0, 0, 0, 0, 0, 0, 0
u64 ZKVM_R1_XR[4]   = 0, 0, 0, 0
ziskasm_zkvm_secp256r1_verify:
	push r1
	copyb(0, r13) -> r32                ; the verified pointer, for the end (no callee uses r32..r39)
	; --- marshal z, r, s, pk (BE bytes -> LE limbs, 1 step per limb) ---
	rev8(r10, 8[a + 24]) -> [ZKVM_R1_Z + 0]
	rev8(r10, 8[a + 16]) -> [ZKVM_R1_Z + 8]
	rev8(r10, 8[a + 8]) -> [ZKVM_R1_Z + 16]
	rev8(r10, 8[a + 0]) -> [ZKVM_R1_Z + 24]
	rev8(r11, 8[a + 24]) -> [ZKVM_R1_R + 0]
	rev8(r11, 8[a + 16]) -> [ZKVM_R1_R + 8]
	rev8(r11, 8[a + 8]) -> [ZKVM_R1_R + 16]
	rev8(r11, 8[a + 0]) -> [ZKVM_R1_R + 24]
	rev8(r11, 8[a + 56]) -> [ZKVM_R1_S + 0]
	rev8(r11, 8[a + 48]) -> [ZKVM_R1_S + 8]
	rev8(r11, 8[a + 40]) -> [ZKVM_R1_S + 16]
	rev8(r11, 8[a + 32]) -> [ZKVM_R1_S + 24]
	rev8(r12, 8[a + 24]) -> [ZKVM_R1_PK + 0]
	rev8(r12, 8[a + 16]) -> [ZKVM_R1_PK + 8]
	rev8(r12, 8[a + 8]) -> [ZKVM_R1_PK + 16]
	rev8(r12, 8[a + 0]) -> [ZKVM_R1_PK + 24]
	rev8(r12, 8[a + 56]) -> [ZKVM_R1_PK + 32 + 0]
	rev8(r12, 8[a + 48]) -> [ZKVM_R1_PK + 32 + 8]
	rev8(r12, 8[a + 40]) -> [ZKVM_R1_PK + 32 + 16]
	rev8(r12, 8[a + 32]) -> [ZKVM_R1_PK + 32 + 24]

	; ================= verify (limb arrays ZKVM_R1_*) =================
	; --- r, s in [1, n-1]: the top limb settles it unless it is 0 or n's ---
	copyb(0, [ZKVM_R1_R + 24])
	sub(c, 1)
	ltu(c, 0xfffffffeffffffff), j(zrv_rok)   ; top limb in [1, n's top limb - 1]: in range
	copyb(0, ZKVM_R1_R) -> r10
	call ecu_is_zero
	ltu(0, r10), j(zrv_false)
	copyb(0, ZKVM_R1_R) -> r10
	copyb(0, R1_N_MINUS_ONE) -> r11
	call ecu_gt
	ltu(0, r10), j(zrv_false)
zrv_rok:
	copyb(0, [ZKVM_R1_S + 24])
	sub(c, 1)
	ltu(c, 0xfffffffeffffffff), j(zrv_sok)   ; top limb in [1, n's top limb - 1]: in range
	copyb(0, ZKVM_R1_S) -> r10
	call ecu_is_zero
	ltu(0, r10), j(zrv_false)
	copyb(0, ZKVM_R1_S) -> r10
	copyb(0, R1_N_MINUS_ONE) -> r11
	call ecu_gt
	ltu(0, r10), j(zrv_false)
zrv_sok:
	; --- pk != identity ---
	copyb(0, [ZKVM_R1_PK + 24])
	ltu(0, c), j(zrv_pkxok)             ; x's top limb nonzero: not the identity
	copyb(0, ZKVM_R1_PK) -> r10
	call ecu_is_zero
	eq(r10, 0), j(zrv_pkxok)
	copyb(0, ZKVM_R1_PK) -> r10
	add(r10, 32) -> r10
	call ecu_is_zero
	ltu(0, r10), j(zrv_false)
zrv_pkxok:
	; --- pk_x, pk_y in [0, p-1] ---
	copyb(0, [ZKVM_R1_PK + 24])
	ltu(c, 0xffffffff00000001), j(zrv_pxok)   ; top limb below p-1's: in range
	copyb(0, ZKVM_R1_PK) -> r10
	copyb(0, R1_P_MINUS_ONE) -> r11
	call ecu_gt
	ltu(0, r10), j(zrv_false)
zrv_pxok:
	copyb(0, [ZKVM_R1_PK + 32 + 24])
	ltu(c, 0xffffffff00000001), j(zrv_pyok)   ; top limb below p-1's: in range
	copyb(0, ZKVM_R1_PK + 32) -> r10
	copyb(0, R1_P_MINUS_ONE) -> r11
	call ecu_gt
	ltu(0, r10), j(zrv_false)
zrv_pyok:
	; --- pk on curve ---
	copyb(0, ZKVM_R1_PK) -> r10
	call zisklib_is_on_curve_secp256r1
	eq(r10, 0), j(zrv_false)
	; --- s_inv = s^-1 (mod n) ---
	copyb(0, ZKVM_R1_S) -> r10
	copyb(0, ZKVM_R1_SINV) -> r11
	call zisklib_inv_fn_secp256r1
	; --- u1 = z * s_inv ---
	copyb(0, ZKVM_R1_Z) -> r10
	copyb(0, ZKVM_R1_SINV) -> r11
	copyb(0, ZKVM_R1_U1) -> r12
	call zisklib_mul_fn_secp256r1
	; --- u2 = r * s_inv ---
	copyb(0, ZKVM_R1_R) -> r10
	copyb(0, ZKVM_R1_SINV) -> r11
	copyb(0, ZKVM_R1_U2) -> r12
	call zisklib_mul_fn_secp256r1
	; --- (x,y) = u1*G + u2*pk ---
	copyb(0, ZKVM_R1_U1) -> r10
	copyb(0, ZKVM_R1_U2) -> r11
	copyb(0, ZKVM_R1_PK) -> r12
	copyb(0, ZKVM_R1_PT) -> r13
	call zisklib_double_scalar_mul_with_g_secp256r1
	ltu(0, r10), j(zrv_false)
	; --- accept iff x == r (mod n) ---
	copyb(0, ZKVM_R1_PT) -> r10
	copyb(0, ZKVM_R1_R) -> r11
	call ecu_eq
	ltu(0, r10), j(zrv_true)
	copyb(0, ZKVM_R1_PT) -> r10
	copyb(0, ZKVM_R1_XR) -> r11
	call zisklib_reduce_fn_secp256r1
	copyb(0, ZKVM_R1_XR) -> r10
	copyb(0, ZKVM_R1_R) -> r11
	call ecu_eq
	ltu(0, r10), j(zrv_true)

zrv_false:
	copyb(0, 0) -> r14
	jump(zrv_store)
zrv_true:
	copyb(0, 1) -> r14
zrv_store:
	copyb(r32, r14) -> 1[a + 0]
	copyb(0, 0) -> r10
	pop r1
	ret
