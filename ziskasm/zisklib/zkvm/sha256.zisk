; ============================================================================
; zkvm/sha256.zisk - SHA2-256 for the EF zkVM accelerator C ABI. Entry point
; `ziskasm_zkvm_sha256`, redirect target of the standard symbol `zkvm_sha256`.
;
;   zkvm_status zkvm_sha256(const uint8_t* data, size_t len,
;                           zkvm_sha256_hash* output)
;     a0 = data, a1 = len, a2 = output (32 bytes); returns a0 = ZKVM_EOK (0).
;
; This is a thin shim over the shared `zisklib_sha256` primitive: the argument
; ABI is identical (r10=data, r11=len, r12=output) and SHA-256 is byte-in /
; byte-out, so the only extra work is the EF-ABI status return. Keeping a single
; sha256 body in zisklib_sha256 (which is also called internally by schnorr and
; the BLS12-381 hash-to-curve) avoids duplicating the compress loop.
; ============================================================================

ziskasm_zkvm_sha256:
	push r1
	call zisklib_sha256                 ; r10=data, r11=len, r12=output (in place)
	copyb(0, 0) -> r10                  ; return ZKVM_EOK (a0 = 0)
	pop r1
	ret
