; ============================================================================
; bigint/mul_long.zisk - schoolbook multiply of two large numbers + mul-and-reduce. Mirrors mul_long.rs.
; GENERATED by scripts/legacy/gen_bigint.py. Radix 2^256 (digit = U256 = 4 u64);
; arbitrary-precision arithmetic for modexp (EIP-198). Prefix bi_.
; ============================================================================

; u64 zisklib_mul_long(const u64* a, u64 lena, const u64* b, u64 lenb, u64* out) -> r10 out_len
;   schoolbook radix-2^256. out needs lena+lenb U256 (zeroed here). Uses arith256+add256.
;   Row 0 writes out[j] and its high half into out[j+1]; row i >= 1 adds a_i * b_j into
;   out[i+j] (high half to BI_DH, carried into out[i+j+1] by add256), and out[i+lenb] = BI_DH
;   (+1 on a final carry). The state is in registers: r10 = &a_i, r11 = a end, r12 = &b_0,
;   r13 = b end, r15 = &b_(lenb-1), r14 = &out[i], r6 = &b_j, r7 = &out[i+j], r17 = carry,
;   r5 = the arith256 header, r16 = the add256 header (BI_HDR2).
zisklib_mul_long:
	add(r11, r13) -> r6
	copyb(0, BI_LEN) -> r5
	copyb(r5, r6) -> 8[a + 0]           ; lena + lenb, for the result length
	sll(r6, 5) -> r6
	dma_xmemset(r14, r6) -> r5, j(0, 4)
	sll(r11, 5) -> r11
	add(r10, r11) -> r11
	sll(r13, 5) -> r13
	add(r12, r13) -> r13
	sub(r13, 32) -> r15
	; row 0: out[j] = a_0 * b_j + out[j] (out[0] + 0), high half to out[j+1]
	copyb(0, BI_HDR) -> r5
	copyb(r5, r10) -> 8[a + 0]
	copyb(0, BI_ZERO) -> r6
	copyb(r5, r6) -> 8[a + 16]
	copyb(0, r12) -> r6
	copyb(0, r14) -> r7
bi_mll_j0:
	copyb(r5, r6) -> 8[a + 8]
	copyb(r5, r7) -> 8[a + 24]
	add(r7, 32) -> r7
	copyb(r5, r7) -> 8[a + 32]
	arith256(0, r5)
	copyb(r5, r7) -> 8[a + 16]
	add(r6, 32) -> r6
	ltu(r6, r13), j(bi_mll_j0)
	; rows i >= 1: the high halves go to BI_DH
	copyb(0, BI_DH) -> r6
	copyb(r5, r6) -> 8[a + 32]
	copyb(0, BI_HDR2) -> r16
	copyb(r16, r6) -> 8[a + 8]
bi_mll_i:
	add(r10, 32) -> r10
	add(r14, 32) -> r14
	ltu(r10, r11), j(bi_mll_row)
	jump(bi_mll_id)
bi_mll_row:
	copyb(r5, r10) -> 8[a + 0]
	copyb(0, r12) -> r6
	copyb(0, r14) -> r7
	copyb(0, 0) -> r17
	ltu(r6, r15), j(bi_mll_ij)
	jump(bi_mll_ijlast)
bi_mll_ij:
	copyb(r5, r6) -> 8[a + 8]
	copyb(r5, r7) -> 8[a + 16]
	copyb(r5, r7) -> 8[a + 24]
	arith256(0, r5)
	add(r7, 32) -> r7
	copyb(r16, r7) -> 8[a + 0]
	copyb(r16, r17) -> 8[a + 16]
	copyb(r16, r7) -> 8[a + 24]
	add256(0, r16) -> r17
	add(r6, 32) -> r6
	ltu(r6, r15), j(bi_mll_ij)
bi_mll_ijlast:
	copyb(r5, r6) -> 8[a + 8]
	copyb(r5, r7) -> 8[a + 16]
	copyb(r5, r7) -> 8[a + 24]
	arith256(0, r5)
	eq(r17, 0), j(bi_mll_nocarry)
	copyb(0, BI_DH) -> r6               ; BI_DH += 1 (add256 on the arith256 header)
	copyb(r5, r6) -> 8[a + 0]
	copyb(0, BI_ZERO) -> r6
	copyb(r5, r6) -> 8[a + 8]
	copyb(r5, 1) -> 8[a + 16]
	copyb(0, BI_DH) -> r6
	copyb(r5, r6) -> 8[a + 24]
	add256(0, r5)
bi_mll_nocarry:
	add(r7, 32) -> r7                   ; out[i+lenb] = BI_DH
	copyb(0, BI_DH) -> r6
	copyb(r6, 8[a + 0]) -> r17
	copyb(r7, r17) -> 8[a + 0]
	copyb(r6, 8[a + 8]) -> r17
	copyb(r7, r17) -> 8[a + 8]
	copyb(r6, 8[a + 16]) -> r17
	copyb(r7, r17) -> 8[a + 16]
	copyb(r6, 8[a + 24]) -> r17
	copyb(r7, r17) -> 8[a + 24]
	jump(bi_mll_i)
bi_mll_id:
	; out_len = lena + lenb, less one if the top digit (at r14 + (lenb-1)*32) is zero
	sub(r15, r12) -> r6
	add(r14, r6) -> r14
	copyb(r14, 8[a + 0]) -> r5
	copyb(r14, 8[a + 8]) -> r7
	or(r5, r7) -> r5
	copyb(r14, 8[a + 16]) -> r7
	or(r5, r7) -> r5
	copyb(r14, 8[a + 24]) -> r7
	or(r5, r7) -> r5
	copyb(0, BI_LEN) -> r6
	copyb(r6, 8[a + 0]) -> r10
	ltu(0, r5), j(bi_mll_ret)
	sub(r10, 1) -> r10
bi_mll_ret:
	ret

; u64 zisklib_mul_and_reduce_long(a, lena, b, lenb, mod, lenm, out) -> r10 outlen  (out = a*b mod mod)
zisklib_mul_and_reduce_long:
	push r1
	copyb(0, BI_MR_MOD) -> r5
	copyb(r5, r14) -> 8[a + 0]
	copyb(0, BI_MR_LENM) -> r5
	copyb(r5, r15) -> 8[a + 0]
	copyb(0, BI_MR_OUT) -> r5
	copyb(r5, r16) -> 8[a + 0]
	copyb(0, BI_MUL) -> r14
	call zisklib_mul_long
	copyb(0, r10) -> r11
	copyb(0, BI_MUL) -> r10
	copyb(0, BI_MR_MOD) -> r12
	copyb(r12, 8[a + 0]) -> r12
	copyb(0, BI_MR_LENM) -> r13
	copyb(r13, 8[a + 0]) -> r13
	copyb(0, BI_MR_OUT) -> r14
	copyb(r14, 8[a + 0]) -> r14
	call zisklib_rem_long
	pop r1
	ret

