; u64 zisklib_bin_decomp(const u64* exp, u64 len_e) -> r10 = len_bits ; MSB-first bits in BI_BITS
;   hints the bit decomposition, then recomposes and asserts it equals exp.
zisklib_bin_decomp:
	push r1
	copyb(0, BI_EXPP) -> r5
	copyb(r5, r10) -> 8[a + 0]
	copyb(0, BI_LENB) -> r5
	copyb(r5, r11) -> 8[a + 0]
	copyb(0, BI_BITS) -> r6
	copyb(0, 0) -> r7
bi_bc_zbits:
	eq(r7, 128), j(bi_bc_zbitsd)
	copyb(r6, 0) -> 8[a + 0]
	add(r6, 8) -> r6
	add(r7, 1) -> r7
	jump(bi_bc_zbits)
bi_bc_zbitsd:
	fcall_param(1, r11) -> r14
	copyb(0, BI_J) -> r5
	copyb(r5, 0) -> 8[a + 0]
bi_bc_ap:
	copyb(0, BI_J) -> r5
	copyb(r5, 8[a + 0]) -> r6
	copyb(0, BI_LENB) -> r5
	copyb(r5, 8[a + 0]) -> r7
	eq(r6, r7), j(bi_bc_apd)
	sll(r6, 3) -> r16
	copyb(0, BI_EXPP) -> r5
	copyb(r5, 8[a + 0]) -> r17
	add(r17, r16) -> r17
	copyb(r17, 8[a + 0]) -> r17
	fcall_param(1, r17) -> r14
	copyb(0, BI_J) -> r5
	copyb(r5, 8[a + 0]) -> r6
	add(r6, 1) -> r6
	copyb(r5, r6) -> 8[a + 0]
	jump(bi_bc_ap)
bi_bc_apd:
	fcall(FCALL_BIN_DECOMP, 0) -> r14
	copyb(0, [FREE_INPUT]) -> r6
	copyb(0, BI_NBITS) -> r5
	copyb(r5, r6) -> 8[a + 0]
	copyb(0, BI_J) -> r5
	copyb(r5, 0) -> 8[a + 0]
bi_bc_rb:
	copyb(0, BI_J) -> r5
	copyb(r5, 8[a + 0]) -> r6
	copyb(0, BI_NBITS) -> r5
	copyb(r5, 8[a + 0]) -> r7
	eq(r6, r7), j(bi_bc_rbd)
	fcall_get(0, 0) -> r14
	copyb(0, [FREE_INPUT]) -> r17
	srl(r6, 6) -> r16
	sll(r16, 3) -> r16
	copyb(0, BI_BITS) -> r5
	add(r5, r16) -> r5
	and(r6, 63) -> r7
	sll(r17, r7) -> r17
	copyb(r5, 8[a + 0]) -> r7
	or(r7, r17) -> r7
	copyb(r5, r7) -> 8[a + 0]
	copyb(0, BI_J) -> r5
	copyb(r5, 8[a + 0]) -> r6
	add(r6, 1) -> r6
	copyb(r5, r6) -> 8[a + 0]
	jump(bi_bc_rb)
bi_bc_rbd:
	copyb(0, BI_BITS) -> r5
	copyb(r5, 8[a + 0]) -> r6
	and(r6, 1) -> r6
	copyb(0, 1) -> r7
	eq(r6, r7), j(bi_bc_recinit)
	jump(bi_bc_bad)
bi_bc_recinit:
	copyb(0, BI_LENB) -> r5
	copyb(r5, 8[a + 0]) -> r7
	copyb(0, BI_J) -> r5
	copyb(r5, 0) -> 8[a + 0]
bi_bc_zero:
	copyb(0, BI_J) -> r5
	copyb(r5, 8[a + 0]) -> r6
	copyb(0, BI_LENB) -> r5
	copyb(r5, 8[a + 0]) -> r7
	eq(r6, r7), j(bi_bc_zerod)
	sll(r6, 3) -> r16
	copyb(0, BI_RECEXP) -> r5
	add(r5, r16) -> r5
	copyb(r5, 0) -> 8[a + 0]
	copyb(0, BI_J) -> r5
	copyb(r5, 8[a + 0]) -> r6
	add(r6, 1) -> r6
	copyb(r5, r6) -> 8[a + 0]
	jump(bi_bc_zero)
bi_bc_zerod:
	copyb(0, BI_J) -> r5
	copyb(r5, 0) -> 8[a + 0]
bi_bc_rec:
	copyb(0, BI_J) -> r5
	copyb(r5, 8[a + 0]) -> r6
	copyb(0, BI_NBITS) -> r5
	copyb(r5, 8[a + 0]) -> r7
	eq(r6, r7), j(bi_bc_recd)
	srl(r6, 6) -> r16
	sll(r16, 3) -> r16
	copyb(0, BI_BITS) -> r5
	add(r5, r16) -> r5
	copyb(r5, 8[a + 0]) -> r5
	and(r6, 63) -> r16
	srl(r5, r16) -> r5
	and(r5, 1) -> r17
	eq(r17, 0), j(bi_bc_recnext)
	copyb(0, BI_NBITS) -> r5
	copyb(r5, 8[a + 0]) -> r7
	sub(r7, 1) -> r7
	sub(r7, r6) -> r7
	srl(r7, 6) -> r16
	and(r7, 63) -> r7
	copyb(0, 1) -> r14
	sll(r14, r7) -> r14
	sll(r16, 3) -> r16
	copyb(0, BI_RECEXP) -> r5
	add(r5, r16) -> r5
	copyb(r5, 8[a + 0]) -> r6
	or(r6, r14) -> r6
	copyb(r5, r6) -> 8[a + 0]
bi_bc_recnext:
	copyb(0, BI_J) -> r5
	copyb(r5, 8[a + 0]) -> r6
	add(r6, 1) -> r6
	copyb(r5, r6) -> 8[a + 0]
	jump(bi_bc_rec)
bi_bc_recd:
	copyb(0, BI_RECEXP) -> r10
	copyb(0, BI_EXPP) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(0, BI_LENB) -> r12
	copyb(r12, 8[a + 0]) -> r12
	call bn254_eqn
	eq(r10, 0), j(bi_bc_bad)
	copyb(0, BI_NBITS) -> r5
	copyb(r5, 8[a + 0]) -> r10
	pop r1
	ret
bi_bc_bad:
	copyb(0, 0) -> r10, end

