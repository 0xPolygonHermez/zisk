	copyb(r11, 0) -> 8[a + 0]
	copyb(r11, 0) -> 8[a + 8]
	copyb(r11, 0) -> 8[a + 16]
	copyb(r11, 0) -> 8[a + 24]
	copyb(0, 4) -> r10
	pop r1
	ret
bi_dp_ret1:
	copyb(0, BI_DP_RES) -> r11
	copyb(r11, 8[a + 0]) -> r11
	copyb(r11, 1) -> 8[a + 0]
	copyb(r11, 0) -> 8[a + 8]
	copyb(r11, 0) -> 8[a + 16]
	copyb(r11, 0) -> 8[a + 24]
	copyb(0, 4) -> r10
	pop r1
	ret

