; ============================================================================
; bigint/add_agtb.zisk - add two large numbers with a >= b. Mirrors add_agtb.rs.
; GENERATED by scripts/legacy/gen_bigint.py. Radix 2^256 (digit = U256 = 4 u64);
; arbitrary-precision arithmetic for modexp (EIP-198). Prefix bi_.
; ============================================================================

; u64 zisklib_add_agtb(const u64* a, u64 lena, const u64* b, u64 lenb, u64* out) -> r10 out_len
;   out = a + b, lena >= lenb >= 1: one add256 per digit, b's digits then BI_ZERO. The state
;   is in registers: r10 = &a_i, r12 = &b_i, r14 = &out_i, r15 = carry, r16 = a end,
;   r17 = b end, r5 = the add256 header.
zisklib_add_agtb:
	sll(r11, 5) -> r16
	add(r10, r16) -> r16
	sll(r13, 5) -> r17
	add(r12, r17) -> r17
	copyb(0, BI_HDR) -> r5
	copyb(0, 0) -> r15
bi_ag_b:
	copyb(r5, r10) -> 8[a + 0]
	copyb(r5, r12) -> 8[a + 8]
	copyb(r5, r15) -> 8[a + 16]
	copyb(r5, r14) -> 8[a + 24]
	add256(0, r5) -> r15
	add(r10, 32) -> r10
	add(r12, 32) -> r12
	add(r14, 32) -> r14
	ltu(r12, r17), j(bi_ag_b)
	copyb(0, BI_ZERO) -> r12
	copyb(r5, r12) -> 8[a + 8]
	ltu(r10, r16), j(bi_ag_a)
	jump(bi_ag_done)
bi_ag_a:
	copyb(r5, r10) -> 8[a + 0]
	copyb(r5, r15) -> 8[a + 16]
	copyb(r5, r14) -> 8[a + 24]
	add256(0, r5) -> r15
	add(r10, 32) -> r10
	add(r14, 32) -> r14
	ltu(r10, r16), j(bi_ag_a)
bi_ag_done:
	copyb(0, r11) -> r10
	eq(r15, 0), j(bi_ag_ret)
	copyb(r14, 1) -> 8[a + 0]
	copyb(r14, 0) -> 8[a + 8]
	copyb(r14, 0) -> 8[a + 16]
	copyb(r14, 0) -> 8[a + 24]
	add(r11, 1) -> r10
bi_ag_ret:
	ret

