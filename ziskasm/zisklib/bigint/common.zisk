; (usize,usize) zisklib_bigint_div(const u64* a, u64 lena, const u64* b, u64 lenb, u64* quo, u64* rem)
;   hint quotient+remainder via FCALL_BIGINT_DIV. r10=len_quo, r11=len_rem (u64 counts).
;   lena and lenb are whole U256 digits (multiples of 4), so the operands go 4 words
;   per fcall_param. The loop state is in registers (r16 pointer, r17 end).
zisklib_bigint_div:
	fcall_param(1, r11) -> r0
	sll(r11, 3) -> r17
	add(r10, r17) -> r17
	copyb(0, r10) -> r16
bi_bd_ap:
	fcall_param(4, r16) -> r0
	add(r16, 32) -> r16
	ltu(r16, r17), j(bi_bd_ap)
	fcall_param(1, r13) -> r0
	sll(r13, 3) -> r17
	add(r12, r17) -> r17
	copyb(0, r12) -> r16
bi_bd_bp:
	fcall_param(4, r16) -> r0
	add(r16, 32) -> r16
	ltu(r16, r17), j(bi_bd_bp)
	fcall(FCALL_BIGINT_DIV, 0) -> r0
	copyb(0, [FREE_INPUT]) -> r10
	sll(r10, 3) -> r17
	add(r14, r17) -> r17
	copyb(0, r14) -> r16
	eq(r16, r17), j(bi_bd_rqd)
bi_bd_rq:
	fcall_get(0, 0) -> r0
	copyb(0, [FREE_INPUT]) -> r6
	copyb(r16, r6) -> 8[a + 0]
	add(r16, 8) -> r16
	ltu(r16, r17), j(bi_bd_rq)
bi_bd_rqd:
	fcall_get(0, 0) -> r0
	copyb(0, [FREE_INPUT]) -> r11
	sll(r11, 3) -> r17
	add(r15, r17) -> r17
	copyb(0, r15) -> r16
	eq(r16, r17), j(bi_bd_rrd)
bi_bd_rr:
	fcall_get(0, 0) -> r0
	copyb(0, [FREE_INPUT]) -> r6
	copyb(r16, r6) -> 8[a + 0]
	add(r16, 8) -> r16
	ltu(r16, r17), j(bi_bd_rr)
bi_bd_rrd:
	ret

