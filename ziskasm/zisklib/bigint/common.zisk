	copyb(r14, r17) -> 8[a + 0]
	copyb(0, BI_J) -> r5
	copyb(r5, 8[a + 0]) -> r6
	add(r6, 1) -> r6
	copyb(r5, r6) -> 8[a + 0]
	jump(bi_bd_rr)
bi_bd_rrd:
	copyb(0, BI_LENQ) -> r5
	copyb(r5, 8[a + 0]) -> r10
	copyb(0, BI_LENR) -> r5
	copyb(r5, 8[a + 0]) -> r11
	pop r1
	ret

