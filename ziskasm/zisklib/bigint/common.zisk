; u64 zisklib_bi_lt(const u64* a, u64 lena, const u64* b, u64 lenb) -> r10 (1 if a<b)
zisklib_bi_lt:
	push r1
	ltu(r11, r13), j(bi_lt_less)
	ltu(r13, r11), j(bi_lt_notless)
	copyb(0, r12) -> r14
	sll(r11, 2) -> r12
	copyb(0, r14) -> r11
	call bn254_ltn
	pop r1
	ret
bi_lt_less:
	copyb(0, 1) -> r10
	pop r1
	ret
bi_lt_notless:
	copyb(0, 0) -> r10
	pop r1
	ret

; u64 zisklib_bi_eq(const u64* a, u64 lena, const u64* b, u64 lenb) -> r10 (1 if a==b)
zisklib_bi_eq:
	push r1
	eq(r11, r13), j(bi_eq_same)
	copyb(0, 0) -> r10
	pop r1
	ret
bi_eq_same:
	copyb(0, r12) -> r14
	sll(r11, 2) -> r12
	copyb(0, r14) -> r11
	call bn254_eqn
	pop r1
	ret

; u64 zisklib_bi_iszero(const u64* a, u64 nwords) -> r10 (1 if all zero)
zisklib_bi_iszero:
	sll(r11, 3) -> r7
	add(r10, r7) -> r7                  ; end
	eq(r10, r7), j(bi_iz_zero)
bi_iz_loop:
	copyb(r10, 8[a + 0]) -> r5
	ltu(0, r5), j(bi_iz_nz)             ; a nonzero word: done
	add(r10, 8) -> r10
	ltu(r10, r7), j(bi_iz_loop)
bi_iz_zero:
	copyb(0, 1) -> r10
	ret
bi_iz_nz:
	copyb(0, 0) -> r10
	ret

