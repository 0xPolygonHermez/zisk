; void zisklib_mulmod_short(const u64* a, const u64* b, const u64* modulus, u64* result)
;   result = (a*b) mod modulus  (all single U256). arith256_mod precompile.
zisklib_mulmod_short:
	copyb(0, BI_HDR) -> r5
	copyb(r5, r10) -> 8[a + 0]
	copyb(r5, r11) -> 8[a + 8]
	copyb(0, BI_ZERO) -> r6
	copyb(r5, r6) -> 8[a + 16]
	copyb(r5, r12) -> 8[a + 24]
	copyb(r5, r13) -> 8[a + 32]
	arith256_mod(0, r5) -> r14
	ret

; u64 zisklib_mul_short(const u64* a, u64 len_a, const u64* b, u64* out) -> r10 = out_len
;   out = a*b (a has len_a U256 digits, b is one U256). out needs len_a+1 digits.
zisklib_mul_short:
	push r1
	copyb(0, BI_APTR) -> r5
	copyb(r5, r10) -> 8[a + 0]
	copyb(0, BI_LEN) -> r5
	copyb(r5, r11) -> 8[a + 0]
	copyb(0, BI_BPTR) -> r5
	copyb(r5, r12) -> 8[a + 0]
	copyb(0, BI_OPTR) -> r5
	copyb(r5, r13) -> 8[a + 0]
	copyb(0, BI_CARRY) -> r5
	copyb(r5, 0) -> 8[a + 0]
	copyb(r5, 0) -> 8[a + 8]
	copyb(r5, 0) -> 8[a + 16]
	copyb(r5, 0) -> 8[a + 24]
	copyb(0, BI_I) -> r5
	copyb(r5, 0) -> 8[a + 0]
bi_ms_loop:
	copyb(0, BI_I) -> r5
	copyb(r5, 8[a + 0]) -> r6
	copyb(0, BI_LEN) -> r5
	copyb(r5, 8[a + 0]) -> r7
	eq(r6, r7), j(bi_ms_done)
	copyb(0, BI_CARRY) -> r10
	copyb(0, BI_CIN) -> r11
	copyb(0, 4) -> r12
	call bn254_memcpy
	copyb(0, BI_I) -> r5
	copyb(r5, 8[a + 0]) -> r6
	sll(r6, 5) -> r16
	copyb(0, BI_HDR) -> r5
	copyb(0, BI_APTR) -> r17
	copyb(r17, 8[a + 0]) -> r17
	add(r17, r16) -> r17
	copyb(r5, r17) -> 8[a + 0]
	copyb(0, BI_BPTR) -> r6
	copyb(r6, 8[a + 0]) -> r6
	copyb(r5, r6) -> 8[a + 8]
	copyb(0, BI_CIN) -> r6
	copyb(r5, r6) -> 8[a + 16]
	copyb(0, BI_OPTR) -> r14
	copyb(r14, 8[a + 0]) -> r14
	add(r14, r16) -> r14
	copyb(r5, r14) -> 8[a + 24]
	copyb(0, BI_CARRY) -> r6
	copyb(r5, r6) -> 8[a + 32]
	arith256(0, r5) -> r13
	copyb(0, BI_I) -> r5
	copyb(r5, 8[a + 0]) -> r6
	add(r6, 1) -> r6
	copyb(r5, r6) -> 8[a + 0]
	jump(bi_ms_loop)
bi_ms_done:
	copyb(0, BI_CARRY) -> r6
	copyb(r6, 8[a + 0]) -> r7
	copyb(r6, 8[a + 8]) -> r16
	or(r7, r16) -> r7
	copyb(r6, 8[a + 16]) -> r16
	or(r7, r16) -> r7
	copyb(r6, 8[a + 24]) -> r16
	or(r7, r16) -> r7
	copyb(0, BI_LEN) -> r5
	copyb(r5, 8[a + 0]) -> r10
	eq(r7, 0), j(bi_ms_ret)
	sll(r10, 5) -> r16
	copyb(0, BI_OPTR) -> r5
	copyb(r5, 8[a + 0]) -> r14
	add(r14, r16) -> r14
	copyb(0, BI_CARRY) -> r10
