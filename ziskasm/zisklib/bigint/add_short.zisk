; GENERATED by scratchpad/gen_bigint.py. Radix 2^256 (digit = U256 = 4 u64);
; arbitrary-precision arithmetic for modexp (EIP-198). Prefix bi_.
; ============================================================================

; u64 zisklib_add_short(const u64* a, u64 len_a, const u64* b, u64* out) -> r10 = out_len
;   out = a + b (a has len_a U256 digits, b is one U256). add256 precompile.
zisklib_add_short:
	push r1
	copyb(0, BI_APTR) -> r5
	copyb(r5, r10) -> 8[a + 0]
	copyb(0, BI_LEN) -> r5
	copyb(r5, r11) -> 8[a + 0]
	copyb(0, BI_BPTR) -> r5
	copyb(r5, r12) -> 8[a + 0]
	copyb(0, BI_OPTR) -> r5
	copyb(r5, r13) -> 8[a + 0]
	copyb(0, BI_HDR) -> r5
	copyb(r5, r10) -> 8[a + 0]
	copyb(r5, r12) -> 8[a + 8]
	copyb(r5, 0) -> 8[a + 16]
	copyb(r5, r13) -> 8[a + 24]
	add256(0, r5) -> r15
	copyb(0, BI_I) -> r5
	copyb(r5, 1) -> 8[a + 0]
bi_as_loop:
	copyb(0, BI_I) -> r5
	copyb(r5, 8[a + 0]) -> r6
	copyb(0, BI_LEN) -> r5
	copyb(r5, 8[a + 0]) -> r7
	eq(r6, r7), j(bi_as_done)
	sll(r6, 5) -> r16
	copyb(0, BI_APTR) -> r5
	copyb(r5, 8[a + 0]) -> r17
	add(r17, r16) -> r17
	copyb(0, BI_OPTR) -> r5
	copyb(r5, 8[a + 0]) -> r14
	add(r14, r16) -> r14
	eq(r15, 0), j(bi_as_copy)
	copyb(0, BI_HDR) -> r5
	copyb(r5, r17) -> 8[a + 0]
	copyb(0, BI_ZERO) -> r6
	copyb(r5, r6) -> 8[a + 8]
	copyb(r5, 1) -> 8[a + 16]
	copyb(r5, r14) -> 8[a + 24]
	add256(0, r5) -> r15
	jump(bi_as_next)
bi_as_copy:
	copyb(0, r17) -> r10
	copyb(0, r14) -> r11
	copyb(0, 4) -> r12
	call bn254_memcpy
	copyb(0, 0) -> r15
bi_as_next:
	copyb(0, BI_I) -> r5
	copyb(r5, 8[a + 0]) -> r6
	add(r6, 1) -> r6
	copyb(r5, r6) -> 8[a + 0]
	jump(bi_as_loop)
bi_as_done:
	copyb(0, BI_LEN) -> r5
	copyb(r5, 8[a + 0]) -> r10
	eq(r15, 0), j(bi_as_ret)
	sll(r10, 5) -> r16
	copyb(0, BI_OPTR) -> r5
	copyb(r5, 8[a + 0]) -> r14
	add(r14, r16) -> r14
	copyb(r14, 1) -> 8[a + 0]
	copyb(r14, 0) -> 8[a + 8]
	copyb(r14, 0) -> 8[a + 16]
	copyb(r14, 0) -> 8[a + 24]
	copyb(0, BI_LEN) -> r5
	copyb(r5, 8[a + 0]) -> r10
	add(r10, 1) -> r10
bi_as_ret:
	pop r1
	ret

