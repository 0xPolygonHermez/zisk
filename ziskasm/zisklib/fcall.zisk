; ============================================================================
; fcall.zisk - fcall IDs shared across every ZisK library precompile
; family. Holds only `pub define`s (visible library-wide via the multi-file
; pre-pass); no routines or data. Mirrors ziskos keeping the FCALL_*_ID constants
; in a shared `fcalls/mod.rs` rather than per operation.
; ============================================================================

pub define FCALL_UINT256_DIV     19 ; hints quotient + remainder
pub define FCALL_UINT256_INV     20 ; hints inverse mod 2^256
pub define FCALL_UINT256_INV_MOD 21 ; hints modular inverse / gcd witness

; secp256k1 hints.
pub define FCALL_SECP256K1_FP_INV        1  ; hints 1/x in Fp
pub define FCALL_SECP256K1_FN_INV        2  ; hints 1/x in Fn
pub define FCALL_SECP256K1_FP_SQRT       3  ; hints sqrt in Fp (is_qr + sqrt)
pub define FCALL_SECP256K1_GLV_DECOMPOSE 4  ; hints GLV scalar decomposition
pub define FCALL_SECP256R1_FN_INV        5  ; hints 1/x in the secp256r1 scalar field
pub define FCALL_MSB_POS_256             17 ; hints most-significant set-bit position
