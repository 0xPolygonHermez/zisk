; ============================================================================
; ziskos.zisk
;
; The ZisK program launcher, i.e. the ziskasm equivalent of ziskos::_start
; (ziskos/entrypoint/src/lib.rs). It performs the minimal boot sequence and then
; runs the program entry point `_zisk_main` (defined in doubler.zisk).
;
; ziskos::_start does, in order:
;   1. set the global pointer  (gp / r3 = _global_pointer)
;   2. set the stack pointer   (sp / r2 = _init_stack_top)
;   3. call _zisk_main
;   4. return to the BIOS, which reads the output and ends
;
; This file is the entry point of the program: when the two files are assembled
; together, `_start` is the first instruction (at ROM_ADDR).
;
; Termination uses the ret-to-BIOS convention: the ZisK BIOS enters `_start`
; with the address of its output-finalization code in r1 (a `call`, RISC-V
; `jal r1`). When `_start` returns (`ret`, RISC-V `jalr r0, r1`), the BIOS reads
; the program output from OUTPUT_ADDR and ends. Because our own `call _zisk_main`
; also writes r1, we save and restore the BIOS return address around it.
;
; `call`/`ret` follow the RISC-V convention (return address in r1); see
; ziskasm.md, "Call and return".
; ============================================================================


; ---- Definitions ----

define INIT_STACK_TOP  0xa0400000     ; _init_stack_top = ORIGIN(ram) + stack_size
define GLOBAL_POINTER  0x00000000     ; _global_pointer: unused here (the linker
                                      ; fills it in a real program); set only to
                                      ; mirror the launcher faithfully


_start:
	; ---- Boot sequence (mirrors ziskos::_start) ----
	copyb(0, GLOBAL_POINTER) -> r3        ; gp (r3) = _global_pointer
	copyb(0, INIT_STACK_TOP) -> r2        ; sp (r2) = _init_stack_top

	; The BIOS entered us with its finalization return address in r1. Our own
	; `call` below overwrites r1, so save it in a callee-saved register (r9 / s1)
	; that the program does not touch.
	copyb(0, r1) -> r9                    ; save the BIOS return address

	; Call the program entry point (in doubler.zisk); on return, r1 holds the
	; instruction after this `call`.
	call _zisk_main

	; Restore the BIOS return address and return to the BIOS, which reads the
	; output from OUTPUT_ADDR and ends the program.
	copyb(0, r9) -> r1                    ; restore the BIOS return address
	ret
