; ============================================================================
; compare.zisk - diagnostic for the ZisK comparison instructions.
;
; Covers the 10 compare ops (each stores c = 1 if the relation holds, else 0):
;   lt   ltu   le   leu   eq          (64-bit, signed/unsigned)
;   lt_w ltu_w le_w leu_w eq_w         (32-bit, on the low 32 bits)
;
; Pure-constant style (see minmax.zisk): CMP_TABLE holds the expected 0/1 result
; of every op for each (a, b) pair. Beyond the compare ops it depends only on
; copyb, add and eq. Expected values generated from core/src/ops_core.rs.
;
; CMP_TABLE columns: a b lt ltu le leu eq lt_w ltu_w le_w leu_w eq_w
; First mismatch returns 0x02CC (CC = column: 01=lt .. 0a=eq_w).
;
; Registers: r5 row ptr  r6 row index  r7 a  r8 b  r12 expected  r13 result.
; ============================================================================

define ROWS      15
define ROW_BYTES 96      ; 12 u64 columns * 8 bytes

; a, b, lt, ltu, le, leu, eq, lt_w, ltu_w, le_w, leu_w, eq_w
const u64 CMP_TABLE =
	0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000001, 0x0000000000000001, 0x0000000000000001, 0x0000000000000000, 0x0000000000000000, 0x0000000000000001, 0x0000000000000001, 0x0000000000000001,   ; 0 & 0
	0x0000000000000000, 0x0000000000000001, 0x0000000000000001, 0x0000000000000001, 0x0000000000000001, 0x0000000000000001, 0x0000000000000000, 0x0000000000000001, 0x0000000000000001, 0x0000000000000001, 0x0000000000000001, 0x0000000000000000,   ; 0 & 1
	0x0000000000000001, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,   ; 1 & 0
	0x0000000000000001, 0x0000000000000002, 0x0000000000000001, 0x0000000000000001, 0x0000000000000001, 0x0000000000000001, 0x0000000000000000, 0x0000000000000001, 0x0000000000000001, 0x0000000000000001, 0x0000000000000001, 0x0000000000000000,   ; 1 & 2
	0x0000000000000002, 0x0000000000000001, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,   ; 2 & 1
	0xffffffffffffffff, 0x0000000000000001, 0x0000000000000001, 0x0000000000000000, 0x0000000000000001, 0x0000000000000000, 0x0000000000000000, 0x0000000000000001, 0x0000000000000000, 0x0000000000000001, 0x0000000000000000, 0x0000000000000000,   ; -1 & 1
	0x0000000000000001, 0xffffffffffffffff, 0x0000000000000000, 0x0000000000000001, 0x0000000000000000, 0x0000000000000001, 0x0000000000000000, 0x0000000000000000, 0x0000000000000001, 0x0000000000000000, 0x0000000000000001, 0x0000000000000000,   ; 1 & -1
	0x7fffffffffffffff, 0x8000000000000000, 0x0000000000000000, 0x0000000000000001, 0x0000000000000000, 0x0000000000000001, 0x0000000000000000, 0x0000000000000001, 0x0000000000000000, 0x0000000000000001, 0x0000000000000000, 0x0000000000000000,   ; i64MAX & i64MIN
	0x8000000000000000, 0x7fffffffffffffff, 0x0000000000000001, 0x0000000000000000, 0x0000000000000001, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000001, 0x0000000000000000, 0x0000000000000001, 0x0000000000000000,   ; i64MIN & i64MAX
	0x00000000ffffffff, 0x0000000000000001, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000001, 0x0000000000000000, 0x0000000000000001, 0x0000000000000000, 0x0000000000000000,   ; u32low & 1
	0x000000007fffffff, 0x0000000000000001, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,   ; i32MAX & 1
	0x0000000080000000, 0x0000000000000001, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000001, 0x0000000000000000, 0x0000000000000001, 0x0000000000000000, 0x0000000000000000,   ; i32MIN & 1
	0x0000000080000000, 0x000000007fffffff, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000001, 0x0000000000000000, 0x0000000000000001, 0x0000000000000000, 0x0000000000000000,   ; i32MIN & i32MAX low32
	0xffffffff00000001, 0x0000000100000002, 0x0000000000000001, 0x0000000000000000, 0x0000000000000001, 0x0000000000000000, 0x0000000000000000, 0x0000000000000001, 0x0000000000000001, 0x0000000000000001, 0x0000000000000001, 0x0000000000000000,   ; hi differ, low 1&2
	0xffffffffffffffff, 0xffffffffffffffff, 0x0000000000000000, 0x0000000000000000, 0x0000000000000001, 0x0000000000000001, 0x0000000000000001, 0x0000000000000000, 0x0000000000000000, 0x0000000000000001, 0x0000000000000001, 0x0000000000000001   ; -1 & -1

compare:
	copyb(0, CMP_TABLE) -> r5
	copyb(0, 0) -> r6

cmp_loop:
	eq(r6, ROWS), j(cmp_ok)
	copyb(r5, 8[a + 0]) -> r7      ; a
	copyb(r5, 8[a + 8]) -> r8      ; b

	copyb(r5, 8[a + 16]) -> r12
	lt(r7, r8) -> r13
	eq(r13, r12), j(cmp_c1)
	copyb(0, 0x0201) -> r10
	ret
cmp_c1:
	copyb(r5, 8[a + 24]) -> r12
	ltu(r7, r8) -> r13
	eq(r13, r12), j(cmp_c2)
	copyb(0, 0x0202) -> r10
	ret
cmp_c2:
	copyb(r5, 8[a + 32]) -> r12
	le(r7, r8) -> r13
	eq(r13, r12), j(cmp_c3)
	copyb(0, 0x0203) -> r10
	ret
cmp_c3:
	copyb(r5, 8[a + 40]) -> r12
	leu(r7, r8) -> r13
	eq(r13, r12), j(cmp_c4)
	copyb(0, 0x0204) -> r10
	ret
cmp_c4:
	copyb(r5, 8[a + 48]) -> r12
	eq(r7, r8) -> r13
	eq(r13, r12), j(cmp_c5)
	copyb(0, 0x0205) -> r10
	ret
cmp_c5:
	copyb(r5, 8[a + 56]) -> r12
	lt_w(r7, r8) -> r13
	eq(r13, r12), j(cmp_c6)
	copyb(0, 0x0206) -> r10
	ret
cmp_c6:
	copyb(r5, 8[a + 64]) -> r12
	ltu_w(r7, r8) -> r13
	eq(r13, r12), j(cmp_c7)
	copyb(0, 0x0207) -> r10
	ret
cmp_c7:
	copyb(r5, 8[a + 72]) -> r12
	le_w(r7, r8) -> r13
	eq(r13, r12), j(cmp_c8)
	copyb(0, 0x0208) -> r10
	ret
cmp_c8:
	copyb(r5, 8[a + 80]) -> r12
	leu_w(r7, r8) -> r13
	eq(r13, r12), j(cmp_c9)
	copyb(0, 0x0209) -> r10
	ret
cmp_c9:
	copyb(r5, 8[a + 88]) -> r12
	eq_w(r7, r8) -> r13
	eq(r13, r12), j(cmp_next)
	copyb(0, 0x020a) -> r10
	ret

cmp_next:
	add(r5, ROW_BYTES) -> r5
	add(r6, 1) -> r6
	jump(cmp_loop)

cmp_ok:
	copyb(0, 0) -> r10
	ret
