; ============================================================================
; fcall_bn254.zisk - diagnostic for the ZisK fcall (free-input call) family.
;
; Each sub-check appends a parameter block with a single bulk
; fcall_param(count, ARRAY) (the words>1 form copies `count` u64s from the
; array address), runs fcall(id), then reads the result words back through
; the free-input channel: fcall publishes result[0] and each fcall_get
; publishes the next word, all read as u64 loads from FREE_INPUT (0x40000000).
; Every result word is compared against a golden array generated by running
; fcall_proxy on the host (core/tests/fcall_vectors.rs).
;
; Checks (first mismatch returns 0x2dCC):
;   2d01  bnfpinv (id 6) - Fp inverse
;   2d02  bnfp2inv (id 7) - Fp2 inverse
;   2d03  bntwadd (id 8) - twist line coefficients (add)
;   2d04  bntwdbl (id 9) - twist line coefficients (double)
; ============================================================================

define FREE_INPUT 0x40000000

const u64 BNFPINV_IN1[4] =
	0xf9ee4256a589409f, 0xa21a3985f17502d0, 0xb3eb393d00dc480c, 0x142def02c537eced
const u64 BNFPINV_EXP[4] =
	0x7258dab6e90d1680, 0x779f7ec5cad25c1d, 0xb9c114d250bcaa3c, 0x2525db1f6832d97d

const u64 BNFP2INV_IN1[8] =
	0xa4528921da9661b8, 0xc13514a2f09d4f06, 0x52406705a0d612b8, 0x2b02b26b72efef38,
	0xb64cd3ecb5b08b28, 0xe29c6143da89de45, 0xdfa4f8b46115f7f6, 0x17abb41fc8d1b2c7
const u64 BNFP2INV_EXP[8] =
	0x163d11f5aa617bfc, 0x825bc78934e518e5, 0x31485988143cff2e, 0x0551d3643b94a0ba,
	0xbd2738b4b0c67843, 0xbed5ac50b31d3cef, 0x516d2e7c293eef52, 0x302d79e76ed154c1

const u64 BNTWADD_IN1[32] =
	0x66f0731159b54cd6, 0xb630013739a5a053, 0x31045e15f3a54bc2, 0x214275f5c7d57155,
	0xfaf80b929d13179a, 0xf63689aef8ecc6ff, 0x26ffe67c5b2f3a49, 0x04d4ad74230d1e83,
	0x46246b07a2ce41fd, 0x65cd5922607deeee, 0xe4ae145fac34c502, 0x1e977a2280041e87,
	0x20ca11200df6b3c4, 0x00bed9e88dfb7f8d, 0x735adb5c7981edda, 0x226adef094e4c626,
	0x4b70ada95bc43412, 0x38f6cc990d30c020, 0xca7d1f2becd3258a, 0x2f9041da70888180,
	0x8d940679d41b2409, 0xb28d0f4c5ea7672c, 0xaa05b19dfad3217a, 0x04ff3ef00c3f7d32,
	0x0cf3024d5172b33a, 0xb3f5b354255ea1ee, 0x70f37619880ce080, 0x0e35dfd0b8edaa9c,
	0xf0e610b9d6ba7228, 0x8d4202db12ceed20, 0xdab0c37f22e05f42, 0x172945c562cea2c7
const u64 BNTWADD_EXP[16] =
	0x70a3dd9659d4661d, 0x272dad27777b65c9, 0x0d3ed5d3d8417100, 0x28b3fb64bf5e0593,
	0x84591f2f3fcbbf52, 0x14fd5d4745900016, 0xf620661dd1c5db97, 0x0352e891aa056e3a,
	0x7ae5d34cb3796d62, 0x72e9885302380fda, 0x90ba3e6a5edbad26, 0x0da370e47b9854d6,
	0x337d5300e9a1f793, 0x8e74c5f9836fb364, 0x9207b0b313b312b5, 0x263c38b6fef528c5

const u64 BNTWDBL_IN1[16] =
	0x66f0731159b54cd6, 0xb630013739a5a053, 0x31045e15f3a54bc2, 0x214275f5c7d57155,
	0xfaf80b929d13179a, 0xf63689aef8ecc6ff, 0x26ffe67c5b2f3a49, 0x04d4ad74230d1e83,
	0x46246b07a2ce41fd, 0x65cd5922607deeee, 0xe4ae145fac34c502, 0x1e977a2280041e87,
	0x20ca11200df6b3c4, 0x00bed9e88dfb7f8d, 0x735adb5c7981edda, 0x226adef094e4c626
const u64 BNTWDBL_EXP[16] =
	0xfa23df0596bf5ac0, 0x1d60eabc30697e27, 0xde847f8d09ff3261, 0x0d2b35469ba57c1a,
	0x0e441461c8b02f6c, 0x43ea3964b1f2af60, 0x371d248d3d09e45f, 0x260ac06e4d6faf7d,
	0xf1e9e54da61ae409, 0x1473486505dd6aeb, 0xb6cb8f0ad3d51eea, 0x2e6234f03865fd67,
	0xab884e4411c6b07b, 0x0fafd74a66389f1c, 0x9b91b3503e4834d0, 0x0bb2e0552b697667

fcall_bn254:
	; bnfpinv (id 6)
	fcall_param(4, BNFPINV_IN1) -> r4
	fcall(6, 0) -> r4
	copyb(0, BNFPINV_EXP) -> r5
	copyb(0, 0) -> r6
bn_c1_loop:
	copyb(0, [FREE_INPUT]) -> r7
	copyb(r5, 8[a + 0]) -> r12
	eq(r7, r12), j(bn_c1_n)
	copyb(0, 0x2d01) -> r10
	ret
bn_c1_n:
	add(r5, 8) -> r5
	add(r6, 1) -> r6
	eq(r6, 4), j(bn_c2)
	fcall_get(0, 0) -> r4
	jump(bn_c1_loop)

bn_c2:                              ; bnfp2inv (id 7)
	fcall_param(8, BNFP2INV_IN1) -> r4
	fcall(7, 0) -> r4
	copyb(0, BNFP2INV_EXP) -> r5
	copyb(0, 0) -> r6
bn_c2_loop:
	copyb(0, [FREE_INPUT]) -> r7
	copyb(r5, 8[a + 0]) -> r12
	eq(r7, r12), j(bn_c2_n)
	copyb(0, 0x2d02) -> r10
	ret
bn_c2_n:
	add(r5, 8) -> r5
	add(r6, 1) -> r6
	eq(r6, 8), j(bn_c3)
	fcall_get(0, 0) -> r4
	jump(bn_c2_loop)

bn_c3:                              ; bntwadd (id 8)
	fcall_param(32, BNTWADD_IN1) -> r4
	fcall(8, 0) -> r4
	copyb(0, BNTWADD_EXP) -> r5
	copyb(0, 0) -> r6
bn_c3_loop:
	copyb(0, [FREE_INPUT]) -> r7
	copyb(r5, 8[a + 0]) -> r12
	eq(r7, r12), j(bn_c3_n)
	copyb(0, 0x2d03) -> r10
	ret
bn_c3_n:
	add(r5, 8) -> r5
	add(r6, 1) -> r6
	eq(r6, 16), j(bn_c4)
	fcall_get(0, 0) -> r4
	jump(bn_c3_loop)

bn_c4:                              ; bntwdbl (id 9)
	fcall_param(16, BNTWDBL_IN1) -> r4
	fcall(9, 0) -> r4
	copyb(0, BNTWDBL_EXP) -> r5
	copyb(0, 0) -> r6
bn_c4_loop:
	copyb(0, [FREE_INPUT]) -> r7
	copyb(r5, 8[a + 0]) -> r12
	eq(r7, r12), j(bn_c4_n)
	copyb(0, 0x2d04) -> r10
	ret
bn_c4_n:
	add(r5, 8) -> r5
	add(r6, 1) -> r6
	eq(r6, 16), j(bn_ok)
	fcall_get(0, 0) -> r4
	jump(bn_c4_loop)

bn_ok:
	copyb(0, 0) -> r10
	ret
