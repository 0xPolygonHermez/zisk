; ============================================================================
; fcall_secp256r1.zisk - diagnostic for the ZisK fcall (free-input call) family.
;
; Each sub-check appends a parameter block with a single bulk
; fcall_param(count, ARRAY) (the words>1 form copies `count` u64s from the
; array address), runs fcall(id), then reads the result words back through
; the free-input channel: fcall publishes result[0] and each fcall_get
; publishes the next word, all read as u64 loads from FREE_INPUT (0x40000000).
; Every result word is compared against a golden array generated by running
; fcall_proxy on the host (core/tests/fcall_vectors.rs).
;
; Checks (first mismatch returns 0x2cCC):
;   2c01  r1fninv (id 5) - Fn (scalar) inverse
; ============================================================================

define FREE_INPUT 0x40000000

const u64 R1FNINV_IN1[4] =
	0xf9ee4256a589409f, 0xa21a3985f17502d0, 0xb3eb393d00dc480c, 0x142def02c537eced
const u64 R1FNINV_EXP[4] =
	0x7450938531a554a4, 0x49a5e61e420cf950, 0x5e5e8115e302f1dd, 0xe4bac2152faee1f6

fcall_secp256r1:
	; r1fninv (id 5)
	fcall_param(4, R1FNINV_IN1) -> r4
	fcall(5, 0) -> r4
	copyb(0, R1FNINV_EXP) -> r5
	copyb(0, 0) -> r6
sr_c1_loop:
	copyb(0, [FREE_INPUT]) -> r7
	copyb(r5, 8[a + 0]) -> r12
	eq(r7, r12), j(sr_c1_n)
	copyb(0, 0x2c01) -> r10
	ret
sr_c1_n:
	add(r5, 8) -> r5
	add(r6, 1) -> r6
	eq(r6, 4), j(sr_ok)
	fcall_get(0, 0) -> r4
	jump(sr_c1_loop)

sr_ok:
	copyb(0, 0) -> r10
	ret
