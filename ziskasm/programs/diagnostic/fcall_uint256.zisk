; ============================================================================
; fcall_uint256.zisk - diagnostic for the ZisK fcall (free-input call) family.
;
; Each sub-check appends a parameter block with a single bulk
; fcall_param(count, ARRAY) (the words>1 form copies `count` u64s from the
; array address), runs fcall(id), then reads the result words back through
; the free-input channel: fcall publishes result[0] and each fcall_get
; publishes the next word, all read as u64 loads from FREE_INPUT (0x40000000).
; Every result word is compared against a golden array generated by running
; fcall_proxy on the host (core/tests/fcall_vectors.rs).
;
; Checks (first mismatch returns 0x2aCC):
;   2a01  u256div (id 19) - 256-bit division (quotient+remainder)
;   2a02  u256inv (id 20) - inverse mod 2^256 (flag + value)
;   2a03  u256invmod (id 21) - inverse mod m (flag + value / gcd witness)
; ============================================================================

define FREE_INPUT 0x40000000

const u64 U256DIV_IN1[8] =
	0x0000000000000064, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
	0x0000000000000007, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000
const u64 U256DIV_EXP[8] =
	0x000000000000000e, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
	0x0000000000000002, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000

const u64 U256INV_IN1[4] =
	0x0000000000000003, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000
const u64 U256INV_EXP[5] =
	0x0000000000000001, 0xaaaaaaaaaaaaaaab, 0xaaaaaaaaaaaaaaaa, 0xaaaaaaaaaaaaaaaa,
	0xaaaaaaaaaaaaaaaa

const u64 U256INVMOD_IN1[8] =
	0x000000000000000d, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
	0x000000000000000c, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000
const u64 U256INVMOD_EXP[13] =
	0x0000000000000001, 0x0000000000000001, 0x0000000000000000, 0x0000000000000000,
	0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
	0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
	0x0000000000000000

fcall_uint256:
	; u256div (id 19)
	fcall_param(8, U256DIV_IN1) -> r4
	fcall(19, 0) -> r4
	copyb(0, U256DIV_EXP) -> r5
	copyb(0, 0) -> r6
fu_c1_loop:
	copyb(0, [FREE_INPUT]) -> r7
	copyb(r5, 8[a + 0]) -> r12
	eq(r7, r12), j(fu_c1_n)
	copyb(0, 0x2a01) -> r10
	ret
fu_c1_n:
	add(r5, 8) -> r5
	add(r6, 1) -> r6
	eq(r6, 8), j(fu_c2)
	fcall_get(0, 0) -> r4
	jump(fu_c1_loop)

fu_c2:                              ; u256inv (id 20)
	fcall_param(4, U256INV_IN1) -> r4
	fcall(20, 0) -> r4
	copyb(0, U256INV_EXP) -> r5
	copyb(0, 0) -> r6
fu_c2_loop:
	copyb(0, [FREE_INPUT]) -> r7
	copyb(r5, 8[a + 0]) -> r12
	eq(r7, r12), j(fu_c2_n)
	copyb(0, 0x2a02) -> r10
	ret
fu_c2_n:
	add(r5, 8) -> r5
	add(r6, 1) -> r6
	eq(r6, 5), j(fu_c3)
	fcall_get(0, 0) -> r4
	jump(fu_c2_loop)

fu_c3:                              ; u256invmod (id 21)
	fcall_param(8, U256INVMOD_IN1) -> r4
	fcall(21, 0) -> r4
	copyb(0, U256INVMOD_EXP) -> r5
	copyb(0, 0) -> r6
fu_c3_loop:
	copyb(0, [FREE_INPUT]) -> r7
	copyb(r5, 8[a + 0]) -> r12
	eq(r7, r12), j(fu_c3_n)
	copyb(0, 0x2a03) -> r10
	ret
fu_c3_n:
	add(r5, 8) -> r5
	add(r6, 1) -> r6
	eq(r6, 13), j(fu_ok)
	fcall_get(0, 0) -> r4
	jump(fu_c3_loop)

fu_ok:
	copyb(0, 0) -> r10
	ret
