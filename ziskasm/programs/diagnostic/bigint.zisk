;
; bigint.zisk - diagnostic for the ZisK 256-bit arithmetic precompiles.
;   arith256      : b -> [&a,&b,&c,&dl,&dh]; a*b+c = dh:dl (512-bit)
;   arith256_mod  : b -> [&a,&b,&c,&module,&d]; (a*b+c) mod module
;   add256        : b -> [&a,&b,cin,&c]; a+b+cin -> c, carry-out in the c register
; Vectors: arith256/arith256_mod from arith_eq test data; add256 computed
; independently (256-bit add). First mismatch returns 0x26CC.
;

const u64 A256_A =
	0x0000000000000003, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000

const u64 A256_B =
	0x0000000000000002, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000

const u64 A256_C =
	0x0000000000000005, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000

u64 A256_DL =
	0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000

u64 A256_DH =
	0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000

u64 A256_HDR =
	0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
	0x0000000000000000

const u64 A256_EXPDL =
	0x000000000000000b, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000

const u64 A256_EXPDH =
	0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000

const u64 AMOD_A =
	0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000

const u64 AMOD_B =
	0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000

const u64 AMOD_C =
	0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000

const u64 AMOD_MOD =
	0x0000000000000001, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000

u64 AMOD_D =
	0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000

u64 AMOD_HDR =
	0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
	0x0000000000000000

const u64 AMOD_EXP =
	0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000

const u64 ADD_A =
	0xffffffffffffffff, 0xffffffffffffffff, 0xffffffffffffffff, 0xffffffffffffffff

const u64 ADD_B =
	0x0000000000000001, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000

u64 ADD_C =
	0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000

u64 ADD_HDR =
	0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000

const u64 ADD_EXP =
	0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000

bigint:
	; arith256 (a*b+c -> dl,dh)
	copyb(0, A256_HDR) -> r8
	copyb(0, A256_A) -> r7
	copyb(r8, r7) -> 8[a + 0]
	copyb(0, A256_B) -> r7
	copyb(r8, r7) -> 8[a + 8]
	copyb(0, A256_C) -> r7
	copyb(r8, r7) -> 8[a + 16]
	copyb(0, A256_DL) -> r7
	copyb(r8, r7) -> 8[a + 24]
	copyb(0, A256_DH) -> r7
	copyb(r8, r7) -> 8[a + 32]
	arith256(0, r8) -> r13
	copyb(0, A256_DL) -> r7
	copyb(0, A256_EXPDL) -> r5
	copyb(0, 4) -> r6
A256L_loop:
	eq(r6, 0), j(A256L_ok)
	copyb(r7, 8[a + 0]) -> r13
	copyb(r5, 8[a + 0]) -> r12
	eq(r13, r12), j(A256L_next)
	copyb(0, 0x2601) -> r10
	ret
A256L_next:
	add(r7, 8) -> r7
	add(r5, 8) -> r5
	sub(r6, 1) -> r6
	jump(A256L_loop)
A256L_ok:
	copyb(0, A256_DH) -> r7
	copyb(0, A256_EXPDH) -> r5
	copyb(0, 4) -> r6
A256H_loop:
	eq(r6, 0), j(A256H_ok)
	copyb(r7, 8[a + 0]) -> r13
	copyb(r5, 8[a + 0]) -> r12
	eq(r13, r12), j(A256H_next)
	copyb(0, 0x2602) -> r10
	ret
A256H_next:
	add(r7, 8) -> r7
	add(r5, 8) -> r5
	sub(r6, 1) -> r6
	jump(A256H_loop)
A256H_ok:
	; arith256_mod ((a*b+c) mod m -> d)
	copyb(0, AMOD_HDR) -> r8
	copyb(0, AMOD_A) -> r7
	copyb(r8, r7) -> 8[a + 0]
	copyb(0, AMOD_B) -> r7
	copyb(r8, r7) -> 8[a + 8]
	copyb(0, AMOD_C) -> r7
	copyb(r8, r7) -> 8[a + 16]
	copyb(0, AMOD_MOD) -> r7
	copyb(r8, r7) -> 8[a + 24]
	copyb(0, AMOD_D) -> r7
	copyb(r8, r7) -> 8[a + 32]
	arith256_mod(0, r8) -> r13
	copyb(0, AMOD_D) -> r7
	copyb(0, AMOD_EXP) -> r5
	copyb(0, 4) -> r6
AMOD_loop:
	eq(r6, 0), j(AMOD_ok)
	copyb(r7, 8[a + 0]) -> r13
	copyb(r5, 8[a + 0]) -> r12
	eq(r13, r12), j(AMOD_next)
	copyb(0, 0x2603) -> r10
	ret
AMOD_next:
	add(r7, 8) -> r7
	add(r5, 8) -> r5
	sub(r6, 1) -> r6
	jump(AMOD_loop)
AMOD_ok:
	; add256 (a+b+cin -> c, carry-out in c-reg)
	copyb(0, ADD_HDR) -> r8
	copyb(0, ADD_A) -> r7
	copyb(r8, r7) -> 8[a + 0]
	copyb(0, ADD_B) -> r7
	copyb(r8, r7) -> 8[a + 8]
	copyb(0, 0) -> r7
	copyb(r8, r7) -> 8[a + 16]        ; cin (direct value)
	copyb(0, ADD_C) -> r7
	copyb(r8, r7) -> 8[a + 24]
	add256(0, r8) -> r14                 ; r14 = carry-out
	copyb(0, ADD_C) -> r7
	copyb(0, ADD_EXP) -> r5
	copyb(0, 4) -> r6
ADD_loop:
	eq(r6, 0), j(ADD_ok)
	copyb(r7, 8[a + 0]) -> r13
	copyb(r5, 8[a + 0]) -> r12
	eq(r13, r12), j(ADD_next)
	copyb(0, 0x2604) -> r10
	ret
ADD_next:
	add(r7, 8) -> r7
	add(r5, 8) -> r5
	sub(r6, 1) -> r6
	jump(ADD_loop)
ADD_ok:
	eq(r14, 1), j(ADD_cok)
	copyb(0, 0x2604) -> r10
	ret
ADD_cok:
	copyb(0, 0) -> r10
	ret
