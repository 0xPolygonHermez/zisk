; ============================================================================
; keccak.zisk - diagnostic for the ZisK keccak precompile (Keccak-f[1600]).
;
; The `keccak` op reads a 1600-bit state (25 u64) from the memory address in its
; `b` operand, applies the Keccak-f permutation in place, and writes it back
; (c = 0). Unlike the ALU ops, its data lives in memory, not registers.
;
; This test:
;   1. places a known input state in KSTATE (RAM, so keccak can write it back),
;   2. runs `keccak(_, &KSTATE)` to permute it in place,
;   3. compares the 25 result words against KEXPECT (the reference output).
;
; The reference KEXPECT was produced by an independent Keccak-f[1600]
; implementation, self-checked against keccak256("") =
; c5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470.
; Input state is lane[i] = i (i = 0..24).
;
; Returns r10 = 0 on success, or 0x2001 on the first mismatching word.
;
; Registers: r5 expected ptr  r6 count  r7 result ptr  r8 state addr
;            r12 expected word  r13 result word / keccak c.
; ============================================================================

define WORDS 25

; Input state (RAM, permuted in place): lane[i] = i
u64 KSTATE[25] =
	0x0000000000000000, 0x0000000000000001, 0x0000000000000002, 0x0000000000000003, 0x0000000000000004,
	0x0000000000000005, 0x0000000000000006, 0x0000000000000007, 0x0000000000000008, 0x0000000000000009,
	0x000000000000000a, 0x000000000000000b, 0x000000000000000c, 0x000000000000000d, 0x000000000000000e,
	0x000000000000000f, 0x0000000000000010, 0x0000000000000011, 0x0000000000000012, 0x0000000000000013,
	0x0000000000000014, 0x0000000000000015, 0x0000000000000016, 0x0000000000000017, 0x0000000000000018

; Expected Keccak-f[1600] output for the above input
const u64 KEXPECT[25] =
	0x8374b05252ed8115, 0x1df7a676b6569400, 0xf765194b8a51797d, 0x20477b43d1760545, 0xd15f8ba4f3f6606a,
	0xa1d7144f7c8dd493, 0x30d193965138fd3f, 0x487e9472951be3be, 0x0cf3a858cbda7a5a, 0x2fe54e389bb17f88,
	0x0b7338de0d9f268f, 0x55efdff58b256d7f, 0xc8353e94eb2c3e6a, 0x2e2af6948c901f11, 0xe873de0cca309da6,
	0xf7afc26c944d31e2, 0xa0f5ea808cc415d7, 0x53f531437e3ed8cf, 0x777f1f3b43a4d221, 0xfd0ca63cb499e985,
	0xd4c055c0c5d12330, 0xa72fe58aa6e0a7df, 0x421af5937c9948a3, 0x5e16103071340888, 0xd153f43a297e4a33

keccak:
	copyb(0, KSTATE) -> r8            ; r8 = &KSTATE (the keccak state address)
	keccak(0, r8) -> r13              ; permute the 25-word state in place (c = 0)

	copyb(0, KSTATE) -> r7            ; result pointer
	copyb(0, KEXPECT) -> r5           ; expected pointer
	copyb(0, WORDS) -> r6             ; words remaining

kc_loop:
	eq(r6, 0), j(kc_ok)
	copyb(r7, 8[a + 0]) -> r13        ; result[i]
	copyb(r5, 8[a + 0]) -> r12        ; expected[i]
	eq(r13, r12), j(kc_next)
	copyb(0, 0x2001) -> r10
	ret
kc_next:
	add(r7, 8) -> r7
	add(r5, 8) -> r5
	sub(r6, 1) -> r6
	jump(kc_loop)

kc_ok:
	copyb(0, 0) -> r10
	ret
