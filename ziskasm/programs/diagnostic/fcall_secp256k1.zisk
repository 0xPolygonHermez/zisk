; ============================================================================
; fcall_secp256k1.zisk - diagnostic for the ZisK fcall (free-input call) family.
;
; Each sub-check appends a parameter block with a single bulk
; fcall_param(count, ARRAY) (the words>1 form copies `count` u64s from the
; array address), runs fcall(id), then reads the result words back through
; the free-input channel: fcall publishes result[0] and each fcall_get
; publishes the next word, all read as u64 loads from FREE_INPUT (0x40000000).
; Every result word is compared against a golden array generated by running
; fcall_proxy on the host (core/tests/fcall_vectors.rs).
;
; Checks (first mismatch returns 0x2bCC):
;   2b01  k1fpinv (id 1) - Fp inverse
;   2b02  k1fninv (id 2) - Fn (scalar) inverse
;   2b03  k1fpsqrt (id 3) - Fp square root (flag + root)
;   2b04  k1glv (id 4) - GLV scalar decomposition
; ============================================================================

define FREE_INPUT 0x40000000

const u64 K1FPINV_IN1[4] =
	0xf9ee4256a589409f, 0xa21a3985f17502d0, 0xb3eb393d00dc480c, 0x142def02c537eced
const u64 K1FPINV_EXP[4] =
	0xc198809f72408ac9, 0xa8726302e84e0c65, 0xde970a9a3b70d025, 0xf70d37bc0fece9b8

const u64 K1FNINV_IN1[4] =
	0xf9ee4256a589409f, 0xa21a3985f17502d0, 0xb3eb393d00dc480c, 0x142def02c537eced
const u64 K1FNINV_EXP[4] =
	0x32fe23e91aa741a1, 0x204b2da7afd93e75, 0x39b0bef6b00ec8b0, 0x7a0f1a7146326666

const u64 K1FPSQRT_IN1[5] =
	0x0000000000000001, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
	0x0000000000000001
const u64 K1FPSQRT_EXP[5] =
	0x0000000000000001, 0x0000000000000001, 0x0000000000000000, 0x0000000000000000,
	0x0000000000000000

const u64 K1GLV_IN1[4] =
	0x0000000000000005, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000
const u64 K1GLV_EXP[10] =
	0x0000000000000005, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
	0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
	0x0000000000000000, 0x0000000000000000

fcall_secp256k1:
	; k1fpinv (id 1)
	fcall_param(4, K1FPINV_IN1) -> r4
	fcall(1, 0) -> r4
	copyb(0, K1FPINV_EXP) -> r5
	copyb(0, 0) -> r6
sk_c1_loop:
	copyb(0, [FREE_INPUT]) -> r7
	copyb(r5, 8[a + 0]) -> r12
	eq(r7, r12), j(sk_c1_n)
	copyb(0, 0x2b01) -> r10
	ret
sk_c1_n:
	add(r5, 8) -> r5
	add(r6, 1) -> r6
	eq(r6, 4), j(sk_c2)
	fcall_get(0, 0) -> r4
	jump(sk_c1_loop)

sk_c2:                              ; k1fninv (id 2)
	fcall_param(4, K1FNINV_IN1) -> r4
	fcall(2, 0) -> r4
	copyb(0, K1FNINV_EXP) -> r5
	copyb(0, 0) -> r6
sk_c2_loop:
	copyb(0, [FREE_INPUT]) -> r7
	copyb(r5, 8[a + 0]) -> r12
	eq(r7, r12), j(sk_c2_n)
	copyb(0, 0x2b02) -> r10
	ret
sk_c2_n:
	add(r5, 8) -> r5
	add(r6, 1) -> r6
	eq(r6, 4), j(sk_c3)
	fcall_get(0, 0) -> r4
	jump(sk_c2_loop)

sk_c3:                              ; k1fpsqrt (id 3)
	fcall_param(5, K1FPSQRT_IN1) -> r4
	fcall(3, 0) -> r4
	copyb(0, K1FPSQRT_EXP) -> r5
	copyb(0, 0) -> r6
sk_c3_loop:
	copyb(0, [FREE_INPUT]) -> r7
	copyb(r5, 8[a + 0]) -> r12
	eq(r7, r12), j(sk_c3_n)
	copyb(0, 0x2b03) -> r10
	ret
sk_c3_n:
	add(r5, 8) -> r5
	add(r6, 1) -> r6
	eq(r6, 5), j(sk_c4)
	fcall_get(0, 0) -> r4
	jump(sk_c3_loop)

sk_c4:                              ; k1glv (id 4)
	fcall_param(4, K1GLV_IN1) -> r4
	fcall(4, 0) -> r4
	copyb(0, K1GLV_EXP) -> r5
	copyb(0, 0) -> r6
sk_c4_loop:
	copyb(0, [FREE_INPUT]) -> r7
	copyb(r5, 8[a + 0]) -> r12
	eq(r7, r12), j(sk_c4_n)
	copyb(0, 0x2b04) -> r10
	ret
sk_c4_n:
	add(r5, 8) -> r5
	add(r6, 1) -> r6
	eq(r6, 10), j(sk_ok)
	fcall_get(0, 0) -> r4
	jump(sk_c4_loop)

sk_ok:
	copyb(0, 0) -> r10
	ret
