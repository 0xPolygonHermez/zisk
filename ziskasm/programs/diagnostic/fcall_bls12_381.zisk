; ============================================================================
; fcall_bls12_381.zisk - diagnostic for the ZisK fcall (free-input call) family.
;
; Each sub-check appends a parameter block with a single bulk
; fcall_param(count, ARRAY) (the words>1 form copies `count` u64s from the
; array address), runs fcall(id), then reads the result words back through
; the free-input channel: fcall publishes result[0] and each fcall_get
; publishes the next word, all read as u64 loads from FREE_INPUT (0x40000000).
; Every result word is compared against a golden array generated by running
; fcall_proxy on the host (core/tests/fcall_vectors.rs).
;
; Checks (first mismatch returns 0x2eCC):
;   2e01  blsfpinv (id 10) - Fp inverse
;   2e02  blsfpsqrt (id 11) - Fp square root (flag + root)
;   2e03  blsfp2inv (id 12) - Fp2 inverse
;   2e04  blsfp2sqrt (id 13) - Fp2 square root (flag + root)
;   2e05  blstwadd (id 14) - twist line coefficients (add)
;   2e06  blstwdbl (id 15) - twist line coefficients (double)
; ============================================================================

define FREE_INPUT 0x40000000

const u64 BLSFPINV_IN1[6] =
	0x2d5f30c1d0577c56, 0x29aabf4bbbb4b60a, 0xf65faa3d6bda5044, 0xa56da205ae4bf114,
	0x6ad30a8453e66eac, 0x010a97e50d00668c
const u64 BLSFPINV_EXP[6] =
	0x1d8053f2aed3d017, 0x2912c6d8d7c59be0, 0xea3af967ab741430, 0xdc3cb17c3b332919,
	0x52a4afd74a0b5b20, 0x12be47b0938a6ee1

const u64 BLSFPSQRT_IN1[6] =
	0xf22cb1516a067d13, 0x3e46be206ab02de6, 0x93153c30d0917c98, 0x597d68ca77b5fa6d,
	0x44a50733df914e5e, 0x0f7377b1bb431d82
const u64 BLSFPSQRT_EXP[7] =
	0x0000000000000001, 0x516e9b68ec7e4040, 0x4b1f0de82104d372, 0x7e742e30000909d7,
	0x44051766a1553492, 0xe7043ea4bffc292f, 0x03efcb69d6bf0ce0

const u64 BLSFP2INV_IN1[12] =
	0x49b4b9e2ffd3bf5a, 0x6bc7632c9e4047a7, 0x805d19211a7dc450, 0x41c84ac8cfa40667,
	0xcbc8271a6d95e07f, 0x167ed52ad9b8dc52, 0x9919e620d143515b, 0x808a3f274c49a6c7,
	0xd65c110346cb2c1b, 0x8cd2c11ad5206061, 0x791b9ace70502ab1, 0x07f958516727acdd
const u64 BLSFP2INV_EXP[12] =
	0x55aa5b187f77e83e, 0xff523f3ab3ac46a6, 0xf686d520afbeb578, 0xb1664497d371019b,
	0xcfef6ce72c61e835, 0x1474b2da727c6dfe, 0x5730d5d619884057, 0xd42b3decc96db687,
	0x8abb9a0eed22a8a3, 0xd2f92c46b24958f7, 0x8ab323bd7384ca05, 0x1859d94eddac5b45

const u64 BLSFP2SQRT_IN1[12] =
	0x0000000000000001, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
	0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
	0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000
const u64 BLSFP2SQRT_EXP[13] =
	0x0000000000000001, 0xb9feffffffffaaaa, 0x1eabfffeb153ffff, 0x6730d2a0f6b0f624,
	0x64774b84f38512bf, 0x4b1ba7b6434bacd7, 0x1a0111ea397fe69a, 0x0000000000000000,
	0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
	0x0000000000000000

const u64 BLSTWADD_IN1[32] =
	0x0000000000000001, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
	0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
	0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
	0x0000000000000002, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
	0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
	0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
	0x0000000000000003, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
	0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000
const u64 BLSTWADD_IN2[16] =
	0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
	0x0000000000000004, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
	0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
	0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000
const u64 BLSTWADD_EXP[24] =
	0x0000000000000001, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
	0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
	0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
	0x0000000000000001, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
	0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
	0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000

const u64 BLSTWDBL_IN1[24] =
	0x0000000000000001, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
	0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
	0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
	0x0000000000000002, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
	0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
	0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000
const u64 BLSTWDBL_EXP[24] =
	0xcb7f3fffffffc001, 0x1700ffff04feffff, 0x8d649df8b904b89b, 0x8b5978a3b6a3ce0f,
	0xb854bdc8b278c1a1, 0x1380cd6fab1fecf3, 0x0000000000000000, 0x0000000000000000,
	0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
	0xee7fbfffffffeaac, 0x07aaffffac54ffff, 0xd9cc34a83dac3d89, 0xd91dd2e13ce144af,
	0x92c6e9ed90d2eb35, 0x0680447a8e5ff9a6, 0x0000000000000000, 0x0000000000000000,
	0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000

fcall_bls12_381:
	; blsfpinv (id 10)
	fcall_param(6, BLSFPINV_IN1) -> r4
	fcall(10, 0) -> r4
	copyb(0, BLSFPINV_EXP) -> r5
	copyb(0, 0) -> r6
bl_c1_loop:
	copyb(0, [FREE_INPUT]) -> r7
	copyb(r5, 8[a + 0]) -> r12
	eq(r7, r12), j(bl_c1_n)
	copyb(0, 0x2e01) -> r10
	ret
bl_c1_n:
	add(r5, 8) -> r5
	add(r6, 1) -> r6
	eq(r6, 6), j(bl_c2)
	fcall_get(0, 0) -> r4
	jump(bl_c1_loop)

bl_c2:                              ; blsfpsqrt (id 11)
	fcall_param(6, BLSFPSQRT_IN1) -> r4
	fcall(11, 0) -> r4
	copyb(0, BLSFPSQRT_EXP) -> r5
	copyb(0, 0) -> r6
bl_c2_loop:
	copyb(0, [FREE_INPUT]) -> r7
	copyb(r5, 8[a + 0]) -> r12
	eq(r7, r12), j(bl_c2_n)
	copyb(0, 0x2e02) -> r10
	ret
bl_c2_n:
	add(r5, 8) -> r5
	add(r6, 1) -> r6
	eq(r6, 7), j(bl_c3)
	fcall_get(0, 0) -> r4
	jump(bl_c2_loop)

bl_c3:                              ; blsfp2inv (id 12)
	fcall_param(12, BLSFP2INV_IN1) -> r4
	fcall(12, 0) -> r4
	copyb(0, BLSFP2INV_EXP) -> r5
	copyb(0, 0) -> r6
bl_c3_loop:
	copyb(0, [FREE_INPUT]) -> r7
	copyb(r5, 8[a + 0]) -> r12
	eq(r7, r12), j(bl_c3_n)
	copyb(0, 0x2e03) -> r10
	ret
bl_c3_n:
	add(r5, 8) -> r5
	add(r6, 1) -> r6
	eq(r6, 12), j(bl_c4)
	fcall_get(0, 0) -> r4
	jump(bl_c3_loop)

bl_c4:                              ; blsfp2sqrt (id 13)
	fcall_param(12, BLSFP2SQRT_IN1) -> r4
	fcall(13, 0) -> r4
	copyb(0, BLSFP2SQRT_EXP) -> r5
	copyb(0, 0) -> r6
bl_c4_loop:
	copyb(0, [FREE_INPUT]) -> r7
	copyb(r5, 8[a + 0]) -> r12
	eq(r7, r12), j(bl_c4_n)
	copyb(0, 0x2e04) -> r10
	ret
bl_c4_n:
	add(r5, 8) -> r5
	add(r6, 1) -> r6
	eq(r6, 13), j(bl_c5)
	fcall_get(0, 0) -> r4
	jump(bl_c4_loop)

bl_c5:                              ; blstwadd (id 14)
	fcall_param(32, BLSTWADD_IN1) -> r4
	fcall_param(16, BLSTWADD_IN2) -> r4
	fcall(14, 0) -> r4
	copyb(0, BLSTWADD_EXP) -> r5
	copyb(0, 0) -> r6
bl_c5_loop:
	copyb(0, [FREE_INPUT]) -> r7
	copyb(r5, 8[a + 0]) -> r12
	eq(r7, r12), j(bl_c5_n)
	copyb(0, 0x2e05) -> r10
	ret
bl_c5_n:
	add(r5, 8) -> r5
	add(r6, 1) -> r6
	eq(r6, 24), j(bl_c6)
	fcall_get(0, 0) -> r4
	jump(bl_c5_loop)

bl_c6:                              ; blstwdbl (id 15)
	fcall_param(24, BLSTWDBL_IN1) -> r4
	fcall(15, 0) -> r4
	copyb(0, BLSTWDBL_EXP) -> r5
	copyb(0, 0) -> r6
bl_c6_loop:
	copyb(0, [FREE_INPUT]) -> r7
	copyb(r5, 8[a + 0]) -> r12
	eq(r7, r12), j(bl_c6_n)
	copyb(0, 0x2e06) -> r10
	ret
bl_c6_n:
	add(r5, 8) -> r5
	add(r6, 1) -> r6
	eq(r6, 24), j(bl_ok)
	fcall_get(0, 0) -> r4
	jump(bl_c6_loop)

bl_ok:
	copyb(0, 0) -> r10
	ret
