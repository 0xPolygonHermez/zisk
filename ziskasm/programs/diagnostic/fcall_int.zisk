; ============================================================================
; fcall_int.zisk - diagnostic for the ZisK fcall (free-input call) family.
;
; Each sub-check appends a parameter block with a single bulk
; fcall_param(count, ARRAY) (the words>1 form copies `count` u64s from the
; array address), runs fcall(id), then reads the result words back through
; the free-input channel: fcall publishes result[0] and each fcall_get
; publishes the next word, all read as u64 loads from FREE_INPUT (0x40000000).
; Every result word is compared against a golden array generated by running
; fcall_proxy on the host (core/tests/fcall_vectors.rs).
;
; Checks (first mismatch returns 0x29CC):
;   2901  msb384 (id 18) - most-significant-bit position of two 384-bit values
;   2902  bindec (id 16) - MSB-first bit decomposition of an integer
;   2903  bigdiv (id 22) - arbitrary-length bigint division (quotient+remainder)
; ============================================================================

define FREE_INPUT 0x40000000

const u64 MSB384_IN1[14] =
	0x0000000000000001, 0x0000000000000002, 0x0000000000000003, 0x0000000000000000,
	0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
	0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000,
	0x0000000000000000, 0x0000000000000007
const u64 MSB384_EXP[2] =
	0x0000000000000005, 0x0000000000000002

const u64 BINDEC_IN1[2] =
	0x0000000000000001, 0x000000000000000a
const u64 BINDEC_EXP[5] =
	0x0000000000000004, 0x0000000000000001, 0x0000000000000000, 0x0000000000000001,
	0x0000000000000000

const u64 BIGDIV_IN1[10] =
	0x0000000000000004, 0x0000000000000064, 0x0000000000000000, 0x0000000000000000,
	0x0000000000000000, 0x0000000000000004, 0x0000000000000007, 0x0000000000000000,
	0x0000000000000000, 0x0000000000000000
const u64 BIGDIV_EXP[10] =
	0x0000000000000004, 0x000000000000000e, 0x0000000000000000, 0x0000000000000000,
	0x0000000000000000, 0x0000000000000004, 0x0000000000000002, 0x0000000000000000,
	0x0000000000000000, 0x0000000000000000

fcall_int:
	; msb384 (id 18)
	fcall_param(14, MSB384_IN1) -> r4
	fcall(18, 0) -> r4
	copyb(0, MSB384_EXP) -> r5
	copyb(0, 0) -> r6
fi_c1_loop:
	copyb(0, [FREE_INPUT]) -> r7
	copyb(r5, 8[a + 0]) -> r12
	eq(r7, r12), j(fi_c1_n)
	copyb(0, 0x2901) -> r10
	ret
fi_c1_n:
	add(r5, 8) -> r5
	add(r6, 1) -> r6
	eq(r6, 2), j(fi_c2)
	fcall_get(0, 0) -> r4
	jump(fi_c1_loop)

fi_c2:                              ; bindec (id 16)
	fcall_param(2, BINDEC_IN1) -> r4
	fcall(16, 0) -> r4
	copyb(0, BINDEC_EXP) -> r5
	copyb(0, 0) -> r6
fi_c2_loop:
	copyb(0, [FREE_INPUT]) -> r7
	copyb(r5, 8[a + 0]) -> r12
	eq(r7, r12), j(fi_c2_n)
	copyb(0, 0x2902) -> r10
	ret
fi_c2_n:
	add(r5, 8) -> r5
	add(r6, 1) -> r6
	eq(r6, 5), j(fi_c3)
	fcall_get(0, 0) -> r4
	jump(fi_c2_loop)

fi_c3:                              ; bigdiv (id 22)
	fcall_param(10, BIGDIV_IN1) -> r4
	fcall(22, 0) -> r4
	copyb(0, BIGDIV_EXP) -> r5
	copyb(0, 0) -> r6
fi_c3_loop:
	copyb(0, [FREE_INPUT]) -> r7
	copyb(r5, 8[a + 0]) -> r12
	eq(r7, r12), j(fi_c3_n)
	copyb(0, 0x2903) -> r10
	ret
fi_c3_n:
	add(r5, 8) -> r5
	add(r6, 1) -> r6
	eq(r6, 10), j(fi_ok)
	fcall_get(0, 0) -> r4
	jump(fi_c3_loop)

fi_ok:
	copyb(0, 0) -> r10
	ret
