{# `zisk_publics` (64) comes from the Rust context (templates::ZISK_PUBLICS is
   the single source of truth). Slot 0 = is_vadcop_final_proof (1=leaf,
   0=aggregator output); stripped in later layers. See docs/aggregator-flow.md §2. #}
pragma circom 2.1.0;
pragma custom_templates;

include "{{ verifier_filename }}";
include "mux1.circom";
{% if n_programs > 0 %}
include "iszero.circom";
{% endif %}
include "publics_helpers.circom";

// Shared named constant (circom has no const/global): AggregatePublics sizes
// its publics arrays as `[ZISK_PUBLICS()]`.
function ZISK_PUBLICS() {
    return {{ zisk_publics }};
}

{{ aggregate_publics_template }}

{% if n_programs > 0 %}
// 1 iff the two 4-limb VKs are equal (allow-list membership, §3a).
template IsEqualVK() {
    signal input a[4];
    signal input b[4];
    signal output {binary} out;

    signal {binary} eq[4];
    for (var i = 0; i < 4; i++) {
        eq[i] <== IsZero()(a[i] - b[i]);
    }
    signal {binary} eq01 <== eq[0] * eq[1];
    signal {binary} eq23 <== eq[2] * eq[3];
    out <== eq01 * eq23;
}

{% endif %}
{% if normalize %}
{{ normalize_body }}

{% endif %}
template Main(nPublics) {
    // Fold-layer publics: [0]=flag, VK at [VK_BASE..), user inputs at
    // [PUBLICS_BASE..) — see docs/aggregator-flow.md §2. The output re-emits the
    // same layout so it re-verifies one fold up.
    var PROGRAM_VK_LEN = 4;
    var VK_BASE = 1;
    var PUBLICS_BASE = VK_BASE + PROGRAM_VK_LEN;  // = 5
    var OUTPUT_LEN = PUBLICS_BASE + nPublics;

    // Full contiguous output buffer; slot 0 is the is_vadcop_final flag,
    // assigned below (not a separate output signal).
    signal output aggregatedPublics[OUTPUT_LEN];

    // Proofman fills the witness buffer (zkin) positionally, so declaration
    // order is a hard contract: stark_inputs_A, stark_inputs_B, freeInputsA,
    // freeInputsB, rootCRecurserAgg — declared BY SIDE (all A, then all B).
    // Reordering shears the witness silently. (Free-value semantics: §5.)
{{ define_stark_inputs_a }}

{{ define_stark_inputs_b }}

{% if n_free > 0 %}
    signal input freeInputsA[{{ n_free }}];
{% endif %}
{% if n_free > 0 %}
    signal input freeInputsB[{{ n_free }}];
{% endif %}

    signal input rootCRecurserAgg[4];

    var rootCVadcopFinalZisk[4] = [{% for v in root_c_vadcop_final_zisk %}{{ v }}{% if not loop.last %},{% endif %}{% endfor %}];

    // -- Extract each proof's programVK.
    signal programVK_A[4];
    signal programVK_B[4];
    for (var i = 0; i < 4; i++) {
        programVK_A[i] <== a_sv_publics[VK_BASE + i];
        programVK_B[i] <== b_sv_publics[VK_BASE + i];
    }

    // -- is_vadcop_final_proof selector (reserved slot 0).
    signal {binary} isFinalA <== a_sv_publics[{{ is_vadcop_final_slot }}];
    signal {binary} isFinalB <== b_sv_publics[{{ is_vadcop_final_slot }}];
    // Self-defending: enforce boolean, don't merely trust the {binary} tag.
    isFinalA * (1 - isFinalA) === 0;
    isFinalB * (1 - isFinalB) === 0;

{% if n_programs > 0 %}
    // -- Optional leaf allow-list (§3a): a leaf whose programVK is absent makes
    //    the circuit unsatisfiable. Aggregated proofs (isFinal=0) are unaffected.
    var programVKs[{{ n_programs }}][4] = [{% for vk in program_vks %}[{{ vk[0] }},{{ vk[1] }},{{ vk[2] }},{{ vk[3] }}]{% if not loop.last %},{% endif %}{% endfor %}];

    // Membership: isRegistered = 1 - ∏(1 - eq[k]). The product form (not Σ eq[k])
    // keeps circom 2.1's {binary} tag alive (addition strips it, multiplication
    // preserves it), and seeds noMatch[0] from (1 - eq[0]) not a literal 1.
    // Soundness assumes programVKs[] has no duplicates (enforced upstream).
    signal {binary} eqA[{{ n_programs }}];
    signal {binary} eqB[{{ n_programs }}];
    signal {binary} noMatchA[{{ n_programs }}];
    signal {binary} noMatchB[{{ n_programs }}];
    for (var k = 0; k < {{ n_programs }}; k++) {
        eqA[k] <== IsEqualVK()(programVK_A, programVKs[k]);
        eqB[k] <== IsEqualVK()(programVK_B, programVKs[k]);
    }
    noMatchA[0] <== 1 - eqA[0];
    noMatchB[0] <== 1 - eqB[0];
    for (var k = 1; k < {{ n_programs }}; k++) {
        noMatchA[k] <== noMatchA[k - 1] * (1 - eqA[k]);
        noMatchB[k] <== noMatchB[k - 1] * (1 - eqB[k]);
    }
    signal {binary} isRegisteredProgramA <== 1 - noMatchA[{{ n_programs }} - 1];
    signal {binary} isRegisteredProgramB <== 1 - noMatchB[{{ n_programs }} - 1];

    // Claimed leaf must be registered (else unsatisfiable).
    isFinalA * (1 - isRegisteredProgramA) === 0;
    isFinalB * (1 - isRegisteredProgramB) === 0;
{% endif %}

{{ assign_stark_inputs_a }}
{{ assign_stark_inputs_b }}

    // -- rootC: leaf (isFinal=1) -> rootCVadcopFinalZisk; aggregated (isFinal=0) -> programVK.
    vA.rootC <== MultiMux1(4)([programVK_A, rootCVadcopFinalZisk], isFinalA);
    vB.rootC <== MultiMux1(4)([programVK_B, rootCVadcopFinalZisk], isFinalB);

    // -- User publics live at [PUBLICS_BASE..).
    signal aPublics[nPublics];
    signal bPublics[nPublics];
    for (var i = 0; i < nPublics; i++) {
        aPublics[i] <== a_sv_publics[PUBLICS_BASE + i];
        bPublics[i] <== b_sv_publics[PUBLICS_BASE + i];
    }

{% if normalize %}
    // -- Optional NormalizePublics runs on every leaf; aggregated proofs pass raw.
    //    ziskPublicsX = isFinalX * normX + (1 - isFinalX) * rawX.
{% if n_free > 0 %}
    // NormalizePublics emits recurser_publics + free_outputs (§5).
    component normACmp = NormalizePublics(nPublics, {{ n_free }});
    normACmp.publics <== aPublics;
    normACmp.free_inputs <== freeInputsA;
    signal normA[nPublics] <== normACmp.recurser_publics;
    signal normFreeOutA[{{ n_free }}] <== normACmp.free_outputs;

    component normBCmp = NormalizePublics(nPublics, {{ n_free }});
    normBCmp.publics <== bPublics;
    normBCmp.free_inputs <== freeInputsB;
    signal normB[nPublics] <== normBCmp.recurser_publics;
    signal normFreeOutB[{{ n_free }}] <== normBCmp.free_outputs;
{% else %}
    signal normA[nPublics] <== NormalizePublics(nPublics)(aPublics);
    signal normB[nPublics] <== NormalizePublics(nPublics)(bPublics);
{% endif %}
    signal ziskPublicsA[nPublics];
    signal ziskPublicsB[nPublics];
    signal selNormA[nPublics];
    signal selNormB[nPublics];
    signal selRawA[nPublics];
    signal selRawB[nPublics];
    for (var i = 0; i < nPublics; i++) {
        selNormA[i] <== isFinalA * normA[i];
        selNormB[i] <== isFinalB * normB[i];
        selRawA[i] <== (1 - isFinalA) * aPublics[i];
        selRawB[i] <== (1 - isFinalB) * bPublics[i];
        ziskPublicsA[i] <== selNormA[i] + selRawA[i];
        ziskPublicsB[i] <== selNormB[i] + selRawB[i];
    }
{% if n_free > 0 %}
    // -- Free-value mux, parallel to the publics mux (§5).
    signal aggFreeA[{{ n_free }}];
    signal aggFreeB[{{ n_free }}];
    signal selFreeNormA[{{ n_free }}];
    signal selFreeNormB[{{ n_free }}];
    signal selFreeRawA[{{ n_free }}];
    signal selFreeRawB[{{ n_free }}];
    for (var i = 0; i < {{ n_free }}; i++) {
        selFreeNormA[i] <== isFinalA * normFreeOutA[i];
        selFreeNormB[i] <== isFinalB * normFreeOutB[i];
        selFreeRawA[i] <== (1 - isFinalA) * freeInputsA[i];
        selFreeRawB[i] <== (1 - isFinalB) * freeInputsB[i];
        aggFreeA[i] <== selFreeNormA[i] + selFreeRawA[i];
        aggFreeB[i] <== selFreeNormB[i] + selFreeRawB[i];
    }
{% endif %}
{% else %}
    // -- No normalize configured: every proof's publics pass through raw.
    signal ziskPublicsA[nPublics];
    signal ziskPublicsB[nPublics];
    for (var i = 0; i < nPublics; i++) {
        ziskPublicsA[i] <== aPublics[i];
        ziskPublicsB[i] <== bPublics[i];
    }
{% if n_free > 0 %}
    // -- No normalize: freeInputsX is the free value directly (no norm path, no mux).
    signal aggFreeA[{{ n_free }}] <== freeInputsA;
    signal aggFreeB[{{ n_free }}] <== freeInputsB;
{% endif %}
{% endif %}

    // -- Consistency + aggregation. AggregatePublics asserts the stitching
    //    constraints and produces the merged publics; it also receives both
    //    sides' free values (§6).
{% if n_free > 0 %}
    signal aggPublics[nPublics] <== AggregatePublics({{ n_free }})(
        ziskPublicsA, ziskPublicsB, aggFreeA, aggFreeB);
{% else %}
    signal aggPublics[nPublics] <== AggregatePublics()(ziskPublicsA, ziskPublicsB);
{% endif %}

    // Re-emit user publics at [PUBLICS_BASE..).
    for (var i = 0; i < nPublics; i++) {
        aggregatedPublics[PUBLICS_BASE + i] <== aggPublics[i];
    }

    // -- When both proofs are aggregated, their programVKs must match.
    signal bothAggregated <== (1 - isFinalA) * (1 - isFinalB);
    for (var i = 0; i < 4; i++) {
        bothAggregated * (programVK_A[i] - programVK_B[i]) === 0;
    }

    // -- Output programVK selection (selectors mutually exclusive, sum to 1):
    //      both leaves          -> rootCRecurserAgg
    //      A aggregated         -> programVK_A
    //      A leaf, B aggregated -> programVK_B
    signal selectAgg <== isFinalA * isFinalB;
    signal selectAVK <== 1 - isFinalA;
    signal selectBVK <== isFinalA * (1 - isFinalB);

    signal aggTerm[4];
    signal aTerm[4];
    signal bTerm[4];
    for (var i = 0; i < 4; i++) {
        aggTerm[i] <== selectAgg * rootCRecurserAgg[i];
        aTerm[i]   <== selectAVK * programVK_A[i];
        bTerm[i]   <== selectBVK * programVK_B[i];
        aggregatedPublics[VK_BASE + i] <== aggTerm[i] + aTerm[i] + bTerm[i];
    }

    // -- Slot 0 = 0: an aggregator output is never a raw vadcop_final leaf.
    //    Must be `<==` (assign), not `===`: the signal is otherwise undriven.
    aggregatedPublics[{{ is_vadcop_final_slot }}] <== 0;
}

component main = Main({{ zisk_publics }});
