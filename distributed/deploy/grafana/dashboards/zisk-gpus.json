    },
    "enable": true,
    "hide": true,
    "expr": "sum(((last_over_time(coordinator_worker_registrations_total{job=\"zisk-coordinator\",cluster=~\"$cluster\",reconnect=\"false\"}[1m]) - last_over_time(coordinator_worker_registrations_total{job=\"zisk-coordinator\",cluster=~\"$cluster\",reconnect=\"false\"}[1m] offset $__interval)) > 0))",
    "iconColor": "purple",
    "step": "2s",
    "titleFormat": "worker restarted",
    "useValueForTime": false
   },
   {
    "name": "Job cancelled",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "enable": true,
    "hide": true,
    "expr": "sum(((last_over_time(coordinator_jobs_total{job=\"zisk-coordinator\",cluster=~\"$cluster\",outcome=\"cancelled\"}[1m]) - last_over_time(coordinator_jobs_total{job=\"zisk-coordinator\",cluster=~\"$cluster\",outcome=\"cancelled\"}[1m] offset $__interval)) > 0))",
    "iconColor": "dark-blue",
    "step": "2s",
    "titleFormat": "job cancelled",
    "useValueForTime": false
   },
   {
    "name": "Job failed",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
