     "refId": "A",
     "expr": "(100 * nvidia_smi_utilization_gpu_ratio{host=~\"$host\"}) * on (uuid) group_left (index) nvidia_smi_gpu_info{host=~\"$host\"}",
     "legendFormat": "GPU {{index}}",
