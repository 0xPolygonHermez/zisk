      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 15,
      "lineWidth": 1,
      "showPoints": "auto",
      "spanNulls": false,
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     },
     "min": 0,
     "max": 100
    },
    "overrides": []
   },
   "options": {
