 "editable": true,
 "panels": [
  {
   "type": "row",
   "title": "Host $host",
   "id": 1,
   "collapsed": false,
   "repeat": "host",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "table",
   "title": "Each GPU now",
   "description": "nvidia-smi's last reading of each GPU (every 5 s). Power capped: the driver is holding the clocks down to stay within the power limit",
   "targets": [
    {
     "refId": "A",
     "expr": "(100 * nvidia_smi_utilization_gpu_ratio{host=~\"$host\"}) * on (uuid) group_left (index) nvidia_smi_gpu_info{host=~\"$host\"}",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "B",
     "expr": "(nvidia_smi_memory_used_bytes{host=~\"$host\"}) * on (uuid) group_left (index) nvidia_smi_gpu_info{host=~\"$host\"}",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "C",
     "expr": "(100 * nvidia_smi_memory_used_bytes{host=~\"$host\"} / nvidia_smi_memory_total_bytes{host=~\"$host\"}) * on (uuid) group_left (index) nvidia_smi_gpu_info{host=~\"$host\"}",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "D",
     "expr": "(nvidia_smi_power_draw_watts{host=~\"$host\"}) * on (uuid) group_left (index) nvidia_smi_gpu_info{host=~\"$host\"}",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "E",
     "expr": "(nvidia_smi_enforced_power_limit_watts{host=~\"$host\"}) * on (uuid) group_left (index) nvidia_smi_gpu_info{host=~\"$host\"}",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "F",
     "expr": "(nvidia_smi_clocks_throttle_reasons_sw_power_cap{host=~\"$host\"}) * on (uuid) group_left (index) nvidia_smi_gpu_info{host=~\"$host\"}",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "G",
     "expr": "(nvidia_smi_temperature_gpu{host=~\"$host\"}) * on (uuid) group_left (index) nvidia_smi_gpu_info{host=~\"$host\"}",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "H",
     "expr": "(nvidia_smi_clocks_current_sm_clock_hz{host=~\"$host\"}) * on (uuid) group_left (index) nvidia_smi_gpu_info{host=~\"$host\"}",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "I",
     "expr": "(nvidia_smi_pstate{host=~\"$host\"}) * on (uuid) group_left (index) nvidia_smi_gpu_info{host=~\"$host\"}",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
