     "options": {
      "conversions": [
       {
        "targetField": "index",
        "destinationType": "number"
       }
      ]
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "index",
        "desc": false
       }
      ]
     }
    },
    {
