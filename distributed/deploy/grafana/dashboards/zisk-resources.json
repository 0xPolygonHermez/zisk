  {
   "type": "stat",
   "title": "Worker peak memory",
   "description": "cgroup memory.peak since the worker's service started, as the worker reports",
   "targets": [
    {
     "refId": "A",
     "expr": "coordinator_worker_cgroup_memory_bytes{job=\"zisk-coordinator\",cluster=~\"$cluster\",kind=\"peak\"}",
     "legendFormat": "worker {{worker_id}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       },
       {
        "color": "green",
        "value": -1e+300
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value_and_name",
    "justifyMode": "auto"
