 "templating": {
  "list": [
   {
    "type": "query",
    "name": "cluster",
    "label": "Cluster",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(coordinator_info, cluster)",
     "refId": "cluster"
    },
    "definition": "label_values(coordinator_info, cluster)",
    "refresh": 2,
    "includeAll": true,
    "allValue": ".*",
    "multi": false,
    "current": {
     "text": "All",
     "value": "$__all"
    }
   },
   {
    "type": "query",
    "name": "coordinator_name",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "hide": 2,
    "query": {
     "query": "label_values(coordinator_info{job=\"zisk-coordinator\",cluster=~\"$cluster\"}, name)",
     "refId": "name"
    },
    "definition": "label_values(coordinator_info{job=\"zisk-coordinator\",cluster=~\"$cluster\"}, name)",
    "refresh": 2
   },
   {
    "type": "query",
    "name": "coordinator_environment",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "hide": 2,
    "query": {
     "query": "label_values(coordinator_info{job=\"zisk-coordinator\",cluster=~\"$cluster\"}, environment)",
     "refId": "environment"
    },
    "definition": "label_values(coordinator_info{job=\"zisk-coordinator\",cluster=~\"$cluster\"}, environment)",
    "refresh": 2
   },
   {
    "type": "query",
    "name": "coordinator_version",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "hide": 2,
    "query": {
     "query": "label_values(coordinator_info{job=\"zisk-coordinator\",cluster=~\"$cluster\"}, version)",
     "refId": "version"
    },
    "definition": "label_values(coordinator_info{job=\"zisk-coordinator\",cluster=~\"$cluster\"}, version)",
    "refresh": 2
   },
   {
    "type": "query",
    "name": "host",
    "label": "Host",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(up{job=\"node\",cluster=~\"$cluster\"}, host)",
     "refId": "host"
    },
    "definition": "label_values(up{job=\"node\",cluster=~\"$cluster\"}, host)",
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 },
