  {
   "type": "timeseries",
   "title": "Job outcomes (per 5 min)",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (outcome) (label_replace(label_replace(label_replace(sum by (outcome, reason) (increase(coordinator_jobs_total{job=\"zisk-coordinator\",cluster=~\"$cluster\"}[5m])), \"outcome\", \"succeeded\", \"outcome\", \"success\"), \"outcome\", \"failed\", \"outcome\", \"failure\"), \"outcome\", \"failed: $1\", \"reason\", \"(.+)\"))",
     "legendFormat": "{{outcome}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60,
      "lineWidth": 1,
      "showPoints": "auto",
      "spanNulls": false,
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^succeeded$|.*(success|finished|done).*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "green"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*cancel.*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "dark-blue"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*fail.*"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
