  {
   "type": "stat",
   "title": "Recoveries done",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "expr": "sum(coordinator_worker_recoveries_total{job=\"zisk-coordinator\",cluster=~\"$cluster\",result=\"done\"}) or vector(0)",
     "legendFormat": "done",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
