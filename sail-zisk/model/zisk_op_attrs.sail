  ZOP_ADD_U_W() => struct { op_type = OT_BINARY_E, input_size = 0, output_size = 0, m32 = true },
  ZOP_SH1ADD_U_W() => struct { op_type = OT_BINARY_E, input_size = 0, output_size = 0, m32 = true },
