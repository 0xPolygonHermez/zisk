  ZOP_CZERO_NEZ() => struct { op_type = OT_BINARY_E, input_size = 0, output_size = 0, m32 = false },
  ZOP_PUBOUT() => struct { op_type = OT_PUB_OUT, input_size = 0, output_size = 0, m32 = false },
  ZOP_MULU() => struct { op_type = OT_ARITH_AM32, input_size = 0, output_size = 0, m32 = false },
  ZOP_MULUH() => struct { op_type = OT_ARITH_AM32, input_size = 0, output_size = 0, m32 = false },
  ZOP_MULSUH() => struct { op_type = OT_ARITH_AM32, input_size = 0, output_size = 0, m32 = false },
  ZOP_MUL() => struct { op_type = OT_ARITH_AM32, input_size = 0, output_size = 0, m32 = false },
  ZOP_MULH() => struct { op_type = OT_ARITH_AM32, input_size = 0, output_size = 0, m32 = false },
  ZOP_MUL_W() => struct { op_type = OT_ARITH_AM32, input_size = 0, output_size = 0, m32 = true },
  ZOP_DIVU() => struct { op_type = OT_ARITH_AM32, input_size = 0, output_size = 0, m32 = false },
  ZOP_REMU() => struct { op_type = OT_ARITH_AM32, input_size = 0, output_size = 0, m32 = false },
  ZOP_DIV() => struct { op_type = OT_ARITH_AM32, input_size = 0, output_size = 0, m32 = false },
  ZOP_REM() => struct { op_type = OT_ARITH_AM32, input_size = 0, output_size = 0, m32 = false },
  ZOP_DIVU_W() => struct { op_type = OT_ARITH_A32, input_size = 0, output_size = 0, m32 = true },
