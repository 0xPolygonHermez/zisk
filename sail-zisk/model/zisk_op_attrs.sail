  ZOP_XOR() => struct { op_type = OT_BINARY, input_size = 0, output_size = 0, m32 = false },
  ZOP_MINU_W() => struct { op_type = OT_BINARY, input_size = 0, output_size = 0, m32 = true },
  ZOP_MIN_W() => struct { op_type = OT_BINARY, input_size = 0, output_size = 0, m32 = true },
  ZOP_MAXU_W() => struct { op_type = OT_BINARY, input_size = 0, output_size = 0, m32 = true },
  ZOP_MAX_W() => struct { op_type = OT_BINARY, input_size = 0, output_size = 0, m32 = true },
  ZOP_LTU_W() => struct { op_type = OT_BINARY, input_size = 0, output_size = 0, m32 = true },
