  ZOP_CLMUL() => struct { op_type = OT_BINARY_E, input_size = 0, output_size = 0, m32 = false },
  ZOP_CLMUL_H() => struct { op_type = OT_BINARY_E, input_size = 0, output_size = 0, m32 = false },
  ZOP_CLMUL_R() => struct { op_type = OT_BINARY_E, input_size = 0, output_size = 0, m32 = false },
