  ZOP_SIGNEXTEND_W() => struct { op_type = OT_BINARY_E, input_size = 0, output_size = 0, m32 = true },
  ZOP_REV8() => struct { op_type = OT_BINARY_E, input_size = 0, output_size = 0, m32 = false },
  ZOP_PACK() => struct { op_type = OT_BINARY_E, input_size = 0, output_size = 0, m32 = false },
  ZOP_PACK_H() => struct { op_type = OT_BINARY_E, input_size = 0, output_size = 0, m32 = false },
