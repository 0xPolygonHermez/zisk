/* Generated by gen_op_attrs.py (`make constants`) from the define_ops!
 * table of core/src/zisk_ops.rs. Do not edit; `make ops` checks it is current.
 *
 * What each operation is, besides what it computes: its type, which decides
 * the state machine that proves it; as a precompile, how many bytes of
 * memory it reads and writes (input_size, output_size); and m32, whether the
 * circuit hands it only the low 32 bits of a — set, as ZiskInstBuilder sets
 * it, for every operation whose name contains `_w`. The model's execution
 * needs only input_size: whether the op gets an extended argument.
 */

enum zisk_op_type = {
  OT_INTERNAL,
  OT_ARITH,
  OT_ARITH_A32,
  OT_ARITH_AM32,
  OT_BINARY,
  OT_BINARY_E,
  OT_KECCAK,
  OT_SHA256,
  OT_POSEIDON,
  OT_PUB_OUT,
  OT_ARITH_EQ,
  OT_FCALL,
  OT_ARITH_EQ384,
  OT_BIG_INT,
  OT_EVM,
  OT_DMA,
  OT_BLAKE2B,
  OT_PROFILE,
  OT_TWISTED_EDWARDS,
  OT_BLAKE3,
  OT_BLAKE2S,
  OT_POSEIDON2_KOALA_BEAR
}

struct zisk_op_attrs = {
  op_type     : zisk_op_type,
  input_size  : int,
  output_size : int,
  m32         : bool
}

val zisk_op_attrs : zisk_op -> zisk_op_attrs
function zisk_op_attrs(op) = match op {
  ZOP_FLAG() => struct { op_type = OT_INTERNAL, input_size = 0, output_size = 0, m32 = false },
  ZOP_COPYB() => struct { op_type = OT_INTERNAL, input_size = 0, output_size = 0, m32 = false },
  ZOP_MINU() => struct { op_type = OT_BINARY, input_size = 0, output_size = 0, m32 = false },
  ZOP_MIN() => struct { op_type = OT_BINARY, input_size = 0, output_size = 0, m32 = false },
  ZOP_MAXU() => struct { op_type = OT_BINARY, input_size = 0, output_size = 0, m32 = false },
  ZOP_MAX() => struct { op_type = OT_BINARY, input_size = 0, output_size = 0, m32 = false },
  ZOP_LTU() => struct { op_type = OT_BINARY, input_size = 0, output_size = 0, m32 = false },
  ZOP_LT() => struct { op_type = OT_BINARY, input_size = 0, output_size = 0, m32 = false },
  ZOP_EQ() => struct { op_type = OT_BINARY, input_size = 0, output_size = 0, m32 = false },
  ZOP_ADD() => struct { op_type = OT_BINARY, input_size = 0, output_size = 0, m32 = false },
  ZOP_SUB() => struct { op_type = OT_BINARY, input_size = 0, output_size = 0, m32 = false },
  ZOP_LEU() => struct { op_type = OT_BINARY, input_size = 0, output_size = 0, m32 = false },
