require "std_direct.pil"

require "operations.pil"
require "opids.pil"
require "config.pil"

require "evm/pil/jump_dest.pil"
require "evm/pil/jump_dest_compressor_table.pil"
require "evm/pil/jump_dest_bitmap_table.pil"
require "dma/pil/dual_range.pil"
require "mem/pil/mem.pil"
require "mem/pil/mem_align.pil"
require "mem/pil/mem_align_byte.pil"
require "mem/pil/rom_data.pil"
require "mem/pil/compact_mem.pil"
require "mem/pil/compact_mem_align.pil"
require "rom/pil/rom.pil"
require "main/pil/main.pil"
require "frequent-ops/pil/frequent_ops.pil"
require "binary/pil/binary.pil"
require "binary/pil/binary_extension.pil"
require "binary/pil/binary_add.pil"
require "binary/pil/binary_add_hi.pil"
require "arith/pil/arith.pil"
require "big_int/pil/big_int_add.pil"
require "arith_eq/pil/arith_eq.pil"
require "arith_eq_384/pil/arith_eq_384.pil"
require "babyjubjub/pil/babyjubjub.pil"
require "keccakf/pil/keccakf.pil"
require "sha256f/pil/sha256f.pil"
require "dma/pil/dma.pil"
require "dma/pil/dma_rom.pil"
require "dma/pil/dma_pre_post.pil"
require "dma/pil/dma_with_pre_post.pil"
require "dma/pil/dma_pre_post_table.pil"
require "dma/pil/dma_byte_cmp_table.pil"
require "dma/pil/dma_64_aligned.pil"
require "dma/pil/dma_unaligned.pil"
require "dma/pil/dma_loop.pil"
require "dma/pil/compact_dma.pil"
require "poseidon/pil/poseidon.pil"
require "blake2/pil/blake2br.pil"
require "blake3/pil/blake3f.pil"

enable_range_stats();

// Selectors for continuations.
//
// Every air that keeps a continuation chain needs ONE of these of its own: the flag gates the global
// seed of that air's chain, and Dma64Aligned gives each of its aliases its own auto-generated
// cont_subid, so two aliases sharing a flag would seed two chains while only one of them is
// instantiated — leaving the other seed with nothing to consume it.
proofval enable_input_data;
proofval enable_rom_data;
proofval enable_dma_64_aligned;
proofval enable_dma_64_aligned_large;
proofval enable_dma_64_aligned_inputcpy;
proofval enable_dma_64_aligned_mem;
proofval enable_dma_64_aligned_mem_large;
proofval enable_dma_64_aligned_memcpy;
proofval enable_dma_64_aligned_memset;
proofval enable_dma_unaligned;
proofval enable_dma_loop;
proofval enable_compact_dma;
proofval enable_jump_dest;

// Binary constraints to continuations enable proofvals
enable_input_data * (1 - enable_input_data) === 0;
enable_rom_data * (1 - enable_rom_data) === 0;
enable_dma_64_aligned * (1 - enable_dma_64_aligned) === 0;
enable_dma_64_aligned_large * (1 - enable_dma_64_aligned_large) === 0;
enable_dma_64_aligned_inputcpy * (1 - enable_dma_64_aligned_inputcpy) === 0;
enable_dma_64_aligned_mem * (1 - enable_dma_64_aligned_mem) === 0;
enable_dma_64_aligned_mem_large * (1 - enable_dma_64_aligned_mem_large) === 0;
enable_dma_64_aligned_memcpy * (1 - enable_dma_64_aligned_memcpy) === 0;
enable_dma_64_aligned_memset * (1 - enable_dma_64_aligned_memset) === 0;
enable_dma_unaligned * (1 - enable_dma_unaligned) === 0;
enable_dma_loop * (1 - enable_dma_loop) === 0;
enable_compact_dma * (1 - enable_compact_dma) === 0;
enable_jump_dest * (1 - enable_jump_dest) === 0;

const int PUBLIC_INPUTS_64_BITS = 32;  // 32 x 64 bits = 2048 bits
public inputs[PUBLIC_INPUTS_64_BITS * 2]; // 2 x 32-bits = 64 bits

function range_dual_byte(expr byte_a, expr byte_b, expr sel = 1, int sel_is_binary = 0) {
    lookup_assumes(DUAL_RANGE_BYTE_ID, expressions: [byte_a, byte_b], sel: sel, sel_is_binary: sel_is_binary);
}

airgroup Zisk {
    // Virtual Tables Configuration
    set_range_check_tables_virtual();
    set_max_bits_virtual_tables(21);
    set_num_virtual_tables(2);
    set_group_virtual_tables([ARITH_FROPS_TABLE_ID, BINARY_FROPS_TABLE_ID, BINARY_EXTENSION_FROPS_TABLE_ID]);

    // Main Program
    Main(N: 2**22, lanes_x_row: 4);
    Rom(N: 2**22);

    // Memory
    Mem(N: 2**22, base_address: 0xA000_0000, size_mb: 512, large_mem: 1, dual_mem: 1, lanes_x_row: 8);
    Mem(N: 2**22, base_address: 0x4000_0000, size_mb: 1024, large_mem: 1, free_input_mem: 1, enable_flag: enable_input_data, lanes_x_row: 4) alias InputData;
    RomData(N: 2**22, base_address: 0x8000_0000, size_mb: 128, enable_flag: enable_rom_data, lanes_x_row: 2);

    // The three memory areas above, fused into one air: every row carries a slice of the three
    // sequences at once. It proves segment 0 of each area, so an execution that needs one segment
    // of each -- which is every execution -- spends one instance instead of three.
    //
    // Each block is sized exactly like the air it takes the segment from (same rows, same lanes),
    // so the planners keep segmenting as they do today. It MUST come after Mem, InputData and
    // RomData: whichever air is declared first is the one that opens each continuation cycle, and
    // only the standalone airs know that area's enable_flag.
    CompactMem(N: 2**22,
               mem_base_address: 0xA000_0000, mem_size_mb: 512, mem_large_mem: 1, mem_dual_mem: 1,
               mem_lanes_x_row: 8,
               input_base_address: 0x4000_0000, input_size_mb: 1024, input_large_mem: 1,
               input_lanes_x_row: 4,
               rom_lanes_x_row: 2);

    MemAlign(N: 2**21);
    MemAlign(N: 2**23) alias MemAlignLarge;

    MemAlignByte(N: 2**22, read: 1, write: 1);
    MemAlignByte(N: 2**22, read: 1, write: 0) alias MemAlignReadByte;
    MemAlignByte(N: 2**22, read: 0, write: 1) alias MemAlignWriteByte;

    MemAlignByte(N: 2**23, read: 1, write: 1) alias MemAlignByteLarge;
    MemAlignByte(N: 2**23, read: 1, write: 0) alias MemAlignReadByteLarge;

    // `MemAlign` and `MemAlignByte` fused into one air: every row carries a slice of the two
    // sequences at once, so an execution that has both kinds of unaligned access -- which is every
    // execution that touches a byte and a half-word across a word boundary -- spends one instance
    // instead of two.
    //
    // The blocks are sized in the same 1:2 proportion the two airs are instantiated in above: the
    // `full_` block of the small air holds the rows of `MemAlign` (2**21) and its `bytes_` block
    // those of `MemAlignByte` (2**22 virtual rows, 2 lanes per row).
    CompactMemAlign(N: 2**21, full_lanes_x_row: 1, bytes_lanes_x_row: 2);
    CompactMemAlign(N: 2**22, full_lanes_x_row: 2, bytes_lanes_x_row: 4) alias CompactMemAlignLarge;

    virtual MemAlignRom();

    // Standard operations
    Arith(N: 2**21);
    virtual ArithTable();
    virtual ArithRangeTable();
    virtual FrequentOps(table_id: ARITH_FROPS_TABLE_ID,
                        bin_file: "state-machines/arith/src/arith_frops_fixed.bin") alias ArithFrops;

    Binary(N: 2**22);
    Binary(N: 2**22, lanes_x_row: 2) alias BinaryLarge;
    Binary(N: 2**22, lanes_x_row: 4) alias BinaryHuge;

    BinaryAdd(N: 2**22);
    BinaryAdd(N: 2**22, lanes_x_row: 2) alias BinaryAddLarge;
    BinaryAdd(N: 2**22, lanes_x_row: 4) alias BinaryAddHuge;

    BinaryAddHi(N: 2**22, lanes_x_row: 2);
    BinaryAddHi(N: 2**22, lanes_x_row: 4) alias BinaryAddHiLarge;
    BinaryAddHi(N: 2**22, lanes_x_row: 8) alias BinaryAddHiHuge;

    BinaryExtension(N: 2**22);
    BinaryExtension(N: 2**22, lanes_x_row: 2) alias BinaryExtensionLarge;

    virtual BinaryTable();
    virtual BinaryExtensionTable();

    virtual FrequentOps(table_id: BINARY_FROPS_TABLE_ID,
                        bin_file: "state-machines/binary/src/binary_basic_frops_fixed.bin") alias BinaryBasicFrops;
    virtual FrequentOps(table_id: BINARY_EXTENSION_FROPS_TABLE_ID,
                        bin_file: "state-machines/binary/src/binary_extension_frops_fixed.bin") alias BinaryExtensionFrops;

    // Precompiles
    BigIntAdd(N: 2**20, bits: 256, operation_code: OP_ADD256) alias Add256;

    ArithEq(N: 2**20);
    ArithEq(N: 2**22) alias ArithEqLarge;
    ArithEq(N: 2**23) alias ArithEqHuge;
    // ArithEq(N: 2**20, equations: EQ_ARITH256) alias Arith256;
    ArithEq(N: 2**20, equations: EQ_ARITH256 + EQ_ARITH256_MOD) alias Arith256X;
    ArithEq(N: 2**23, equations: EQ_ARITH256 + EQ_ARITH256_MOD) alias Arith256XLarge;
    // ArithEq(N: 2**22, equations: EQ_ARITH256 + EQ_ARITH256_MOD) alias Arith256XHuge;
    ArithEq(N: 2**20, equations: EQ_SECP256K1) alias ArithSecp256K1;
    ArithEq(N: 2**23, equations: EQ_SECP256K1) alias ArithSecp256K1Large;
    // ArithEq(N: 2**22, equations: EQ_SECP256K1) alias ArithSecp256K1Huge;
    ArithEq(N: 2**20, equations: EQ_BN254_EC + EQ_BN254_ADD + EQ_BN254_SUB + EQ_BN254_MUL) alias ArithBn254;
    ArithEq(N: 2**23, equations: EQ_BN254_EC + EQ_BN254_ADD + EQ_BN254_SUB + EQ_BN254_MUL) alias ArithBn254Large;
    // ArithEq(N: 2**22, equations: EQ_BN254_EC + EQ_BN254_ADD + EQ_BN254_SUB + EQ_BN254_MUL) alias ArithBn254Huge;
    ArithEq384(N: 2**20);
    ArithEq384(N: 2**22) alias ArithEq384Large;
    ArithEq384(N: 2**23) alias ArithEq384Huge;

    BabyJubJub(N: 2**18);
    virtual ArithEqLtTable(ARITH_EQ_LT_TABLE_SIZE);

    Keccakf(N: 2**20, lanes_per_row: 5);
    virtual KeccakfChiTable(KECCAKF_CHI_TABLE_SIZE);
    virtual KeccakfXor5Table(KECCAKF_XOR5_TABLE_SIZE);

    Sha256f(N: 2**18);

    Poseidon(N: 2**17);

    Blake2br(N: 2**18);
    virtual Blake2brTable(BLAKE2BR_TABLE_SIZE);

    Blake3f(N: 2**20, LANES:2);
    virtual Blake3fTable(BLAKE3F_TABLE_SIZE);

    Dma();
    // Dma(enable: E_DMA_MEMCPY) alias DmaMemCpy;
    // Dma(enable: E_DMA_INPUTCPY) alias DmaInputCpy;

    Dma64Aligned(N: 2**22, enable_flag: enable_dma_64_aligned);
    Dma64Aligned(N: 2**23, enable_flag: enable_dma_64_aligned_large, lanes_x_row: 4) alias Dma64AlignedLarge;

    // Dma64Aligned(enable: E_DMA_INPUTCPY, enable_flag: enable_dma_64_aligned_inputcpy) alias Dma64AlignedInputCpy;
    Dma64Aligned(N: 2**23, enable: E_DMA_MEMSET, enable_flag: enable_dma_64_aligned_memset, lanes_x_row: 4) alias Dma64AlignedMemSet;
    Dma64Aligned(N: 2**23, enable: E_DMA_MEMCPY|E_DMA_MEMCMP|E_DMA_MEMSET, enable_flag: enable_dma_64_aligned_mem, lanes_x_row: 4) alias Dma64AlignedMem;
    Dma64Aligned(N: 2**23, enable: E_DMA_MEMCPY|E_DMA_MEMCMP|E_DMA_MEMSET, enable_flag: enable_dma_64_aligned_mem_large, lanes_x_row: 4) alias Dma64AlignedMemLarge;
    Dma64Aligned(N: 2**23, enable: E_DMA_MEMCPY, enable_flag: enable_dma_64_aligned_memcpy, lanes_x_row: 4) alias Dma64AlignedMemCpy;

    DmaUnaligned(N: 2**20, enable_flag: enable_dma_unaligned, op_x_row: 4);

    DmaPrePost();
    // DmaPrePost(enable: E_DMA_MEMCPY) alias DmaPrePostMemCpy;
    // DmaPrePost(enable: E_DMA_INPUTCPY) alias DmaPrePostInputCpy;

    // Dma + DmaPrePost fused in a single air (no DMA_BUS_ID between them). Full only, not
    // parameterizable. It replaces Dma() + DmaPrePost() for the operations the strategy routes
    // to it; while DmaStrategy::USE_DMA_WITH_PRE_POST is true that is every non-direct operation,
    // and Dma() / DmaPrePost() are the ones left without an instance.
    DmaWithPrePost();

    // Dma64Aligned and DmaUnaligned fused in a single air: the loop phase of any operation, aligned
    // or not, one to four words per row. A generalist for the strategy, which picks it when a
    // workload has both kinds of loop and not enough of either to justify an instance of each. Its
    // op_x_row matches the four words per row the loop counters budget, so its rows are the ones
    // Dma64Aligned and DmaUnaligned are sized with.
    DmaLoop(N: 2**21, enable_flag: enable_dma_loop, op_x_row: 4);

    // DmaWithPrePost and DmaLoop fused side by side: one instance carries the controller with its
    // PRE/POST sub-operations and the loop, so an execution that uses the DMA lightly pays one
    // instance instead of two or three. Small on purpose: it is meant for that case, the standalone
    // airs take over when the work does not fit.
    CompactDma(N: 2**20, loop_enable_flag: enable_compact_dma, loop_op_x_row: 4);

    virtual DmaByteCmpTable();
    virtual DmaRom();
    virtual DmaPrePostTable();

    // EVM
    virtual JumpDestCompressorTable();
    virtual JumpDestBitmapTable();
    JumpDest(N: 2**21, enable_flag: enable_jump_dest);

    virtual DualRange(id: DUAL_RANGE_7_BITS_ID, min1: 0, max1: P2_7-1, min2: 0, max2: P2_7-1) alias DualRange7Bits;
    virtual DualRange(id: DUAL_RANGE_BYTE_ID, min1: 0, max1: P2_8-1, min2: 0, max2: P2_8-1) alias DualByte;

    // Public Inputs
    for (int i = 0; i < PUBLIC_INPUTS_64_BITS; i++) {
        direct_global_update_proves(OPERATION_BUS_ID, [OP_PUBOUT, i, 0, inputs[i*2], inputs[i*2 + 1], inputs[i*2], inputs[i*2 + 1]], surname: PIOP_SURNAME_DYNAMIC);
    }
}
