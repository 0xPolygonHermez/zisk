const int MAIN_STEP_BITS = 36;
const int MAX_STEPS = 1 << MAIN_STEP_BITS;
const int MEM_STEP_BITS = MAIN_STEP_BITS + 2;
const int REG_STEP_BITS = MAIN_STEP_BITS + 2;
// Addresses are 33 bits wide and travel on the memory bus as a single field element.
const int ADDR_BITS = 33;
const int ADDR_W_BITS = ADDR_BITS - 3;
const int EXTRA_PARAMS_ADDR = 0xC0400F00;
