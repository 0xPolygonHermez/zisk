/*
    Reserved Operation Codes:
    ==========================
      - Binary Operations:
        - 0x02-0x10 (64-bit), 0x12-0x20 (their m32 variants)
        - 0x50, 0x51 (LT_ABS_NP, LT_ABS_PN: internal, assumed by Arith)
        - 0x52-0x55 (Zbb/Zbkb bitwise)
        - 0x56-0x58 (Zba shift-and-add)
        - 0x59-0x5F (free, reserved for binary)
        - 0x60-0x6F (m32 shadows of 0x50-0x5F, must stay empty)
      - Binary Extension Operations:
        - 0x21-0x29
        - 0x30-0x42 (Zbb/Zbs/Zbkb)
        - 0x43 (Zba slli.uw)
      - "Software" Operations (not proven by any air):
        - 0x90-0x9F
      - Arithmetic Operations:
        - 0xB0-0xBF
      - DMA Operations:
        - 0xDA-0xDF
      - Precompiles:
        - 0xE1-0xEE
        - 0xF0-0xF5
        - 0xF9-0xFE
      - Misc:
        - 0x00 (FLAG)
        - 0x01 (COPYB)
        - 0xA0 (PUBOUT)
        - 0xF6-0xF8 (Function Calls)
        - 0xFF (HALT)
    ==========================

    Binary proves an opcode and its m32 variant at opcode+0x10 with the same air: mode32 is a free
    witness, so from b_op it can always also prove b_op + 0x10. Every opcode assigned to Binary
    therefore reserves opcode+0x10 as well, even when it has no m32 variant -- handing that slot to
    a different operation would let Binary satisfy it with the wrong semantics.
*/

const int OP_FLAG = 0x00;
const int OP_COPYB = 0x01;

// Binary, 64-bit operations
const int OP_MINU = 0x02;
const int OP_MIN = 0x03;
const int OP_MAXU = 0x04;
const int OP_MAX = 0x05;
const int OP_LTU = 0x06;
const int OP_LT = 0x07;
const int OP_GT = 0x08;
const int OP_EQ = 0x09;
const int OP_ADD = 0x0A;
const int OP_SUB = 0x0B;
const int OP_LEU = 0x0C;
const int OP_LE = 0x0D;
const int OP_AND = 0x0E;
const int OP_OR = 0x0F;
const int OP_XOR = 0x10;

// Binary, 32-bit operations: opcode = 64-bit opcode + 0x10
const int OP_MINU_W = 0x12;
const int OP_MIN_W = 0x13;
const int OP_MAXU_W = 0x14;
const int OP_MAX_W = 0x15;
const int OP_LTU_W = 0x16;
const int OP_LT_W = 0x17;
const int OP_GT_W = 0x18;
const int OP_EQ_W = 0x19;
const int OP_ADD_W = 0x1A;
const int OP_SUB_W = 0x1B;
const int OP_LEU_W = 0x1C;
const int OP_LE_W = 0x1D;

// Binary Extension
const int OP_SLL = 0x21;
const int OP_SRL = 0x22;
const int OP_SRA = 0x23;
const int OP_SLL_W = 0x24;
const int OP_SRL_W = 0x25;
const int OP_SRA_W = 0x26;
const int OP_SIGNEXTEND_B = 0x27;
const int OP_SIGNEXTEND_H = 0x28;
const int OP_SIGNEXTEND_W = 0x29;

// Zbb/Zbs/Zbkb bit manipulation operations, proven by Binary Extension
const int OP_REV8 = 0x30;
const int OP_PACK = 0x31;
const int OP_PACK_H = 0x32;
const int OP_PACK_W = 0x33;
const int OP_ROL = 0x34;
const int OP_ROL_W = 0x35;
const int OP_ROR = 0x36;
const int OP_ROR_W = 0x37;
const int OP_CLZ = 0x38;
const int OP_CLZ_W = 0x39;
const int OP_CTZ = 0x3a;
const int OP_CTZ_W = 0x3b;
const int OP_CPOP = 0x3c;
const int OP_CPOP_W = 0x3d;
const int OP_ORC_B = 0x3e;
const int OP_BCLR = 0x3f;
const int OP_BEXT = 0x40;
const int OP_BINV = 0x41;
const int OP_BSET = 0x42;

// Zba slli.uw, proven by Binary Extension: c = zext32(a) << (b & 0x3F). Its instruction sets the
// m32 flag, so the high half of a never reaches the bus (that is the zero extension)
const int OP_SLL_U_W = 0x43;

// Absolute value comparisons, assumed by Arith and proven by Binary. They are not ZisK opcodes,
// but they live in the Binary space and reserve their m32 shadows (0x60, 0x61) just the same
const int OP_LT_ABS_NP = 0x50;
const int OP_LT_ABS_PN = 0x51;

// Zbb/Zbkb bitwise and Zba shift-and-add (c = b + (a << shift)) operations, proven by Binary.
// None of them has an m32 variant, so their shadows (0x62-0x68) must stay empty
const int OP_BREV8 = 0x52;
const int OP_ANDN = 0x53;
const int OP_ORN = 0x54;
const int OP_XNOR = 0x55;
const int OP_SH1ADD = 0x56;
const int OP_SH2ADD = 0x57;
const int OP_SH3ADD = 0x58;

const int OP_PUBOUT = 0xA0;

const int OP_MULU = 0xB0;
const int OP_MULUH = 0xB1;
// const int OP_MULSH = 0xB2;
const int OP_MULSUH = 0xB3;
const int OP_MUL = 0xB4;
const int OP_MULH = 0xB5;
const int OP_MUL_W = 0xB6;
// const int OP_MULH_W = 0xB7;
const int OP_DIVU = 0xB8;
const int OP_REMU = 0xB9;
const int OP_DIV = 0xBA;
const int OP_REM = 0xBB;
const int OP_DIVU_W = 0xBC;
const int OP_REMU_W = 0xBD;
const int OP_DIV_W = 0xBE;
const int OP_REM_W = 0xBF;

const int OP_JUMP_DEST = 0xC0;

const int OP_DMA_MEMCPY = 0xD0;
const int OP_DMA_MEMCMP = 0xD1;
const int OP_DMA_INPUTCPY = 0xD2;
const int __OP_DMA_MEMSET__ = 0xD3;   // not implemented, unsual and too expensive
const int __OP_DMA_MEMEQ__ = 0xD4;    // main don't known in compilation time

const int OP_DMA_X_OFFSET = 6;

const int OP_DMA_XMEMCPY = OP_DMA_MEMCPY + OP_DMA_X_OFFSET;     // 0xD6
const int OP_DMA_XMEMCMP = OP_DMA_MEMCMP + OP_DMA_X_OFFSET;     // 0xD7
const int OP_DMA_XMEMSET = __OP_DMA_MEMSET__ + OP_DMA_X_OFFSET; // 0xD9
const int OP_DMA_XMEMEQ = __OP_DMA_MEMEQ__ + OP_DMA_X_OFFSET;   // 0xDA

const int OP_ARITH384_MOD = 0xE2;
const int OP_BLS12_381_CURVE_ADD = 0xE3;
const int OP_BLS12_381_CURVE_DBL = 0xE4;
const int OP_BLS12_381_COMPLEX_ADD = 0xE5;
const int OP_BLS12_381_COMPLEX_SUB = 0xE6;
const int OP_BLS12_381_COMPLEX_MUL = 0xE7;

const int OP_SECP256R1_ADD = 0xE8;
const int OP_SECP256R1_DBL = 0xE9;

const int OP_BLAKE2 = 0xEA;

const int OP_POSEIDON2 = 0xEB;
const int OP_POSEIDON1 = 0xEC;

const int OP_BABYJUBJUB_ADD = 0xED;

const int OP_BLAKE3 = 0xEE;

const int OP_ADD256 = 0xF0;
const int OP_KECCAK = 0xF1;
const int OP_ARITH256 = 0xF2;
const int OP_ARITH256_MOD = 0xF3;
const int OP_SECP256K1_ADD = 0xF4;
const int OP_SECP256K1_DBL = 0xF5;

const int OP_FCALL_PARAM = 0xF6;
const int OP_FCALL = 0xF7;
const int OP_FCALL_GET = 0xF8;

const int OP_SHA256 = 0xF9;

const int OP_BN254_CURVE_ADD = 0xFA;
const int OP_BN254_CURVE_DBL = 0xFB;
const int OP_BN254_COMPLEX_ADD = 0xFC;
const int OP_BN254_COMPLEX_SUB = 0xFD;
const int OP_BN254_COMPLEX_MUL = 0xFE;

const int OP_HALT = 0xFF;

function assumes_operation (const expr op, const expr a[] = [0,0], const expr b[] = [0,0], const expr c[] = [0,0], 
                            const expr flag = 0, const expr main_step = 0,
                            const expr extended_arg = 0,
                            const expr sel = 1,
                            const int sel_is_binary = 0,
                            const expr extra_args[] = [0])
{
    assert(length(extra_args) == 1);
    lookup_assumes(OPERATION_BUS_ID, [op, ...a, ...b, ...c, flag, main_step, extended_arg, ...extra_args], 
                   sel:, sel_is_binary:);
}                              

function proves_operation (const expr op, const expr a[] = [0, 0], const expr b[] = [0, 0], const expr c[] = [0, 0], 
                           const expr flag = 0, const expr main_step = 0,
                           const expr extended_arg = 0,
                           const expr mul = 1,
                           const expr extra_args[] = [0],
                           const int table_id = -1)
{
    assert(length(extra_args) == 1);
    lookup_proves(OPERATION_BUS_ID, [op, ...a, ...b, ...c, flag, main_step, extended_arg, ...extra_args], table_id:, mul:);
}                              


function assumes_padding_operation (const expr op, const expr a[] = [0,0], const expr b[] = [0,0], const expr c[] = [0,0], 
                               const expr flag = 0, const expr main_step = 0,
                               const expr extended_arg = 0,
                               const expr extra_args[] = [0],
                               const expr padding_size = 1)
{
    assert(length(extra_args) == 1);
    direct_update_assumes(OPERATION_BUS_ID, [op, ...a, ...b, ...c, flag, main_step, extended_arg, ...extra_args], sel:padding_size);
}                              
