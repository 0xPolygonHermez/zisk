/-- `Add256`'s arguments on the operation bus. -/
def Add256Inst.provers {xv : VirtualTableZisk1.Ctx F} {tv : VirtualTableZisk1.Trace F} (I : Add256Inst xv tv) :
    List (Prover F) :=
  [⟨Add256.bus59, I.x, I.t⟩]

theorem Add256Inst.ok {xv : VirtualTableZisk1.Ctx F} {tv : VirtualTableZisk1.Trace F} (hT : Tables xv tv)
    (I : Add256Inst xv tv) : OpsProved I.provers :=
  opsProved_cons
    { add := opProves_of_not (fun j _ => Add256_bus59_not_add (I.rows j))
      ltu := opProves_of_not (fun j _ => Add256_bus59_not_cmp (I.rows j) 6 (by simp))
      eq := opProves_of_not (fun j _ => Add256_bus59_not_cmp (I.rows j) 9 (by simp))
      and := opProves_of_not (fun j _ => Add256_bus59_not_cmp (I.rows j) 14 (by simp)) }
    (opsProved_nil)

theorem Add256Inst.pub {xv : VirtualTableZisk1.Ctx F} {tv : VirtualTableZisk1.Trace F} (hT : Tables xv tv)
    (I : Add256Inst xv tv) : PubProved I.provers :=
  pubProved_cons
    (opProves_of_not (fun j _ => Add256_bus59_not_pub (I.rows j) 160 (by simp)))
    (pubProved_nil)

