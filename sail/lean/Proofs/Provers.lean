/-! ### The system -/

/-- Every instance of every AIR that proves on the operation bus, and the two
virtual tables. -/
structure System (F : Type) [Lean.Grind.Field F] where
  xv : VirtualTableZisk1.Ctx F
  tv : VirtualTableZisk1.Trace F
  x0 : VirtualTableZisk0.Ctx F
  t0 : VirtualTableZisk0.Trace F
  add256 : List (Add256Inst xv tv)
  arith : List (ArithInst xv tv)
  arith256X : List (Arith256XInst xv tv)
  arith256XLarge : List (Arith256XLargeInst xv tv)
  arithBn254 : List (ArithBn254Inst xv tv)
  arithBn254Large : List (ArithBn254LargeInst xv tv)
  arithEq : List (ArithEqInst xv tv)
  arithEq384 : List (ArithEq384Inst xv tv)
  arithEq384Large : List (ArithEq384LargeInst xv tv)
  arithEqLarge : List (ArithEqLargeInst xv tv)
  arithSecp256K1 : List (ArithSecp256K1Inst xv tv)
  arithSecp256K1Large : List (ArithSecp256K1LargeInst xv tv)
  binary : List (BinaryInst xv tv)
  binaryAdd : List (BinaryAddInst xv tv)
  binaryAddHi : List (BinaryAddHiInst xv tv)
  binaryAddHiHuge : List (BinaryAddHiHugeInst xv tv)
  binaryAddHiLarge : List (BinaryAddHiLargeInst xv tv)
  binaryAddHuge : List (BinaryAddHugeInst xv tv)
  binaryAddLarge : List (BinaryAddLargeInst xv tv)
  binaryExtension : List (BinaryExtensionInst xv tv)
  binaryExtensionLarge : List (BinaryExtensionLargeInst xv tv)
  binaryHuge : List (BinaryHugeInst xv tv)
  binaryLarge : List (BinaryLargeInst xv tv)
  blake2br : List (Blake2brInst xv tv)
  blake2s : List (Blake2sInst xv tv)
  blake3f : List (Blake3fInst xv tv)
  dma : List (DmaInst xv tv)
  dma64Aligned : List (Dma64AlignedInst xv tv)
  dma64AlignedLarge : List (Dma64AlignedLargeInst xv tv)
  dma64AlignedMem : List (Dma64AlignedMemInst xv tv)
  dma64AlignedMemCpy : List (Dma64AlignedMemCpyInst xv tv)
  dma64AlignedMemLarge : List (Dma64AlignedMemLargeInst xv tv)
  dma64AlignedMemSet : List (Dma64AlignedMemSetInst xv tv)
  dmaUnaligned : List (DmaUnalignedInst xv tv)
  jumpDest : List (JumpDestInst xv tv)
  keccakf : List (KeccakfInst xv tv)
  poseidon : List (PoseidonInst xv tv)
  sha256f : List (Sha256fInst xv tv)
  twistedEdwards : List (TwistedEdwardsInst xv tv)

/-- The operation bus's provers: every argument of every instance. -/
def System.provers (S : System F) : List (Prover F) :=
  frops S.x0 S.t0 ++ (
    (S.add256.flatMap Add256Inst.provers) ++ (
    (S.arith.flatMap ArithInst.provers) ++ (
    (S.arith256X.flatMap Arith256XInst.provers) ++ (
    (S.arith256XLarge.flatMap Arith256XLargeInst.provers) ++ (
    (S.arithBn254.flatMap ArithBn254Inst.provers) ++ (
    (S.arithBn254Large.flatMap ArithBn254LargeInst.provers) ++ (
    (S.arithEq.flatMap ArithEqInst.provers) ++ (
    (S.arithEq384.flatMap ArithEq384Inst.provers) ++ (
    (S.arithEq384Large.flatMap ArithEq384LargeInst.provers) ++ (
    (S.arithEqLarge.flatMap ArithEqLargeInst.provers) ++ (
    (S.arithSecp256K1.flatMap ArithSecp256K1Inst.provers) ++ (
    (S.arithSecp256K1Large.flatMap ArithSecp256K1LargeInst.provers) ++ (
    (S.binary.flatMap BinaryInst.provers) ++ (
    (S.binaryAdd.flatMap BinaryAddInst.provers) ++ (
    (S.binaryAddHi.flatMap BinaryAddHiInst.provers) ++ (
    (S.binaryAddHiHuge.flatMap BinaryAddHiHugeInst.provers) ++ (
    (S.binaryAddHiLarge.flatMap BinaryAddHiLargeInst.provers) ++ (
    (S.binaryAddHuge.flatMap BinaryAddHugeInst.provers) ++ (
    (S.binaryAddLarge.flatMap BinaryAddLargeInst.provers) ++ (
    (S.binaryExtension.flatMap BinaryExtensionInst.provers) ++ (
    (S.binaryExtensionLarge.flatMap BinaryExtensionLargeInst.provers) ++ (
    (S.binaryHuge.flatMap BinaryHugeInst.provers) ++ (
    (S.binaryLarge.flatMap BinaryLargeInst.provers) ++ (
    (S.blake2br.flatMap Blake2brInst.provers) ++ (
    (S.blake2s.flatMap Blake2sInst.provers) ++ (
    (S.blake3f.flatMap Blake3fInst.provers) ++ (
    (S.dma.flatMap DmaInst.provers) ++ (
    (S.dma64Aligned.flatMap Dma64AlignedInst.provers) ++ (
    (S.dma64AlignedLarge.flatMap Dma64AlignedLargeInst.provers) ++ (
    (S.dma64AlignedMem.flatMap Dma64AlignedMemInst.provers) ++ (
    (S.dma64AlignedMemCpy.flatMap Dma64AlignedMemCpyInst.provers) ++ (
    (S.dma64AlignedMemLarge.flatMap Dma64AlignedMemLargeInst.provers) ++ (
    (S.dma64AlignedMemSet.flatMap Dma64AlignedMemSetInst.provers) ++ (
    (S.dmaUnaligned.flatMap DmaUnalignedInst.provers) ++ (
    (S.jumpDest.flatMap JumpDestInst.provers) ++ (
    (S.keccakf.flatMap KeccakfInst.provers) ++ (
    (S.poseidon.flatMap PoseidonInst.provers) ++ (
    (S.sha256f.flatMap Sha256fInst.provers) ++ (
    (S.twistedEdwards.flatMap TwistedEdwardsInst.provers))))))))))))))))))))))))))))))))))))))))

/-- **Every prover on the operation bus computes the four ops**, given the
tables' contents. -/
theorem System.ok (S : System F) (hT : Tables S.xv S.tv) (hF : ∀ p ∈ frops S.x0 S.t0, FropsOk p) :
    OpsProved S.provers :=
  opsProved_append (frops_ok hF) <|
    opsProved_append (opsProved_flatMap (fun I _ => Add256Inst.ok hT I)) <|
    opsProved_append (opsProved_flatMap (fun I _ => ArithInst.ok hT I)) <|
    opsProved_append (opsProved_flatMap (fun I _ => Arith256XInst.ok hT I)) <|
    opsProved_append (opsProved_flatMap (fun I _ => Arith256XLargeInst.ok hT I)) <|
    opsProved_append (opsProved_flatMap (fun I _ => ArithBn254Inst.ok hT I)) <|
    opsProved_append (opsProved_flatMap (fun I _ => ArithBn254LargeInst.ok hT I)) <|
    opsProved_append (opsProved_flatMap (fun I _ => ArithEqInst.ok hT I)) <|
    opsProved_append (opsProved_flatMap (fun I _ => ArithEq384Inst.ok hT I)) <|
    opsProved_append (opsProved_flatMap (fun I _ => ArithEq384LargeInst.ok hT I)) <|
    opsProved_append (opsProved_flatMap (fun I _ => ArithEqLargeInst.ok hT I)) <|
    opsProved_append (opsProved_flatMap (fun I _ => ArithSecp256K1Inst.ok hT I)) <|
    opsProved_append (opsProved_flatMap (fun I _ => ArithSecp256K1LargeInst.ok hT I)) <|
    opsProved_append (opsProved_flatMap (fun I _ => BinaryInst.ok hT I)) <|
    opsProved_append (opsProved_flatMap (fun I _ => BinaryAddInst.ok hT I)) <|
    opsProved_append (opsProved_flatMap (fun I _ => BinaryAddHiInst.ok hT I)) <|
    opsProved_append (opsProved_flatMap (fun I _ => BinaryAddHiHugeInst.ok hT I)) <|
    opsProved_append (opsProved_flatMap (fun I _ => BinaryAddHiLargeInst.ok hT I)) <|
    opsProved_append (opsProved_flatMap (fun I _ => BinaryAddHugeInst.ok hT I)) <|
    opsProved_append (opsProved_flatMap (fun I _ => BinaryAddLargeInst.ok hT I)) <|
    opsProved_append (opsProved_flatMap (fun I _ => BinaryExtensionInst.ok hT I)) <|
    opsProved_append (opsProved_flatMap (fun I _ => BinaryExtensionLargeInst.ok hT I)) <|
    opsProved_append (opsProved_flatMap (fun I _ => BinaryHugeInst.ok hT I)) <|
    opsProved_append (opsProved_flatMap (fun I _ => BinaryLargeInst.ok hT I)) <|
    opsProved_append (opsProved_flatMap (fun I _ => Blake2brInst.ok hT I)) <|
    opsProved_append (opsProved_flatMap (fun I _ => Blake2sInst.ok hT I)) <|
    opsProved_append (opsProved_flatMap (fun I _ => Blake3fInst.ok hT I)) <|
    opsProved_append (opsProved_flatMap (fun I _ => DmaInst.ok hT I)) <|
    opsProved_append (opsProved_flatMap (fun I _ => Dma64AlignedInst.ok hT I)) <|
    opsProved_append (opsProved_flatMap (fun I _ => Dma64AlignedLargeInst.ok hT I)) <|
    opsProved_append (opsProved_flatMap (fun I _ => Dma64AlignedMemInst.ok hT I)) <|
    opsProved_append (opsProved_flatMap (fun I _ => Dma64AlignedMemCpyInst.ok hT I)) <|
    opsProved_append (opsProved_flatMap (fun I _ => Dma64AlignedMemLargeInst.ok hT I)) <|
    opsProved_append (opsProved_flatMap (fun I _ => Dma64AlignedMemSetInst.ok hT I)) <|
    opsProved_append (opsProved_flatMap (fun I _ => DmaUnalignedInst.ok hT I)) <|
    opsProved_append (opsProved_flatMap (fun I _ => JumpDestInst.ok hT I)) <|
    opsProved_append (opsProved_flatMap (fun I _ => KeccakfInst.ok hT I)) <|
    opsProved_append (opsProved_flatMap (fun I _ => PoseidonInst.ok hT I)) <|
    opsProved_append (opsProved_flatMap (fun I _ => Sha256fInst.ok hT I)) <|
    opsProved_flatMap (fun I _ => TwistedEdwardsInst.ok hT I)

/-- **Every prover on the operation bus proves `pubout` correctly**, given the
tables' contents: none of them proves it at all. -/
theorem System.pub (S : System F) (hT : Tables S.xv S.tv) (hF : ∀ p ∈ frops S.x0 S.t0, FropsOk p) :
    PubProved S.provers :=
  pubProved_append (frops_pub hF) <|
    pubProved_append (pubProved_flatMap (fun I _ => Add256Inst.pub hT I)) <|
