require "std_permutation.pil"
require "opids.pil"

// ROM DATA STATE MACHINE
//
// This state machine proves all read accesses to a read-only memory. To prove these accesses,
// it groups all accesses to the same address together (consecutive lanes with the same addr).
// The first access to each address must be an initialization operation (MEMORY_ROM_INIT_OP)
// generated by the Rom state machine, which contains these initializations alongside the
// program instructions.
//
// To prove that all addresses are grouped (consecutive), an addr_change forces an INIT operation.
// Since the ROM only initializes each address once, addresses cannot be split into multiple
// groups — the second group would lack an INIT. This mechanism eliminates the need for address
// ordering or explicit address range checks.
//
// LANES
//
// A "lane" is the set of columns that verifies one ROM data access: addr_change, addr, step and
// value. With `lanes_x_row` > 1 each row packs `lanes_x_row` consecutive lanes of the sequence,
// ordered from index 0 to index lanes_x_row - 1, so the "previous lane" of lane `l` > 0 is lane
// `l - 1` of the same row, and the "previous lane" of lane 0 is the last lane (lanes_x_row - 1)
// of the previous row. The continuation air values (`previous_segment_*`) sit before lane 0 of
// the first row, and (`segment_last_*`) are the values of the last lane of the last row.

airtemplate RomData(const int N = 2**21, const int id = MEMORY_ID, const int rom_bus_id = ROM_BUS_ID, 
                const int RC = 2, const int bytes = 8, const int base_address = 0, const int size_mb = 128,
                const expr enable_flag = 1, const int lanes_x_row = 1) {

    assert(bytes == 8);
    assert(lanes_x_row >= 1);
    // Witness generation maps virtual rows to (row, lane) with a shift and a mask
    // (see MemLanes in state-machines/mem-common/src/mem_lanes.rs), so the lane count
    // must be a power of two.
    assert((lanes_x_row & (lanes_x_row - 1)) == 0, `lanes_x_row must be a power of two but it's ${lanes_x_row}`);

    const expr L1 = get_L1();
    const expr LAST = L1';

    // index of the last lane of a row, the lane used by the continuation values of the segment.
    const int LAST_LANE = lanes_x_row - 1;

    col witness bits(1) addr_change[lanes_x_row];
    col witness bits(29) addr[lanes_x_row];
    col witness bits(40) step[lanes_x_row];
    col witness bits(32) value[lanes_x_row][RC];

    // CONTINUATIONS

    // These previous values used on direct update to air bus, using constraints proves the relation
    // with values of the first lane of the first row of current segment

    airval previous_segment_value[RC];
    airval previous_segment_addr;
    
    airval segment_last_value[RC];
    airval segment_last_addr;

    airval segment_id;
    airval is_first_segment;
    airval is_last_segment;

    // constraints for boolean airvalues

    is_first_segment * (1 - is_first_segment) === 0;
    is_last_segment * (1 - is_last_segment) === 0;

    // If is_first_segment means that segment must be 0
    is_first_segment * segment_id === 0;

    // Force in first segment the first lane of the first row must be addr_change to force a INIT
    // operation
    is_first_segment * L1 * (addr_change[0] - 1) === 0;

    // ADDRESS GROUPING CONSTRAINTS
    //
    // addr_change = 1 forces step = MEMORY_INIT_STEP, linking the lane to an INIT operation.
    // When addr_change = 0, addr and value must equal the previous lane's values, ensuring
    // all accesses to the same address remain consecutive.

    for (int lane = 0; lane < lanes_x_row; ++lane) {
        addr_change[lane] * (1 - addr_change[lane]) === 0;
        addr_change[lane] * (step[lane] - MEMORY_INIT_STEP) === 0;
    }

    // `previous_value[l]` / `previous_addr[l]` are the values of the lane that precedes lane `l`:
    // lane `l - 1` of the same row when l > 0, and the last lane (LAST_LANE) of the previous row
    // when l == 0. On the first row (L1) lane 0 takes the values of the previous segment.

    const expr previous_value[lanes_x_row][RC];
    const expr previous_addr[lanes_x_row];

    for (int i = 0; i < RC; i++) {
      previous_value[0][i] = L1 * (previous_segment_value[i] - 'value[LAST_LANE][i]) + 'value[LAST_LANE][i];
      for (int lane = 1; lane < lanes_x_row; ++lane) {
        previous_value[lane][i] = value[lane-1][i];
      }
      // This constraint "proves" that the previous values of the next segment are the current last
      // values of this segment (airvals).
      // These last values must match the last lane of the last row of the current segment.
      LAST * (segment_last_value[i] - value[LAST_LANE][i]) === 0;
    }

    previous_addr[0] = L1 * (previous_segment_addr - 'addr[LAST_LANE]) + 'addr[LAST_LANE];
    for (int lane = 1; lane < lanes_x_row; ++lane) {
      previous_addr[lane] = addr[lane-1];
    }

    // The `segment_last_addr` air_value must match the `addr[LAST_LANE]` from the last row.
    LAST * (segment_last_addr - addr[LAST_LANE]) === 0;

    // BUS INTERACTION
    //
    // Every lane is sent to the memory bus as either a MEMORY_ROM_INIT_OP (when addr_change = 1,
    // i.e. the address is new) or a MEMORY_LOAD_OP (when addr_change = 0, i.e. the address
    // continues from the previous lane). Since the ROM is the sole source of INIT claims, only
    // addresses explicitly present in the ROM data can be proven valid.
    //
    // Address ordering is unnecessary: if a ROM address appeared more than once, only the first
    // occurrence would be consumed as an INIT (addr_change = 1). Any subsequent occurrence would
    // be sent as a plain LOAD (addr_change = 0), which cannot satisfy the bus INIT requirement —
    // making it impossible to forge or reuse addresses beyond those legitimately declared.

    for (int lane = 0; lane < lanes_x_row; ++lane) {
      for (int i = 0; i < RC; i++) {
        (1 - addr_change[lane]) * (value[lane][i] - previous_value[lane][i]) === 0;
      }
      (1 - addr_change[lane]) * (addr[lane] - previous_addr[lane]) === 0;

      permutation_proves(id, expressions: [addr_change[lane] * (MEMORY_ROM_INIT_OP - MEMORY_LOAD_OP) + MEMORY_LOAD_OP, addr[lane] * bytes, step[lane], 8, ...value[lane]]);
    }

    // In columns sent to the bus, we add base_address to avoid collisions between different memory
    // areas. Also for security send is_last_segment to avoid reuse end of last segment as start of
    // new cycle of segments

    const expr internal_base_address = base_address / bytes;
    const expr internal_end_address = (base_address + (size_mb * 1024 * 1024) - 1) / bytes;

    direct_update_assumes(ROM_DATA_CONTINUATION_ID, [ segment_id, is_first_segment, previous_segment_addr, ...previous_segment_value]);

    direct_update_proves(ROM_DATA_CONTINUATION_ID, [ segment_id+1, 0, segment_last_addr, ...segment_last_value], sel: (1 - is_last_segment));

    const int zeros[RC];

    for (int i = 0; i < RC; ++i) {
        zeros[i] = 0;
    }

    // Global constraint to ensure that memory segments are initialized only once. The `enable_flag`
    // must be a boolean value. The constraint on this boolean should be defined outside of memory
    // to prevent redundant constraints.This flag is used to handle cases where a memory area is not
    // used during a given execution.

    direct_global_update_proves(ROM_DATA_CONTINUATION_ID, [ 0,         // segment_id
                                                            1,         // is_first_segment
                                                            0,         // previous_segment_addr
                                                            ...zeros], // value
                                                            sel: enable_flag);
  
    // PADDING
    // 
    // The padding, number of assumes, is limited only to the last segment (is_last_segment = 1) and 
    // must be a positive number less than 2**24. It counts lanes, not rows.
    //
    // Security limitations:
    // • The memory operation is fixed (MEMORY_LOAD_OP): does not allow to start a new cycle
    // • The step value is fixed to MEMORY_INIT_STEP
    // • The addr and value must match the last values of the last lane (segment_last_addr and
    //   segment_last_value), assuming that the lanes are correct, these values are correct.
    
    airval padding_size;
    lookup(id, expressions: [MEMORY_LOAD_OP, segment_last_addr * 8, MEMORY_INIT_STEP, bytes, ...segment_last_value], mul: -padding_size);

    (1 - is_last_segment) * padding_size === 0;

    assert(N * lanes_x_row <= 2**24);
    range_check(expression: padding_size, min: 0, max: 2**24 - 1, sel: is_last_segment);
}
