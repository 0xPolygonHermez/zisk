require "std_lookup.pil";
require "std_permutation.pil";
require "std_direct.pil";
require "registers.pil"
require "opids.pil";

const int BOOT_ADDR = 0x1000;
const int END_PC_ADDR = 0x1004;
const int INITIAL_SP = 0;
const int END_SP = 0;
const int MAX_RANGE = (1 << 24) - 1;
const int REG_BASE_ADDR = 0xA040_0000;

airtemplate Main(int N = 2**21, int RC = 2, int stack_enabled = 0, 
                 const int REGS_IN_MAIN_FROM = 1, const int REGS_IN_MAIN_TO = 31,
                 const int lanes_x_row = 1) {

    assert(lanes_x_row > 0, "lanes_x_row must be greater than 0");

    const int REGS_IN_MAIN = REGS_IN_MAIN_TO - REGS_IN_MAIN_FROM + 1;

    // LANES
    //
    // A "lane" is the full set of columns that proves ONE execution step. With `lanes_x_row` > 1
    // each row packs that many CONSECUTIVE steps, ordered 0 .. lanes_x_row - 1, so the step before
    // lane `l` > 0 is lane `l - 1` of the same row, and the step before lane 0 is the last lane
    // (LAST_LANE) of the previous row. Every constraint that looked at the previous row now looks
    // at the previous lane, so the execution chain means the same: only how many steps ride on a
    // row changes.
    //
    // A segment therefore holds N * lanes_x_row steps, which is what STEPS names below. The main
    // step, the flush windows and the segment range check are all counted in those, not in rows.

    const int LAST_LANE = lanes_x_row - 1;
    const int STEPS = N * lanes_x_row;

    col fixed SEGMENT_STEP = [0..(N-1)];

    const expr SEGMENT_L1 = get_L1();
    const expr SEGMENT_LAST = SEGMENT_L1';

    // CONTINUATIONS
    //
    // Main continuations use air values to define constraints in a one-dimensional space
    // between air segments. Additionally, constraints involving these air values
    // and two-dimensional elements (trace, with rows and columns) are defined in air,
    // usually affecting values in the first and last rows of each segment.
    //
    //                       ┌── segment/next_segment
    //                       │   ┌── 0/is_last_segment
    //                       │   │     ┌── segment_initial_step/segment_next_step
    //                       │   │     │        ┌── inicial_pc/next_pc
    //                       │   │     │        │       ┌── previous_c/last_c
    //                       │   │     │        │       │
    //                       │   │     │        │       │             BUS
    //  global constraint  [  0|  0|     0|INITIAL_PC|0         ]   => | | ╌┐
    //                                                                 | |  ┆
    //  segment-0          [  0|  0|     0|INITIAL_PC|0         ]   <= | | <┘
    //  segment-0          [  1|  0|     N|pc_1      |last_c    ]   => | | ╌┐
    //  segment-1          [  1|  0|     N|pc_1      |previous_c]   <= | | <┘
    //  segment-1          [  2|  0|    2N|pc_2      |last_c    ]   => | | ╌┐
    //                     :   :   :      :          :          :      : :  :
    //                     :   :   :      :          :          :      : :  :
    //  segment-i          [  i|  0|    iN|pc_i      |previous_c]   <= | | <┘
    //  segment-i          [i+1|  0|(i+1)N|pc_i+1    |last_c    ]   => | | ╌┐
    //                     :   :   :      :          :          :      : :  :
    //                     :   :   :      :          :          :      : :  :
    //  segment-n          [  n|  0|    nN|pc_n      |previous_c]   <= | | <┘
    //  segment-n          [  0|  1|     0|END_PC    |0         ]   => | | ╌┐
    //                                                                 | |  ┆
    //  global constraint  [  0|  1|     0|END_PC    |0         ]   <= | | <┘
    //
    // One segment "assumes" the state/values of the previous segment and "proves" the state/values
    // of the next segment. To prevent an insecure cycle, we enforce that the beginning and end
    // of the cycle are defined by global constraints. With this mechanism, we ensure that only one
    // cycle is executed and what is exactly the initial and final state of the main trace.
    //
    // In the "assumed" state of the segment we put a 0 on second column (is_last_segment), while in
    // "proved" state we put the value of is_last_segment, with this we ensure that the end of last
    // segment cannot be used to init a new cycle.
    //
    // In main continuations, the `pc` of the next step is determined by the current state
    // (flags, register values, etc.). For this reason, in the last row, the next `pc` value is
    // calculated and then sent to the bus. In the first row of the next segment, it is verified
    // that these two values match.
    //
    // In the case of `c`, the current value of `c` is sent in the last row of a segment.
    // Within a segment, when `last_c` is referenced, if we are in the first row,
    // we take the value received from the bus; otherwise, we take the value from the previous row.

    airval main_last_segment;          // Selector to indicate that this is last main segment
    airval main_segment;               // Id of current main segment
    airval segment_initial_pc;         // Initial value of `pc`, it matches the `pc` value at row 0.
    airval segment_previous_c[RC];     // Last value stored in previous instance.
    airval segment_next_pc;            // The initial `pc` of next instance.
    airval segment_last_c[RC];         // Last value stored in current instance.
    airval segment_initial_step;       // Step offset of the first row in the current segment.

    const expr segment_next_step = (segment_initial_step + STEPS) * (1 - main_last_segment);

    if (stack_enabled) {
        airval air.segment_initial_sp;     // Initial value of `sp`, it matches the `sp` value at row 0.
        airval air.segment_next_sp;        // The initial `sp` of next instance.
    }

    // main_last_segment is a boolean value

    main_last_segment * (1 - main_last_segment) === 0;

    // STEP is a composed value of segment_initial_step (the steps run before this segment),
    // SEGMENT_STEP (the row, relative to the segment) and the lane inside the row.

    // A row advances lanes_x_row steps, and the lane is the offset inside it.
    const expr STEP[lanes_x_row];
    for (int lane = 0; lane < lanes_x_row; ++lane) {
        STEP[lane] = segment_initial_step + SEGMENT_STEP * lanes_x_row + lane;
    }

    // Registers

    col witness bits(32) a[lanes_x_row][RC];
    col witness bits(32) b[lanes_x_row][RC];
    col witness bits(32) c[lanes_x_row][RC];
    col witness bits(1) flag[lanes_x_row];
    col witness bits(32) pc[lanes_x_row];

    // Source A

    col witness bits(1) a_src_imm[lanes_x_row];
    col witness bits(1) a_src_mem[lanes_x_row];
    col witness bits(64, signed) a_offset_imm0[lanes_x_row];
                                       // the lower 32-bit part of an immediate value or the memory
                                       // address offset.
    if (stack_enabled == 1) {
        col witness bits(32) air.sp[lanes_x_row];
        col witness bits(1) air.a_src_sp[lanes_x_row];
        col witness bits(32) air.a_use_sp_imm1[lanes_x_row];
    } else {
        col witness bits(32) air.a_imm1[lanes_x_row];
    }
    col witness bits(1) is_precompiled[lanes_x_row];          // Selector to include step on operation bus

    // Source B

    col witness bits(1) b_src_imm[lanes_x_row];
    col witness bits(1) b_src_mem[lanes_x_row];
    col witness bits(64, signed) b_offset_imm0[lanes_x_row];
                                       // the lower 32-bit part of an immediate value or the memory
                                       // address offset.

    if (stack_enabled) {
        col witness bits(32) air.b_use_sp_imm1[lanes_x_row];
    } else {
        col witness bits(32) air.b_imm1[lanes_x_row];
    }
    col witness bits(1) b_src_ind[lanes_x_row];
                                       // read b form memory (b = mem[a])
    col witness bits(4) ind_width[lanes_x_row];

    // Operations related

    col witness bits(1) is_external_op[lanes_x_row];
    col witness bits(8) op[lanes_x_row];
                                       // [is_external_op == 0 && op=1] ==>  c=b, flag=0 (copy_b)
                                       // else then this op is sent to the bus.

    // Destination C

    col witness bits(1) store_pc[lanes_x_row];

    col witness bits(1) store_mem[lanes_x_row];
    
    col witness bits(1) store_ind[lanes_x_row];

    col witness bits(64, signed) store_offset[lanes_x_row];

    col witness bits(1) set_pc[lanes_x_row];

    if (stack_enabled) {
        col witness bits(1) air.store_use_sp[lanes_x_row];
        col witness bits(1) air.set_sp[lanes_x_row];
        col witness bits(64, signed) air.inc_sp[lanes_x_row];
    }

    // branch jump if flag = 1, jump to pc + jmp_offset1
    //             if set_pc = 1, jump to c[0] + jmp_offset1
    col witness bits(64, signed) jmp_offset1[lanes_x_row];

    // default jump if flag = 0, jump to pc + jmp_offset2
    col witness bits(64, signed) jmp_offset2[lanes_x_row];

    col witness bits(1) m32[lanes_x_row];
                                       // to bus must be 0, because it's a 32 bits operation. Used
                                       // to avoid sent to bus dirty values.

    const expr sel_mem_b[lanes_x_row];
    for (int lane = 0; lane < lanes_x_row; ++lane) {
        sel_mem_b[lane] = b_src_mem[lane] + b_src_ind[lane];
    }

    // Some of these values are expressions while others are witness + constraint. The expressions
    // are "converted" to witness to avoid increase the degree on stage 2 with extension.

    if (stack_enabled) {
        col witness bits(32) air.addr0[lanes_x_row];
        col witness bits(32) air.addr1[lanes_x_row];
        col witness bits(32) air.addr2[lanes_x_row];

        for (int lane = 0; lane < lanes_x_row; ++lane) {
            addr0[lane] === a_offset_imm0[lane] + a_use_sp_imm1[lane] * sp[lane];
            addr1[lane] === b_offset_imm0[lane] + b_src_ind[lane] * a[lane][0] +  b_use_sp_imm1[lane] * sp[lane];
            addr2[lane] === store_offset[lane] + store_ind[lane] * a[lane][0] + store_use_sp[lane] * sp[lane];

            // to avoid the addr1 overflow when a[0] has high value, this is not problem
            // because use address of 32-bits
            (store_ind[lane] + b_src_ind[lane]) * a[lane][1] === 0;
        }
    } else {
        const expr air.addr0[lanes_x_row];
        col witness bits(32) air.addr1[lanes_x_row];
        const expr air.addr2[lanes_x_row];
        for (int lane = 0; lane < lanes_x_row; ++lane) {
            addr0[lane] = a_offset_imm0[lane];
            addr1[lane] === b_offset_imm0[lane] + b_src_ind[lane] * a[lane][0];
            addr2[lane] = store_offset[lane] + store_ind[lane] * a[lane][0];

            // to avoid the addr1 overflow when a[0] has high value, this is not problem
            // because use address of 32-bits
            (store_ind[lane] + b_src_ind[lane]) * a[lane][1] === 0;
        }
    }

    //
    // Timestamp: main_step, mem_step
    //
    // A step of the main is like a timestamp. We use the concepts of main_step and mem_step.
    // The mem_step is a smaller unit than the main_step because, in the same main_step, multiple
    // memory operations can occur. We have 4 mem_steps for each main_step to do two reads and one
    // write. These reads and writes could be unaligned, or we could call to a precompiled operation,
    // and we need space for them (unaligned, precompiled make read and write).
    //
    // The conversion is like mem_step = 1 + main_step * 4 + mem_slot.
    // The mem_slot is the position of operation inside de main_step, 0,1 for read, 2,3 for write.

    //
    // Registers on Main
    //
    // Move registers from memory to main, using a linked operations list to guarantee the
    // integrity of register operations:
    //
    // - List must be ordered.
    //
    //   To check it, on each operation, we verify with a range check that the previous operation
    //   is older than the current; this means the difference between current mem_step and
    //   previous_reg_mem_step is greater than 1.
    //
    // - Link operations
    //
    //   We assume that the register on the previous mem_step has a previous value, and we prove
    //   the register has a value in the current mem_step. The previous value and value are the
    //   same for a read operation because they use the same column. To reduce number of columns,
    //   we reuse the actual assume used by memory. For this reason really we use prove for previous
    //   operation and assume for current operation.
    //
    // - Large Range Check
    //
    //   When we verify that prev_reg_mem_step is less than reg_mem_step, use a range check,
    //   but this range check is limited to 2^24, but it isn't enough. For example, if we read
    //   a register on the first row of an instance and read again at the same row but eight
    //   instances after, the difference between range_checks was 4 * 8 * sizeo_of_instance.
    //
    //   For example: 4 * 8 * 2^21 = 2^26.
    //
    //   To avoid this situation, we reload all registers at the end of every flush window (at
    //   most 2^22 main steps, a single end-of-segment flush when N <= 2^22): the reload proves
    //   the last access of the window and assumes a fresh one, restarting the maximum distance.
    //   With this, every difference stays below 4 * 2^22 = 2^24, regardless of the instance
    //   size N.
    //
    // - Initial and Final Cycle
    //
    //   In the global constraints, we prove (assume) that the initial values of registers were
    //   zero. At each end of the instance, we send to the bus a proves and assumes for each
    //   register, but in the last segment, we don't send the assume, only send provers, and
    //   with this, we close the cycle.
    //
    // - The register region and normal memory are non-overlapping.
    //
    //   The register area is mapped to a separate "address range", ensuring it does not
    //   interfere with normal memory. Registers use indexes as their addresses to prevent overlap
    //   with regular memory. The area allocated for registers does not overlap with any memory
    //   region. As a result, no memory state machine can validate memory access in this area;
    //   only the main state machine can 'prove' such memory access.
    //
    // - SECURITY: the chain must be STRICTLY incremental.
    //
    //   The permutation argument only guarantees that every assumed tuple is proven exactly once
    //   (conservation); having one global start (init) and one global end (flush of the last
    //   segment) only guarantees that ONE init->flush path exists. It does NOT exclude extra
    //   disconnected components: since every access proves one tuple and assumes one tuple, the
    //   access graph decomposes into one path PLUS any number of disjoint cycles. If the range
    //   check allowed prev_reg_mem_step == reg_mem_step, a single link could close on itself:
    //   the access would prove exactly the tuple it assumes (both share the same value column),
    //   both sides of the permutation cancel, and the link detaches from the real chain carrying
    //   an ARBITRARY value, while the real chain reconnects around it (the next access simply
    //   points its free prev_reg_mem_step at the older tuple). The strict -1 in every range
    //   check is what makes cycles impossible: around a cycle the mem_step would have to
    //   strictly increase and return to its starting point. This is also why every access of an
    //   instruction needs its own mem_slot (a=0, b=1, store=2, flush=3): distinct slots keep the
    //   strict check satisfiable when chaining accesses of the same main_step (e.g. a and b
    //   reading the same register).

    col witness bits(REG_STEP_BITS) a_reg_prev_mem_step[lanes_x_row];
    col witness bits(REG_STEP_BITS) b_reg_prev_mem_step[lanes_x_row];
    col witness bits(REG_STEP_BITS) store_reg_prev_mem_step[lanes_x_row];
    col witness bits(32) store_reg_prev_value[lanes_x_row][RC];
    col witness bits(1) a_src_reg[lanes_x_row];
    col witness bits(1) b_src_reg[lanes_x_row];
    col witness bits(1) store_reg[lanes_x_row];

    const expr a_mem_step[lanes_x_row];
    const expr b_mem_step[lanes_x_row];
    const expr store_mem_step[lanes_x_row];

    for (int lane = 0; lane < lanes_x_row; ++lane) {
        // Calculate the memory step from the main step

        a_mem_step[lane] = main_step_to_mem_step(STEP[lane], 0);
        b_mem_step[lane] = main_step_to_mem_step(STEP[lane], 1);
        store_mem_step[lane] = main_step_to_mem_step(STEP[lane], 2);

        // Memory function to prove that previous register a_offset_imm0 access.

        reg_pre_load(sel: a_src_reg[lane],
                 prev_mem_step: a_reg_prev_mem_step[lane],
                 addr: a_offset_imm0[lane],
                 value: a[lane]);

        // Memory function to assume current register a_offset_imm0 access or memory access to addr0.

        mem_op(sel: a_src_mem[lane] + a_src_reg[lane],
               op: MEMORY_LOAD_OP * a_src_mem[lane] + MEMORY_REG_OP * a_src_reg[lane],
               mem_step: a_mem_step[lane],
               addr: addr0[lane],
               value: a[lane]);


        // Memory function to prove that previous register b_offset_imm0 access.

        reg_pre_load(sel: b_src_reg[lane],
                 prev_mem_step: b_reg_prev_mem_step[lane],
                 addr: b_offset_imm0[lane],
                 value: b[lane]);

        // Memory function to assume current register b_offset_imm0 access or memory access to addr1.

        mem_op(sel: sel_mem_b[lane] + b_src_reg[lane],
               op: MEMORY_LOAD_OP * sel_mem_b[lane] + MEMORY_REG_OP * b_src_reg[lane],
               mem_step: b_mem_step[lane],
               bytes: b_src_ind[lane] * (ind_width[lane] - 8) + 8,
               addr: addr1[lane],
               value: b[lane]);

        // Calculate the value to store in memory

        const expr store_value[lanes_x_row][2];

        store_value[lane][0] = store_pc[lane]*(pc[lane] + jmp_offset2[lane] - c[lane][0]) + c[lane][0];
        // BUG(rv64-auipc): when store_pc=1 (AUIPC), store_value[1] is forced to 0, dropping the
        // carry out of bit 31 of (pc + jmp_offset2).  For pc + jmp_offset2 >= 2^32 - valid in RV64I,
        // e.g. auipc rd, 0x7ffff at PC >= 0x80001000 - this no longer matches the 64-bit value
        // that the memory/register bus represents as two 32-bit limbs.
        // Reproducer: elf-regressions/auipc_rv64_overflow/
        store_value[lane][1] = (1 - store_pc[lane]) * c[lane][1];

        // Memory function to prove that previous register store_offset access.

        reg_pre_store(sel: store_reg[lane],
                  prev_mem_step: store_reg_prev_mem_step[lane],
                  addr: store_offset[lane],
                  value: store_reg_prev_value[lane]);

        // Memory function to assume current register store_offset access or memory access to addr2.

        mem_op(sel: store_mem[lane] + store_ind[lane] + store_reg[lane],
               op: MEMORY_STORE_OP * (store_mem[lane] + store_ind[lane]) + MEMORY_REG_OP * store_reg[lane],
               mem_step: store_mem_step[lane],
               bytes: store_ind[lane] * (ind_width[lane] - 8) + 8,
               addr: addr2[lane],
               value: store_value[lane]);

        // Range check for register operations, to check that previous register access is greater than
        // the current register access.

        range_check(expression: a_mem_step[lane] - a_reg_prev_mem_step[lane] - 1, min: 0, max: MAX_RANGE, sel: a_src_reg[lane]);
        range_check(expression: b_mem_step[lane] - b_reg_prev_mem_step[lane] - 1, min: 0, max: MAX_RANGE, sel: b_src_reg[lane]);
        range_check(expression: store_mem_step[lane] - store_reg_prev_mem_step[lane] - 1 , min: 0, max: MAX_RANGE, sel: store_reg[lane]);

        const expr a_src_c[lanes_x_row];
        const expr b_src_c[lanes_x_row];

        const expr a_imm[lanes_x_row][2];
        const expr b_imm[lanes_x_row][2];

        a_imm[lane][0] = a_offset_imm0[lane];
        b_imm[lane][0] = b_offset_imm0[lane];

        // Optimization to avoid use extra columns when c is source for a or b.

        if (stack_enabled) {
            a_src_c[lane] = 1 - a_src_mem[lane] - a_src_imm[lane] - a_src_sp[lane];
            b_src_c[lane] = 1 - b_src_mem[lane] - b_src_imm[lane] - b_src_ind[lane] - b_src_reg[lane];
            a_imm[lane][1] = a_use_sp_imm1[lane];
            b_imm[lane][1] = b_use_sp_imm1[lane];
        } else {
            a_src_c[lane] = 1 - a_src_mem[lane] - a_src_imm[lane] - a_src_reg[lane];
            b_src_c[lane] = 1 - b_src_mem[lane] - b_src_imm[lane] - b_src_ind[lane] - b_src_reg[lane];
            a_imm[lane][1] = a_imm1[lane];
            b_imm[lane][1] = b_imm1[lane];
        }

        // Sent to bus the external operation

        // Precompiles are generated throw transpilation because them not exists directly in RISCV
    
        // The flag m32 is used to avoid send "garbage" values to bus, to simplify the other state
        // state machines and to increase the hits to FROPS (frequent operations).

        assumes_operation(op: op[lane],
                          a: [a[lane][0], (1 - m32[lane]) * a[lane][1]], 
                          b: [b[lane][0], (1 - m32[lane]) * b[lane][1]], 
                          c: c[lane], 
                          flag: flag[lane], 
                          main_step: STEP[lane] * is_precompiled[lane], 
                          extended_arg: jmp_offset1[lane] * is_precompiled[lane],
                          sel: is_external_op[lane]);

        for (int index = 0; index < RC; ++index) {
            // The step before this one: lane l - 1 of the same row, or the last lane of the previous
            // row for lane 0 — which on the first row is what the previous segment handed over.
            const expr previous_c;
            if (lane == 0) {
                previous_c = SEGMENT_L1 * (segment_previous_c[index] - 'c[LAST_LANE][index]) + 'c[LAST_LANE][index];
            } else {
                previous_c = c[lane - 1][index];
            }

            if (stack_enabled) {
                // a_src_sp ===> set a = sp (only less significant index, rest must be 0)
                a_src_sp[lane] * (a[lane][index] - (index == 0 ? sp: 0 )) === 0;
            }

            // If source is c, value must be same as previous_c
            a_src_c[lane] * (a[lane][index] - previous_c) === 0;
            b_src_c[lane] * (b[lane][index] - previous_c) === 0;

            // If source is immediate, value must immediate value
            a_src_imm[lane] * (a[lane][index] - a_imm[lane][index]) === 0;
            b_src_imm[lane] * (b[lane][index] - b_imm[lane][index]) === 0;

            // if is not an external op and op=0 set c = 0
            (1 - is_external_op[lane]) * (1 - op[lane]) * c[lane][index] === 0;

            // if is not an external op and op=1 set c = b
            (1 - is_external_op[lane]) * op[lane] * (b[lane][index] - c[lane][index]) === 0;
        }


        // if is not an external op and op=0 set flag = 1
        (1 - is_external_op[lane]) * (1 - op[lane]) * (1 - flag[lane]) === 0;

        // if is not an external op and op=1 set flag = 0
        (1 - is_external_op[lane]) * op[lane] * (flag[lane]) === 0;

        // The selectors flag an set_pc are disjoint, meaning they cannot be active simultaneously.
        flag[lane] * set_pc[lane] === 0;

        // A user program lives in [0x8000_0000, 0x8000_0000 + 128MB), so any valid address plus a
        // valid 12-bit (or 32-bit) offset is guaranteed to fit within a Goldilocks field element.
        // If the result is "negative" or falls outside this range, proof generation will fail,
        // because the program will have jumped to a non-existent address and the ROM lookup will fail.
        // This constraint addresses a soundness issue: without it, if c[1] were non-zero,
        // the jump destination would be computed using only c[0] + jmp_offset1 — ignoring the upper
        // part of the address — which could silently land on a different but valid address, producing
        // a valid proof for an incorrect jump target.
        // To prevent this, c[1] is assumed to be zero, and this constraint enforces it.
        set_pc[lane] * c[lane][1] === 0;

        // The pc that follows the previous step. For lane 0 that step is on the previous row, so the
        // constraint is skipped on the first row — the segment hands the pc over instead. For any other
        // lane the previous step is on this same row, so there is no boundary to skip.
        const expr expected_current_pc;
        if (lane == 0) {
            expected_current_pc = 'set_pc[LAST_LANE] * ('c[LAST_LANE][0] + 'jmp_offset1[LAST_LANE])
                                  + (1 - 'set_pc[LAST_LANE]) * ('pc[LAST_LANE] + 'jmp_offset2[LAST_LANE])
                                  + 'flag[LAST_LANE] * ('jmp_offset1[LAST_LANE] - 'jmp_offset2[LAST_LANE]);
            (1 - SEGMENT_L1) * (pc[0] - expected_current_pc) === 0;
        } else {
            expected_current_pc = set_pc[lane - 1] * (c[lane - 1][0] + jmp_offset1[lane - 1])
                                  + (1 - set_pc[lane - 1]) * (pc[lane - 1] + jmp_offset2[lane - 1])
                                  + flag[lane - 1] * (jmp_offset1[lane - 1] - jmp_offset2[lane - 1]);
            pc[lane] - expected_current_pc === 0;
        }


        if (stack_enabled) {
            const expr expected_current_sp;
            if (lane == 0) {
                expected_current_sp = 'set_sp[LAST_LANE] * ('c[LAST_LANE][0] - 'sp[LAST_LANE]) + 'sp[LAST_LANE] + 'inc_sp[LAST_LANE];
                SEGMENT_L1 * (sp[0] - segment_initial_sp) === 0;
                (1 - SEGMENT_L1) * (sp[0] - expected_current_sp) === 0;
                // What follows the last lane of the last row is what lane 0 of the next row takes.
                SEGMENT_LAST * (expected_current_sp' - segment_next_sp) === 0;
            } else {
                expected_current_sp = set_sp[lane - 1] * (c[lane - 1][0] - sp[lane - 1]) + sp[lane - 1] + inc_sp[lane - 1];
                sp[lane] - expected_current_sp === 0;
            }
        }

        // Only lane 0 carries the hand-over: its expression one row on is the pc that follows the last
        // step of the segment.
        if (lane == 0) {
            SEGMENT_LAST * (segment_next_pc - expected_current_pc') === 0;
        }

        // The segment hands over the c of its LAST step, which is the last lane of the last row.
        if (lane == LAST_LANE) {
            for (int index = 0; index < RC; ++index) {
                SEGMENT_LAST * (segment_last_c[index] - c[LAST_LANE][index]) === 0;
            }
        }

    }

    for (int lane = 0; lane < lanes_x_row; ++lane) {
        // flag must be boolean

        flag[lane] * (1 - flag[lane]) === 0;

        // set lsb of rom_flags always to 1 to force that padding rom rows (all values to zero), doesn't
        // match with main trace.

        // To compress flags into a single value and optimize ROM, we must ensure that all these flags
        // are boolean.

        a_src_imm[lane] * (1 - a_src_imm[lane]) === 0;
        a_src_mem[lane] * (1 - a_src_mem[lane]) === 0;
        is_precompiled[lane] * (1 - is_precompiled[lane]) === 0;
        b_src_imm[lane] * (1 - b_src_imm[lane]) === 0;
        b_src_mem[lane] * (1 - b_src_mem[lane]) === 0;
        is_external_op[lane] * (1 - is_external_op[lane]) === 0;
        store_pc[lane] * (1 - store_pc[lane]) === 0;
        store_mem[lane] * (1 - store_mem[lane]) === 0;
        store_ind[lane] * (1 - store_ind[lane]) === 0;
        set_pc[lane] * (1 - set_pc[lane]) === 0;
        m32[lane] * (1 - m32[lane]) === 0;
        b_src_ind[lane] * (1 - b_src_ind[lane]) === 0;
        a_src_reg[lane] * (1 - a_src_reg[lane]) === 0;
        b_src_reg[lane] * (1 - b_src_reg[lane]) === 0;
        store_reg[lane] * (1 - store_reg[lane]) === 0;

        expr _flags = 1 + 2 * a_src_imm[lane] + 2**2 * a_src_mem[lane] + 2**3 * is_precompiled[lane] + 2**4 * b_src_imm[lane]
                      + 2**5 * b_src_mem[lane] + 2**6 * is_external_op[lane] + 2**7 * store_pc[lane] + 2**8 * store_mem[lane]
                      + 2**9 * store_ind[lane] + 2**10 * set_pc[lane] + 2**11 * m32[lane] + 2**12 * b_src_ind[lane]
                      + 2**13 * a_src_reg[lane] + 2**14 * b_src_reg[lane] + 2**15 * store_reg[lane];

        if (stack_enabled) {
            a_src_sp[lane] * (1 - a_src_sp[lane]) === 0;
            store_use_sp[lane] * (1 - store_use_sp[lane]) === 0;
            set_sp[lane] * (1 - set_sp[lane]) === 0;

            _flags = _flags + 2**20 * a_src_sp[lane] + 2**21 * store_use_sp[lane] + 2**22 * set_sp[lane];
        }

        const expr rom_flags = _flags;

        // Lookup in ROM to ensure that only program instructions are executed.

        if (stack_enabled) {
            lookup_assumes(ROM_BUS_ID, [pc[lane], a_offset_imm0[lane], a_use_sp_imm1[lane], b_offset_imm0[lane], b_use_sp_imm1[lane], ind_width[lane],
                                        op[lane], store_offset[lane], jmp_offset1[lane], jmp_offset2[lane], inc_sp[lane], rom_flags]);
        } else {
            lookup_assumes(ROM_BUS_ID, [pc[lane], a_offset_imm0[lane], a_imm1[lane], b_offset_imm0[lane], b_imm1[lane], ind_width[lane],
                                        op[lane], store_offset[lane], jmp_offset1[lane], jmp_offset2[lane], rom_flags]);
        }
    }

    // Constraints for registers on main
    //
    // Registers are reloaded (flushed) in windows of at most 2^22 main steps: each flush proves
    // the last access of its window and assumes a reload at the window's special mem_step, which
    // becomes the previous access of the next window (or of the next segment, for the last one).
    // Every flush restarts the maximum distance between chained accesses, so all the register
    // range checks stay below 4 * 2^22 = 2^24 regardless of STEPS. For STEPS <= 2^22 there is a
    // single flush at the end of the segment.

    const int FLUSH_COUNT;
    const int FLUSH_SIZE;
    if (STEPS > 2**22) {
        FLUSH_COUNT = STEPS >> 22;
        FLUSH_SIZE = 2**22;
    } else {
        FLUSH_COUNT = 1;
        FLUSH_SIZE = STEPS;
    }

    airval last_reg_value[FLUSH_COUNT][REGS_IN_MAIN][RC]; // last value of the flush window for each register.
    airval last_reg_mem_step[FLUSH_COUNT][REGS_IN_MAIN];  // last access mem_step of the flush window for each register.

    for (int flush_index = 0; flush_index < FLUSH_COUNT; ++flush_index) {

        // Special mem_step at the end of the window. If the last rows have stored a value in a
        // register, the `mem_offset` is 2. For this reason, `mem_offset` 3 is safe and available.
        // The `mem_offset` is only used by precompiled or unaligned memory writes, which exclude
        // a register write.

        const expr flush_reg_mem_step = main_step_to_special_mem_step(segment_initial_step + (flush_index + 1) * FLUSH_SIZE - 1);

        for (int ireg = 0; ireg < REGS_IN_MAIN; ++ireg) {
            // Range check to verify that the previous access was strictly before the flush.
            range_check(expression: flush_reg_mem_step - last_reg_mem_step[flush_index][ireg] - 1, min: 0, max: MAX_RANGE);

            // Proves the last access of the window.
            reg_pre_load(prev_mem_step: last_reg_mem_step[flush_index][ireg], addr: ireg + REGS_IN_MAIN_FROM, value: last_reg_value[flush_index][ireg]);

            // Assume the reload: it becomes the previous access of the next window, or of the
            // next segment for the last flush. Intermediate reloads are always sent (they are
            // consumed inside this same segment); the last one is not sent in the last segment,
            // closing the cycle.
            if (flush_index == FLUSH_COUNT - 1) {
                mem_op(op: MEMORY_REG_OP, mem_step: flush_reg_mem_step, addr: ireg + REGS_IN_MAIN_FROM, value: last_reg_value[flush_index][ireg], sel: (1 - main_last_segment));
            } else {
                mem_op(op: MEMORY_REG_OP, mem_step: flush_reg_mem_step, addr: ireg + REGS_IN_MAIN_FROM, value: last_reg_value[flush_index][ireg]);
            }
        }
    }
    // Continuations between segments, we assume initial state and proves the final state.

    // The next segment increments the current segment by one, except for the last segment, which
    // closes the cycle at the known main_segment_id.

    const expr main_next_segment = (main_segment + 1) * (1 - main_last_segment);

    if (stack_enabled) {
        direct_update_assumes(MAIN_CONTINUATION_ID, [main_segment, 0, segment_initial_step, segment_initial_pc, ...segment_previous_c, segment_initial_sp]);
        direct_update_proves(MAIN_CONTINUATION_ID, [main_next_segment, main_last_segment, segment_next_step, segment_next_pc, ...segment_last_c, segment_next_sp]);
    } else {
        direct_update_assumes(MAIN_CONTINUATION_ID, [main_segment, 0, segment_initial_step, segment_initial_pc, ...segment_previous_c]);
        direct_update_proves(MAIN_CONTINUATION_ID, [main_next_segment, main_last_segment, segment_next_step, segment_next_pc, ...segment_last_c]);
    }

    SEGMENT_L1 * (segment_initial_pc - pc[0]) === 0;

    // This global constraint is sent to the bus to define the initial and final values of
    // continuations. A global constraint is used to ensure there is only one initial and one final
    // value, preventing multiple cycles of `main`.

    // In the initial state define the initial `pc` and final  `pc`. Before finish a execution the
    // value of "c" must be 0.

    const int zeros[RC];
    for (int index = 0; index < RC; ++index) {
        zeros[index] = 0;
    }

    // These constraints define the state at the beginning and end of a main continuation.

    if (stack_enabled) {
        direct_global_update_proves(MAIN_CONTINUATION_ID, expressions: [0, 0, 0, BOOT_ADDR, ...zeros, INITIAL_SP]);
        direct_global_update_assumes(MAIN_CONTINUATION_ID, expressions: [0, 1, 0, END_PC_ADDR, ...zeros, END_SP]);
    } else {
        direct_global_update_proves(MAIN_CONTINUATION_ID, expressions: [0, 0, 0, BOOT_ADDR, ...zeros]);
        direct_global_update_assumes(MAIN_CONTINUATION_ID, expressions: [0, 1, 0, END_PC_ADDR, ...zeros]);
    }

    // The initialization of the main registers cycle, these constraints that defines the beginning
    // of a cycle of register access. Their initial value is set to zero.

    for (int ireg = 0; ireg < REGS_IN_MAIN; ++ireg) {
        global_init_mem(sel: 1, addr: ireg + REGS_IN_MAIN_FROM, value: zeros);
    }


    // Main Segment constraint
    range_check(main_segment, min: 0, max: ((2**MAIN_STEP_BITS)/STEPS) - 1);
}
